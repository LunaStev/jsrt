import("./context_state")::{owned_context_slot, active_context};
struct HttpClientState {
    clients: ptr<Client>;
    multi: ptr<u8>;
    initialized: bool;
    methods: array<ptr<u8>, 13>;
    https_exports: ptr<u8>;
    object_keys: ptr<u8>;
    header_states: ptr<u8>;
}

fun http_client_storage(ctx: ptr<u8>) -> ptr<HttpClientState> {
    return owned_context_slot(ctx, 13, size_of<HttpClientState>() as i64) as ptr<HttpClientState>;
}

// libcurl drives DNS/TLS and transport. Wave owns validation, streams and JS dispatch.
import("./url")::{url_input};
import("std::mem::alloc")::{mem_alloc, mem_alloc_zeroed, mem_free};
import("std::mem::layout")::{size_of};
