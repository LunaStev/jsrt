extern(c, "curl_global_init") fun curl_init(flags: i64) -> i32;
extern(c, "curl_global_cleanup") fun curl_cleanup();
extern(c, "curl_easy_init") fun easy_init() -> ptr<u8>;
extern(c, "curl_easy_cleanup") fun easy_cleanup(easy: ptr<u8>);
extern(c, "curl_easy_pause") fun easy_pause(easy: ptr<u8>, flags: i32) -> i32;
extern(c, "curl_multi_init") fun multi_init() -> ptr<u8>;
extern(c, "curl_multi_cleanup") fun multi_cleanup(multi: ptr<u8>) -> i32;
extern(c, "curl_multi_add_handle") fun multi_add(multi: ptr<u8>, easy: ptr<u8>) -> i32;
extern(c, "curl_multi_remove_handle") fun multi_remove(multi: ptr<u8>, easy: ptr<u8>) -> i32;
extern(c, "curl_multi_perform") fun multi_perform(multi: ptr<u8>, running: ptr<i32>) -> i32;
extern(c, "curl_slist_append") fun header_append(headers: ptr<u8>, line: str) -> ptr<u8>;
extern(c, "curl_slist_free_all") fun headers_free(headers: ptr<u8>);
extern(c, "curl_easy_strerror") fun curl_error(code: i32) -> str;
extern(c, "curl_url") fun url_new() -> ptr<u8>;
extern(c, "curl_url_cleanup") fun url_free(url: ptr<u8>);
extern(c, "curl_url_set") fun url_set(url: ptr<u8>, part: i32, value: ptr<u8>, flags: u32) -> i32;
extern(c, "curl_url_get") fun url_get(url: ptr<u8>, part: i32, value: ptr<ptr<u8>>, flags: u32) -> i32;
extern(c, "curl_free") fun curl_free(value: ptr<u8>);
extern(c, "jsrt_curl_set_long") fun set_long(easy: ptr<u8>, key: i32, value: i64) -> i32;
extern(c, "jsrt_curl_set_ptr") fun set_ptr(easy: ptr<u8>, key: i32, value: ptr<u8>) -> i32;
extern(c, "jsrt_curl_get_long") fun get_long(easy: ptr<u8>, key: i32) -> i64;
extern(c, "jsrt_curl_get_ptr") fun get_ptr(easy: ptr<u8>, key: i32) -> ptr<u8>;
