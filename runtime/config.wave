pub fun engine_supported(major: u32, minor: u32, micro: u32, patch: u32) -> bool {
    return major > ENGINE_MAJOR || (major == ENGINE_MAJOR && minor > ENGINE_MINOR) || (major == ENGINE_MAJOR && minor == ENGINE_MINOR && micro > ENGINE_MICRO) || (major == ENGINE_MAJOR && minor == ENGINE_MINOR && micro == ENGINE_MICRO && patch >= ENGINE_PATCH);
}
