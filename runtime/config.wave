// JavaScriptCoreGTK baseline restored to the project's original engine policy.
// Release source: https://webkitgtk.org/releases/ (verified 2026-10-20).
pub const ENGINE_MAJOR: u32 = 2;
pub const ENGINE_MINOR: u32 = 54;
pub const ENGINE_MICRO: u32 = 1;
pub const ENGINE_PATCH: u32 = 0;
