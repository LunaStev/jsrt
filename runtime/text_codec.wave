// UTF-8 Web encoders and incremental decoders, including BOM and fatal policy.
import("./context_state")::{owned_context_slot, context_slot, release_context_slot};
import("./values")::{get, put, text, plain, define, getter, fail};
import("./collections")::{weak_map, weak_get, weak_set, flag, set_flag};
import("./web_support")::{source_bytes, usv_text, public_constructor};
import("./buffer_core")::{byte_view_length, copy_byte_view, buffer_from_bytes, write_byte_view};
import("./byte_codec")::{encode_utf8};
import("./config")::{BUFFER_LIMIT};
import("std::mem::layout")::{size_of};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::mem::cstr")::{mem_eq_cstr};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_number") fun number(ctx: ptr<u8>, value: f64) -> ptr<u8>;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, value: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_utf16") fun utf16(value: ptr<u16>, count: i64) -> ptr<u8>;
extern(c, "wr_string_value") fun string_value(ctx: ptr<u8>, value: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_typed_type") fun typed_type(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i32;
extern(c, "wr_u8_new") fun new_u8(ctx: ptr<u8>, count: i64, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "jsrt_text_callback") fun callback(constructing: bool) -> ptr<u8>;
const SLOT: i64 = 43;
const ENCODE: i64 = 0;
const ENCODE_INTO: i64 = 1;
const DECODE: i64 = 2;
const ENCODING: i64 = 3;
const FATAL: i64 = 4;
const IGNORE_BOM: i64 = 5;
struct State {
    records: ptr<u8>;
    ctors: array<ptr<u8>, 2>;
    methods: array<ptr<u8>, 6>;
}
fun state(ctx: ptr<u8>) -> ptr<State> {
    return context_slot(ctx, SLOT) as ptr<State>;
}
fun record(ctx: ptr<u8>, owner: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, owner) != 5) {
        fail(ctx, ex, 1, "invalid text codec receiver");
        return undefined(ctx);
    }
    var s: ptr<State> = state(ctx);
    var result: ptr<u8> = weak_get(ctx, deref s.records, owner, ex);
    if (kind(ctx, result) != 5) {
        fail(ctx, ex, 1, "invalid text codec receiver");
    }
    return result;
}
export(c) fun jsrt_text_construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var decoder: bool = equal(ctx, ctor, (deref s.ctors)[1]);
    var r: ptr<u8> = plain(ctx);
    protect(ctx, r);
    set_flag(ctx, r, "decoder", decoder, ex);
    if (decoder && count > 0 && kind(ctx, args[0]) != 0) {
        var label: ptr<u8> = usv_text(ctx, args[0], ex);
        protect(ctx, label);
        var bytes: array<u8, 128>;
        var n: i64 = encode_utf8(ctx, label, &bytes[0], 128, false, ex);
        var first: i64 = 0;
        while (first < n && (bytes[first] == 32 || (bytes[first] >= 9 && bytes[first] <= 13))) {
            first += 1;
        }
        while (n > first && (bytes[n - 1] == 32 || (bytes[n - 1] >= 9 && bytes[n - 1] <= 13))) {
            n -= 1;
        }
        if (n >= 0) {
            bytes[n] = 0;
            for (var i: i64 = first; i < n; i++) {
                if (bytes[i] >= 65 && bytes[i] <= 90) {
                    bytes[i] += 32;
                }
            }
            if (!mem_eq_cstr((&bytes[0] + first) as str, "utf-8") &&
                !mem_eq_cstr((&bytes[0] + first) as str, "utf8") &&
                !mem_eq_cstr((&bytes[0] + first) as str, "unicode-1-1-utf-8")) {
                fail(ctx, ex, 2, "TextDecoder currently supports UTF-8 labels only");
            }
        }
        unprotect(ctx, label);
    }
    if (decoder && count > 1 && kind(ctx, args[1]) != 0 && kind(ctx, args[1]) != 1) {
        if (kind(ctx, args[1]) != 5) {
            fail(ctx, ex, 1, "TextDecoder options must be an object");
        } else {
            set_flag(ctx, r, "fatal", truth(ctx, get(ctx, args[1], "fatal", ex)), ex);
            set_flag(ctx, r, "ignoreBOM", truth(ctx, get(ctx, args[1], "ignoreBOM", ex)), ex);
        }
    }
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        result = object(ctx, null, null);
        protect(ctx, result);
        prototype(ctx, result, get(ctx, ctor, "prototype", ex));
        weak_set(ctx, deref s.records, result, r, ex);
        unprotect(ctx, result);
    }
    unprotect(ctx, r);
    return result;
}
fun encode(ctx: ptr<u8>, mode: i64, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var source: ptr<u8> = text(ctx, "");
    if (count > 0 && kind(ctx, args[0]) != 0) {
        source = usv_text(ctx, args[0], ex);
    }
    protect(ctx, source);
    var capacity: i64 = BUFFER_LIMIT;
    if (mode == ENCODE_INTO) {
        if (count < 2 || typed_type(ctx, args[1], ex) != 3) {
            fail(ctx, ex, 1, "encodeInto destination must be a Uint8Array");
        } else {
            capacity = byte_view_length(ctx, args[1], ex);
        }
    }
    var raw: ptr<u8> = mem_alloc(BUFFER_LIMIT + 1);
    var result: ptr<u8> = undefined(ctx);
    if (raw == null) {
        fail(ctx, ex, 2, "cannot allocate encoded text");
    } else if (deref ex == null) {
        var n: i64 = encode_utf8(ctx, source, raw, BUFFER_LIMIT + 1, false, ex);
        if (deref ex == null && mode == ENCODE) {
            result = new_u8(ctx, n, ex);
            protect(ctx, result);
            write_byte_view(ctx, result, 0, raw, n, ex);
            unprotect(ctx, result);
        } else if (deref ex == null) {
            var used: i64 = 0;
            var read: i64 = 0;
            while (used < n) {
                var width: i64 = 1;
                if (raw[used] >= 240) {
                    width = 4;
                } else if (raw[used] >= 224) {
                    width = 3;
                } else if (raw[used] >= 192) {
                    width = 2;
                }
                if (width > capacity - used) {
                    break;
                }
                used += width;
                read += 1;
                if (width == 4) {
                    read += 1;
                }
            }
            write_byte_view(ctx, args[1], 0, raw, used, ex);
            result = object(ctx, null, null);
            protect(ctx, result);
            define(ctx, result, "read", number(ctx, read as f64), ex, true);
            define(ctx, result, "written", number(ctx, used as f64), ex, true);
            unprotect(ctx, result);
        }
    }
    if (raw != null) {
        mem_free(raw, BUFFER_LIMIT + 1);
    }
    unprotect(ctx, source);
    return result;
}
fun decode(ctx: ptr<u8>, r: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var bytes: ptr<u8> = buffer_from_bytes(ctx, null, 0, ex);
    if (count > 0 && kind(ctx, args[0]) != 0) {
        bytes = source_bytes(ctx, args[0], ex);
        if (bytes == null) {
            fail(ctx, ex, 1, "decode input must be a BufferSource");
        }
    }
    protect(ctx, bytes);
    var streaming: bool = false;
    if (count > 1 && kind(ctx, args[1]) != 0 && kind(ctx, args[1]) != 1) {
        if (kind(ctx, args[1]) != 5) {
            fail(ctx, ex, 1, "decode options must be an object");
        } else {
            streaming = truth(ctx, get(ctx, args[1], "stream", ex));
        }
    }
    var pending: ptr<u8> = get(ctx, r, "pending", ex);
    var prefix: i64 = 0;
    if (kind(ctx, pending) == 5) {
        prefix = byte_view_length(ctx, pending, ex);
    }
    var size: i64 = 0;
    if (deref ex == null) {
        size = byte_view_length(ctx, bytes, ex);
    }
    if (deref ex != null) {
        unprotect(ctx, bytes);
        return undefined(ctx);
    }
    var raw: ptr<u8> = mem_alloc(size + prefix + 1);
    var units: ptr<u16> = mem_alloc((size + prefix + 1) * 2) as ptr<u16>;
    if (raw == null || units == null) {
        if (raw != null) {
            mem_free(raw, size + prefix + 1);
        }
        if (units != null) {
            mem_free(units as ptr<u8>, (size + prefix + 1) * 2);
        }
        fail(ctx, ex, 2, "cannot allocate decoded text");
        unprotect(ctx, bytes);
        return undefined(ctx);
    }
    if (prefix > 0) {
        copy_byte_view(ctx, pending, raw, prefix, ex);
    }
    copy_byte_view(ctx, bytes, raw + prefix, size, ex);
    var total: i64 = size + prefix;
    var at: i64 = 0;
    var used: i64 = 0;
    while (at < total && deref ex == null) {
        var first: u8 = raw[at];
        var width: i64 = 1;
        var cp: u32 = first as u32;
        var valid: bool = true;
        if (first >= 194 && first <= 223) {
            width = 2;
            cp = (first & 31) as u32;
        } else if (first >= 224 && first <= 239) {
            width = 3;
            cp = (first & 15) as u32;
        } else if (first >= 240 && first <= 244) {
            width = 4;
            cp = (first & 7) as u32;
        } else if (first >= 128) {
            valid = false;
        }
        var consumed: i64 = 1;
        while (valid && consumed < width && at + consumed < total) {
            var c: u8 = raw[at + consumed];
            if (c < 128 || c > 191 || (consumed == 1 &&
                ((first == 224 && c < 160) || (first == 237 && c >= 160) ||
                (first == 240 && c < 144) || (first == 244 && c >= 144)))) {
                valid = false;
                break;
            }
            cp = (cp << 6) | (c & 63) as u32;
            consumed += 1;
        }
        if (valid && consumed < width) {
            if (streaming) {
                break;
            }
            valid = false;
        }
        if (!valid) {
            if (flag(ctx, r, "fatal", ex)) {
                fail(ctx, ex, 1, "invalid UTF-8 in TextDecoder");
                break;
            }
            cp = 65533;
        }
        at += consumed;
        var emit: bool = true;
        if (!flag(ctx, r, "bomSeen", ex)) {
            set_flag(ctx, r, "bomSeen", true, ex);
            if (cp == 65279 && !flag(ctx, r, "ignoreBOM", ex)) {
                emit = false;
            }
        }
        if (emit) {
            if (cp >= 65536) {
                cp -= 65536;
                units[used] = (55296 + (cp >> 10)) as u16;
                used += 1;
                units[used] = (56320 + (cp & 1023)) as u16;
                used += 1;
            } else {
                units[used] = cp as u16;
                used += 1;
            }
        }
    }
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        put(ctx, r, "pending", buffer_from_bytes(ctx, raw + at, total - at, ex), ex);
        if (!streaming) {
            set_flag(ctx, r, "bomSeen", false, ex);
        }
        var value: ptr<u8> = utf16(units, used);
        result = string_value(ctx, value);
        release(value);
    } else {
        var ignored: ptr<u8> = null;
        put(ctx, r, "pending", undefined(ctx), &ignored);
        set_flag(ctx, r, "bomSeen", false, &ignored);
    }
    mem_free(raw, size + prefix + 1);
    mem_free(units as ptr<u8>, (size + prefix + 1) * 2);
    unprotect(ctx, bytes);
    return result;
}
export(c) fun jsrt_text_method(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var r: ptr<u8> = record(ctx, owner, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    var mode: i64 = 0;
    while (mode < 6 && !equal(ctx, fn, (deref s.methods)[mode])) {
        mode += 1;
    }
    var decoder: bool = flag(ctx, r, "decoder", ex);
    if (mode != ENCODING && ((decoder && mode < DECODE) || (!decoder && mode >= DECODE))) {
        fail(ctx, ex, 1, "invalid text codec method receiver");
        return undefined(ctx);
    }
    if (mode == ENCODING) {
        return text(ctx, "utf-8");
    }
    if (mode == FATAL) {
        return boolean(ctx, flag(ctx, r, "fatal", ex));
    }
    if (mode == IGNORE_BOM) {
        return boolean(ctx, flag(ctx, r, "ignoreBOM", ex));
    }
    if (mode == DECODE) {
        return decode(ctx, r, count, args, ex);
    }
    return encode(ctx, mode, count, args, ex);
}
pub fun install_text_codec(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var s: ptr<State> = owned_context_slot(ctx, SLOT, size_of<State>() as i64) as ptr<State>;
    deref s.records = weak_map(ctx, ex);
    protect(ctx, deref s.records);
    var names: array<str, 6> = ["encode", "encodeInto", "decode", "encoding", "fatal", "ignoreBOM"];
    for (var i: i64 = 0; i < 6; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref s.methods)[i] = function(ctx, name, callback(false));
        release(name);
        protect(ctx, (deref s.methods)[i]);
    }
    var classes: array<str, 2> = ["TextEncoder", "TextDecoder"];
    for (var i: i64 = 0; i < 2; i++) {
        (deref s.ctors)[i] = public_constructor(ctx, callback(true), classes[i], ex);
        protect(ctx, (deref s.ctors)[i]);
        var parent: ptr<u8> = get(ctx, (deref s.ctors)[i], "prototype", ex);
        define(ctx, parent, "constructor", (deref s.ctors)[i], ex, false);
        getter(ctx, parent, "encoding", (deref s.methods)[ENCODING], ex);
        if (i == 0) {
            define(ctx, parent, "encode", (deref s.methods)[ENCODE], ex, false);
            define(ctx, parent, "encodeInto", (deref s.methods)[ENCODE_INTO], ex, false);
        } else {
            define(ctx, parent, "decode", (deref s.methods)[DECODE], ex, false);
            getter(ctx, parent, "fatal", (deref s.methods)[FATAL], ex);
            getter(ctx, parent, "ignoreBOM", (deref s.methods)[IGNORE_BOM], ex);
        }
        define(ctx, global(ctx), classes[i], (deref s.ctors)[i], ex, false);
    }
    return deref ex == null;
}
pub fun shutdown_text_codec(ctx: ptr<u8>) {
    var s: ptr<State> = state(ctx);
    if (s == null) {
        return;
    }
    if (deref s.records != null) {
        unprotect(ctx, deref s.records);
    }
    for (var i: i64 = 0; i < 2; i++) {
        if ((deref s.ctors)[i] != null) {
            unprotect(ctx, (deref s.ctors)[i]);
        }
    }
    for (var i: i64 = 0; i < 6; i++) {
        if ((deref s.methods)[i] != null) {
            unprotect(ctx, (deref s.methods)[i]);
        }
    }
    release_context_slot(ctx, SLOT, size_of<State>() as i64);
}
