import("./context_state")::{owned_context_slot, active_context};
import("std::mem::layout")::{size_of};
struct PathState {
    exports: ptr<u8>;
    methods: array<ptr<u8>, 10>;
}

fun path_storage(ctx: ptr<u8>) -> ptr<PathState> {
    return owned_context_slot(ctx, 20, size_of<PathState>() as i64) as ptr<PathState>;
}

// POSIX path policy in Wave. No filesystem access except resolve's current directory.
import("std::env::cwd")::{env_getcwd};
import("std::mem::ops")::{mem_copy};
import("std::mem::cstr")::{mem_len_cstr};
import("./system")::{copy_host_path};
import("./values")::{get, text, plain, define, fail};
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "jsrt_path_callback") fun callback() -> ptr<u8>;
const CAP: i64 = 8192;

fun normalized(bytes: ptr<u8>, n: i64, result: ptr<u8>, trailing: bool) -> i64 {
    var absolute: bool = n > 0 && bytes[0] == 47;
    var used: i64 = 0;
    if (absolute) {
        result[0] = 47;
        used = 1;
    }
    var starts: array<i64, 4096>;
    var parents: array<bool, 4096>;
    var depth: i64 = 0;
    var at: i64 = 0;
    while (at < n) {
        while (at < n && bytes[at] == 47) {
            at += 1;
        }
        var begin: i64 = at;
        while (at < n && bytes[at] != 47) {
            at += 1;
        }
        var size: i64 = at - begin;
        if (size == 0 || (size == 1 && bytes[begin] == 46)) {
            continue;
        }
        var parent: bool = size == 2 && bytes[begin] == 46 && bytes[begin + 1] == 46;
        if (parent && depth > 0 && !parents[depth - 1]) {
            depth -= 1;
            used = starts[depth];
            continue;
        }
        if (parent && absolute) {
            continue;
        }
        if (depth >= 4096) {
            return -1;
        }
        starts[depth] = used;
        parents[depth] = parent;
        depth += 1;
        if (used > 0 && result[used - 1] != 47) {
            result[used] = 47;
            used += 1;
        }
        if (used + size >= CAP) {
            return -1;
        }
        mem_copy(result + used, bytes + begin, size);
        used += size;
    }
    if (used == 0) {
        result[used] = 46;
        used += 1;
    }
    if (trailing && n > 0 && bytes[n - 1] == 47 && result[used - 1] != 47) {
        if (used + 1 >= CAP) {
            return -1;
        }
        result[used] = 47;
        used += 1;
    }
    result[used] = 0;
    return used;
}

fun collect(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, joined: ptr<u8>, resolve: bool, ex: ptr<ptr<u8>>) -> i64 {
    var used: i64 = 0;
    var scratch: array<u8, 8192>;
    if (resolve) {
        used = env_getcwd(joined, 8192);
        if (used < 0) {
            fail(ctx, ex, 0, "cannot get current directory");
            return -1;
        }
        used = mem_len_cstr(joined as str);
    }
    for (var i: i64 = 0; i < count && deref ex == null; i++) {
        var n: i64 = copy_host_path(ctx, args[i], &scratch[0], CAP, ex);
        if (n < 0) {
            return -1;
        }
        if (n == 0) {
            continue;
        }
        if (resolve && scratch[0] == 47) {
            used = 0;
        }
        var separator: i64 = 0;
        if (used > 0) {
            separator = 1;
        }
        if (used + n + separator >= CAP) {
            fail(ctx, ex, 2, "path byte limit exceeded");
            return -1;
        }
        if (used > 0) {
            joined[used] = 47;
            used += 1;
        }
        mem_copy(joined + used, &scratch[0], n);
        used += n;
    }
    joined[used] = 0;
    return used;
}

fun slice(ctx: ptr<u8>, bytes: ptr<u8>, begin: i64, end: i64) -> ptr<u8> {
    var save: u8 = bytes[end];
    bytes[end] = 0;
    var result: ptr<u8> = text(ctx, (bytes + begin) as str);
    bytes[end] = save;
    return result;
}

fun base_start(bytes: ptr<u8>, end: i64) -> i64 {
    var begin: i64 = end;
    while (begin > 0 && bytes[begin - 1] != 47) {
        begin -= 1;
    }
    return begin;
}

fun extension(bytes: ptr<u8>, begin: i64, end: i64) -> i64 {
    if (end - begin == 2 && bytes[begin] == 46 && bytes[begin + 1] == 46) {
        return end;
    }
    var dot: i64 = end;
    for (var i: i64 = begin + 1; i < end; i++) {
        if (bytes[i] == 46) {
            dot = i;
        }
    }
    return dot;
}

fun format_path(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, value) != 5) {
        fail(ctx, ex, 1, "path.format requires an object");
        return undefined(ctx);
    }
    var directory: ptr<u8> = get(ctx, value, "dir", ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, directory);
    var root: ptr<u8> = get(ctx, value, "root", ex);
    if (deref ex != null) {
        unprotect(ctx, directory);
        return undefined(ctx);
    }
    protect(ctx, root);
    if (!truth(ctx, directory)) {
        unprotect(ctx, directory);
        directory = root;
        protect(ctx, directory);
    }
    var base: ptr<u8> = get(ctx, value, "base", ex);
    var name: ptr<u8> = undefined(ctx);
    var ext: ptr<u8> = undefined(ctx);
    protect(ctx, base);
    if (deref ex == null && !truth(ctx, base)) {
        name = get(ctx, value, "name", ex);
        protect(ctx, name);
        if (deref ex == null) {
            ext = get(ctx, value, "ext", ex);
        }
        protect(ctx, ext);
    } else {
        protect(ctx, name);
        protect(ctx, ext);
    }
    var output: array<u8, 8192>;
    var scratch: array<u8, 8192>;
    var used: i64 = 0;
    var values: array<ptr<u8>, 3> = [directory, base, undefined(ctx)];
    if (!truth(ctx, base)) {
        values[1] = name;
        values[2] = ext;
    }
    for (var i: i64 = 0; i < 3 && deref ex == null; i++) {
        if (!truth(ctx, values[i])) {
            continue;
        }
        var size: i64 = copy_host_path(ctx, values[i], &scratch[0], CAP, ex);
        if (size < 0) {
            break;
        }
        var prefix: u8 = 0;
        if (i == 2 && size > 0 && scratch[0] != 46) {
            prefix = 46;
        }
        var extra: i64 = 0;
        if (prefix != 0) {
            extra = 1;
        }
        if (used + extra + size >= CAP) {
            fail(ctx, ex, 2, "formatted path byte limit exceeded");
            break;
        }
        if (prefix != 0) {
            output[used] = prefix;
            used += 1;
        }
        mem_copy(&output[used], &scratch[0], size);
        used += size;
        if (i == 0 && !equal(ctx, directory, root)) {
            if (used + 1 >= CAP) {
                fail(ctx, ex, 2, "formatted path byte limit exceeded");
                break;
            }
            output[used] = 47;
            used += 1;
        }
    }
    output[used] = 0;
    unprotect(ctx, ext);
    unprotect(ctx, name);
    unprotect(ctx, base);
    unprotect(ctx, directory);
    unprotect(ctx, root);
    if (deref ex != null) {
        return undefined(ctx);
    }
    return text(ctx, &output[0] as str);
}

export(c) fun jsrt_path_api(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<PathState> = path_storage(ctx);
    if (equal(ctx, fn, (deref host_state.methods)[9])) {
        if (count == 0) {
            fail(ctx, ex, 1, "path.format requires an object");
            return undefined(ctx);
        }
        return format_path(ctx, args[0], ex);
    }
    var bytes: array<u8, 8192>;
    var result: array<u8, 8192>;
    var n: i64 = 0;
    if (equal(ctx, fn, (deref host_state.methods)[1]) || equal(ctx, fn, (deref host_state.methods)[2])) {
        n = collect(ctx, count, args, &bytes[0], equal(ctx, fn, (deref host_state.methods)[2]), ex);
        if (n >= 0) {
            n = normalized(&bytes[0], n, &result[0], equal(ctx, fn, (deref host_state.methods)[1]));
        }
        if (n < 0) {
            fail(ctx, ex, 2, "path byte limit exceeded");
            return undefined(ctx);
        }
        return text(ctx, &result[0] as str);
    }
    if (count == 0) {
        fail(ctx, ex, 1, "path argument required");
        return undefined(ctx);
    }
    n = copy_host_path(ctx, args[0], &bytes[0], CAP, ex);
    if (n < 0) {
        return undefined(ctx);
    }
    if (equal(ctx, fn, (deref host_state.methods)[0])) {
        if (normalized(&bytes[0], n, &result[0], true) < 0) {
            fail(ctx, ex, 2, "path byte limit exceeded");
            return undefined(ctx);
        }
        return text(ctx, &result[0] as str);
    }
    if (equal(ctx, fn, (deref host_state.methods)[6])) {
        return boolean(ctx, n > 0 && bytes[0] == 47);
    }
    if (equal(ctx, fn, (deref host_state.methods)[7])) {
        if (count < 2) {
            fail(ctx, ex, 1, "relative requires two paths");
            return undefined(ctx);
        }
        var left: array<u8, 8192>;
        var right: array<u8, 8192>;
        var a: i64 = collect(ctx, 1, args, &bytes[0], true, ex);
        if (a < 0) {
            return undefined(ctx);
        }
        a = normalized(&bytes[0], a, &left[0], false);
        var b: i64 = collect(ctx, 1, args + 1, &bytes[0], true, ex);
        if (b < 0) {
            return undefined(ctx);
        }
        b = normalized(&bytes[0], b, &right[0], false);
        var common: i64 = 0;
        var at: i64 = 0;
        while (at < a && at < b && left[at] == right[at]) {
            if (left[at] == 47) {
                common = at + 1;
            }
            at += 1;
        }
        if (at == a && at == b) {
            return text(ctx, "");
        }
        if (at == a && right[at] == 47) {
            common = at + 1;
        } else if (at == b && left[at] == 47) {
            common = at + 1;
        }
        var used: i64 = 0;
        var cursor: i64 = common;
        while (cursor < a) {
            while (cursor < a && left[cursor] == 47) {
                cursor += 1;
            }
            if (cursor >= a) {
                break;
            }
            if (used + 3 >= CAP) {
                fail(ctx, ex, 2, "relative path limit exceeded");
                return undefined(ctx);
            }
            if (used > 0) {
                result[used] = 47;
                used += 1;
            }
            result[used] = 46;
            result[used + 1] = 46;
            used += 2;
            while (cursor < a && left[cursor] != 47) {
                cursor += 1;
            }
        }
        if (common < b) {
            if (used > 0) {
                result[used] = 47;
                used += 1;
            }
            if (used + b - common >= CAP) {
                fail(ctx, ex, 2, "relative path limit exceeded");
                return undefined(ctx);
            }
            mem_copy(&result[used], &right[common], b - common);
            used += b - common;
        }
        result[used] = 0;
        return text(ctx, &result[0] as str);
    }
    var end: i64 = n;
    while (end > 0 && bytes[end - 1] == 47) {
        end -= 1;
    }
    var begin: i64 = base_start(&bytes[0], end);
    var dot: i64 = extension(&bytes[0], begin, end);
    if (equal(ctx, fn, (deref host_state.methods)[4])) {
        if (count > 1 && kind(ctx, args[1]) != 0) {
            var suffix: array<u8, 8192>;
            var size: i64 = copy_host_path(ctx, args[1], &suffix[0], CAP, ex);
            if (size < 0) {
                return undefined(ctx);
            }
            // Node's boundary rules: a suffix equal to the whole path yields "", a suffix equal to
            // the whole final name keeps the name, and only a shorter matching tail is removed.
            var whole_path: bool = size == n;
            for (var i: i64 = 0; whole_path && i < size; i++) {
                whole_path = bytes[i] == suffix[i];
            }
            if (whole_path && size > 0) {
                return text(ctx, "");
            }
            if (size > 0 && size < end - begin) {
                var matches: bool = true;
                for (var i: i64 = 0; i < size; i++) {
                    if (bytes[end - size + i] != suffix[i]) {
                        matches = false;
                    }
                }
                if (matches) {
                    end -= size;
                }
            }
        }
        return slice(ctx, &bytes[0], begin, end);
    }
    if (equal(ctx, fn, (deref host_state.methods)[5])) {
        return slice(ctx, &bytes[0], dot, end);
    }
    var dir_end: i64 = 0;
    if (begin > 0) {
        dir_end = begin - 1;
    }
    if (n > 0 && bytes[0] == 47 && dir_end == 0) {
        dir_end = 1;
    }
    if (equal(ctx, fn, (deref host_state.methods)[3]) && n > 0 && bytes[0] == 47 && begin == 2) {
        dir_end = 2;
    }
    if (equal(ctx, fn, (deref host_state.methods)[3])) {
        if (dir_end == 0) {
            if (n > 0 && bytes[0] == 47) {
                return text(ctx, "/");
            }
            return text(ctx, ".");
        }
        return slice(ctx, &bytes[0], 0, dir_end);
    }
    var parsed: ptr<u8> = plain(ctx);
    protect(ctx, parsed);
    var root: str = "";
    if (n > 0 && bytes[0] == 47) {
        root = "/";
    }
    define(ctx, parsed, "root", text(ctx, root), ex, true);
    define(ctx, parsed, "dir", slice(ctx, &bytes[0], 0, dir_end), ex, true);
    define(ctx, parsed, "base", slice(ctx, &bytes[0], begin, end), ex, true);
    define(ctx, parsed, "ext", slice(ctx, &bytes[0], dot, end), ex, true);
    define(ctx, parsed, "name", slice(ctx, &bytes[0], begin, dot), ex, true);
    unprotect(ctx, parsed);
    return parsed;
}

pub fun install_path(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<PathState> = path_storage(ctx);
    (deref host_state.exports) = plain(ctx);
    protect(ctx, (deref host_state.exports));
    var names: array<str, 10> = ["normalize", "join", "resolve", "dirname", "basename", "extname", "isAbsolute",
        "relative", "parse", "format"];
    for (var i: i64 = 0; i < 10; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref host_state.methods)[i] = function(ctx, name, callback());
        release(name);
        protect(ctx, (deref host_state.methods)[i]);
        define(ctx, (deref host_state.exports), names[i], (deref host_state.methods)[i], ex, false);
    }
    define(ctx, (deref host_state.exports), "sep", text(ctx, "/"), ex, true);
    define(ctx, (deref host_state.exports), "delimiter", text(ctx, ":"), ex, true);
    define(ctx, (deref host_state.exports), "posix", (deref host_state.exports), ex, false);
    return deref ex == null;
}

pub fun path_module() -> ptr<u8> {
    var host_state: ptr<PathState> = path_storage(active_context());
    return(deref host_state.exports);
}

pub fun shutdown_path(ctx: ptr<u8>) {
    var host_state: ptr<PathState> = path_storage(ctx);
    if ((deref host_state.exports) != null) {
        unprotect(ctx, (deref host_state.exports));
        (deref host_state.exports) = null;
    }
    for (var i: i64 = 0; i < 10; i++) {
        if ((deref host_state.methods)[i] != null) {
            unprotect(ctx, (deref host_state.methods)[i]);
            (deref host_state.methods)[i] = null;
        }
    }
}
