import("./context_state")::{owned_context_slot, active_context};
import("std::mem::layout")::{size_of};
struct CryptoState {
    exports: ptr<u8>;
    states: ptr<u8>;
    methods: array<ptr<u8>, 8>;
}

fun crypto_storage(ctx: ptr<u8>) -> ptr<CryptoState> {
    return owned_context_slot(ctx, 11, size_of<CryptoState>() as i64) as ptr<CryptoState>;
}

// Wave owns validation and JS state; OpenSSL owns digest primitives.
// Incremental native state is owned by private engine ArrayBuffers.
import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::mem::cstr")::{mem_eq_cstr, mem_len_cstr};
import("std::random::fill")::{RandomFillResult, random_fill};
import("./config")::{BUFFER_LIMIT};
import("./values")::{get, put, plain, text, define, fail, fail_coded};
import("./buffer")::{buffer_integer, copy_buffer_input};
import("./buffer_core")::{byte_view_length, copy_byte_view, buffer_from_bytes};
import("./byte_codec")::{encode_utf8, encoding};
import("./collections")::{weak_map, weak_get, weak_set, flag, set_flag};
import("./crypto_state")::{create_hash_state, update_hash_state, finish_hash_state};
extern(c, "CRYPTO_memcmp") fun secure_compare(a: ptr<u8>, b: ptr<u8>, size: u64) -> i32;
extern(c, "OPENSSL_cleanse") fun cleanse(bytes: ptr<u8>, size: u64);
extern(c, "OpenSSL_version") fun openssl_version(selector: i32) -> str;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "jsrt_crypto_callback") fun callback() -> ptr<u8>;
extern(c, "jsrt_crypto_hashes_callback") fun hashes_callback() -> ptr<u8>;
extern(c, "wr_array") fun wr_array(ctx: ptr<u8>, count: i64, values: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;

fun arg(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, index: i64) -> ptr<u8> {
    if (index < count) {
        return args[index];
    }
    return undefined(ctx);
}

// Algorithm codes shared with crypto_state: 0 sha256, 1 sha384, 2 sha512, 3 sha1, 4 md5. Names are
// case-insensitive and a dash after "sha" is accepted ("SHA-256"), as Node/OpenSSL do.
fun algorithm(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64 {
    var raw: array<u8, 32>;
    var name: array<u8, 32>;
    var n: i64 = encode_utf8(ctx, value, &raw[0], 31, false, ex);
    if (n < 0) {
        return -1;
    }
    var used: i64 = 0;
    for (var i: i64 = 0; i < n; i++) {
        var c: u8 = raw[i];
        if (c >= 65 && c <= 90) {
            c += 32;
        }
        if (c == 45 && used == 3) {
            continue;
        }
        name[used] = c;
        used += 1;
    }
    name[used] = 0;
    // A NUL inside the name must not truncate it ("sha256\0suffix" is not sha256): the decoded length
    // has to equal the C-string length.
    var text: str = &name[0] as str;
    if (mem_len_cstr(text) != used) {
        fail(ctx, ex, 1, "supported hash algorithms: sha1, sha256, sha384, sha512, md5");
        return -1;
    }
    if (mem_eq_cstr(text, "sha256")) {
        return 0;
    }
    if (mem_eq_cstr(text, "sha384")) {
        return 1;
    }
    if (mem_eq_cstr(text, "sha512")) {
        return 2;
    }
    if (mem_eq_cstr(text, "sha1")) {
        return 3;
    }
    if (mem_eq_cstr(text, "md5")) {
        return 4;
    }
    fail(ctx, ex, 1, "supported hash algorithms: sha1, sha256, sha384, sha512, md5");
    return -1;
}

fun output_encoding(ctx: ptr<u8>, value: ptr<u8>, fallback: i32, allow_buffer: bool, ex: ptr<ptr<u8>>) -> i32 {
    if (kind(ctx, value) == 0) {
        return fallback;
    }
    if (allow_buffer && kind(ctx, value) == 4) {
        var name: array<u8, 32>;
        var n: i64 = encode_utf8(ctx, value, &name[0], 32, false, ex);
        if (n < 0) {
            return -2;
        }
        if (n == 6 && mem_eq_cstr(&name[0] as str, "buffer")) {
            return -1;
        }
    }
    var code: i32 = encoding(ctx, value, ex, false);
    if (deref ex != null) {
        return -2;
    }
    return code;
}

fun snapshot(ctx: ptr<u8>, value: ptr<u8>, enc: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, value) != 4) {
        if (byte_view_length(ctx, value, ex) < 0) {
            return undefined(ctx);
        }
    }
    return copy_buffer_input(ctx, value, enc, ex);
}

export(c) fun jsrt_crypto_api(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<CryptoState> = crypto_storage(ctx);
    if (equal(ctx, fn, (deref host_state.methods)[0])) {
        if (count != 1) {
            fail(ctx, ex, 1, "randomBytes supports exactly one size argument");
            return undefined(ctx);
        }
        var size: i64 = buffer_integer(ctx, args[0], 0, BUFFER_LIMIT, ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        var capacity: i64 = size;
        if (capacity == 0) {
            capacity = 1;
        }
        var bytes: ptr<u8> = mem_alloc(capacity);
        if (bytes == null) {
            fail(ctx, ex, 2, "cannot allocate random bytes");
            return undefined(ctx);
        }
        var entropy: RandomFillResult = random_fill(bytes, size);
        var result: ptr<u8> = undefined(ctx);
        if (!entropy.ok) {
            fail(ctx, ex, 0, "OS entropy unavailable");
        } else {
            result = buffer_from_bytes(ctx, bytes, size, ex);
        }
        cleanse(bytes, capacity as u64);
        mem_free(bytes, capacity);
        return result;
    }
    if (equal(ctx, fn, (deref host_state.methods)[1])) {
        if (count != 0) {
            fail(ctx, ex, 1, "randomUUID options are not supported");
            return undefined(ctx);
        }
        var bytes: array<u8, 16>;
        var entropy: RandomFillResult = random_fill(&bytes[0], 16);
        if (!entropy.ok) {
            fail(ctx, ex, 0, "OS entropy unavailable");
            return undefined(ctx);
        }
        bytes[6] = (bytes[6] & 15) | 64;
        bytes[8] = (bytes[8] & 63) | 128;
        var digits: str = "0123456789abcdef";
        var result: array<u8, 37>;
        var used: i64 = 0;
        for (var i: i64 = 0; i < 16; i++) {
            if (i == 4 || i == 6 || i == 8 || i == 10) {
                result[used] = 45;
                used += 1;
            }
            result[used] = digits[bytes[i] >> 4];
            result[used + 1] = digits[bytes[i] & 15];
            used += 2;
        }
        result[36] = 0;
        return text(ctx, &result[0] as str);
    }
    if (equal(ctx, fn, (deref host_state.methods)[2])) {
        if (count != 2) {
            fail(ctx, ex, 1, "timingSafeEqual requires two byte views");
            return undefined(ctx);
        }
        var na: i64 = byte_view_length(ctx, args[0], ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        var nb: i64 = byte_view_length(ctx, args[1], ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        if (na != nb) {
            fail_coded(ctx, ex, 2, "ERR_CRYPTO_TIMING_SAFE_EQUAL_LENGTH", "timingSafeEqual requires equal byte lengths");
            return undefined(ctx);
        }
        if (na == 0) {
            return boolean(ctx, true);
        }
        var bytes: ptr<u8> = mem_alloc(na * 2);
        if (bytes == null) {
            fail(ctx, ex, 2, "cannot allocate comparison bytes");
            return undefined(ctx);
        }
        var a: i64 = copy_byte_view(ctx, args[0], bytes, na, ex);
        var b: i64 = -1;
        if (deref ex == null) {
            b = copy_byte_view(ctx, args[1], bytes + na, na, ex);
        }
        var same: bool = false;
        if (a == na && b == na && deref ex == null) {
            same = secure_compare(bytes, bytes + na, na as u64) == 0;
        }
        cleanse(bytes, (na * 2) as u64);
        mem_free(bytes, na * 2);
        return boolean(ctx, same);
    }
    if (equal(ctx, fn, (deref host_state.methods)[3]) || equal(ctx, fn, (deref host_state.methods)[4]) || equal(ctx,
        fn, (deref host_state.methods)[7])) {
        var alg: i64 = algorithm(ctx, arg(ctx, count, args, 0), ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        if (equal(ctx, fn, (deref host_state.methods)[4]) || equal(ctx, fn, (deref host_state.methods)[7])) {
            var keyed: bool = equal(ctx, fn, (deref host_state.methods)[7]);
            var required: i64 = 1;
            if (keyed) {
                required = 2;
            }
            if (count != required) {
                fail(ctx, ex, 1, "createHash/createHmac require algorithm and optional HMAC key; options are not supported");
                return undefined(ctx);
            }
            var key: ptr<u8> = undefined(ctx);
            if (keyed) {
                key = snapshot(ctx, args[1], undefined(ctx), ex);
            }
            protect(ctx, key);
            var native_state: ptr<u8> = undefined(ctx);
            if (deref ex == null) {
                native_state = create_hash_state(ctx, alg, keyed, key, ex);
            }
            protect(ctx, native_state);
            unprotect(ctx, key);
            if (deref ex != null) {
                unprotect(ctx, native_state);
                return undefined(ctx);
            }
            var owner: ptr<u8> = plain(ctx);
            protect(ctx, owner);
            var record: ptr<u8> = plain(ctx);
            protect(ctx, record);
            put(ctx, record, "native", native_state, ex);
            define(ctx, owner, "update", (deref host_state.methods)[5], ex, false);
            define(ctx, owner, "digest", (deref host_state.methods)[6], ex, false);
            weak_set(ctx, (deref host_state.states), owner, record, ex);
            unprotect(ctx, record);
            unprotect(ctx, owner);
            unprotect(ctx, native_state);
            return owner;
        }
        if (count < 2 || count > 3) {
            fail(ctx, ex, 1, "hash requires algorithm, data and optional encoding");
            return undefined(ctx);
        }
        var code: i32 = output_encoding(ctx, arg(ctx, count, args, 2), 1, true, ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        var value: ptr<u8> = snapshot(ctx, args[1], undefined(ctx), ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        protect(ctx, value);
        var native_state: ptr<u8> = create_hash_state(ctx, alg, false, undefined(ctx), ex);
        protect(ctx, native_state);
        if (deref ex == null) {
            update_hash_state(ctx, native_state, value, ex);
        }
        unprotect(ctx, value);
        var result: ptr<u8> = undefined(ctx);
        if (deref ex == null) {
            result = finish_hash_state(ctx, native_state, code, ex);
        }
        unprotect(ctx, native_state);
        return result;
    }
    if (kind(ctx, receiver) != 5) {
        fail(ctx, ex, 1, "invalid Hash receiver");
        return undefined(ctx);
    }
    var record: ptr<u8> = weak_get(ctx, (deref host_state.states), receiver, ex);
    if (kind(ctx, record) != 5 || deref ex != null) {
        fail(ctx, ex, 1, "invalid Hash receiver");
        return undefined(ctx);
    }
    if (flag(ctx, record, "done", ex)) {
        fail_coded(ctx, ex, 0, "ERR_CRYPTO_HASH_FINALIZED", "Hash already finalized");
        return undefined(ctx);
    }
    if (equal(ctx, fn, (deref host_state.methods)[5])) {
        if (count < 1 || count > 2) {
            fail(ctx, ex, 1, "update requires data and optional input encoding");
            return undefined(ctx);
        }
        var value: ptr<u8> = snapshot(ctx, args[0], arg(ctx, count, args, 1), ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        protect(ctx, value);
        update_hash_state(ctx, get(ctx, record, "native", ex), value, ex);
        unprotect(ctx, value);
        return receiver;
    }
    if (count > 1) {
        fail(ctx, ex, 1, "digest accepts one optional encoding");
        return undefined(ctx);
    }
    var code: i32 = output_encoding(ctx, arg(ctx, count, args, 0), -1, false, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    set_flag(ctx, record, "done", true, ex);
    return finish_hash_state(ctx, get(ctx, record, "native", ex), code, ex);
}

pub fun install_crypto(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<CryptoState> = crypto_storage(ctx);
    (deref host_state.states) = weak_map(ctx, ex);
    if (deref ex != null) {
        (deref host_state.states) = null;
        return false;
    }
    protect(ctx, (deref host_state.states));
    (deref host_state.exports) = plain(ctx);
    protect(ctx, (deref host_state.exports));
    var names: array<str, 8> = ["randomBytes", "randomUUID", "timingSafeEqual", "hash", "createHash",
        "update", "digest", "createHmac"];
    for (var i: i64 = 0; i < 8; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref host_state.methods)[i] = function(ctx, name, callback());
        release(name);
        protect(ctx, (deref host_state.methods)[i]);
        if (i < 5 || i == 7) {
            define(ctx, (deref host_state.exports), names[i], (deref host_state.methods)[i], ex, false);
        }
    }
    define(ctx, (deref host_state.exports), "opensslVersion", text(ctx, openssl_version(0)), ex, false);
    var hashes_name: ptr<u8> = utf8("getHashes");
    define(ctx, (deref host_state.exports), "getHashes", function(ctx, hashes_name, hashes_callback()), ex, false);
    release(hashes_name);
    return deref ex == null;
}


// crypto.getHashes(): the algorithms createHash/createHmac accept here, as a fresh array each call.
// Node lists every algorithm name OpenSSL knows; only the supported ones are reported.
export(c) fun jsrt_crypto_hashes(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var names: array<str, 5> = ["md5", "sha1", "sha256", "sha384", "sha512"];
    var items: array<ptr<u8>, 5>;
    for (var i: i64 = 0; i < 5; i++) {
        items[i] = text(ctx, names[i]);
        protect(ctx, items[i]);
    }
    var result: ptr<u8> = wr_array(ctx, 5, &items[0], ex);
    for (var i: i64 = 0; i < 5; i++) {
        unprotect(ctx, items[i]);
    }
    if (deref ex != null || result == null) {
        return undefined(ctx);
    }
    return result;
}
pub fun crypto_module() -> ptr<u8> {
    var host_state: ptr<CryptoState> = crypto_storage(active_context());
    return(deref host_state.exports);
}

pub fun shutdown_crypto(ctx: ptr<u8>) {
    var host_state: ptr<CryptoState> = crypto_storage(ctx);
    if ((deref host_state.states) != null) {
        unprotect(ctx, (deref host_state.states));
        (deref host_state.states) = null;
    }
    if ((deref host_state.exports) != null) {
        unprotect(ctx, (deref host_state.exports));
        (deref host_state.exports) = null;
    }
    for (var i: i64 = 0; i < 8; i++) {
        if ((deref host_state.methods)[i] != null) {
            unprotect(ctx, (deref host_state.methods)[i]);
            (deref host_state.methods)[i] = null;
        }
    }
}
