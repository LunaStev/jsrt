import("./context_state")::{BUFFER_SLOT, context_slot, allocate_context_slot, release_context_slot};
pub fun buffer_root(ctx: ptr<u8>, index: i64) -> ptr<ptr<u8>> {
    return(context_slot(ctx, BUFFER_SLOT) as ptr<ptr<u8>>) + index;
}

// Engine-owned Uint8Array storage. Raw pointers are used only until the next JSC call.
import("std::mem::ops")::{mem_copy};
import("./config")::{BUFFER_LIMIT};
import("./values")::{get, capture, fail};
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_construct") fun construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_to_boolean") fun to_boolean(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_set_prototype") fun set_prototype(ctx: ptr<u8>, value: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_typed_type") fun typed_type(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i32;
extern(c, "wr_typed_length") fun typed_length(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64;
extern(c, "wr_typed_offset") fun typed_offset(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64;
extern(c, "wr_typed_bytes") fun typed_bytes(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_typed_buffer") fun typed_buffer(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_u8_new") fun new_u8(ctx: ptr<u8>, length: i64, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_u8_view") fun view_u8(ctx: ptr<u8>, buffer: ptr<u8>, offset: i64, length: i64, ex: ptr<ptr<u8>>) -> ptr<u8>;

pub fun initialize_buffer_brand(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (!allocate_context_slot(ctx, BUFFER_SLOT, 48)) {
        return false;
    }
    var ctor: ptr<u8> = get(ctx, global(ctx), "WeakSet", ex);
    var parent: ptr<u8> = get(ctx, ctor, "prototype", ex);
    deref buffer_root(ctx, 4) = capture(ctx, parent, "add", ex);
    deref buffer_root(ctx, 5) = capture(ctx, parent, "has", ex);
    deref buffer_root(ctx, 3) = construct(ctx, ctor, 0, null, ex);
    if (deref buffer_root(ctx, 3) != null && deref ex == null) {
        protect(ctx, deref buffer_root(ctx, 3));
        return true;
    }
    deref buffer_root(ctx, 3) = null;
    return false;
}

pub fun is_buffer(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (kind(ctx, value) != 5) {
        return false;
    }
    var args: array<ptr<u8>, 1> = [value];
    var result: ptr<u8> = call(ctx, deref buffer_root(ctx, 5), deref buffer_root(ctx, 3), 1, &args[0],
        ex);
    return deref ex == null && to_boolean(ctx, result);
}

pub fun is_byte_view(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    return typed_type(ctx, value, ex) == 3;
}

pub fun byte_view_length(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64 {
    if (!is_byte_view(ctx, value, ex)) {
        fail(ctx, ex, 1, "expected Buffer or Uint8Array");
        return -1;
    }
    var size: i64 = typed_length(ctx, value, ex);
    if (size > BUFFER_LIMIT) {
        fail(ctx, ex, 2, "byte view exceeds buffer limit");
        return -1;
    }
    return size;
}

pub fun copy_byte_view(ctx: ptr<u8>, value: ptr<u8>, dest: ptr<u8>, capacity: i64, ex: ptr<ptr<u8>>) -> i64 {
    var size: i64 = byte_view_length(ctx, value, ex);
    if (size < 0) {
        return -1;
    }
    if (size > capacity) {
        fail(ctx, ex, 2, "byte view exceeds destination limit");
        return -1;
    }
    var offset: i64 = typed_offset(ctx, value, ex);
    if (deref ex != null) {
        return -1;
    }
    var bytes: ptr<u8> = typed_bytes(ctx, value, ex);
    if (deref ex != null || (bytes == null && size > 0)) {
        fail(ctx, ex, 1, "unavailable byte view storage");
        return -1;
    }
    if (size > 0) {
        mem_copy(dest, bytes + offset, size);
    }
    return size;
}

pub fun write_byte_view(ctx: ptr<u8>, value: ptr<u8>, start: i64, bytes: ptr<u8>, length: i64, ex: ptr<ptr<u8>>) -> bool {
    var size: i64 = byte_view_length(ctx, value, ex);
    if (size < 0 || start < 0 || length < 0 || start > size || length > size - start) {
        fail(ctx, ex, 2, "byte write exceeds view");
        return false;
    }
    var offset: i64 = typed_offset(ctx, value, ex);
    if (deref ex != null) {
        return false;
    }
    var dest: ptr<u8> = typed_bytes(ctx, value, ex);
    if (deref ex != null || (dest == null && length > 0)) {
        fail(ctx, ex, 1, "unavailable byte view storage");
        return false;
    }
    if (length > 0) {
        mem_copy(dest + offset + start, bytes, length);
    }
    return true;
}

fun mark_buffer(ctx: ptr<u8>, result: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (result == null || deref ex != null) {
        return null;
    }
    protect(ctx, result);
    set_prototype(ctx, result, deref buffer_root(ctx, 0));
    var args: array<ptr<u8>, 1> = [result];
    call(ctx, deref buffer_root(ctx, 4), deref buffer_root(ctx, 3), 1, &args[0], ex);
    unprotect(ctx, result);
    return result;
}

pub fun allocate_buffer(ctx: ptr<u8>, length: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (length < 0 || length > BUFFER_LIMIT) {
        fail(ctx, ex, 2, "buffer size exceeds limit");
        return null;
    }
    return mark_buffer(ctx, new_u8(ctx, length, ex), ex);
}

pub fun buffer_from_bytes(ctx: ptr<u8>, bytes: ptr<u8>, length: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = allocate_buffer(ctx, length, ex);
    if (result == null || deref ex != null) {
        return null;
    }
    protect(ctx, result);
    write_byte_view(ctx, result, 0, bytes, length, ex);
    unprotect(ctx, result);
    return result;
}

pub fun buffer_view(ctx: ptr<u8>, backing: ptr<u8>, offset: i64, length: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (length < 0 || length > BUFFER_LIMIT) {
        fail(ctx, ex, 2, "buffer view exceeds limit");
        return null;
    }
    return mark_buffer(ctx, view_u8(ctx, backing, offset, length, ex), ex);
}

pub fun buffer_subview(ctx: ptr<u8>, source: ptr<u8>, start: i64, length: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var backing: ptr<u8> = typed_buffer(ctx, source, ex);
    if (backing == null || deref ex != null) {
        return null;
    }
    protect(ctx, backing);
    var offset: i64 = typed_offset(ctx, source, ex);
    var result: ptr<u8> = buffer_view(ctx, backing, offset + start, length, ex);
    unprotect(ctx, backing);
    return result;
}

pub fun shutdown_buffer_core(ctx: ptr<u8>) {
    if (context_slot(ctx, BUFFER_SLOT) == null) {
        return;
    }
    if (deref buffer_root(ctx, 3) != null) {
        unprotect(ctx, deref buffer_root(ctx, 3));
        deref buffer_root(ctx, 3) = null;
    }
    if (deref buffer_root(ctx, 4) != null) {
        unprotect(ctx, deref buffer_root(ctx, 4));
        deref buffer_root(ctx, 4) = null;
    }
    if (deref buffer_root(ctx, 5) != null) {
        unprotect(ctx, deref buffer_root(ctx, 5));
        deref buffer_root(ctx, 5) = null;
    }
    if (deref buffer_root(ctx, 2) != null) {
        unprotect(ctx, deref buffer_root(ctx, 2));
        deref buffer_root(ctx, 2) = null;
    }
    if (deref buffer_root(ctx, 0) != null) {
        unprotect(ctx, deref buffer_root(ctx, 0));
        deref buffer_root(ctx, 0) = null;
    }
    if (deref buffer_root(ctx, 1) != null) {
        unprotect(ctx, deref buffer_root(ctx, 1));
        deref buffer_root(ctx, 1) = null;
    }
    release_context_slot(ctx, BUFFER_SLOT, 48);
}
