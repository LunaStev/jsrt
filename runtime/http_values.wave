import("./context_state")::{owned_context_slot, active_context};
import("std::mem::layout")::{size_of};
struct HttpValuesState {
    define_fn: ptr<u8>;
    keys_fn: ptr<u8>;
}

fun http_values_storage(ctx: ptr<u8>) -> ptr<HttpValuesState> {
    return owned_context_slot(ctx, 16, size_of<HttpValuesState>() as i64) as ptr<HttpValuesState>;
}

// JS value helpers for HTTP; capture definition intrinsics before user code.
import("std::mem::alloc")::{mem_alloc, mem_free};
import("./system")::{system_fail};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, object: ptr<u8>, value: ptr<u8>);
extern(c, "wr_null") fun js_null(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(text: str) -> ptr<u8>;
extern(c, "wr_string_utf16") fun utf16(text: ptr<u16>, length: i64) -> ptr<u8>;
extern(c, "wr_string_value") fun string_value(ctx: ptr<u8>, text: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_release") fun release(text: ptr<u8>);
extern(c, "wr_get") fun property(ctx: ptr<u8>, object: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_set") fun assign(ctx: ptr<u8>, object: ptr<u8>, key: ptr<u8>, value: ptr<u8>, flags: u32,
    ex: ptr<ptr<u8>>);
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_call") fun call(ctx: ptr<u8>, function: ptr<u8>, receiver: ptr<u8>, argc: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_to_boolean") fun to_boolean(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "jsrt_http_callback") fun callback(kind: i32) -> ptr<u8>;

pub fun http_object(ctx: ptr<u8>) -> ptr<u8> {
    var result: ptr<u8> = object(ctx, null, null);
    prototype(ctx, result, js_null(ctx));
    return result;
}

pub fun http_text(ctx: ptr<u8>, text: str) -> ptr<u8> {
    var key: ptr<u8> = utf8(text);
    var result: ptr<u8> = string_value(ctx, key);
    release(key);
    return result;
}

pub fun http_latin1(ctx: ptr<u8>, bytes: ptr<u8>, length: i64) -> ptr<u8> {
    var units: ptr<u16> = mem_alloc((length + 1) * 2) as ptr<u16>;
    if (units == null) {
        return null;
    }
    for (var i: i64 = 0; i < length; i++) {
        units[i] = bytes[i] as u16;
    }
    var key: ptr<u8> = utf16(units, length);
    mem_free(units as ptr<u8>, (length + 1) * 2);
    var result: ptr<u8> = string_value(ctx, key);
    release(key);
    return result;
}

pub fun http_get(ctx: ptr<u8>, object: ptr<u8>, name: str, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var key: ptr<u8> = utf8(name);
    var result: ptr<u8> = property(ctx, object, key, ex);
    release(key);
    return result;
}

pub fun http_put(ctx: ptr<u8>, object: ptr<u8>, name: str, value: ptr<u8>, ex: ptr<ptr<u8>>) {
    protect(ctx, value);
    var key: ptr<u8> = utf8(name);
    assign(ctx, object, key, value, 0, ex);
    release(key);
    unprotect(ctx, value);
}

pub fun http_define(ctx: ptr<u8>, object: ptr<u8>, name: str, value: ptr<u8>, ex: ptr<ptr<u8>>) {
    var host_state: ptr<HttpValuesState> = http_values_storage(ctx);
    if (deref ex != null) {
        return;
    }
    protect(ctx, value);
    var descriptor: ptr<u8> = http_object(ctx);
    protect(ctx, descriptor);
    http_put(ctx, descriptor, "value", value, ex);
    http_put(ctx, descriptor, "writable", boolean(ctx, true), ex);
    http_put(ctx, descriptor, "enumerable", boolean(ctx, true), ex);
    http_put(ctx, descriptor, "configurable", boolean(ctx, true), ex);
    var args: array<ptr<u8>, 3> = [object, http_text(ctx, name), descriptor];
    protect(ctx, args[1]);
    var result: ptr<u8> = call(ctx, (deref host_state.define_fn), null, 3, &args[0], ex);
    if (deref ex == null && !to_boolean(ctx, result)) {
        system_fail(ctx, ex, false, "cannot define HTTP property");
    }
    unprotect(ctx, args[1]);
    unprotect(ctx, descriptor);
    unprotect(ctx, value);
}

pub fun http_native(ctx: ptr<u8>, name: str, kind: i32) -> ptr<u8> {
    var key: ptr<u8> = utf8(name);
    var result: ptr<u8> = function(ctx, key, callback(kind));
    release(key);
    return result;
}

pub fun initialize_http_values(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<HttpValuesState> = http_values_storage(ctx);
    var reflect: ptr<u8> = http_get(ctx, global(ctx), "Reflect", ex);
    deref host_state.keys_fn = http_get(ctx, http_get(ctx, global(ctx), "Object", ex), "keys", ex);
    protect(ctx, deref host_state.keys_fn);
    (deref host_state.define_fn) = http_get(ctx, reflect, "defineProperty", ex);
    if (deref ex != null || (deref host_state.define_fn) == null) {
        (deref host_state.define_fn) = null;
        return false;
    }
    protect(ctx, (deref host_state.define_fn));
    return true;
}

pub fun shutdown_http_values(ctx: ptr<u8>) {
    var host_state: ptr<HttpValuesState> = http_values_storage(ctx);
    if (deref host_state.keys_fn != null) {
        unprotect(ctx, deref host_state.keys_fn);
        deref host_state.keys_fn = null;
    }
    if ((deref host_state.define_fn) != null) {
        unprotect(ctx, (deref host_state.define_fn));
        (deref host_state.define_fn) = null;
    }
}

pub fun http_keys(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<HttpValuesState> = http_values_storage(ctx);
    var args: array<ptr<u8>, 1> = [value];
    return call(ctx, deref s.keys_fn, null, 1, &args[0], ex);
}
