// Buffered Web bodies own snapshots in JSC WeakMaps. Network bodies stay streams.
import("./context_state")::{owned_context_slot, release_context_slot};
import("./values")::{get, put, plain, text, define, define_key, getter, capture, fail, coerce_number};
import("./collections")::{weak_map, weak_get, weak_set, length, at, integer, set_integer, flag, set_flag};
import("./buffer")::{copy_buffer_input, buffer_integer};
import("./buffer_core")::{buffer_from_bytes, byte_view_length, copy_byte_view};
import("./byte_codec")::{decode_bytes};
import("./headers")::{create_headers, default_header};
import("./streams")::{create_stream, stream_invoke};
import("./body_collect")::{attach_body, body_consumed, mark_body_consumed, body_failure, fail_buffered_body};
import("./abort")::{signal_aborted, dependent_signal};
import("./web_support")::{source_bytes, iterable_list, readonly, public_constructor};
import("./system")::{copy_host_path};
import("./url")::{url_input};
import("./url_core")::{usv, parse_url, url_part};
import("./form_data")::{install_form_data, shutdown_form_data, form_data_type, form_data_body};
import("./config")::{BUFFER_LIMIT, BUFFER_PART_LIMIT, BLOB_TYPE_LIMIT};
import("std::mem::layout")::{size_of};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::mem::cstr")::{mem_eq_cstr};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_null") fun js_null(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_number") fun number(ctx: ptr<u8>, n: f64) -> ptr<u8>;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, owner: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_to_string") fun stringify(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_string_value") fun string_value(ctx: ptr<u8>, value: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_length") fun string_length(value: ptr<u8>) -> i64;
extern(c, "wr_string_characters") fun characters(value: ptr<u8>) -> ptr<u16>;
extern(c, "wr_typed_buffer") fun backing(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_promise") fun promise(ctx: ptr<u8>, resolve: ptr<ptr<u8>>, reject: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_construct") fun construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_web_callback") fun callback(code: i32) -> ptr<u8>;
extern(c, "jsrt_web_constructor") fun constructor_callback() -> ptr<u8>;
const SLOT: i64 = 39;
const BLOB: i64 = 0;
const RESPONSE: i64 = 1;
const REQUEST: i64 = 2;
const METHOD_COUNT: i64 = 9;
struct State {
    records: ptr<u8>;
    ctors: array<ptr<u8>, 3>;
    parents: array<ptr<u8>, 3>;
    methods: array<ptr<u8>, 9>;
    stringify: ptr<u8>;
}
fun state(ctx: ptr<u8>) -> ptr<State> {
    return owned_context_slot(ctx, SLOT, size_of<State>() as i64) as ptr<State>;
}
fun record(ctx: ptr<u8>, owner: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, owner) != 5) {
        return undefined(ctx);
    }
    var s: ptr<State> = state(ctx);
    return weak_get(ctx, deref s.records, owner, ex);
}
fun string_copy(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null) {
        return undefined(ctx);
    }
    var source: ptr<u8> = stringify(ctx, value, ex);
    if (source == null || deref ex != null) {
        return undefined(ctx);
    }
    var result: ptr<u8> = string_value(ctx, source);
    release(source);
    return result;
}
// Blob content type is printable ASCII, lowercased without calling user code.
fun content_type(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, value) == 0) {
        return text(ctx, "");
    }
    var source: ptr<u8> = stringify(ctx, value, ex);
    if (source == null || deref ex != null) {
        return undefined(ctx);
    }
    var n: i64 = string_length(source);
    if (n > BLOB_TYPE_LIMIT) {
        release(source);
        fail(ctx, ex, 2, "Blob type exceeds text limit");
        return undefined(ctx);
    }
    var units: ptr<u16> = characters(source);
    var bytes: array<u8, 8192>;
    var valid: bool = true;
    for (var i: i64 = 0; i < n; i++) {
        var c: u16 = units[i];
        if (c < 32 || c > 126) {
            valid = false;
        }
        if (c >= 65 && c <= 90) {
            c += 32;
        }
        bytes[i] = c as u8;
    }
    bytes[n] = 0;
    release(source);
    if (!valid) {
        return text(ctx, "");
    }
    return text(ctx, &bytes[0] as str);
}

pub fun web_body_bytes(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null) {
        return undefined(ctx);
    }
    var multipart: ptr<u8> = form_data_body(ctx, value, ex);
    if (multipart != null || deref ex != null) {
        return multipart;
    }
    var r: ptr<u8> = record(ctx, value, ex);
    if (kind(ctx, r) == 5 && integer(ctx, r, "kind", ex) == BLOB) {
        value = get(ctx, r, "bytes", ex);
    }
    if (kind(ctx, value) == 0 || kind(ctx, value) == 1) {
        return buffer_from_bytes(ctx, null, 0, ex);
    }
    var snapshot: ptr<u8> = source_bytes(ctx, value, ex);
    if (snapshot != null || deref ex != null) {
        return snapshot;
    }
    return copy_buffer_input(ctx, value, undefined(ctx), ex);
}
fun blob_parts(ctx: ptr<u8>, parts: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, parts) == 0) {
        return buffer_from_bytes(ctx, null, 0, ex);
    }
    parts = iterable_list(ctx, parts, BUFFER_PART_LIMIT, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, parts);
    var n: i64 = length(ctx, parts, ex);
    if (n > BUFFER_PART_LIMIT) {
        fail(ctx, ex, 2, "Blob part count exceeded");
        unprotect(ctx, parts);
        return undefined(ctx);
    }
    var bytes: ptr<u8> = mem_alloc(BUFFER_LIMIT + 1);
    if (bytes == null) {
        fail(ctx, ex, 2, "cannot allocate Blob bytes");
        unprotect(ctx, parts);
        return undefined(ctx);
    }
    var used: i64 = 0;
    for (var i: i64 = 0; i < n && deref ex == null; i++) {
        var part: ptr<u8> = at(ctx, parts, i, ex);
        if (deref ex != null) {
            break;
        }
        protect(ctx, part);
        var original: ptr<u8> = part;
        var r: ptr<u8> = record(ctx, part, ex);
        if (kind(ctx, r) == 5 && integer(ctx, r, "kind", ex) == BLOB) {
            part = get(ctx, r, "bytes", ex);
        }
        var chunk: ptr<u8> = undefined(ctx);
        if (deref ex == null) {
            chunk = source_bytes(ctx, part, ex);
            if (chunk == null && deref ex == null) {
                part = string_copy(ctx, part, ex);
                if (deref ex == null) {
                    chunk = copy_buffer_input(ctx, part, undefined(ctx), ex);
                }
            }
        }
        protect(ctx, chunk);
        if (deref ex == null) {
            var size: i64 = copy_byte_view(ctx, chunk, bytes + used, BUFFER_LIMIT - used, ex);
            if (size >= 0) {
                used += size;
            }
        }
        unprotect(ctx, chunk);
        unprotect(ctx, original);
    }
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        result = buffer_from_bytes(ctx, bytes, used, ex);
    }
    mem_free(bytes, BUFFER_LIMIT + 1);
    unprotect(ctx, parts);
    return result;
}
fun owner_with_record(ctx: ptr<u8>, ctor: ptr<u8>, r: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var owner: ptr<u8> = object(ctx, null, null);
    protect(ctx, owner);
    prototype(ctx, owner, get(ctx, ctor, "prototype", ex));
    weak_set(ctx, deref s.records, owner, r, ex);
    unprotect(ctx, owner);
    return owner;
}
fun attach_bytes(ctx: ptr<u8>, owner: ptr<u8>, bytes: ptr<u8>, ex: ptr<ptr<u8>>) {
    var body: ptr<u8> = create_stream(ctx, 1, ex);
    protect(ctx, body);
    attach_body(ctx, owner, body, ex);
    var chunk: array<ptr<u8>, 1> = [bytes];
    if (deref ex == null && byte_view_length(ctx, bytes, ex) > 0) {
        stream_invoke(ctx, body, 0, 1, &chunk[0], ex);
    }
    chunk[0] = js_null(ctx);
    if (deref ex == null) {
        stream_invoke(ctx, body, 0, 1, &chunk[0], ex);
    }
    unprotect(ctx, body);
}
export(c) fun jsrt_web_construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var category: i64 = BLOB;
    if (equal(ctx, ctor, (deref s.ctors)[RESPONSE])) {
        category = RESPONSE;
    } else if (equal(ctx, ctor, (deref s.ctors)[REQUEST])) {
        category = REQUEST;
    }
    var init: ptr<u8> = undefined(ctx);
    if (count > 1) {
        init = args[1];
    }
    if (kind(ctx, init) != 0 && kind(ctx, init) != 1 && kind(ctx, init) != 5) {
        fail(ctx, ex, 1, "Web constructor options must be an object");
        return undefined(ctx);
    }
    var r: ptr<u8> = plain(ctx);
    protect(ctx, r);
    set_integer(ctx, r, "kind", category, ex);
    var bytes: ptr<u8> = undefined(ctx);
    var first: ptr<u8> = undefined(ctx);
    if (count > 0) {
        first = args[0];
    }
    if (category == BLOB) {
        bytes = blob_parts(ctx, first, ex);
        protect(ctx, bytes);
        var mime: ptr<u8> = undefined(ctx);
        if (kind(ctx, init) == 5) {
            mime = get(ctx, init, "type", ex);
            protect(ctx, mime);
            var endings: ptr<u8> = get(ctx, init, "endings", ex);
            if (deref ex == null && kind(ctx, endings) != 0 && !equal(ctx, endings, text(ctx, "transparent")) &&
                !equal(ctx, endings, text(ctx, "native"))) {
                fail(ctx, ex, 1, "invalid Blob endings");
            }
        }
        put(ctx, r, "type", content_type(ctx, mime, ex), ex);
        if (kind(ctx, init) == 5) {
            unprotect(ctx, mime);
        }
    } else {
        var body: ptr<u8> = first;
        var source: ptr<u8> = undefined(ctx);
        if (category == REQUEST) {
            if (count == 0) {
                fail(ctx, ex, 1, "Request requires an HTTP URL");
            }
            source = record(ctx, first, ex);
            if (kind(ctx, source) == 5 && integer(ctx, source, "kind", ex) == REQUEST) {
                if (flag(ctx, source, "used", ex) || body_consumed(ctx, first, ex)) {
                    fail(ctx, ex, 1, "Request body already consumed");
                }
                first = get(ctx, source, "url", ex);
                body = get(ctx, source, "bytes", ex);
                if (!flag(ctx, source, "hasBody", ex)) {
                    body = undefined(ctx);
                }
            } else {
                source = undefined(ctx);
                body = undefined(ctx);
            }
            var url: ptr<u8> = url_input(ctx, first, ex);
            url = usv(ctx, url, ex);
            protect(ctx, url);
            if (deref ex == null) {
                var parsed: ptr<u8> = parse_url(ctx, url, null, ex);
                protect(ctx, parsed);
                if (deref ex == null && (!equal(ctx, url_part(ctx, parsed, 2, ex), text(ctx, "")) ||
                    !equal(ctx, url_part(ctx, parsed, 3, ex), text(ctx, "")))) {
                    fail(ctx, ex, 1, "Request URL cannot contain credentials");
                }
                put(ctx, r, "url", parsed, ex);
                unprotect(ctx, parsed);
            }
            unprotect(ctx, url);
        }
        protect(ctx, body);
        var method: ptr<u8> = text(ctx, "GET");
        var status: i64 = 200;
        var headers: ptr<u8> = undefined(ctx);
        var signal: ptr<u8> = undefined(ctx);
        if (kind(ctx, source) == 5) {
            method = get(ctx, source, "method", ex);
            headers = get(ctx, source, "headers", ex);
            signal = get(ctx, source, "signal", ex);
        }
        protect(ctx, method);
        protect(ctx, headers);
        protect(ctx, signal);
        if (kind(ctx, init) == 5) {
            if (category == REQUEST) {
                var entry: ptr<u8> = get(ctx, init, "method", ex);
                if (kind(ctx, entry) != 0) {
                    unprotect(ctx, method);
                    method = entry;
                    protect(ctx, method);
                }
                entry = get(ctx, init, "body", ex);
                if (kind(ctx, entry) != 0) {
                    unprotect(ctx, body);
                    body = entry;
                    protect(ctx, body);
                }
                entry = get(ctx, init, "signal", ex);
                if (kind(ctx, entry) != 0) {
                    unprotect(ctx, signal);
                    signal = entry;
                    protect(ctx, signal);
                }
            } else {
                var value: ptr<u8> = get(ctx, init, "status", ex);
                if (kind(ctx, value) != 0) {
                    status = buffer_integer(ctx, value, 200, 599, ex);
                }
                value = get(ctx, init, "statusText", ex);
                if (kind(ctx, value) != 0 && !equal(ctx, value, text(ctx, ""))) {
                    fail(ctx, ex, 1, "custom Response statusText is not supported");
                }
            }
            var entry: ptr<u8> = get(ctx, init, "headers", ex);
            if (kind(ctx, entry) != 0) {
                unprotect(ctx, headers);
                headers = entry;
                protect(ctx, headers);
            }
        }
        var verb: array<u8, 32>;
        var n: i64 = copy_host_path(ctx, method, &verb[0], 32, ex);
        if (deref ex == null && category == REQUEST) {
            for (var i: i64 = 0; i < n; i++) {
                if (verb[i] >= 97 && verb[i] <= 122) {
                    verb[i] -= 32;
                }
            }
            if (!mem_eq_cstr(&verb[0] as str, "GET") && !mem_eq_cstr(&verb[0] as str, "HEAD") &&
                !mem_eq_cstr(&verb[0] as str, "POST") && !mem_eq_cstr(&verb[0] as str, "PUT") &&
                !mem_eq_cstr(&verb[0] as str, "DELETE") && !mem_eq_cstr(&verb[0] as str, "PATCH") &&
                !mem_eq_cstr(&verb[0] as str, "OPTIONS")) {
                fail(ctx, ex, 1, "unsupported Request method");
            }
            if ((mem_eq_cstr(&verb[0] as str, "GET") || mem_eq_cstr(&verb[0] as str, "HEAD")) &&
                kind(ctx, body) != 0 && kind(ctx, body) != 1) {
                fail(ctx, ex, 1, "GET/HEAD Request cannot have a body");
            }
            if (kind(ctx, signal) != 0 && kind(ctx, signal) != 1) {
                signal_aborted(ctx, signal, ex);
            }
            put(ctx, r, "method", text(ctx, &verb[0] as str), ex);
            put(ctx, r, "signal", dependent_signal(ctx, signal, ex), ex);
        }
        put(ctx, r, "status", number(ctx, status as f64), ex);
        var wrapper: ptr<u8> = create_headers(ctx, headers, true, ex);
        put(ctx, r, "headers", wrapper, ex);
        if (deref ex == null && kind(ctx, body) == 4) {
            default_header(ctx, wrapper, "content-type", text(ctx, "text/plain;charset=UTF-8"), ex);
        } else if (deref ex == null && kind(ctx, body) == 5) {
            var blob: ptr<u8> = record(ctx, body, ex);
            if (kind(ctx, blob) == 5 && integer(ctx, blob, "kind", ex) == BLOB) {
                var mime: ptr<u8> = get(ctx, blob, "type", ex);
                if (!equal(ctx, mime, text(ctx, ""))) {
                    default_header(ctx, wrapper, "content-type", mime, ex);
                }
            } else {
                var multipart: ptr<u8> = form_data_type(ctx, body, ex);
                if (multipart != null && deref ex == null) {
                    default_header(ctx, wrapper, "content-type", multipart, ex);
                }
            }
        }
        if ((status == 204 || status == 205 || status == 304) && kind(ctx, body) != 0 && kind(ctx, body) != 1) {
            fail(ctx, ex, 1, "Response status cannot have a body");
        }
        set_flag(ctx, r, "hasBody", kind(ctx, body) != 0 && kind(ctx, body) != 1, ex);
        bytes = web_body_bytes(ctx, body, ex);
        protect(ctx, bytes);
        unprotect(ctx, body);
        unprotect(ctx, signal);
        unprotect(ctx, headers);
        unprotect(ctx, method);
    }
    put(ctx, r, "bytes", bytes, ex);
    var owner: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        owner = owner_with_record(ctx, ctor, r, ex);
        protect(ctx, owner);
        if (category != BLOB) {
            expose_body_fields(ctx, owner, r, ex);
            if (flag(ctx, r, "hasBody", ex)) {
                attach_bytes(ctx, owner, bytes, ex);
            } else {
                attach_body(ctx, owner, js_null(ctx), ex);
            }
        }
        unprotect(ctx, owner);
    }
    unprotect(ctx, bytes);
    unprotect(ctx, r);
    return owner;
}
export(c) fun jsrt_web_get(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var r: ptr<u8> = record(ctx, owner, ex);
    if (kind(ctx, r) != 5 || integer(ctx, r, "kind", ex) != BLOB) {
        fail(ctx, ex, 1, "invalid Web object receiver");
        return undefined(ctx);
    }
    if (equal(ctx, fn, (deref s.methods)[0])) {
        return number(ctx, byte_view_length(ctx, get(ctx, r, "bytes", ex), ex) as f64);
    }
    if (equal(ctx, fn, (deref s.methods)[1])) {
        return get(ctx, r, "type", ex);
    }
    return undefined(ctx);
}
export(c) fun jsrt_web_blob_read(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var resolve: ptr<u8> = null;
    var reject: ptr<u8> = null;
    var result: ptr<u8> = promise(ctx, &resolve, &reject, ex);
    protect(ctx, result);
    protect(ctx, resolve);
    protect(ctx, reject);
    var problem: ptr<u8> = null;
    var r: ptr<u8> = record(ctx, owner, &problem);
    var value: ptr<u8> = undefined(ctx);
    if (kind(ctx, r) != 5 || integer(ctx, r, "kind", &problem) != BLOB) {
        fail(ctx, &problem, 1, "invalid Blob receiver");
    } else {
        var bytes: ptr<u8> = get(ctx, r, "bytes", &problem);
        var n: i64 = byte_view_length(ctx, bytes, &problem);
        if (equal(ctx, fn, (deref s.methods)[2])) {
            var raw: ptr<u8> = mem_alloc(n + 1);
            if (raw == null) {
                fail(ctx, &problem, 2, "cannot allocate Blob text");
            } else {
                copy_byte_view(ctx, bytes, raw, n, &problem);
                if (problem == null) {
                    value = decode_bytes(ctx, raw, n, 0, &problem);
                }
                mem_free(raw, n + 1);
            }
        } else {
            value = copy_buffer_input(ctx, bytes, undefined(ctx), &problem);
            protect(ctx, value);
            if (problem == null && equal(ctx, fn, (deref s.methods)[3])) {
                var buffer: ptr<u8> = backing(ctx, value, &problem);
                unprotect(ctx, value);
                value = buffer;
            } else {
                unprotect(ctx, value);
            }
        }
    }
    var done: ptr<u8> = resolve;
    if (problem != null) {
        done = reject;
        value = problem;
    }
    var output: array<ptr<u8>, 1> = [value];
    call(ctx, done, null, 1, &output[0], ex);
    unprotect(ctx, reject);
    unprotect(ctx, resolve);
    unprotect(ctx, result);
    return result;
}
// The accessors are installed on each body owner, leaving mutable Headers private.
fun expose_body_fields(ctx: ptr<u8>, owner: ptr<u8>, r: ptr<u8>, ex: ptr<ptr<u8>>) {
    var category: i64 = integer(ctx, r, "kind", ex);
    readonly(ctx, owner, "headers", get(ctx, r, "headers", ex), ex);
    if (category == REQUEST) {
        readonly(ctx, owner, "url", get(ctx, r, "url", ex), ex);
        readonly(ctx, owner, "method", get(ctx, r, "method", ex), ex);
        readonly(ctx, owner, "signal", get(ctx, r, "signal", ex), ex);
    } else {
        var status: i64 = integer(ctx, r, "status", ex);
        readonly(ctx, owner, "status", number(ctx, status as f64), ex);
        readonly(ctx, owner, "ok", boolean(ctx, status >= 200 && status < 300), ex);
        readonly(ctx, owner, "statusText", text(ctx, ""), ex);
        readonly(ctx, owner, "url", text(ctx, ""), ex);
        readonly(ctx, owner, "redirected", boolean(ctx, false), ex);
        readonly(ctx, owner, "type", text(ctx, "default"), ex);
    }
}
pub fun brand_response(ctx: ptr<u8>, owner: ptr<u8>) {
    var s: ptr<State> = state(ctx);
    prototype(ctx, owner, (deref s.parents)[RESPONSE]);
}
pub fun install_web_objects(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var s: ptr<State> = state(ctx);
    deref s.records = weak_map(ctx, ex);
    protect(ctx, deref s.records);
    deref s.stringify = capture(ctx, get(ctx, global(ctx), "JSON", ex), "stringify", ex);
    var names: array<str, 9> = ["size", "type", "text", "arrayBuffer", "bytes", "slice", "clone", "json", "clone"];
    for (var i: i64 = 0; i < METHOD_COUNT; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref s.methods)[i] = function(ctx, name, callback(i as i32));
        release(name);
        protect(ctx, (deref s.methods)[i]);
    }
    var classes: array<str, 3> = ["Blob", "Response", "Request"];
    for (var i: i64 = 0; i < 3; i++) {
        (deref s.ctors)[i] = public_constructor(ctx, constructor_callback(), classes[i], ex);
        protect(ctx, (deref s.ctors)[i]);
        (deref s.parents)[i] = get(ctx, (deref s.ctors)[i], "prototype", ex);
        protect(ctx, (deref s.parents)[i]);
        define(ctx, (deref s.parents)[i], "constructor", (deref s.ctors)[i], ex, false);
        var tag: ptr<u8> = get(ctx, get(ctx, global(ctx), "Symbol", ex), "toStringTag", ex);
        define_key(ctx, (deref s.parents)[i], tag, text(ctx, classes[i]), ex, false);
        define(ctx, global(ctx), classes[i], (deref s.ctors)[i], ex, true);
    }
    for (var i: i64 = 0; i < 5; i++) {
        if (i < 2) {
            getter(ctx, (deref s.parents)[BLOB], names[i], (deref s.methods)[i], ex);
        } else {
            define(ctx, (deref s.parents)[BLOB], names[i], (deref s.methods)[i], ex, false);
        }
    }
    define(ctx, (deref s.parents)[BLOB], "slice", (deref s.methods)[5], ex, false);
    define(ctx, (deref s.parents)[RESPONSE], "clone", (deref s.methods)[6], ex, false);
    define(ctx, (deref s.parents)[REQUEST], "clone", (deref s.methods)[8], ex, false);
    define(ctx, (deref s.ctors)[RESPONSE], "json", (deref s.methods)[7], ex, false);
    return deref ex == null && install_form_data(ctx, deref s.records, ex);
}
pub fun shutdown_web_objects(ctx: ptr<u8>) {
    shutdown_form_data(ctx);
    var s: ptr<State> = state(ctx);
    if (deref s.records != null) {
        unprotect(ctx, deref s.records);
        deref s.records = null;
    }
    if (deref s.stringify != null) {
        unprotect(ctx, deref s.stringify);
        deref s.stringify = null;
    }
    for (var i: i64 = 0; i < METHOD_COUNT; i++) {
        if ((deref s.methods)[i] != null) {
            unprotect(ctx, (deref s.methods)[i]);
            (deref s.methods)[i] = null;
        }
    }
    for (var i: i64 = 0; i < 3; i++) {
        if ((deref s.parents)[i] != null) {
            unprotect(ctx, (deref s.parents)[i]);
            (deref s.parents)[i] = null;
        }
        if ((deref s.ctors)[i] != null) {
            unprotect(ctx, (deref s.ctors)[i]);
            (deref s.ctors)[i] = null;
        }
    }
    release_context_slot(ctx, SLOT, size_of<State>() as i64);
}

fun slice_index(ctx: ptr<u8>, value: ptr<u8>, fallback: i64, size: i64, ex: ptr<ptr<u8>>) -> i64 {
    if (kind(ctx, value) == 0) {
        return fallback;
    }
    var n: f64 = coerce_number(ctx, value, ex);
    if (deref ex != null || n != n) {
        return 0;
    }
    if (n < 0.0) {
        if (n <= -(size as f64)) {
            return 0;
        }
        return size + (n as i64);
    }
    if (n >= size as f64) {
        return size;
    }
    return n as i64;
}
export(c) fun jsrt_web_copy(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var r: ptr<u8> = record(ctx, owner, ex);
    if (kind(ctx, r) != 5) {
        fail(ctx, ex, 1, "cannot clone a streaming body or invalid receiver");
        return undefined(ctx);
    }
    var category: i64 = integer(ctx, r, "kind", ex);
    var expected: i64 = RESPONSE;
    if (equal(ctx, fn, (deref s.methods)[5])) {
        expected = BLOB;
    } else if (equal(ctx, fn, (deref s.methods)[8])) {
        expected = REQUEST;
    }
    if (category != expected) {
        fail(ctx, ex, 1, "invalid Web method receiver");
        return undefined(ctx);
    }
    if (category != BLOB && (flag(ctx, r, "used", ex) || body_consumed(ctx, owner, ex))) {
        fail(ctx, ex, 1, "body already consumed");
        return undefined(ctx);
    }
    var bytes: ptr<u8> = get(ctx, r, "bytes", ex);
    protect(ctx, bytes);
    var copy: ptr<u8> = plain(ctx);
    protect(ctx, copy);
    set_integer(ctx, copy, "kind", category, ex);
    if (category == BLOB) {
        var size: i64 = byte_view_length(ctx, bytes, ex);
        var start: i64 = 0;
        var end: i64 = size;
        if (count > 0) {
            start = slice_index(ctx, args[0], 0, size, ex);
        }
        if (count > 1) {
            end = slice_index(ctx, args[1], size, size, ex);
        }
        if (end < start) {
            end = start;
        }
        var mime: ptr<u8> = undefined(ctx);
        if (count > 2) {
            mime = args[2];
        }
        put(ctx, copy, "type", content_type(ctx, mime, ex), ex);
        var raw: ptr<u8> = mem_alloc(size + 1);
        if (raw == null) {
            fail(ctx, ex, 2, "cannot allocate Blob slice");
        } else {
            copy_byte_view(ctx, bytes, raw, size, ex);
            if (deref ex == null) {
                put(ctx, copy, "bytes", buffer_from_bytes(ctx, raw + start, end - start, ex), ex);
            }
            mem_free(raw, size + 1);
        }
    } else {
        put(ctx, copy, "bytes", bytes, ex);
        set_flag(ctx, copy, "hasBody", flag(ctx, r, "hasBody", ex), ex);
        var names: array<str, 5> = ["url", "method", "signal", "headers", "status"];
        for (var i: i64 = 0; i < 5 && deref ex == null; i++) {
            var value: ptr<u8> = get(ctx, r, names[i], ex);
            if (i == 3) {
                value = create_headers(ctx, value, true, ex);
            } else if (i == 2 && category == REQUEST) {
                value = dependent_signal(ctx, value, ex);
            }
            put(ctx, copy, names[i], value, ex);
        }
    }
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        result = owner_with_record(ctx, (deref s.ctors)[category], copy, ex);
        protect(ctx, result);
        if (category != BLOB) {
            expose_body_fields(ctx, result, copy, ex);
            if (flag(ctx, r, "hasBody", ex)) {
                attach_bytes(ctx, result, bytes, ex);
                var failure: ptr<u8> = body_failure(ctx, owner, ex);
                if (kind(ctx, failure) != 0 && deref ex == null) {
                    fail_buffered_body(ctx, result, failure, ex);
                }
            } else {
                attach_body(ctx, result, js_null(ctx), ex);
            }
        }
        unprotect(ctx, result);
    }
    unprotect(ctx, copy);
    unprotect(ctx, bytes);
    return result;
}
export(c) fun jsrt_web_json(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var value: ptr<u8> = undefined(ctx);
    if (count > 0) {
        value = args[0];
    }
    var input_args: array<ptr<u8>, 1> = [value];
    var serialized: ptr<u8> = call(ctx, deref s.stringify, null, 1, &input_args[0], ex);
    protect(ctx, serialized);
    if (kind(ctx, serialized) == 0) {
        fail(ctx, ex, 1, "Response.json requires a JSON value");
    }
    var options: ptr<u8> = plain(ctx);
    protect(ctx, options);
    var init: ptr<u8> = undefined(ctx);
    if (count > 1) {
        init = args[1];
    }
    if (kind(ctx, init) == 5) {
        var names: array<str, 3> = ["status", "statusText", "headers"];
        for (var i: i64 = 0; i < 3 && deref ex == null; i++) {
            put(ctx, options, names[i], get(ctx, init, names[i], ex), ex);
        }
    } else if (kind(ctx, init) != 0 && kind(ctx, init) != 1) {
        fail(ctx, ex, 1, "Response.json options must be an object");
    }
    var headers: ptr<u8> = create_headers(ctx, get(ctx, options, "headers", ex), true, ex);
    protect(ctx, headers);
    default_header(ctx, headers, "content-type", text(ctx, "application/json"), ex);
    put(ctx, options, "headers", headers, ex);
    var result: ptr<u8> = undefined(ctx);
    var ctor_args: array<ptr<u8>, 2> = [serialized, options];
    if (deref ex == null) {
        result = construct(ctx, (deref s.ctors)[RESPONSE], 2, &ctor_args[0], ex);
    }
    unprotect(ctx, headers);
    unprotect(ctx, options);
    unprotect(ctx, serialized);
    return result;
}

pub fun request_fetch_options(ctx: ptr<u8>, owner: ptr<u8>, init: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var r: ptr<u8> = record(ctx, owner, ex);
    if (kind(ctx, r) != 5 || integer(ctx, r, "kind", ex) != REQUEST) {
        return null;
    }
    if (flag(ctx, r, "used", ex) || body_consumed(ctx, owner, ex)) {
        fail(ctx, ex, 1, "Request body already consumed");
        return null;
    }
    if (kind(ctx, init) != 0 && kind(ctx, init) != 5) {
        fail(ctx, ex, 1, "fetch options must be an object");
        return null;
    }
    var options: ptr<u8> = plain(ctx);
    protect(ctx, options);
    var names: array<str, 8> = ["method", "headers", "signal", "redirect", "rejectUnauthorized", "connectTimeout", "timeout", "caFile"];
    for (var i: i64 = 0; i < 8 && deref ex == null; i++) {
        var value: ptr<u8> = undefined(ctx);
        if (kind(ctx, init) == 5) {
            value = get(ctx, init, names[i], ex);
        }
        if (kind(ctx, value) == 0) {
            value = get(ctx, r, names[i], ex);
        }
        put(ctx, options, names[i], value, ex);
    }
    var body: ptr<u8> = undefined(ctx);
    if (kind(ctx, init) == 5) {
        body = get(ctx, init, "body", ex);
    }
    if (kind(ctx, body) == 0 && flag(ctx, r, "hasBody", ex)) {
        body = get(ctx, r, "bytes", ex);
    }
    put(ctx, options, "body", body, ex);
    put(ctx, options, "url", get(ctx, r, "url", ex), ex);
    if (deref ex == null && flag(ctx, r, "hasBody", ex)) {
        set_flag(ctx, r, "used", true, ex);
        mark_body_consumed(ctx, owner, ex);
    }
    unprotect(ctx, options);
    return options;
}

pub fun web_body_type(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null) {
        return null;
    }
    if (kind(ctx, value) == 4) {
        return text(ctx, "text/plain;charset=UTF-8");
    }
    var r: ptr<u8> = record(ctx, value, ex);
    if (kind(ctx, r) == 5 && integer(ctx, r, "kind", ex) == BLOB) {
        return get(ctx, r, "type", ex);
    }
    return form_data_type(ctx, value, ex);
}
