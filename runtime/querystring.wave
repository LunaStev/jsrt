// Bounded default querystring.parse policy, sharing Wave's form decoder.
import("./url_params")::{parse_pairs_with, pair, serialize_query_pairs_with, escape_query_text, unescape_query_text};
import("./byte_codec")::{encode_utf8};
import("./values")::{plain, text, define_key, define, fail};
import("./collections")::{length, at, list, append};
import("./config")::{URL_PAIR_LIMIT};
import("./http_values")::{http_keys};
import("./http_values")::{http_native};
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_is_array") fun is_array(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_array") fun array(ctx: ptr<u8>, count: i64, values: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_get") fun get_key(ctx: ptr<u8>, owner: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_to_string") fun to_string(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_string_release") fun release_string(value: ptr<u8>);
extern(c, "wr_set_index") fun set_index(ctx: ptr<u8>, owner: ptr<u8>, index: u32, value: ptr<u8>, ex: ptr<ptr<u8>>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_string_value") fun string_value(ctx: ptr<u8>, value: ptr<u8>) -> ptr<u8>;
extern(c, "wr_to_number") fun to_number(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> f64;

// JSType codes returned by wr_type.
const TYPE_BOOLEAN: i32 = 2;
const TYPE_NUMBER: i32 = 3;
const TYPE_STRING: i32 = 4;
const TYPE_OBJECT: i32 = 5;
const TYPE_BIGINT: i32 = 7;


// querystring separators: a missing or undefined sep/eq means the default; otherwise it must be a
// non-empty string (Node uses the default for an empty one as well). Delimiters longer than this
// are rejected so the fixed byte buffers stay bounded.
const DELIMITER_CAPACITY: i64 = 64;

fun delimiter_argument(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, index: i64, fallback: u8, buffer: ptr<u8>,
    ex: ptr<ptr<u8>>) -> i64 {
    buffer[0] = fallback;
    if (count <= index || kind(ctx, args[index]) == 0 || kind(ctx, args[index]) == 1) {
        return 1;
    }
    if (kind(ctx, args[index]) != TYPE_STRING) {
        // Node coerces other values to a string; only strings are supported here.
        fail(ctx, ex, 1, "querystring separators must be strings");
        return 0;
    }
    var length: i64 = encode_utf8(ctx, args[index], buffer, DELIMITER_CAPACITY, false, ex);
    if (deref ex != null || length < 0) {
        return 0;
    }
    if (length == 0) {
        buffer[0] = fallback;
        return 1;
    }
    return length;
}
export(c) fun jsrt_query_parse(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = plain(ctx);
    if (count == 0 || kind(ctx, args[0]) != 4) {
        return result;
    }
    var separator: array<u8, 64>;
    var equals: array<u8, 64>;
    var separator_length: i64 = delimiter_argument(ctx, count, args, 1, 38, &separator[0], ex);
    var equals_length: i64 = 0;
    if (deref ex == null) {
        equals_length = delimiter_argument(ctx, count, args, 2, 61, &equals[0], ex);
    }
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, result);
    var pairs: ptr<u8> = parse_pairs_with(ctx, args[0], false, &separator[0], separator_length, &equals[0],
        equals_length, ex);
    protect(ctx, pairs);
    for (var i: i64 = 0; i < length(ctx, pairs, ex) && deref ex == null; i++) {
        var pair: ptr<u8> = at(ctx, pairs, i, ex);
        var name: ptr<u8> = at(ctx, pair, 0, ex);
        var value: ptr<u8> = at(ctx, pair, 1, ex);
        var key: ptr<u8> = to_string(ctx, name, ex);
        if (key == null || deref ex != null) {
            break;
        }
        var previous: ptr<u8> = get_key(ctx, result, key, ex);
        release_string(key);
        if (kind(ctx, previous) == 0) {
            define_key(ctx, result, name, value, ex, true);
        } else if (is_array(ctx, previous)) {
            set_index(ctx, previous, length(ctx, previous, ex) as u32, value, ex);
        } else {
            var items: array<ptr<u8>, 2> = [previous, value];
            define_key(ctx, result, name, array(ctx, 2, &items[0], ex), ex, true);
        }
    }
    unprotect(ctx, pairs);
    unprotect(ctx, result);
    return result;
}

// Node stringifyPrimitive: strings, finite numbers, bigints and booleans convert; anything
// else becomes the empty string.
fun primitive_text(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var value_type: i32 = kind(ctx, value);
    var convertible: bool = value_type == TYPE_STRING || value_type == TYPE_BOOLEAN || value_type == TYPE_BIGINT;
    if (value_type == TYPE_NUMBER) {
        var number: f64 = to_number(ctx, value, ex);
        convertible = number == number && number - number == 0.0;
    }
    if (!convertible || deref ex != null) {
        return text(ctx, "");
    }
    var raw: ptr<u8> = to_string(ctx, value, ex);
    if (raw == null || deref ex != null) {
        return text(ctx, "");
    }
    var result: ptr<u8> = string_value(ctx, raw);
    release_string(raw);
    return result;
}

fun add_entry(ctx: ptr<u8>, entries: ptr<u8>, name: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) {
    if (length(ctx, entries, ex) >= URL_PAIR_LIMIT) {
        fail(ctx, ex, 2, "querystring.stringify pair limit exceeded");
        return;
    }
    var converted: ptr<u8> = primitive_text(ctx, value, ex);
    protect(ctx, converted);
    append(ctx, entries, pair(ctx, name, converted, ex), ex);
    unprotect(ctx, converted);
}

// Default separators only, like parse. Bounded by the shared URL pair and byte limits.
export(c) fun jsrt_query_stringify(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count == 0 || kind(ctx, args[0]) != TYPE_OBJECT) {
        return text(ctx, "");
    }
    var separator: array<u8, 64>;
    var equals: array<u8, 64>;
    var separator_length: i64 = delimiter_argument(ctx, count, args, 1, 38, &separator[0], ex);
    var equals_length: i64 = 0;
    if (deref ex == null) {
        equals_length = delimiter_argument(ctx, count, args, 2, 61, &equals[0], ex);
    }
    if (deref ex != null) {
        return undefined(ctx);
    }
    var source: ptr<u8> = args[0];
    var entries: ptr<u8> = list(ctx, ex);
    protect(ctx, entries);
    var keys: ptr<u8> = http_keys(ctx, source, ex);
    protect(ctx, keys);
    for (var i: i64 = 0; i < length(ctx, keys, ex) && deref ex == null; i++) {
        var name: ptr<u8> = at(ctx, keys, i, ex);
        protect(ctx, name);
        var raw_name: ptr<u8> = to_string(ctx, name, ex);
        var value: ptr<u8> = undefined(ctx);
        if (raw_name != null && deref ex == null) {
            value = get_key(ctx, source, raw_name, ex);
            release_string(raw_name);
        }
        if (deref ex == null && is_array(ctx, value)) {
            protect(ctx, value);
            for (var j: i64 = 0; j < length(ctx, value, ex) && deref ex == null; j++) {
                add_entry(ctx, entries, name, at(ctx, value, j, ex), ex);
            }
            unprotect(ctx, value);
        } else if (deref ex == null) {
            add_entry(ctx, entries, name, value, ex);
        }
        unprotect(ctx, name);
    }
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        result = serialize_query_pairs_with(ctx, entries, &separator[0], separator_length, &equals[0], equals_length, ex);
    }
    unprotect(ctx, keys);
    unprotect(ctx, entries);
    return result;
}

pub fun querystring_module(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = plain(ctx);
    protect(ctx, result);
    define(ctx, result, "parse", http_native(ctx, "parse", 17), ex, true);
    define(ctx, result, "decode", http_native(ctx, "decode", 17), ex, true);
    define(ctx, result, "stringify", http_native(ctx, "stringify", 25), ex, true);
    define(ctx, result, "encode", http_native(ctx, "encode", 25), ex, true);
    define(ctx, result, "escape", http_native(ctx, "escape", 26), ex, true);
    define(ctx, result, "unescape", http_native(ctx, "unescape", 27), ex, true);
    unprotect(ctx, result);
    return result;
}

export(c) fun jsrt_query_escape(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count == 0) {
        return text(ctx, "");
    }
    var raw: ptr<u8> = to_string(ctx, args[0], ex);
    if (raw == null || deref ex != null) {
        return undefined(ctx);
    }
    var converted: ptr<u8> = string_value(ctx, raw);
    release_string(raw);
    protect(ctx, converted);
    var result: ptr<u8> = escape_query_text(ctx, converted, ex);
    unprotect(ctx, converted);
    return result;
}

export(c) fun jsrt_query_unescape(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count == 0) {
        return text(ctx, "");
    }
    var raw: ptr<u8> = to_string(ctx, args[0], ex);
    if (raw == null || deref ex != null) {
        return undefined(ctx);
    }
    var converted: ptr<u8> = string_value(ctx, raw);
    release_string(raw);
    protect(ctx, converted);
    var result: ptr<u8> = unescape_query_text(ctx, converted, ex);
    unprotect(ctx, converted);
    return result;
}
