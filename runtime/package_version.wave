// Strict, borrowed SemVer values. No allocation and no JS execution.
import("std::mem::cstr")::{mem_len_cstr};
import("./config")::{PACKAGE_VERSION_TEXT_LIMIT};

pub const VERSION_TEXT_LIMIT: i64 = PACKAGE_VERSION_TEXT_LIMIT;
const MAX_COMPONENT: i64 = 9007199254740991;

pub struct Version {
    valid: bool;
    parts: i64;
    major: i64;
    minor: i64;
    patch: i64;
    text: str;
    pre_start: i64;
    pre_end: i64;
}

fun identifier_char(c: u8) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45;
}

fun identifiers(text: str, start: i64, end: i64, prerelease: bool) -> bool {
    var first: i64 = start;
    while (first < end) {
        var at: i64 = first;
        var numeric: bool = true;
        while (at < end && text[at] != 46) {
            if (!identifier_char(text[at])) {
                return false;
            }
            if (text[at] < 48 || text[at] > 57) {
                numeric = false;
            }
            at += 1;
        }
        if (at == first || (prerelease && numeric && at-first > 1 && text[first] == 48)) {
            return false;
        }
        if (at == end) {
            return true;
        }
        first = at + 1;
    }
    return false;
}

pub fun version_span(text: str, size: i64, partial: bool) -> Version {
    var result: Version = Version {
        valid: false,
        parts: 0,
        major: 0,
        minor: 0,
        patch: 0,
        text: text,
        pre_start: 0,
        pre_end: 0
    };
    if (size < 1 || size > VERSION_TEXT_LIMIT) {
        return result;
    }
    var at: i64 = 0;
    var wildcard: bool = false;
    var components: array<i64, 3> = [0, 0, 0];
    for (var part: i64 = 0; part < 3; part++) {
        if (at >= size) {
            return result;
        }
        var first: i64 = at;
        var c: u8 = text[at];
        if (partial && (c == 42 || c == 120 || c == 88)) {
            wildcard = true;
            at += 1;
        } else {
            if (wildcard || c < 48 || c > 57) {
                return result;
            }
            var number: i64 = 0;
            while (at < size && text[at] >= 48 && text[at] <= 57) {
                var digit: i64 = (text[at]-48) as i64;
                if (number > (MAX_COMPONENT-digit)/10) {
                    return result;
                }
                number = number*10+digit;
                at += 1;
            }
            if (at-first > 1 && text[first] == 48) {
                return result;
            }
            components[part] = number;
            result.parts += 1;
        }
        if (at == size) {
            if (!partial && part != 2) {
                return result;
            }
            break;
        }
        if (text[at] != 46) {
            if (part != 2 || wildcard) {
                return result;
            }
            break;
        }
        if (part == 2) {
            return result;
        }
        at += 1;
    }
    result.major = components[0];
    result.minor = components[1];
    result.patch = components[2];
    if (at < size && text[at] == 45) {
        at += 1;
        result.pre_start = at;
        while (at < size && text[at] != 43) {
            at += 1;
        }
        result.pre_end = at;
        if (!identifiers(text, result.pre_start, at, true)) {
            return result;
        }
    }
    if (at < size && text[at] == 43) {
        at += 1;
        if (!identifiers(text, at, size, false)) {
            return result;
        }
        at = size;
    }
    result.valid = at == size;
    return result;
}

pub fun parse_version(text: str) -> Version {
    if ((text as ptr<u8>) == null) {
        return version_span("", 0, false);
    }
    return version_span(text, mem_len_cstr(text), false);
}

pub fun same_core(a: Version, b: Version) -> bool {
    return a.major == b.major && a.minor == b.minor && a.patch == b.patch;
}

pub fun compare_core(a: Version, b: Version) -> i64 {
    if (a.major != b.major) {
        if (a.major < b.major) {
            return -1;
        }
        return 1;
    }
    if (a.minor != b.minor) {
        if (a.minor < b.minor) {
            return -1;
        }
        return 1;
    }
    if (a.patch != b.patch) {
        if (a.patch < b.patch) {
            return -1;
        }
        return 1;
    }
    return 0;
}

pub fun compare_versions(a: Version, b: Version) -> i64 {
    var core: i64 = compare_core(a, b);
    if (core != 0) {
        return core;
    }
    var left: i64 = a.pre_start;
    var right: i64 = b.pre_start;
    var a_pre: bool = a.pre_end > left;
    var b_pre: bool = b.pre_end > right;
    if (!a_pre || !b_pre) {
        if (a_pre) {
            return -1;
        }
        if (b_pre) {
            return 1;
        }
        return 0;
    }
    while (left < a.pre_end && right < b.pre_end) {
        var ae: i64 = left;
        var be: i64 = right;
        var an: bool = true;
        var bn: bool = true;
        while (ae < a.pre_end && a.text[ae] != 46) {
            if (a.text[ae] < 48 || a.text[ae] > 57) {
                an = false;
            }
            ae += 1;
        }
        while (be < b.pre_end && b.text[be] != 46) {
            if (b.text[be] < 48 || b.text[be] > 57) {
                bn = false;
            }
            be += 1;
        }
        if (an && !bn) {
            return -1;
        }
        if (!an && bn) {
            return 1;
        }
        if (an && bn && ae-left != be-right) {
            if (ae-left < be-right) {
                return -1;
            }
            return 1;
        }
        var i: i64 = 0;
        while (left+i < ae && right+i < be) {
            if (a.text[left+i] != b.text[right+i]) {
                if (a.text[left+i] < b.text[right+i]) {
                    return -1;
                }
                return 1;
            }
            i += 1;
        }
        if (ae-left != be-right) {
            if (ae-left < be-right) {
                return -1;
            }
            return 1;
        }
        left = ae+1;
        right = be+1;
    }
    if (left <= a.pre_end) {
        return 1;
    }
    if (right <= b.pre_end) {
        return -1;
    }
    return 0;
}
