import("./context_state")::{owned_context_slot, active_context};
import("./assert_deep")::{DeepIntrinsics, deep_install, deep_release, deep_equal};
import("std::mem::layout")::{size_of};
struct AssertState {
    methods: array<ptr<u8>, 13>;
    // AssertionError constructor and prototype; thrown assertion errors inherit from the prototype.
    ctor: ptr<u8>;
    class_prototype: ptr<u8>;
    // Promise reaction handlers for assert.rejects and assert.doesNotReject. Each runs with the
    // per-call record as its receiver, bound at call time.
    on_fulfilled: ptr<u8>;
    on_rejected: ptr<u8>;
    same: ptr<u8>;
    deep: DeepIntrinsics;
    // Captured for exception matchers: isPrototypeOf, RegExp.prototype.exec, RegExp.prototype,
    // Object.keys, String, Error, Reflect.get and String.prototype.concat.
    matcher: array<ptr<u8>, 8>;
}

// Method slots: 0 ok, 1 strictEqual, 2 notStrictEqual, 3 fail, 4 throws, 5 doesNotThrow,
// 6 ifError, 7 deepStrictEqual, 8 notDeepStrictEqual, 9 match, 10 doesNotMatch, 11 rejects,
// 12 doesNotReject.
const METHOD_COUNT: i64 = 13;
const METHOD_MATCH: i64 = 9;
const METHOD_DOES_NOT_MATCH: i64 = 10;
const METHOD_REJECTS: i64 = 11;
const METHOD_DOES_NOT_REJECT: i64 = 12;
const METHOD_DEEP_EQUAL: i64 = 7;
const METHOD_NOT_DEEP_EQUAL: i64 = 8;
const METHOD_THROWS: i64 = 4;
const METHOD_DOES_NOT_THROW: i64 = 5;
const M_IS_PROTOTYPE_OF: i64 = 0;
const M_REGEXP_EXEC: i64 = 1;
const M_REGEXP_PROTO: i64 = 2;
const M_KEYS: i64 = 3;
const M_STRING: i64 = 4;
const M_ERROR: i64 = 5;
const M_REFLECT_GET: i64 = 6;
const M_CONCAT: i64 = 7;
const MATCHER_COUNT: i64 = 8;
const TYPE_UNDEFINED: i32 = 0;
const TYPE_NULL: i32 = 1;
const TYPE_BOOLEAN: i32 = 2;
const TYPE_STRING: i32 = 4;
const TYPE_OBJECT: i32 = 5;

fun assert_storage(ctx: ptr<u8>) -> ptr<AssertState> {
    return owned_context_slot(ctx, 9, size_of<AssertState>() as i64) as ptr<AssertState>;
}

// A strict assertion subset. Preserve original exceptions and inspect no values implicitly.
import("./values")::{get, text, define, capture, fail, plain, make_error, fail_dynamic};
import("./web_support")::{public_constructor};
import("./util_text")::{invalid_argument_type, received_description};
import("./brands")::{is_promise};
import("./format")::{inspect_to_value};
import("./collections")::{bind_one};
import("./collections")::{length, at};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_assert_callback") fun callback() -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, value: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_promise") fun promise(ctx: ptr<u8>, resolve: ptr<ptr<u8>>, reject: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_assert_ctor_callback") fun ctor_callback() -> ptr<u8>;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;

fun assertion(ctx: ptr<u8>, actual: ptr<u8>, expected: ptr<u8>, message: ptr<u8>, operation: str, ex: ptr<ptr<u8>>) {
    var generated: bool = kind(ctx, message) != TYPE_STRING;
    assertion_flagged(ctx, actual, expected, message, generated, operation, ex);
}

// Builds the AssertionError. `generated` follows Node's generatedMessage: false when the caller
// supplied the text. The error inherits from AssertionError.prototype once that class exists.
fun assertion_flagged(ctx: ptr<u8>, actual: ptr<u8>, expected: ptr<u8>, message: ptr<u8>, generated: bool,
    operation: str, ex: ptr<ptr<u8>>) {
    var state: ptr<AssertState> = assert_storage(ctx);
    var report: ptr<u8> = message;
    if (kind(ctx, message) != TYPE_STRING && generated) {
        report = generated_text(ctx, state, actual, expected, operation, ex);
    }
    var error: ptr<u8> = null;
    if (kind(ctx, report) == TYPE_STRING) {
        error = make_error(ctx, 0, report, ex);
    } else {
        fail(ctx, &error, 0, "assertion failed");
    }
    if (error == null) {
        return;
    }
    protect(ctx, error);
    if (deref state.class_prototype != null) {
        prototype(ctx, error, deref state.class_prototype);
    }
    define(ctx, error, "name", text(ctx, "AssertionError"), ex, false);
    define(ctx, error, "code", text(ctx, "ERR_ASSERTION"), ex, true);
    define(ctx, error, "actual", actual, ex, true);
    define(ctx, error, "expected", expected, ex, true);
    define(ctx, error, "operator", text(ctx, operation), ex, true);
    define(ctx, error, "generatedMessage", boolean(ctx, generated), ex, true);
    if (kind(ctx, message) == 4) {
        define(ctx, error, "message", message, ex, false);
    }
    if (deref ex == null) {
        deref ex = error;
    }
    unprotect(ctx, error);
}


fun matcher_fn(state: ptr<AssertState>, index: i64) -> ptr<u8> {
    return (deref state.matcher)[index];
}

fun is_prototype_of(ctx: ptr<u8>, state: ptr<AssertState>, prototype: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (kind(ctx, prototype) != TYPE_OBJECT || kind(ctx, value) != TYPE_OBJECT) {
        return false;
    }
    var argument: array<ptr<u8>, 1> = [value];
    var result: ptr<u8> = call(ctx, matcher_fn(state, M_IS_PROTOTYPE_OF), prototype, 1, &argument[0], ex);
    return deref ex == null && truth(ctx, result);
}

fun is_regexp(ctx: ptr<u8>, state: ptr<AssertState>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    return is_prototype_of(ctx, state, matcher_fn(state, M_REGEXP_PROTO), value, ex);
}

// Runs the captured RegExp.prototype.exec so a replaced exec cannot change the result.
fun regexp_matches(ctx: ptr<u8>, state: ptr<AssertState>, pattern: ptr<u8>, subject: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var argument: array<ptr<u8>, 1> = [subject];
    var text_value: ptr<u8> = call(ctx, matcher_fn(state, M_STRING), null, 1, &argument[0], ex);
    if (deref ex != null) {
        return false;
    }
    protect(ctx, text_value);
    var exec_argument: array<ptr<u8>, 1> = [text_value];
    var result: ptr<u8> = call(ctx, matcher_fn(state, M_REGEXP_EXEC), pattern, 1, &exec_argument[0], ex);
    unprotect(ctx, text_value);
    return deref ex == null && kind(ctx, result) != TYPE_NULL && kind(ctx, result) != TYPE_UNDEFINED;
}

// Every own enumerable key of the expected object must match the error: RegExp values are tested
// against string properties, everything else is compared with deepStrictEqual.
fun object_matches(ctx: ptr<u8>, state: ptr<AssertState>, error: ptr<u8>, expected: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (kind(ctx, error) != TYPE_OBJECT) {
        return false;
    }
    var argument: array<ptr<u8>, 1> = [expected];
    var keys: ptr<u8> = call(ctx, matcher_fn(state, M_KEYS), null, 1, &argument[0], ex);
    if (deref ex != null) {
        return false;
    }
    protect(ctx, keys);
    var result: bool = true;
    var total: i64 = length(ctx, keys, ex);
    for (var i: i64 = 0; result && deref ex == null && i < total; i++) {
        var key: ptr<u8> = at(ctx, keys, i, ex);
        var expected_pair: array<ptr<u8>, 2> = [expected, key];
        var wanted: ptr<u8> = call(ctx, matcher_fn(state, M_REFLECT_GET), null, 2, &expected_pair[0], ex);
        protect(ctx, wanted);
        var actual_pair: array<ptr<u8>, 2> = [error, key];
        var present: ptr<u8> = call(ctx, matcher_fn(state, M_REFLECT_GET), null, 2, &actual_pair[0], ex);
        protect(ctx, present);
        if (deref ex == null) {
            if (kind(ctx, present) == TYPE_STRING && is_regexp(ctx, state, wanted, ex)) {
                result = regexp_matches(ctx, state, wanted, present, ex);
            } else if (deref ex == null) {
                result = deep_equal(ctx, &(deref state.deep), present, wanted, ex);
            }
        }
        unprotect(ctx, present);
        unprotect(ctx, wanted);
    }
    unprotect(ctx, keys);
    return result && deref ex == null;
}

// Node's matcher rules for assert.throws/doesNotThrow: a class matches by instanceof, an Error
// subclass that does not match fails, any other function is a validator that must return true,
// a RegExp is tested against String(error) and an object is compared key by key.
fun error_matches(ctx: ptr<u8>, state: ptr<AssertState>, error: ptr<u8>, expected: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (is_regexp(ctx, state, expected, ex)) {
        return regexp_matches(ctx, state, expected, error, ex);
    }
    if (deref ex != null) {
        return false;
    }
    if (callable(ctx, expected)) {
        var prototype: ptr<u8> = get(ctx, expected, "prototype", ex);
        if (deref ex == null && is_prototype_of(ctx, state, prototype, error, ex)) {
            return true;
        }
        var error_ctor: ptr<u8> = matcher_fn(state, M_ERROR);
        if (deref ex == null && (equal(ctx, expected, error_ctor) || is_prototype_of(ctx, state, error_ctor, expected, ex))) {
            return false;
        }
        if (deref ex != null) {
            return false;
        }
        var receiver: ptr<u8> = plain(ctx);
        protect(ctx, receiver);
        var argument: array<ptr<u8>, 1> = [error];
        var verdict: ptr<u8> = call(ctx, expected, receiver, 1, &argument[0], ex);
        unprotect(ctx, receiver);
        return deref ex == null && kind(ctx, verdict) == TYPE_BOOLEAN && truth(ctx, verdict);
    }
    return object_matches(ctx, state, error, expected, ex);
}


// Joins up to four JS values with the captured String.prototype.concat.
fun join_text(ctx: ptr<u8>, state: ptr<AssertState>, head: ptr<u8>, count: i64, parts: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = call(ctx, matcher_fn(state, M_CONCAT), head, count, parts, ex);
    if (deref ex != null || result == null) {
        return undefined(ctx);
    }
    return result;
}

// Node's wording: "<base> (MatcherName): message" or "<base> (MatcherName)." The name part appears
// only for a function matcher with a non-empty name.
fun compose_message(ctx: ptr<u8>, state: ptr<AssertState>, base: str, matcher: ptr<u8>, message: ptr<u8>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = text(ctx, base);
    protect(ctx, result);
    if (kind(ctx, matcher) == TYPE_OBJECT && callable(ctx, matcher)) {
        var name: ptr<u8> = get(ctx, matcher, "name", ex);
        if (deref ex == null && kind(ctx, name) == TYPE_STRING && truth(ctx, name)) {
            var named: array<ptr<u8>, 3> = [text(ctx, " ("), name, text(ctx, ")")];
            var next: ptr<u8> = join_text(ctx, state, result, 3, &named[0], ex);
            unprotect(ctx, result);
            result = next;
            protect(ctx, result);
        }
    }
    var tail: array<ptr<u8>, 2> = [text(ctx, "."), undefined(ctx)];
    var tail_count: i64 = 1;
    if (kind(ctx, message) == TYPE_STRING) {
        tail[0] = text(ctx, ": ");
        tail[1] = message;
        tail_count = 2;
    }
    var finished: ptr<u8> = join_text(ctx, state, result, tail_count, &tail[0], ex);
    unprotect(ctx, result);
    return finished;
}

// 'The error is expected to be an instance of "Expected". Received "Actual"' for class mismatches.
fun instance_message(ctx: ptr<u8>, state: ptr<AssertState>, error: ptr<u8>, matcher: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var expected_name: ptr<u8> = get(ctx, matcher, "name", ex);
    protect(ctx, expected_name);
    var actual_name: ptr<u8> = text(ctx, "undefined");
    if (deref ex == null && kind(ctx, error) == TYPE_OBJECT) {
        var ctor: ptr<u8> = get(ctx, error, "constructor", ex);
        if (deref ex == null && kind(ctx, ctor) == TYPE_OBJECT) {
            actual_name = get(ctx, ctor, "name", ex);
        }
    }
    protect(ctx, actual_name);
    var parts: array<ptr<u8>, 4> = [expected_name, text(ctx, "\". Received \""), actual_name, text(ctx, "\"")];
    var result: ptr<u8> = join_text(ctx, state, text(ctx, "The error is expected to be an instance of \""), 4,
        &parts[0], ex);
    unprotect(ctx, actual_name);
    unprotect(ctx, expected_name);
    return result;
}

// True for a function matcher that is an Error class, the case Node reports with instance_message.
fun is_error_class(ctx: ptr<u8>, state: ptr<AssertState>, matcher: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (kind(ctx, matcher) != TYPE_OBJECT || !callable(ctx, matcher)) {
        return false;
    }
    var error_ctor: ptr<u8> = matcher_fn(state, M_ERROR);
    return equal(ctx, matcher, error_ctor) || is_prototype_of(ctx, state, error_ctor, matcher, ex);
}
// assert.throws(fn[, matcher][, message]) and assert.doesNotThrow(fn[, matcher][, message]).
fun run_throws(ctx: ptr<u8>, state: ptr<AssertState>, fn: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) {
    if (count == 0 || kind(ctx, args[0]) != TYPE_OBJECT || !callable(ctx, args[0])) {
        fail(ctx, ex, 1, "assertion requires a function");
        return;
    }
    var matcher: ptr<u8> = undefined(ctx);
    var message: ptr<u8> = undefined(ctx);
    if (count > 1 && kind(ctx, args[1]) == TYPE_STRING) {
        message = args[1];
    } else if (count > 1 && kind(ctx, args[1]) != TYPE_UNDEFINED) {
        matcher = args[1];
        if (count > 2) {
            message = args[2];
        }
        if (kind(ctx, matcher) != TYPE_OBJECT) {
            fail(ctx, ex, 1, "the error matcher must be a function, RegExp or object");
            return;
        }
    }
    var has_matcher: bool = kind(ctx, matcher) == TYPE_OBJECT;
    var problem: ptr<u8> = null;
    call(ctx, args[0], null, 0, null, &problem);
    var throws_method: bool = equal(ctx, fn, (deref state.methods)[METHOD_THROWS]);
    if (throws_method && problem == null) {
        var missing: ptr<u8> = compose_message(ctx, state, "Missing expected exception", matcher, message, ex);
        if (deref ex == null) {
            protect(ctx, missing);
            assertion(ctx, undefined(ctx), matcher, missing, "throws", ex);
            unprotect(ctx, missing);
        }
        return;
    }
    if (problem == null) {
        return;
    }
    protect(ctx, problem);
    var matched: bool = true;
    if (has_matcher) {
        matched = error_matches(ctx, state, problem, matcher, ex);
    }
    if (deref ex == null) {
        if (throws_method && !matched) {
            // A caller-supplied message replaces Node's generated text entirely here.
            if (kind(ctx, message) != TYPE_STRING) {
                if (is_error_class(ctx, state, matcher, ex)) {
                    message = instance_message(ctx, state, problem, matcher, ex);
                } else {
                    message = text(ctx, "The error did not match the expected matcher.");
                }
            }
            protect(ctx, message);
            if (deref ex == null) {
                assertion(ctx, problem, matcher, message, "throws", ex);
            }
            unprotect(ctx, message);
        } else if (!throws_method && has_matcher && !matched) {
            // doesNotThrow only reports errors it was asked about; others propagate unchanged.
            deref ex = problem;
        } else if (!throws_method) {
            var unwanted: ptr<u8> = compose_message(ctx, state, "Got unwanted exception", undefined(ctx), message, ex);
            if (deref ex == null) {
                protect(ctx, unwanted);
                assertion(ctx, problem, matcher, unwanted, "doesNotThrow", ex);
                unprotect(ctx, unwanted);
            }
        }
    }
    unprotect(ctx, problem);
}
// Node-style text for assertions raised without a message. Primitive comparisons use Node's
// layout; objects fall back to "<actual> <operator> <expected>" because no diff is rendered.
fun generated_text(ctx: ptr<u8>, state: ptr<AssertState>, actual: ptr<u8>, expected: ptr<u8>, operation: str,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (same_operation(operation, "fail")) {
        return text(ctx, "Failed");
    }
    var left: ptr<u8> = inspected(ctx, actual, ex);
    protect(ctx, left);
    var result: ptr<u8> = undefined(ctx);
    if (same_operation(operation, "strictEqual") || same_operation(operation, "deepStrictEqual")) {
        var head: str = "Expected values to be strictly equal:\n\n";
        if (same_operation(operation, "deepStrictEqual")) {
            head = "Expected values to be strictly deep-equal:\n\n";
        }
        var parts: array<ptr<u8>, 4> = [left, text(ctx, " !== "), inspected(ctx, expected, ex), text(ctx, "\n")];
        result = join_text(ctx, state, text(ctx, head), 4, &parts[0], ex);
    } else if (same_operation(operation, "notStrictEqual") || same_operation(operation, "notDeepStrictEqual")) {
        var head: str = "Expected \"actual\" to be strictly unequal to: ";
        if (same_operation(operation, "notDeepStrictEqual")) {
            head = "Expected \"actual\" not to be strictly deep-equal to: ";
        }
        var parts: array<ptr<u8>, 1> = [inspected(ctx, expected, ex)];
        result = join_text(ctx, state, text(ctx, head), 1, &parts[0], ex);
    } else if (same_operation(operation, "==")) {
        var parts: array<ptr<u8>, 2> = [left, text(ctx, ")\n")];
        result = join_text(ctx, state, text(ctx, "The expression evaluated to a falsy value:\n\n  assert.ok("), 2,
            &parts[0], ex);
    } else if (same_operation(operation, "ifError")) {
        var shown: ptr<u8> = left;
        if (kind(ctx, actual) == TYPE_OBJECT && deref ex == null) {
            var own: ptr<u8> = get(ctx, actual, "message", ex);
            if (deref ex == null && kind(ctx, own) == TYPE_STRING) {
                shown = own;
            }
        }
        var parts: array<ptr<u8>, 1> = [shown];
        result = join_text(ctx, state, text(ctx, "ifError got unwanted exception: "), 1, &parts[0], ex);
    } else {
        var parts: array<ptr<u8>, 4> = [text(ctx, " "), text(ctx, operation), text(ctx, " "), inspected(ctx, expected, ex)];
        result = join_text(ctx, state, left, 4, &parts[0], ex);
    }
    unprotect(ctx, left);
    return result;
}

fun same_operation(a: str, b: str) -> bool {
    var left: ptr<u8> = a as ptr<u8>;
    var right: ptr<u8> = b as ptr<u8>;
    var i: i64 = 0;
    while (left[i] != 0 && right[i] != 0) {
        if (left[i] != right[i]) {
            return false;
        }
        i += 1;
    }
    return left[i] == right[i];
}

// --- assert.match / assert.doesNotMatch ---------------------------------------------------------

fun string_of(ctx: ptr<u8>, state: ptr<AssertState>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var argument: array<ptr<u8>, 1> = [value];
    return call(ctx, matcher_fn(state, M_STRING), null, 1, &argument[0], ex);
}

fun inspected(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var argument: array<ptr<u8>, 1> = [value];
    var result: ptr<u8> = inspect_to_value(ctx, 1, &argument[0], ex);
    if (result == null) {
        return text(ctx, "undefined");
    }
    return result;
}

// The message of the TypeError that invalid_argument_type would throw, used as the generated
// message of an AssertionError for a non-string input.
fun argument_message(ctx: ptr<u8>, prefix: str, expected: str, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var problem: ptr<u8> = null;
    invalid_argument_type(ctx, &problem, prefix, expected, value);
    if (problem == null) {
        return text(ctx, "invalid argument");
    }
    return get(ctx, problem, "message", ex);
}

fun run_match(ctx: ptr<u8>, state: ptr<AssertState>, negate: bool, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) {
    var subject: ptr<u8> = undefined(ctx);
    var pattern: ptr<u8> = undefined(ctx);
    var message: ptr<u8> = undefined(ctx);
    if (count > 0) {
        subject = args[0];
    }
    if (count > 1) {
        pattern = args[1];
    }
    if (count > 2) {
        message = args[2];
    }
    if (!is_regexp(ctx, state, pattern, ex)) {
        if (deref ex == null) {
            invalid_argument_type(ctx, ex, "The \"regexp\" argument", "an instance of RegExp", pattern);
        }
        return;
    }
    var operation: str = "match";
    if (negate) {
        operation = "doesNotMatch";
    }
    var generated: bool = kind(ctx, message) != TYPE_STRING;
    if (kind(ctx, subject) != TYPE_STRING) {
        var problem: ptr<u8> = message;
        if (generated) {
            problem = argument_message(ctx, "The \"string\" argument", "of type string", subject, ex);
        }
        if (deref ex == null) {
            assertion_flagged(ctx, subject, pattern, problem, generated, operation, ex);
        }
        return;
    }
    var matched: bool = regexp_matches(ctx, state, pattern, subject, ex);
    if (deref ex != null || (matched && !negate) || (!matched && negate)) {
        return;
    }
    var report: ptr<u8> = message;
    if (generated) {
        var head: str = "The input did not match the regular expression ";
        if (negate) {
            head = "The input was expected to not match the regular expression ";
        }
        var source: ptr<u8> = string_of(ctx, state, pattern, ex);
        protect(ctx, source);
        var parts: array<ptr<u8>, 3> = [source, text(ctx, ". Input:\n\n"), inspected(ctx, subject, ex)];
        var composed: ptr<u8> = join_text(ctx, state, text(ctx, head), 3, &parts[0], ex);
        unprotect(ctx, source);
        if (deref ex != null) {
            return;
        }
        var newline: array<ptr<u8>, 1> = [text(ctx, "\n")];
        report = join_text(ctx, state, composed, 1, &newline[0], ex);
    }
    if (deref ex == null) {
        protect(ctx, report);
        assertion_flagged(ctx, subject, pattern, report, generated, operation, ex);
        unprotect(ctx, report);
    }
}

// --- assert.rejects / assert.doesNotReject ----------------------------------------------------

// The outer Promise returned to the caller is settled through resolve/reject kept in a record that
// the reaction handlers receive as their receiver. The record is reachable from the bound handlers
// held by the awaited promise, so it needs no protection once the handlers are attached.
fun settle_rejected(ctx: ptr<u8>, reject: ptr<u8>, reason: ptr<u8>) {
    var ignored: ptr<u8> = null;
    var argument: array<ptr<u8>, 1> = [reason];
    call(ctx, reject, null, 1, &argument[0], &ignored);
}

fun fail_return_value(ctx: ptr<u8>, state: ptr<AssertState>, ex: ptr<ptr<u8>>, value: ptr<u8>) {
    var description: ptr<u8> = received_description(ctx, value);
    protect(ctx, description);
    var parts: array<ptr<u8>, 2> = [description, text(ctx, ".")];
    var report: ptr<u8> = join_text(ctx, state, text(ctx, "Expected instance of Promise to be returned from the \"promiseFn\" function but got "), 2, &parts[0], ex);
    unprotect(ctx, description);
    fail_dynamic(ctx, ex, 1, "ERR_INVALID_RETURN_VALUE", report);
}

fun rejection_input(ctx: ptr<u8>, state: ptr<AssertState>, source: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, source) == TYPE_OBJECT && callable(ctx, source)) {
        var problem: ptr<u8> = null;
        var produced: ptr<u8> = call(ctx, source, null, 0, null, &problem);
        if (problem != null) {
            deref ex = problem;
            return null;
        }
        if (produced == null || !is_promise(ctx, produced)) {
            fail_return_value(ctx, state, ex, produced);
            return null;
        }
        return produced;
    }
    if (kind(ctx, source) == TYPE_OBJECT && is_promise(ctx, source)) {
        return source;
    }
    invalid_argument_type(ctx, ex, "The \"promiseFn\" argument", "of type function or an instance of Promise", source);
    return null;
}

fun run_rejects(ctx: ptr<u8>, state: ptr<AssertState>, negate: bool, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var resolve: ptr<u8> = null;
    var reject: ptr<u8> = null;
    var outer: ptr<u8> = promise(ctx, &resolve, &reject, ex);
    if (deref ex != null || outer == null) {
        return undefined(ctx);
    }
    protect(ctx, outer);
    protect(ctx, resolve);
    protect(ctx, reject);
    var matcher: ptr<u8> = undefined(ctx);
    var message: ptr<u8> = undefined(ctx);
    if (count > 1 && kind(ctx, args[1]) == TYPE_STRING) {
        message = args[1];
    } else if (count > 1 && kind(ctx, args[1]) != TYPE_UNDEFINED) {
        matcher = args[1];
        if (count > 2) {
            message = args[2];
        }
    }
    var source: ptr<u8> = undefined(ctx);
    if (count > 0) {
        source = args[0];
    }
    var problem: ptr<u8> = null;
    var awaited: ptr<u8> = rejection_input(ctx, state, source, &problem);
    if (problem != null || awaited == null) {
        if (problem != null) {
            settle_rejected(ctx, reject, problem);
        }
    } else {
        var record: ptr<u8> = plain(ctx);
        protect(ctx, record);
        var link: ptr<u8> = null;
        put_record(ctx, record, resolve, reject, matcher, message, negate, &link);
        var on_fulfilled: ptr<u8> = bind_one(ctx, deref state.on_fulfilled, record, undefined(ctx), &link);
        protect(ctx, on_fulfilled);
        var on_rejected: ptr<u8> = bind_one(ctx, deref state.on_rejected, record, undefined(ctx), &link);
        protect(ctx, on_rejected);
        var then: ptr<u8> = get(ctx, awaited, "then", &link);
        if (link == null) {
            var handlers: array<ptr<u8>, 2> = [on_fulfilled, on_rejected];
            call(ctx, then, awaited, 2, &handlers[0], &link);
        }
        if (link != null) {
            settle_rejected(ctx, reject, link);
        }
        unprotect(ctx, on_rejected);
        unprotect(ctx, on_fulfilled);
        unprotect(ctx, record);
    }
    unprotect(ctx, reject);
    unprotect(ctx, resolve);
    unprotect(ctx, outer);
    return outer;
}

fun put_record(ctx: ptr<u8>, record: ptr<u8>, resolve: ptr<u8>, reject: ptr<u8>, matcher: ptr<u8>, message: ptr<u8>,
    negate: bool, ex: ptr<ptr<u8>>) {
    define(ctx, record, "resolve", resolve, ex, true);
    define(ctx, record, "reject", reject, ex, true);
    define(ctx, record, "matcher", matcher, ex, true);
    define(ctx, record, "message", message, ex, true);
    define(ctx, record, "negate", boolean(ctx, negate), ex, true);
}

fun call_settler(ctx: ptr<u8>, record: ptr<u8>, name: str, value: ptr<u8>) {
    var ignored: ptr<u8> = null;
    var settler: ptr<u8> = get(ctx, record, name, &ignored);
    var argument: array<ptr<u8>, 1> = [value];
    call(ctx, settler, null, 1, &argument[0], &ignored);
}

// Handler for a fulfilled input: rejects() fails with "Missing expected rejection", doesNotReject()
// succeeds.
fun rejection_missing(ctx: ptr<u8>, state: ptr<AssertState>, record: ptr<u8>, ex: ptr<ptr<u8>>) {
    var negate: ptr<u8> = get(ctx, record, "negate", ex);
    if (truth(ctx, negate)) {
        call_settler(ctx, record, "resolve", undefined(ctx));
        return;
    }
    var matcher: ptr<u8> = get(ctx, record, "matcher", ex);
    var message: ptr<u8> = get(ctx, record, "message", ex);
    var report: ptr<u8> = compose_message(ctx, state, "Missing expected rejection", matcher, message, ex);
    if (deref ex != null) {
        return;
    }
    protect(ctx, report);
    var problem: ptr<u8> = null;
    assertion_flagged(ctx, undefined(ctx), matcher, report, false, "rejects", &problem);
    unprotect(ctx, report);
    if (problem != null) {
        call_settler(ctx, record, "reject", problem);
    }
}

// Handler for a rejected input.
fun rejection_received(ctx: ptr<u8>, state: ptr<AssertState>, record: ptr<u8>, reason: ptr<u8>,
    ex: ptr<ptr<u8>>) {
    var negate: bool = truth(ctx, get(ctx, record, "negate", ex));
    var matcher: ptr<u8> = get(ctx, record, "matcher", ex);
    var message: ptr<u8> = get(ctx, record, "message", ex);
    if (deref ex != null) {
        return;
    }
    var has_matcher: bool = kind(ctx, matcher) == TYPE_OBJECT;
    var matched: bool = true;
    if (has_matcher) {
        matched = error_matches(ctx, state, reason, matcher, ex);
    }
    if (deref ex != null) {
        return;
    }
    var problem: ptr<u8> = null;
    if (!negate) {
        if (matched) {
            call_settler(ctx, record, "resolve", undefined(ctx));
            return;
        }
        var report: ptr<u8> = message;
        if (kind(ctx, report) != TYPE_STRING) {
            if (is_error_class(ctx, state, matcher, ex)) {
                report = instance_message(ctx, state, reason, matcher, ex);
            } else {
                report = text(ctx, "The error did not match the expected matcher.");
            }
        }
        protect(ctx, report);
        assertion_flagged(ctx, reason, matcher, report, kind(ctx, message) != TYPE_STRING, "rejects", &problem);
        unprotect(ctx, report);
    } else if (has_matcher && !matched) {
        // A rejection the caller did not ask about passes through unchanged.
        call_settler(ctx, record, "reject", reason);
        return;
    } else {
        var base: ptr<u8> = compose_message(ctx, state, "Got unwanted rejection", undefined(ctx), message, ex);
        protect(ctx, base);
        var detail: ptr<u8> = undefined(ctx);
        if (kind(ctx, reason) == TYPE_OBJECT) {
            detail = get(ctx, reason, "message", ex);
        }
        var parts: array<ptr<u8>, 3> = [text(ctx, "\nActual message: \""), detail, text(ctx, "\"")];
        var report: ptr<u8> = join_text(ctx, state, base, 3, &parts[0], ex);
        unprotect(ctx, base);
        if (deref ex != null) {
            return;
        }
        protect(ctx, report);
        assertion_flagged(ctx, reason, matcher, report, false, "doesNotReject", &problem);
        unprotect(ctx, report);
    }
    if (problem != null) {
        call_settler(ctx, record, "reject", problem);
    }
}

// --- AssertionError constructor -------------------------------------------------------------

fun same_text_value(ctx: ptr<u8>, value: ptr<u8>, expected: str) -> bool {
    if (kind(ctx, value) != TYPE_STRING) {
        return false;
    }
    var key: ptr<u8> = text(ctx, expected);
    return equal(ctx, value, key);
}

// new assert.AssertionError({ message, actual, expected, operator }). Without a message the text is
// "<actual> <operator> <expected>", with Node's wording for primitive strictEqual mismatches.
export(c) fun jsrt_assert_construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var state: ptr<AssertState> = assert_storage(ctx);
    var options: ptr<u8> = undefined(ctx);
    if (count > 0) {
        options = args[0];
    }
    if (kind(ctx, options) != TYPE_OBJECT || callable(ctx, options)) {
        invalid_argument_type(ctx, ex, "The \"options\" argument", "of type object", options);
        return undefined(ctx);
    }
    var message: ptr<u8> = get(ctx, options, "message", ex);
    var actual: ptr<u8> = get(ctx, options, "actual", ex);
    var expected: ptr<u8> = get(ctx, options, "expected", ex);
    var operator: ptr<u8> = get(ctx, options, "operator", ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    var generated: bool = kind(ctx, message) == TYPE_UNDEFINED || kind(ctx, message) == TYPE_NULL;
    var report: ptr<u8> = message;
    if (generated) {
        var left: ptr<u8> = inspected(ctx, actual, ex);
        protect(ctx, left);
        var right: ptr<u8> = inspected(ctx, expected, ex);
        protect(ctx, right);
        if (same_text_value(ctx, operator, "strictEqual")) {
            var strict: array<ptr<u8>, 4> = [left, text(ctx, " !== "), right, text(ctx, "\n")];
            report = join_text(ctx, state, text(ctx, "Expected values to be strictly equal:\n\n"), 4, &strict[0], ex);
        } else {
            var label: ptr<u8> = string_of(ctx, state, operator, ex);
            protect(ctx, label);
            var generic: array<ptr<u8>, 4> = [text(ctx, " "), label, text(ctx, " "), right];
            report = join_text(ctx, state, left, 4, &generic[0], ex);
            unprotect(ctx, label);
        }
        unprotect(ctx, right);
        unprotect(ctx, left);
    } else {
        report = string_of(ctx, state, message, ex);
    }
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, report);
    var error: ptr<u8> = make_error(ctx, 0, report, ex);
    unprotect(ctx, report);
    if (deref ex != null || error == null) {
        return undefined(ctx);
    }
    protect(ctx, error);
    prototype(ctx, error, get(ctx, ctor, "prototype", ex));
    define(ctx, error, "name", text(ctx, "AssertionError"), ex, false);
    define(ctx, error, "code", text(ctx, "ERR_ASSERTION"), ex, true);
    define(ctx, error, "actual", actual, ex, true);
    define(ctx, error, "expected", expected, ex, true);
    define(ctx, error, "operator", operator, ex, true);
    define(ctx, error, "generatedMessage", boolean(ctx, generated), ex, true);
    unprotect(ctx, error);
    return error;
}

export(c) fun jsrt_assert_api(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<AssertState> = assert_storage(ctx);
    var actual: ptr<u8> = undefined(ctx);
    var expected: ptr<u8> = undefined(ctx);
    var message: ptr<u8> = undefined(ctx);
    if (count > 0) {
        actual = args[0];
    }
    if (count > 1) {
        expected = args[1];
    }
    if (count > 2) {
        message = args[2];
    }
    if (equal(ctx, fn, (deref host_state.methods)[0])) {
        if (count == 0) {
            assertion_flagged(ctx, actual, boolean(ctx, true), text(ctx, "No value argument passed to `assert.ok()`"), true,
                "==", ex);
            return undefined(ctx);
        }
        if (!truth(ctx, actual)) {
            // Node reports ok() failures as actual == true with the second argument as the message.
            assertion(ctx, actual, boolean(ctx, true), expected, "==", ex);
        }
    } else if (equal(ctx, fn, (deref host_state.methods)[1]) || equal(ctx, fn, (deref host_state.methods)[2])) {
        if (count < 2) {
            fail(ctx, ex, 1, "strict equality requires two values");
            return undefined(ctx);
        }
        var pair: array<ptr<u8>, 2> = [actual, expected];
        var matches: bool = truth(ctx, call(ctx, (deref host_state.same), null, 2, &pair[0], ex));
        var negate: bool = equal(ctx, fn, (deref host_state.methods)[2]);
        if ((matches && negate) || (!matches && !negate)) {
            var operation: str = "strictEqual";
            if (negate) {
                operation = "notStrictEqual";
            }
            assertion(ctx, actual, expected, message, operation, ex);
        }
    } else if (equal(ctx, fn, (deref host_state.methods)[METHOD_DEEP_EQUAL]) ||
        equal(ctx, fn, (deref host_state.methods)[METHOD_NOT_DEEP_EQUAL])) {
        if (count < 2) {
            fail(ctx, ex, 1, "deep equality requires two values");
            return undefined(ctx);
        }
        var matches: bool = deep_equal(ctx, &(deref host_state.deep), actual, expected, ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        var negate: bool = equal(ctx, fn, (deref host_state.methods)[METHOD_NOT_DEEP_EQUAL]);
        if ((matches && negate) || (!matches && !negate)) {
            var operation: str = "deepStrictEqual";
            if (negate) {
                operation = "notDeepStrictEqual";
            }
            assertion(ctx, actual, expected, message, operation, ex);
        }
    } else if (equal(ctx, fn, (deref host_state.methods)[3])) {
        assertion(ctx, undefined(ctx), undefined(ctx), actual, "fail", ex);
    } else if (equal(ctx, fn, (deref host_state.methods)[METHOD_MATCH]) ||
        equal(ctx, fn, (deref host_state.methods)[METHOD_DOES_NOT_MATCH])) {
        run_match(ctx, host_state, equal(ctx, fn, (deref host_state.methods)[METHOD_DOES_NOT_MATCH]), count, args, ex);
    } else if (equal(ctx, fn, (deref host_state.methods)[METHOD_REJECTS]) ||
        equal(ctx, fn, (deref host_state.methods)[METHOD_DOES_NOT_REJECT])) {
        return run_rejects(ctx, host_state, equal(ctx, fn, (deref host_state.methods)[METHOD_DOES_NOT_REJECT]), count, args, ex);
    } else if (equal(ctx, fn, deref host_state.on_fulfilled)) {
        rejection_missing(ctx, host_state, receiver, ex);
    } else if (equal(ctx, fn, deref host_state.on_rejected)) {
        var reason: ptr<u8> = undefined(ctx);
        if (count > 1) {
            reason = args[1];
        }
        rejection_received(ctx, host_state, receiver, reason, ex);
    } else if (equal(ctx, fn, (deref host_state.methods)[6])) {
        if (kind(ctx, actual) != 0 && kind(ctx, actual) != 1) {
            assertion(ctx, actual, undefined(ctx), undefined(ctx), "ifError", ex);
        }
    } else {
        run_throws(ctx, host_state, fn, count, args, ex);
    }
    return undefined(ctx);
}

pub fun install_assert(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<AssertState> = assert_storage(ctx);
    (deref host_state.same) = capture(ctx, get(ctx, global(ctx), "Object", ex), "is", ex);
    // Matcher intrinsics are captured before user code runs, so replacing them later cannot change results.
    var root: ptr<u8> = global(ctx);
    var object_ctor: ptr<u8> = get(ctx, root, "Object", ex);
    var regexp_ctor: ptr<u8> = get(ctx, root, "RegExp", ex);
    (deref host_state.matcher)[M_IS_PROTOTYPE_OF] = capture(ctx, get(ctx, object_ctor, "prototype", ex), "isPrototypeOf", ex);
    (deref host_state.matcher)[M_REGEXP_EXEC] = capture(ctx, get(ctx, regexp_ctor, "prototype", ex), "exec", ex);
    (deref host_state.matcher)[M_REGEXP_PROTO] = capture(ctx, regexp_ctor, "prototype", ex);
    (deref host_state.matcher)[M_KEYS] = capture(ctx, object_ctor, "keys", ex);
    (deref host_state.matcher)[M_STRING] = capture(ctx, root, "String", ex);
    (deref host_state.matcher)[M_ERROR] = capture(ctx, root, "Error", ex);
    (deref host_state.matcher)[M_REFLECT_GET] = capture(ctx, get(ctx, root, "Reflect", ex), "get", ex);
    (deref host_state.matcher)[M_CONCAT] = capture(ctx, get(ctx, get(ctx, root, "String", ex), "prototype", ex), "concat", ex);
    if (deref ex != null) {
        return false;
    }
    var names: array<str, 13> = ["ok", "strictEqual", "notStrictEqual", "fail", "throws", "doesNotThrow",
        "ifError", "deepStrictEqual", "notDeepStrictEqual", "match", "doesNotMatch", "rejects", "doesNotReject"];
    if (!deep_install(ctx, &(deref host_state.deep), ex)) {
        return false;
    }
    for (var i: i64 = 0; i < METHOD_COUNT; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref host_state.methods)[i] = function(ctx, name, callback());
        release(name);
        protect(ctx, (deref host_state.methods)[i]);
    }
    for (var i: i64 = 0; i < METHOD_COUNT; i++) {
        define(ctx, (deref host_state.methods)[0], names[i], (deref host_state.methods)[i], ex, false);
    }
    var handler_name: ptr<u8> = utf8("onFulfilled");
    deref host_state.on_fulfilled = function(ctx, handler_name, callback());
    release(handler_name);
    protect(ctx, deref host_state.on_fulfilled);
    handler_name = utf8("onRejected");
    deref host_state.on_rejected = function(ctx, handler_name, callback());
    release(handler_name);
    protect(ctx, deref host_state.on_rejected);
    install_assertion_error(ctx, host_state, ex);
    define(ctx, (deref host_state.methods)[0], "strict", (deref host_state.methods)[0], ex, false);
    define(ctx, (deref host_state.methods)[0], "equal", (deref host_state.methods)[1], ex, false);
    define(ctx, (deref host_state.methods)[0], "notEqual", (deref host_state.methods)[2], ex, false);
    // Like equal/notEqual above, the loose names alias the strict behavior.
    define(ctx, (deref host_state.methods)[0], "deepEqual", (deref host_state.methods)[METHOD_DEEP_EQUAL], ex, false);
    define(ctx, (deref host_state.methods)[0], "notDeepEqual", (deref host_state.methods)[METHOD_NOT_DEEP_EQUAL], ex, false);
    return deref ex == null;
}

// AssertionError inherits from Error.prototype and is exposed as assert.AssertionError.
fun install_assertion_error(ctx: ptr<u8>, state: ptr<AssertState>, ex: ptr<ptr<u8>>) {
    var ctor: ptr<u8> = public_constructor(ctx, ctor_callback(), "AssertionError", ex);
    if (deref ex != null) {
        return;
    }
    protect(ctx, ctor);
    deref state.ctor = ctor;
    var shared: ptr<u8> = get(ctx, ctor, "prototype", ex);
    protect(ctx, shared);
    deref state.class_prototype = shared;
    prototype(ctx, shared, get(ctx, matcher_fn(state, M_ERROR), "prototype", ex));
    define(ctx, shared, "constructor", ctor, ex, false);
    define(ctx, (deref state.methods)[0], "AssertionError", ctor, ex, false);
}

pub fun assert_module() -> ptr<u8> {
    var host_state: ptr<AssertState> = assert_storage(active_context());
    return(deref host_state.methods)[0];
}

pub fun shutdown_assert(ctx: ptr<u8>) {
    var host_state: ptr<AssertState> = assert_storage(ctx);
    if (deref host_state.ctor != null) {
        unprotect(ctx, deref host_state.ctor);
        deref host_state.ctor = null;
    }
    if (deref host_state.class_prototype != null) {
        unprotect(ctx, deref host_state.class_prototype);
        deref host_state.class_prototype = null;
    }
    if (deref host_state.on_fulfilled != null) {
        unprotect(ctx, deref host_state.on_fulfilled);
        deref host_state.on_fulfilled = null;
    }
    if (deref host_state.on_rejected != null) {
        unprotect(ctx, deref host_state.on_rejected);
        deref host_state.on_rejected = null;
    }
    if ((deref host_state.same) != null) {
        unprotect(ctx, (deref host_state.same));
        (deref host_state.same) = null;
    }
    deep_release(ctx, &(deref host_state.deep));
    for (var i: i64 = 0; i < MATCHER_COUNT; i++) {
        if ((deref host_state.matcher)[i] != null) {
            unprotect(ctx, (deref host_state.matcher)[i]);
            (deref host_state.matcher)[i] = null;
        }
    }
    for (var i: i64 = 0; i < METHOD_COUNT; i++) {
        if ((deref host_state.methods)[i] != null) {
            unprotect(ctx, (deref host_state.methods)[i]);
            (deref host_state.methods)[i] = null;
        }
    }
}
