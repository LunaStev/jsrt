import("./context_state")::{owned_context_slot, active_context};
import("std::mem::layout")::{size_of};
struct AssertState {
    methods: array<ptr<u8>, 7>;
    same: ptr<u8>;
}

fun assert_storage(ctx: ptr<u8>) -> ptr<AssertState> {
    return owned_context_slot(ctx, 9, size_of<AssertState>() as i64) as ptr<AssertState>;
}

// A strict assertion subset. Preserve original exceptions and inspect no values implicitly.
import("./values")::{get, text, define, capture, fail};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_assert_callback") fun callback() -> ptr<u8>;

fun assertion(ctx: ptr<u8>, actual: ptr<u8>, expected: ptr<u8>, message: ptr<u8>, operation: str, ex: ptr<ptr<u8>>) {
    var error: ptr<u8> = null;
    fail(ctx, &error, 0, "assertion failed");
    protect(ctx, error);
    define(ctx, error, "name", text(ctx, "AssertionError"), ex, false);
    define(ctx, error, "code", text(ctx, "ERR_ASSERTION"), ex, true);
    define(ctx, error, "actual", actual, ex, true);
    define(ctx, error, "expected", expected, ex, true);
    define(ctx, error, "operator", text(ctx, operation), ex, true);
    if (kind(ctx, message) == 4) {
        define(ctx, error, "message", message, ex, false);
    }
    if (deref ex == null) {
        deref ex = error;
    }
    unprotect(ctx, error);
}

export(c) fun jsrt_assert_api(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<AssertState> = assert_storage(ctx);
    var actual: ptr<u8> = undefined(ctx);
    var expected: ptr<u8> = undefined(ctx);
    var message: ptr<u8> = undefined(ctx);
    if (count > 0) {
        actual = args[0];
    }
    if (count > 1) {
        expected = args[1];
    }
    if (count > 2) {
        message = args[2];
    }
    if (equal(ctx, fn, (deref host_state.methods)[0])) {
        if (!truth(ctx, actual)) {
            assertion(ctx, actual, expected, expected, "ok", ex);
        }
    } else if (equal(ctx, fn, (deref host_state.methods)[1]) || equal(ctx, fn, (deref host_state.methods)[2])) {
        if (count < 2) {
            fail(ctx, ex, 1, "strict equality requires two values");
            return undefined(ctx);
        }
        var pair: array<ptr<u8>, 2> = [actual, expected];
        var matches: bool = truth(ctx, call(ctx, (deref host_state.same), null, 2, &pair[0], ex));
        var negate: bool = equal(ctx, fn, (deref host_state.methods)[2]);
        if ((matches && negate) || (!matches && !negate)) {
            var operation: str = "strictEqual";
            if (negate) {
                operation = "notStrictEqual";
            }
            assertion(ctx, actual, expected, message, operation, ex);
        }
    } else if (equal(ctx, fn, (deref host_state.methods)[3])) {
        assertion(ctx, undefined(ctx), undefined(ctx), actual, "fail", ex);
    } else if (equal(ctx, fn, (deref host_state.methods)[6])) {
        if (kind(ctx, actual) != 0 && kind(ctx, actual) != 1) {
            assertion(ctx, actual, undefined(ctx), undefined(ctx), "ifError", ex);
        }
    } else {
        if (count == 0 || kind(ctx, actual) != 5 || !callable(ctx, actual)) {
            fail(ctx, ex, 1, "assertion requires a function");
            return undefined(ctx);
        }
        if (count > 1 && kind(ctx, expected) != 4) {
            fail(ctx, ex, 1, "exception matchers are not implemented; use a message string");
            return undefined(ctx);
        }
        var problem: ptr<u8> = null;
        call(ctx, actual, null, 0, null, &problem);
        if (equal(ctx, fn, (deref host_state.methods)[4]) && problem == null) {
            assertion(ctx, undefined(ctx), undefined(ctx), expected, "throws", ex);
        } else if (equal(ctx, fn, (deref host_state.methods)[5]) && problem != null) {
            deref ex = problem;
        }
    }
    return undefined(ctx);
}

pub fun install_assert(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<AssertState> = assert_storage(ctx);
    (deref host_state.same) = capture(ctx, get(ctx, global(ctx), "Object", ex), "is", ex);
    var names: array<str, 7> = ["ok", "strictEqual", "notStrictEqual", "fail", "throws", "doesNotThrow",
        "ifError"];
    for (var i: i64 = 0; i < 7; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref host_state.methods)[i] = function(ctx, name, callback());
        release(name);
        protect(ctx, (deref host_state.methods)[i]);
    }
    for (var i: i64 = 0; i < 7; i++) {
        define(ctx, (deref host_state.methods)[0], names[i], (deref host_state.methods)[i], ex, false);
    }
    define(ctx, (deref host_state.methods)[0], "strict", (deref host_state.methods)[0], ex, false);
    define(ctx, (deref host_state.methods)[0], "equal", (deref host_state.methods)[1], ex, false);
    define(ctx, (deref host_state.methods)[0], "notEqual", (deref host_state.methods)[2], ex, false);
    return deref ex == null;
}

pub fun assert_module() -> ptr<u8> {
    var host_state: ptr<AssertState> = assert_storage(active_context());
    return(deref host_state.methods)[0];
}

pub fun shutdown_assert(ctx: ptr<u8>) {
    var host_state: ptr<AssertState> = assert_storage(ctx);
    if ((deref host_state.same) != null) {
        unprotect(ctx, (deref host_state.same));
        (deref host_state.same) = null;
    }
    for (var i: i64 = 0; i < 7; i++) {
        if ((deref host_state.methods)[i] != null) {
            unprotect(ctx, (deref host_state.methods)[i]);
            (deref host_state.methods)[i] = null;
        }
    }
}
