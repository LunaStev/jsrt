// CommonJS module cache, execution and host lifetime. Resolution is delegated.
import("./module_state")::{modules_storage, Module, ModulesState, PATH_CAP};
import("./module_support")::{text, get, define, error, missing, annotate, builtin};
import("./querystring")::{querystring_module};
import("./workers")::{worker_module};
import("./module_files")::{ends, canonical, parsed_file};
import("./module_packages")::{commonjs_scope, esm_scope};
import("./module_resolver")::{resolve_path};
import("./module_compile")::{compile_module};
import("./esm_files")::{file_source_url};
import("./system")::{read_text_file, copy_host_path};
import("./http_server")::{http_module};
import("./buffer")::{buffer_module};
import("./events")::{events_module};
import("./streams")::{streams_module};
import("./web_streams")::{web_streams_module};
import("./timers_promises")::{timers_promises_module};
import("./stream_utils")::{stream_promises_module};
import("./http_client")::{https_module};
import("./path")::{path_module};
import("./os")::{os_module};
import("./util")::{util_module};
import("./assert")::{assert_module};
import("./crypto")::{crypto_module};
import("./url")::{url_module};
import("./child_process")::{child_process_module};
import("./addons")::{load_addon};
import("./config")::{MODULE_LIMIT, DEPTH_LIMIT};
import("std::env::cwd")::{env_getcwd};
import("std::path::copy")::{path_join2, path_dirname_copy};
import("std::mem::alloc")::{mem_alloc, mem_alloc_zeroed, mem_free};
import("std::mem::layout")::{size_of};
import("std::mem::cstr")::{mem_eq_cstr};
extern(c, "wr_context_global") fun wr_context_global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_object") fun wr_object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_undefined") fun wr_undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_boolean") fun wr_boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_delete") fun wr_delete(ctx: ptr<u8>, object: ptr<u8>, name: ptr<u8>, ex: ptr<ptr<u8>>) -> bool;
extern(c, "wr_protect") fun wr_protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun wr_unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_to_string") fun wr_to_string(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun wr_string_utf8(text: str) -> ptr<u8>;
extern(c, "wr_string_release") fun wr_string_release(text: ptr<u8>);
extern(c, "wr_function") fun wr_function(ctx: ptr<u8>, name: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_call") fun wr_call(ctx: ptr<u8>, function: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_module_callback") fun jsrt_module_callback(resolve_only: i32) -> ptr<u8>;

fun native(ctx: ptr<u8>, name: str, resolving: i32) -> ptr<u8> {
    var key: ptr<u8> = wr_string_utf8(name);
    var result: ptr<u8> = wr_function(ctx, key, jsrt_module_callback(resolving));
    wr_string_release(key);
    return result;
}

fun create_module(ctx: ptr<u8>, path: ptr<u8>, main: bool, ex: ptr<ptr<u8>>) -> ptr<Module> {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    var modules_record: ptr<Module> = deref host_state.modules;
    if ((deref host_state.count) >= MODULE_LIMIT) {
        error(ctx, ex, 2, "module record limit exceeded (1024)", "ERR_MODULE_LIMIT");
        return null;
    }
    var record: ptr<Module> = (deref host_state.modules) + (deref host_state.count);
    (deref host_state.count) += 1;
    deref record.path = path;
    deref record.directory = mem_alloc(PATH_CAP);
    if (deref record.directory == null || path_dirname_copy(deref record.directory, 8192, path as str) < 0) {
        error(ctx, ex, 2, "cannot allocate module directory", "ERR_MODULE_LIMIT");
        return record;
    }
    deref record.object = wr_object(ctx, null, null);
    wr_protect(ctx, deref record.object);
    deref record.require_fn = native(ctx, "require", 0);
    wr_protect(ctx, deref record.require_fn);
    deref record.resolve_fn = native(ctx, "resolve", 1);
    wr_protect(ctx, deref record.resolve_fn);
    var exports: ptr<u8> = wr_object(ctx, null, null);
    wr_protect(ctx, exports);
    var identifier: str = path as str;
    if (main && !(deref host_state.eval_entry)) {
        identifier = ".";
    }
    define(ctx, deref record.object, "id", text(ctx, identifier), ex, true);
    define(ctx, deref record.object, "filename", text(ctx, path as str), ex, true);
    define(ctx, deref record.object, "path", text(ctx, deref record.directory as str), ex, true);
    define(ctx, deref record.object, "exports", exports, ex, true);
    define(ctx, deref record.object, "loaded", wr_boolean(ctx, false), ex, true);
    define(ctx, deref record.object, "require", deref record.require_fn, ex, true);
    define(ctx, deref record.require_fn, "resolve", deref record.resolve_fn, ex, false);
    var main_object: ptr<u8> = deref modules_record.object;
    if ((deref host_state.eval_entry)) {
        main_object = wr_undefined(ctx);
    }
    define(ctx, deref record.require_fn, "main", main_object, ex, false);
    wr_unprotect(ctx, exports);
    deref record.cached = deref ex == null;
    return record;
}

fun execute(ctx: ptr<u8>, record: ptr<Module>, source: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    // JSC's dynamic-import hook receives SourceOrigin. An absolute filesystem
    // string is not a file URL; supply the encoded origin for CommonJS as well.
    var url: ptr<u8> = file_source_url(ctx, deref record.path as str, ex);
    var function: ptr<u8> = null;
    if (url != null && deref ex == null) {
        function = compile_module(ctx, source, url, ex);
    }
    if (url != null) {
        wr_string_release(url);
    }
    if (function == null || deref ex != null) {
        deref record.cached = false;
        if (deref ex != null) {
            annotate(ctx, deref ex, deref record.path as str);
        }
        return wr_undefined(ctx);
    }
    wr_protect(ctx, function);
    var exports: ptr<u8> = get(ctx, deref record.object, "exports", ex);
    wr_protect(ctx, exports);
    var args: array<ptr<u8>, 5> = [exports, deref record.require_fn, deref record.object, text(ctx, deref record.path as str),
        null];
    wr_protect(ctx, args[3]);
    args[4] = text(ctx, deref record.directory as str);
    wr_protect(ctx, args[4]);
    (deref host_state.depth) += 1;
    if (deref ex == null) {
        wr_call(ctx, function, exports, 5, &args[0], ex);
    }
    (deref host_state.depth) -= 1;
    wr_unprotect(ctx, args[4]);
    wr_unprotect(ctx, args[3]);
    wr_unprotect(ctx, exports);
    wr_unprotect(ctx, function);
    if (deref ex == null) {
        define(ctx, deref record.object, "loaded", wr_boolean(ctx, true), ex, true);
    }
    if (deref ex != null) {
        deref record.cached = false;
        return wr_undefined(ctx);
    }
    var result: ptr<u8> = get(ctx, deref record.object, "exports", ex);
    if (deref ex != null) {
        deref record.cached = false;
    }
    return result;
}

fun load(ctx: ptr<u8>, path: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    for (var i: i64 = 0; i < (deref host_state.count); i++) {
        var record: ptr<Module> = (deref host_state.modules) + i;
        if (deref record.cached && mem_eq_cstr(deref record.path as str, path as str)) {
            mem_free(path, PATH_CAP);
            return get(ctx, deref record.object, "exports", ex);
        }
    }
    if (ends(path as str, ".mjs")) {
        mem_free(path, PATH_CAP);
        error(ctx, ex, 0, "require() cannot load an ES module; use import()", "ERR_REQUIRE_ESM");
        return wr_undefined(ctx);
    }
    if ((deref host_state.depth) >= DEPTH_LIMIT) {
        mem_free(path, PATH_CAP);
        error(ctx, ex, 2, "module loading depth exceeded (128)", "ERR_MODULE_LIMIT");
        return wr_undefined(ctx);
    }
    if (!ends(path as str, ".node") && !commonjs_scope(ctx, path as str, ex)) {
        mem_free(path, PATH_CAP);
        return wr_undefined(ctx);
    }
    var record: ptr<Module> = create_module(ctx, path, false, ex);
    if (record == null) {
        mem_free(path, PATH_CAP);
        return wr_undefined(ctx);
    }
    if (deref ex != null) {
        return wr_undefined(ctx);
    }
    if (ends(path as str, ".node")) {
        var exports: ptr<u8> = get(ctx, deref record.object, "exports", ex);
        wr_protect(ctx, exports);
        var value: ptr<u8> = load_addon(ctx, path as str, exports, ex);
        if (deref ex == null) {
            wr_protect(ctx, value);
            define(ctx, deref record.object, "exports", value, ex, true);
            define(ctx, deref record.object, "loaded", wr_boolean(ctx, true), ex, true);
            wr_unprotect(ctx, value);
        }
        wr_unprotect(ctx, exports);
        if (deref ex != null) {
            deref record.cached = false;
        }
        return value;
    }
    if (ends(path as str, ".json")) {
        var value: ptr<u8> = parsed_file(ctx, path as str, ex);
        if (deref ex == null) {
            wr_protect(ctx, value);
            define(ctx, deref record.object, "exports", value, ex, true);
            define(ctx, deref record.object, "loaded", wr_boolean(ctx, true), ex, true);
            wr_unprotect(ctx, value);
        }
        if (deref ex != null) {
            deref record.cached = false;
        }
        return value;
    }
    var path_value: ptr<u8> = text(ctx, path as str);
    wr_protect(ctx, path_value);
    var source_value: ptr<u8> = read_text_file(ctx, path_value, ex);
    wr_unprotect(ctx, path_value);
    if (deref ex != null) {
        deref record.cached = false;
        return wr_undefined(ctx);
    }
    wr_protect(ctx, source_value);
    var source: ptr<u8> = wr_to_string(ctx, source_value, ex);
    var result: ptr<u8> = execute(ctx, record, source, ex);
    wr_string_release(source);
    wr_unprotect(ctx, source_value);
    return result;
}

// ESM synthetic records reuse the CommonJS/JSON cache and Wave loading policy.
pub fun load_esm_dependency(ctx: ptr<u8>, request: str, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var index: i64 = builtin(request);
    if (index >= 0) {
        var host_state: ptr<ModulesState> = modules_storage(ctx);
        return (deref host_state.builtins)[index];
    }
    var path: ptr<u8> = canonical(request);
    if (path == null) {
        missing(ctx, request, ex);
        return wr_undefined(ctx);
    }
    return load(ctx, path, ex);
}

fun dispatch(ctx: ptr<u8>, function: ptr<u8>, argc: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>, resolving: bool) -> ptr<u8> {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    if (argc < 1) {
        error(ctx, ex, 1, "require expects a module name", "ERR_INVALID_ARG_TYPE");
        return wr_undefined(ctx);
    }
    var parent: ptr<Module> = null;
    for (var i: i64 = 0; i < (deref host_state.count); i++) {
        var record: ptr<Module> = (deref host_state.modules) + i;
        if ((!resolving && deref record.require_fn == function) || (resolving && deref record.resolve_fn == function)) {
            parent = record;
            break;
        }
    }
    if (parent == null) {
        error(ctx, ex, 0, "unknown require context", "ERR_INVALID_MODULE_CONTEXT");
        return wr_undefined(ctx);
    }
    var request: array<u8, 8192>;
    if (copy_host_path(ctx, args[0], &request[0], PATH_CAP, ex) < 0) {
        return wr_undefined(ctx);
    }
    var index: i64 = builtin(&request[0] as str);
    if (index >= 0) {
        if (resolving) {
            return text(ctx, &request[0] as str);
        }
        return (deref host_state.builtins)[index];
    }
    if (request[0] == 110 && request[1] == 111 && request[2] == 100 && request[3] == 101 && request[4] == 58) {
        error(ctx, ex, 0, "unknown built-in module", "ERR_UNKNOWN_BUILTIN_MODULE");
        return wr_undefined(ctx);
    }
    var path: ptr<u8> = resolve_path(ctx, parent, &request[0] as str, ex);
    if (path == null) {
        if (deref ex == null) {
            missing(ctx, &request[0] as str, ex);
        }
        return wr_undefined(ctx);
    }
    var mapped_builtin: i64 = builtin(path as str);
    if (mapped_builtin >= 0) {
        var result: ptr<u8> = (deref host_state.builtins)[mapped_builtin];
        if (resolving) {
            result = text(ctx, path as str);
        }
        mem_free(path, PATH_CAP);
        return result;
    }
    if (resolving) {
        var result: ptr<u8> = text(ctx, path as str);
        mem_free(path, PATH_CAP);
        return result;
    }
    return load(ctx, path, ex);
}

export(c) fun jsrt_require(ctx: ptr<u8>, function: ptr<u8>, receiver: ptr<u8>, argc: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    return dispatch(ctx, function, argc, args, ex, false);
}

export(c) fun jsrt_resolve(ctx: ptr<u8>, function: ptr<u8>, receiver: ptr<u8>, argc: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    return dispatch(ctx, function, argc, args, ex, true);
}

fun capture_metadata(ctx: ptr<u8>, ex: ptr<ptr<u8>>) {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    var global: ptr<u8> = wr_context_global(ctx);
    var names: array<str, 4> = ["Error", "TypeError", "RangeError", "SyntaxError"];
    for (var i: i64 = 0; i < 4; i++) {
        (deref host_state.constructors)[i] = get(ctx, global, names[i], ex);
        wr_protect(ctx, (deref host_state.constructors)[i]);
    }
    var reflect: ptr<u8> = get(ctx, global, "Reflect", ex);
    (deref host_state.define_fn) = get(ctx, reflect, "defineProperty", ex);
    wr_protect(ctx, (deref host_state.define_fn));
    (deref host_state.descriptor_fn) = get(ctx, reflect, "getOwnPropertyDescriptor", ex);
    wr_protect(ctx, (deref host_state.descriptor_fn));
    (deref host_state.keys_fn) = get(ctx, get(ctx, global, "Object", ex), "keys", ex);
    wr_protect(ctx, (deref host_state.keys_fn));
}

pub fun check_commonjs(ctx: ptr<u8>, source: ptr<u8>, url: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    capture_metadata(ctx, ex);
    if (deref ex != null) {
        return false;
    }
    return compile_module(ctx, source, url, ex) != null && deref ex == null;
}

pub fun install_modules(ctx: ptr<u8>, path: str, evaluating: bool, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    (deref host_state.eval_entry) = evaluating;
    (deref host_state.count) = 0;
    (deref host_state.depth) = 0;
    (deref host_state.modules) = mem_alloc_zeroed(MODULE_LIMIT * (size_of<Module>() as i64)) as ptr<Module>;
    if ((deref host_state.modules) == null) {
        return false;
    }
    capture_metadata(ctx, ex);
    if (deref ex != null) {
        return false;
    }
    var global: ptr<u8> = wr_context_global(ctx);
    var json: ptr<u8> = get(ctx, global, "JSON", ex);
    (deref host_state.parse_fn) = get(ctx, json, "parse", ex);
    wr_protect(ctx, (deref host_state.parse_fn));
    (deref host_state.builtins)[0] = get(ctx, global, "fs", ex);
    wr_protect(ctx, (deref host_state.builtins)[0]);
    (deref host_state.builtins)[4] = get(ctx, (deref host_state.builtins)[0], "promises", ex);
    wr_protect(ctx, (deref host_state.builtins)[4]);
    (deref host_state.builtins)[5] = http_module();
    wr_protect(ctx, (deref host_state.builtins)[5]);
    (deref host_state.builtins)[6] = buffer_module(ctx);
    wr_protect(ctx, (deref host_state.builtins)[6]);
    (deref host_state.builtins)[7] = events_module(ctx);
    wr_protect(ctx, (deref host_state.builtins)[7]);
    (deref host_state.builtins)[8] = streams_module();
    wr_protect(ctx, (deref host_state.builtins)[8]);
    (deref host_state.builtins)[9] = stream_promises_module();
    wr_protect(ctx, (deref host_state.builtins)[9]);
    (deref host_state.builtins)[10] = https_module();
    wr_protect(ctx, (deref host_state.builtins)[10]);
    (deref host_state.builtins)[11] = path_module();
    wr_protect(ctx, (deref host_state.builtins)[11]);
    (deref host_state.builtins)[12] = os_module();
    wr_protect(ctx, (deref host_state.builtins)[12]);
    (deref host_state.builtins)[13] = util_module();
    wr_protect(ctx, (deref host_state.builtins)[13]);
    (deref host_state.builtins)[14] = assert_module();
    wr_protect(ctx, (deref host_state.builtins)[14]);
    (deref host_state.builtins)[15] = crypto_module();
    wr_protect(ctx, (deref host_state.builtins)[15]);
    (deref host_state.builtins)[16] = url_module();
    wr_protect(ctx, (deref host_state.builtins)[16]);
    (deref host_state.builtins)[17] = child_process_module(ctx, ex);
    wr_protect(ctx, (deref host_state.builtins)[17]);
    (deref host_state.builtins)[18] = worker_module(ctx);
    wr_protect(ctx, (deref host_state.builtins)[18]);
    (deref host_state.builtins)[19] = querystring_module(ctx, ex);
    wr_protect(ctx, (deref host_state.builtins)[19]);
    (deref host_state.builtins)[20] = web_streams_module(ctx);
    wr_protect(ctx, (deref host_state.builtins)[20]);
    (deref host_state.builtins)[21] = timers_promises_module(ctx, ex);
    wr_protect(ctx, (deref host_state.builtins)[21]);
    var fs_key: ptr<u8> = wr_string_utf8("fs");
    wr_delete(ctx, global, fs_key, ex);
    wr_string_release(fs_key);
    (deref host_state.builtins)[1] = get(ctx, global, "process", ex);
    wr_protect(ctx, (deref host_state.builtins)[1]);
    (deref host_state.builtins)[3] = get(ctx, global, "console", ex);
    wr_protect(ctx, (deref host_state.builtins)[3]);
    (deref host_state.builtins)[2] = wr_object(ctx, null, null);
    wr_protect(ctx, (deref host_state.builtins)[2]);
    var timer_names: array<str, 5> = ["setTimeout", "setInterval", "clearTimeout", "clearInterval", "queueMicrotask"];
    for (var i: i64 = 0; i < 5; i++) {
        define(ctx, (deref host_state.builtins)[2], timer_names[i], get(ctx, global, timer_names[i],
            ex), ex, true);
    }
    // The timers module also exposes the immediate functions and the promises namespace.
    var immediate_names: array<str, 2> = ["setImmediate", "clearImmediate"];
    for (var i: i64 = 0; i < 2; i++) {
        define(ctx, (deref host_state.builtins)[2], immediate_names[i], get(ctx, global, immediate_names[i],
            ex), ex, true);
    }
    define(ctx, (deref host_state.builtins)[2], "promises", (deref host_state.builtins)[21], ex, true);
    var main_path: ptr<u8> = null;
    if (evaluating) {
        main_path = mem_alloc(PATH_CAP);
        var cwd: array<u8, 8192>;
        if (main_path == null || env_getcwd(&cwd[0], PATH_CAP) < 0 || path_join2(main_path, 8192, &cwd[0] as str,
            "<eval>") < 0) {
            if (main_path != null) {
                mem_free(main_path, PATH_CAP);
            }
            return false;
        }
    } else {
        main_path = canonical(path);
    }
    if (main_path == null) {
        return false;
    }
    var main: ptr<Module> = create_module(ctx, main_path, true, ex);
    if (main == null) {
        mem_free(main_path, PATH_CAP);
        return false;
    }
    if (!evaluating && deref ex == null && esm_scope(ctx, main_path as str, ex)) {
        deref main.cached = false;
    }
    if (evaluating && deref ex == null) {
        deref main.cached = false;
        define(ctx, global, "require", deref main.require_fn, ex, true);
        define(ctx, global, "module", deref main.object, ex, true);
        define(ctx, global, "exports", get(ctx, deref main.object, "exports", ex), ex, true);
        define(ctx, global, "__filename", text(ctx, main_path as str), ex, true);
        define(ctx, global, "__dirname", text(ctx, deref main.directory as str), ex, true);
    }
    return deref ex == null;
}

pub fun execute_main_module(ctx: ptr<u8>, source: ptr<u8>, ex: ptr<ptr<u8>>) {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    var modules_record: ptr<Module> = deref host_state.modules;
    if (ends(deref modules_record.path as str, ".mjs")) {
        error(ctx, ex, 0, "ES modules cannot execute through the CommonJS entry point", "ERR_REQUIRE_ESM");
        return;
    }
    if (!commonjs_scope(ctx, deref modules_record.path as str, ex)) {
        return;
    }
    // Keep the module call nested inside a native engine callback. This lets
    // Wave mark module.loaded before JSC runs the outer API's Promise jobs.
    (deref host_state.main_source) = source;
    var dispatcher: ptr<u8> = native(ctx, "runMain", 2);
    wr_protect(ctx, dispatcher);
    wr_call(ctx, dispatcher, null, 0, null, ex);
    wr_unprotect(ctx, dispatcher);
    (deref host_state.main_source) = null;
}

export(c) fun jsrt_run_main(ctx: ptr<u8>, function: ptr<u8>, receiver: ptr<u8>, argc: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    execute(ctx, (deref host_state.modules), (deref host_state.main_source), ex);
    return wr_undefined(ctx);
}

pub fun shutdown_modules(ctx: ptr<u8>) {
    var host_state: ptr<ModulesState> = modules_storage(ctx);
    for (var i: i64 = 0; i < (deref host_state.count); i++) {
        var record: ptr<Module> = (deref host_state.modules) + i;
        if (deref record.object != null) {
            wr_unprotect(ctx, deref record.object);
        }
        if (deref record.require_fn != null) {
            wr_unprotect(ctx, deref record.require_fn);
        }
        if (deref record.resolve_fn != null) {
            wr_unprotect(ctx, deref record.resolve_fn);
        }
        if (deref record.path != null) {
            mem_free(deref record.path, PATH_CAP);
        }
        if (deref record.directory != null) {
            mem_free(deref record.directory, PATH_CAP);
        }
    }
    (deref host_state.count) = 0;
    if ((deref host_state.modules) != null) {
        mem_free((deref host_state.modules) as ptr<u8>, MODULE_LIMIT * (size_of<Module>() as i64));
