// Shared cancellation state. This module never imports EventTarget or Abort policy.
import("./context_state")::{owned_context_slot};
import("std::mem::layout")::{size_of};
pub struct AbortState {
    states: ptr<u8>;
    controllers: ptr<u8>;
    controller_ctor: ptr<u8>;
    signal_ctor: ptr<u8>;
    signal_parent: ptr<u8>;
    timer: ptr<u8>;
    array_test: ptr<u8>;
    methods: array<ptr<u8>, 12>;
}

const ABORT_SLOT: i64 = 8;
pub fun abort_storage(ctx: ptr<u8>) -> ptr<AbortState> {
    return owned_context_slot(ctx, ABORT_SLOT, size_of<AbortState>() as i64) as ptr<AbortState>;
}

import("./values")::{get, fail};
import("./collections")::{weak_get, length, at, append, remove_at, flag};
import("./config")::{EVENT_LISTENER_LIMIT};
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;

pub fun signal_state(ctx: ptr<u8>, signal: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<AbortState> = abort_storage(ctx);
    if (kind(ctx, signal) != 5) {
        fail(ctx, ex, 1, "expected an AbortSignal");
        return null;
    }
    var result: ptr<u8> = weak_get(ctx, (deref host_state.states), signal, ex);
    if (deref ex != null) {
        return null;
    }
    if (kind(ctx, result) != 5) {
        fail(ctx, ex, 1, "invalid AbortSignal receiver");
        return null;
    }
    return result;
}

pub fun is_aborted(ctx: ptr<u8>, signal: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var s: ptr<u8> = signal_state(ctx, signal, ex);
    return s != null && flag(ctx, s, "aborted", ex);
}

pub fun reason_for(ctx: ptr<u8>, signal: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<u8> = signal_state(ctx, signal, ex);
    if (s == null) {
        return undefined(ctx);
    }
    return get(ctx, s, "reason", ex);
}

pub fun subscribe(ctx: ptr<u8>, signal: ptr<u8>, cb: ptr<u8>, ex: ptr<ptr<u8>>) {
    var s: ptr<u8> = signal_state(ctx, signal, ex);
    if (s == null) {
        return;
    }
    if (flag(ctx, s, "aborted", ex)) {
        call(ctx, cb, signal, 0, null, ex);
        return;
    }
    var entries: ptr<u8> = get(ctx, s, "algorithms", ex);
    if (length(ctx, entries, ex) >= EVENT_LISTENER_LIMIT) {
        fail(ctx, ex, 2, "AbortSignal subscription limit exceeded");
        return;
    }
    append(ctx, entries, cb, ex);
}

pub fun unsubscribe(ctx: ptr<u8>, signal: ptr<u8>, cb: ptr<u8>, ex: ptr<ptr<u8>>) {
    var s: ptr<u8> = signal_state(ctx, signal, ex);
    if (s == null) {
        return;
    }
    var entries: ptr<u8> = get(ctx, s, "algorithms", ex);
    for (var i: i64 = 0; i < length(ctx, entries, ex); i++) {
        if (equal(ctx, at(ctx, entries, i, ex), cb)) {
            remove_at(ctx, entries, i, ex);
            break;
        }
    }
}
