// Captured WebIDL conversion intrinsics. Host policy and limits remain in Wave.
import("./context_state")::{owned_context_slot, context_slot, release_context_slot};
import("./values")::{get, put, plain, text, capture, fail};
import("./collections")::{list, append, length};
import("./buffer_core")::{buffer_from_bytes, buffer_view, copy_byte_view};
import("./byte_codec")::{encode_utf8, decode_bytes};
import("./config")::{BUFFER_LIMIT};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::mem::layout")::{size_of};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_to_number") fun numeric(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> f64;
extern(c, "wr_typed_type") fun typed_type(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i32;
extern(c, "wr_typed_buffer") fun backing(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_typed_offset") fun offset(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64;
extern(c, "wr_typed_length") fun byte_length(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64;
extern(c, "wr_array_buffer_length") fun buffer_length(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64;
extern(c, "wr_array") fun array(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_to_string") fun stringify(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_string_value") fun string_value(ctx: ptr<u8>, value: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "jsrt_web_public_constructor") fun callable_constructor(ctx: ptr<u8>, construct: ptr<u8>) -> ptr<u8>;
const SLOT: i64 = 42;
const ROOT_COUNT: i64 = 9;
struct State {
    roots: array<ptr<u8>, 9>;
}
fun state(ctx: ptr<u8>) -> ptr<State> {
    return context_slot(ctx, SLOT) as ptr<State>;
}
export(c) fun jsrt_web_requires_new(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    fail(ctx, ex, 1, "Web class constructor requires new");
    return undefined(ctx);
}
pub fun public_constructor(ctx: ptr<u8>, construct: ptr<u8>, name: str, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null) {
        return undefined(ctx);
    }
    var ctor: ptr<u8> = callable_constructor(ctx, construct);
    if (ctor == null) {
        fail(ctx, ex, 1, "matching callable-constructor engine ABI is unavailable");
        return undefined(ctx);
    }
    protect(ctx, ctor);
    readonly(ctx, ctor, "name", text(ctx, name), ex);
    unprotect(ctx, ctor);
    return ctor;
}
pub fun apply(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null) {
        return undefined(ctx);
    }
    var s: ptr<State> = state(ctx);
    var values: ptr<u8> = array(ctx, count, args, ex);
    protect(ctx, values);
    var call_args: array<ptr<u8>, 3> = [fn, owner, values];
    var result: ptr<u8> = call(ctx, (deref s.roots)[0], null, 3, &call_args[0], ex);
    unprotect(ctx, values);
    return result;
}
// null means this value is not a BufferSource; exceptions are never overwritten.
pub fun source_bytes(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null || kind(ctx, value) != 5) {
        return null;
    }
    var s: ptr<State> = state(ctx);
    var category: i32 = typed_type(ctx, value, ex);
    var start: i64 = 0;
    var size: i64 = 0;
    var buffer: ptr<u8> = value;
    if (category == 9) {
        size = buffer_length(ctx, value, ex);
    } else {
        var call_args: array<ptr<u8>, 1> = [value];
        if (!truth(ctx, call(ctx, (deref s.roots)[1], null, 1, &call_args[0], ex))) {
            return null;
        }
        if (category == 10) {
            buffer = call(ctx, (deref s.roots)[2], value, 0, null, ex);
            protect(ctx, buffer);
            start = numeric(ctx, call(ctx, (deref s.roots)[3], value, 0, null, ex), ex) as i64;
            size = numeric(ctx, call(ctx, (deref s.roots)[4], value, 0, null, ex), ex) as i64;
            unprotect(ctx, buffer);
        } else {
            buffer = backing(ctx, value, ex);
            start = offset(ctx, value, ex);
            size = byte_length(ctx, value, ex);
        }
    }
    if (deref ex != null) {
        return null;
    }
    if (size < 0 || size > BUFFER_LIMIT || start < 0) {
        fail(ctx, ex, 2, "BufferSource exceeds byte limit");
        return null;
    }
    protect(ctx, buffer);
    var view: ptr<u8> = buffer_view(ctx, buffer, start, size, ex);
    protect(ctx, view);
    var raw: ptr<u8> = mem_alloc(size + 1);
    var result: ptr<u8> = undefined(ctx);
    if (raw == null) {
        fail(ctx, ex, 2, "cannot allocate BufferSource snapshot");
    } else {
        if (deref ex == null && copy_byte_view(ctx, view, raw, size, ex) >= 0) {
            result = buffer_from_bytes(ctx, raw, size, ex);
        }
        mem_free(raw, size + 1);
    }
    unprotect(ctx, view);
    unprotect(ctx, buffer);
    return result;
}
pub fun dom_text(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (deref ex != null) {
        return undefined(ctx);
    }
    var source: ptr<u8> = stringify(ctx, value, ex);
    if (source == null || deref ex != null) {
        return undefined(ctx);
    }
    var converted: ptr<u8> = string_value(ctx, source);
    release(source);
    return converted;
}
pub fun usv_text(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var converted: ptr<u8> = dom_text(ctx, value, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, converted);
    var bytes: ptr<u8> = mem_alloc(BUFFER_LIMIT + 1);
    if (bytes == null) {
        fail(ctx, ex, 2, "cannot allocate Web text");
        unprotect(ctx, converted);
        return undefined(ctx);
    }
    var n: i64 = encode_utf8(ctx, converted, bytes, BUFFER_LIMIT + 1, false, ex);
    unprotect(ctx, converted);
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null && n >= 0) {
        result = decode_bytes(ctx, bytes, n, 0, ex);
    }
    mem_free(bytes, BUFFER_LIMIT + 1);
    return result;
}
pub fun iterable_method(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, value) != 5 && kind(ctx, value) != 4) {
        return undefined(ctx);
    }
    var s: ptr<State> = state(ctx);
    var call_args: array<ptr<u8>, 2> = [value, (deref s.roots)[5]];
    return call(ctx, (deref s.roots)[8], null, 2, &call_args[0], ex);
}
pub fun iterable_list(ctx: ptr<u8>, value: ptr<u8>, limit: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var method: ptr<u8> = iterable_method(ctx, value, ex);
    if (deref ex != null || !callable(ctx, method)) {
        fail(ctx, ex, 1, "expected an iterable");
        return undefined(ctx);
    }
    protect(ctx, method);
    var iterator: ptr<u8> = call(ctx, method, value, 0, null, ex);
    protect(ctx, iterator);
    var next: ptr<u8> = undefined(ctx);
    if (kind(ctx, iterator) != 5) {
        fail(ctx, ex, 1, "iterator must be an object");
    } else {
        next = get(ctx, iterator, "next", ex);
    }
    protect(ctx, next);
    var result: ptr<u8> = list(ctx, ex);
    protect(ctx, result);
    while (deref ex == null) {
        var entry: ptr<u8> = call(ctx, next, iterator, 0, null, ex);
        protect(ctx, entry);
        if (deref ex == null && kind(ctx, entry) != 5) {
            fail(ctx, ex, 1, "iterator result must be an object");
        }
        var done: bool = truth(ctx, get(ctx, entry, "done", ex));
        if (!done && deref ex == null) {
            if (length(ctx, result, ex) >= limit) {
                fail(ctx, ex, 2, "iterable item limit exceeded");
            } else {
                append(ctx, result, get(ctx, entry, "value", ex), ex);
            }
        }
        unprotect(ctx, entry);
        if (done) {
            break;
        }
    }
    if (deref ex != null && kind(ctx, iterator) == 5) {
        // IteratorClose must preserve the first conversion/limit exception.
        var ignored: ptr<u8> = null;
        var finish: ptr<u8> = get(ctx, iterator, "return", &ignored);
        if (ignored == null && callable(ctx, finish)) {
            call(ctx, finish, iterator, 0, null, &ignored);
        }
    }
    unprotect(ctx, result);
    unprotect(ctx, next);
    unprotect(ctx, iterator);
    unprotect(ctx, method);
    return result;
}
pub fun readonly(ctx: ptr<u8>, owner: ptr<u8>, name: str, value: ptr<u8>, ex: ptr<ptr<u8>>) {
    var s: ptr<State> = state(ctx);
    protect(ctx, value);
    var descriptor: ptr<u8> = plain(ctx);
    protect(ctx, descriptor);
    put(ctx, descriptor, "value", value, ex);
    var call_args: array<ptr<u8>, 3> = [owner, text(ctx, name), descriptor];
    call(ctx, (deref s.roots)[6], null, 3, &call_args[0], ex);
    unprotect(ctx, descriptor);
    unprotect(ctx, value);
}
pub fun install_web_support(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var s: ptr<State> = owned_context_slot(ctx, SLOT, size_of<State>() as i64) as ptr<State>;
    (deref s.roots)[0] = capture(ctx, get(ctx, global(ctx), "Reflect", ex), "apply", ex);
    (deref s.roots)[1] = capture(ctx, get(ctx, global(ctx), "ArrayBuffer", ex), "isView", ex);
    (deref s.roots)[6] = capture(ctx, get(ctx, global(ctx), "Reflect", ex), "defineProperty", ex);
    (deref s.roots)[5] = capture(ctx, get(ctx, global(ctx), "Symbol", ex), "iterator", ex);
    (deref s.roots)[7] = capture(ctx, get(ctx, global(ctx), "Object", ex), "getOwnPropertyDescriptor", ex);
    (deref s.roots)[8] = capture(ctx, get(ctx, global(ctx), "Reflect", ex), "get", ex);
    var parent: ptr<u8> = get(ctx, get(ctx, global(ctx), "DataView", ex), "prototype", ex);
    var names: array<str, 3> = ["buffer", "byteOffset", "byteLength"];
    for (var i: i64 = 0; i < 3 && deref ex == null; i++) {
        var call_args: array<ptr<u8>, 2> = [parent, text(ctx, names[i])];
        var descriptor: ptr<u8> = call(ctx, (deref s.roots)[7], null, 2, &call_args[0], ex);
        (deref s.roots)[i + 2] = capture(ctx, descriptor, "get", ex);
    }
    return deref ex == null;
}
pub fun shutdown_web_support(ctx: ptr<u8>) {
    var s: ptr<State> = state(ctx);
    if (s == null) {
        return;
    }
    for (var i: i64 = 0; i < ROOT_COUNT; i++) {
        if ((deref s.roots)[i] != null) {
            unprotect(ctx, (deref s.roots)[i]);
        }
    }
    release_context_slot(ctx, SLOT, size_of<State>() as i64);
}
