// Owned nonblocking process descriptors; no worker or native callback calls JS.
import("./context_state")::{context_slot, owned_context_slot, release_context_slot};
import("./config")::{PROCESS_PIPE_LIMIT, PROCESS_PIPE_CHUNK};
import("./streams")::{create_stream, stream_invoke};
import("./values")::{define, fail};
import("./http_values")::{http_native};
import("./system")::{open_process_stdin};
import("./worker_state")::{worker_state, WorkerState};
import("./buffer_core")::{buffer_from_bytes, byte_view_length, copy_byte_view};
import("std::mem::layout")::{size_of};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("std::io::fd")::{io_read, io_close};
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_null") fun js_null(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
const SLOT: i64 = 38;
const IO_READ: i32 = 20;
const IO_DESTROY: i32 = 21;
const IO_WRITE: i32 = 22;
const IO_FINAL: i32 = 23;
extern(c, "jsrt_pipe_write") fun pipe_write(fd: i32, bytes: ptr<u8>, count: i64) -> i64;
struct Channel {
    owner: ptr<u8>;
    fd: i64;
    wanted: bool;
    stdin: bool;
    finished: bool;
    writing: bool;
    chunk: ptr<u8>;
    completion: ptr<u8>;
    offset: i64;
}
struct State {
    channels: array<Channel, 49>;
}
fun state(ctx: ptr<u8>) -> ptr<State> {
    return owned_context_slot(ctx, SLOT, size_of<State>() as i64) as ptr<State>;
}
fun find(ctx: ptr<u8>, owner: ptr<u8>) -> ptr<Channel> {
    if (owner == null) {
        return null;
    }
    var s: ptr<State> = context_slot(ctx, SLOT) as ptr<State>;
    if (s == null) {
        return null;
    }
    for (var i: i64 = 0; i < PROCESS_PIPE_LIMIT; i++) {
        var c: ptr<Channel> = &(deref s.channels)[i];
        if (deref c.owner == owner) {
            return c;
        }
    }
    return null;
}
fun close_channel(c: ptr<Channel>) {
    if (deref c.fd >= 0) {
        io_close(deref c.fd);
        deref c.fd = -1;
    }
    deref c.wanted = false;
    deref c.finished = true;
}
pub fun process_read_stream(ctx: ptr<u8>, fd: i64, stdin: bool, ex: ptr<ptr<u8>>) -> ptr<u8> {
    return process_stream(ctx, fd, stdin, false, ex);
}
pub fun process_write_stream(ctx: ptr<u8>, fd: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    return process_stream(ctx, fd, false, true, ex);
}
fun process_stream(ctx: ptr<u8>, fd: i64, stdin: bool, writing: bool, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    var selected: ptr<Channel> = null;
    for (var i: i64 = 0; i < PROCESS_PIPE_LIMIT; i++) {
        var c: ptr<Channel> = &(deref s.channels)[i];
        if (deref c.owner == null) {
            selected = c;
            // Reserve before any JS construction can reenter the host.
            deref c.owner = undefined(ctx);
            deref c.fd = fd;
            deref c.stdin = stdin;
            deref c.finished = false;
            deref c.writing = writing;
            break;
        }
    }
    if (selected == null) {
        if (fd >= 0) {
            io_close(fd);
        }
        fail(ctx, ex, 2, "process pipe limit exceeded");
        return undefined(ctx);
    }
    var category: i64 = 1;
    if (writing) {
        category = 2;
    }
    var owner: ptr<u8> = create_stream(ctx, category, ex);
    protect(ctx, owner);
    if (deref ex == null) {
        define(ctx, owner, "_read", http_native(ctx, "processRead", IO_READ), ex, false);
        define(ctx, owner, "_destroy", http_native(ctx, "processDestroy", IO_DESTROY), ex, false);
        if (writing) {
            define(ctx, owner, "_write", http_native(ctx, "processWrite", IO_WRITE), ex, false);
            define(ctx, owner, "_final", http_native(ctx, "processFinal", IO_FINAL), ex, false);
        }
    }
    if (deref ex != null) {
        close_channel(selected);
        deref selected.owner = null;
        unprotect(ctx, owner);
        return undefined(ctx);
    }
    deref selected.owner = owner;
    return owner;
}
export(c) fun jsrt_process_io_read(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var c: ptr<Channel> = find(ctx, owner);
    if (c == null || deref c.finished) {
        return undefined(ctx);
    }
    if (deref c.stdin && deref c.fd < 0) {
        var w: ptr<WorkerState> = worker_state(ctx);
        if (w != null && deref w.parent != null) {
            fail(ctx, ex, 1, "Workers cannot read process stdin");
            return undefined(ctx);
        }
        deref c.fd = open_process_stdin();
        if (deref c.fd < 0) {
            fail(ctx, ex, 0, "cannot open nonblocking process stdin");
            return undefined(ctx);
        }
    }
    deref c.wanted = true;
    return undefined(ctx);
}
export(c) fun jsrt_process_io_destroy(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 2 || kind(ctx, args[1]) != 5 || !callable(ctx, args[1])) {
        fail(ctx, ex, 1, "process pipe destroy callback must be a function");
        return undefined(ctx);
    }
    discard_process_stream(ctx, owner);
    if (count > 1) {
        call(ctx, args[1], owner, 1, args, ex);
    }
    return undefined(ctx);
}
export(c) fun jsrt_process_io_write(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var c: ptr<Channel> = find(ctx, owner);
    if (count < 3 || kind(ctx, args[2]) != 5 || !callable(ctx, args[2])) {
        fail(ctx, ex, 1, "process pipe write callback must be a function");
        return undefined(ctx);
    }
    if (c == null || deref c.finished || !deref c.writing || deref c.completion != null) {
        fail(ctx, ex, 0, "invalid process pipe write");
        return undefined(ctx);
    }
    byte_view_length(ctx, args[0], ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    deref c.chunk = args[0];
    protect(ctx, deref c.chunk);
    deref c.completion = args[2];
    protect(ctx, deref c.completion);
    deref c.offset = 0;
    deref c.wanted = true;
    return undefined(ctx);
}
export(c) fun jsrt_process_io_final(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count == 0 || kind(ctx, args[0]) != 5 || !callable(ctx, args[0])) {
        fail(ctx, ex, 1, "process pipe final callback must be a function");
        return undefined(ctx);
    }
    var c: ptr<Channel> = find(ctx, owner);
    if (c != null) {
        close_channel(c);
        deref c.owner = null;
        unprotect(ctx, owner);
    }
    if (count > 0) {
        call(ctx, args[0], owner, 0, null, ex);
    }
    return undefined(ctx);
}
fun poll_write(ctx: ptr<u8>, c: ptr<Channel>, ex: ptr<ptr<u8>>) -> i32 {
    var n: i64 = byte_view_length(ctx, deref c.chunk, ex);
    var bytes: ptr<u8> = null;
    if (deref ex == null) {
        bytes = mem_alloc(n + 1);
        if (bytes == null) {
            fail(ctx, ex, 2, "cannot allocate process pipe bytes");
        } else {
            copy_byte_view(ctx, deref c.chunk, bytes, n, ex);
        }
    }
    var sent: i64 = -5;
    if (deref ex == null) {
        var amount: i64 = n - deref c.offset;
        if (amount > PROCESS_PIPE_CHUNK) {
            amount = PROCESS_PIPE_CHUNK;
        }
        sent = pipe_write(deref c.fd as i32, bytes + deref c.offset, amount);
    }
    if (bytes != null) {
        mem_free(bytes, n + 1);
    }
    if (deref ex != null) {
        return -1;
    }
    if (sent == -11 || sent == -4) {
        return 0;
    }
    if (sent >= 0) {
        deref c.offset += sent;
        if (deref c.offset < n) {
            return 1;
        }
    }
    var done: ptr<u8> = deref c.completion;
    var owner: ptr<u8> = deref c.owner;
    protect(ctx, owner);
    deref c.completion = null;
    unprotect(ctx, deref c.chunk);
    deref c.chunk = null;
    deref c.wanted = false;
    var problem: ptr<u8> = undefined(ctx);
    if (sent < 0) {
        var failure: ptr<u8> = null;
        fail(ctx, &failure, 0, "process pipe write failed");
        problem = failure;
    }
    var result: array<ptr<u8>, 1> = [problem];
    call(ctx, done, owner, 1, &result[0], ex);
    unprotect(ctx, done);
    unprotect(ctx, owner);
    return 1;
}
pub fun process_io_pending(ctx: ptr<u8>) -> bool {
    var s: ptr<State> = state(ctx);
    for (var i: i64 = 0; i < PROCESS_PIPE_LIMIT; i++) {
        var c: ptr<Channel> = &(deref s.channels)[i];
        if (deref c.owner != null && deref c.wanted && !deref c.finished) {
            return true;
        }
    }
    return false;
}
pub fun process_stream_closed(ctx: ptr<u8>, owner: ptr<u8>) -> bool {
    var c: ptr<Channel> = find(ctx, owner);
    return c == null || deref c.finished;
}
pub fun discard_process_stream(ctx: ptr<u8>, owner: ptr<u8>) {
    var c: ptr<Channel> = find(ctx, owner);
    if (c == null) {
        return;
    }
    close_channel(c);
    if (deref c.chunk != null) {
        unprotect(ctx, deref c.chunk);
        deref c.chunk = null;
    }
    if (deref c.completion != null) {
        unprotect(ctx, deref c.completion);
        deref c.completion = null;
    }
    deref c.owner = null;
    unprotect(ctx, owner);
}
pub fun poll_process_io(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> i32 {
    var s: ptr<State> = state(ctx);
    var changed: i32 = 0;
    var bytes: array<u8, 65536>;
    for (var i: i64 = 0; i < PROCESS_PIPE_LIMIT && deref ex == null; i++) {
        var c: ptr<Channel> = &(deref s.channels)[i];
        if (deref c.owner == null || !deref c.wanted || deref c.finished) {
            continue;
        }
        if (deref c.writing) {
            var work: i32 = poll_write(ctx, c, ex);
            if (work != 0) {
                changed = 1;
            }
            continue;
        }
        var n: i64 = io_read(deref c.fd, &bytes[0], PROCESS_PIPE_CHUNK);
        if (n == -11 || n == -4) {
            continue;
        }
        var owner: ptr<u8> = deref c.owner;
        protect(ctx, owner);
        deref c.wanted = false;
        changed = 1;
        if (n < 0) {
            var reason: ptr<u8> = null;
            fail(ctx, &reason, 0, "process pipe read failed");
            var failure: array<ptr<u8>, 1> = [reason];
            stream_invoke(ctx, owner, 6, 1, &failure[0], ex);
        } else {
            var chunk: ptr<u8> = js_null(ctx);
            if (n == 0) {
                close_channel(c);
                deref c.owner = null;
                unprotect(ctx, owner);
            } else {
                chunk = buffer_from_bytes(ctx, &bytes[0], n, ex);
            }
            var call_args: array<ptr<u8>, 1> = [chunk];
            if (deref ex == null) {
                stream_invoke(ctx, owner, 0, 1, &call_args[0], ex);
            }
        }
        unprotect(ctx, owner);
    }
    if (deref ex != null) {
        return -1;
    }
    return changed;
}
pub fun shutdown_process_io(ctx: ptr<u8>) {
    var s: ptr<State> = context_slot(ctx, SLOT) as ptr<State>;
    if (s == null) {
        return;
    }
    for (var i: i64 = 0; i < PROCESS_PIPE_LIMIT; i++) {
        var c: ptr<Channel> = &(deref s.channels)[i];
        if (deref c.owner != null) {
            discard_process_stream(ctx, deref c.owner);
        }
    }
    release_context_slot(ctx, SLOT, size_of<State>() as i64);
}
