pub fun stream_invoke(ctx: ptr<u8>, receiver: ptr<u8>, code: i64, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var stream_state_roots: ptr<StreamHostState> = stream_state_storage(ctx);
    return call(ctx, (deref stream_state_roots.stream_methods)[code], receiver, count, args, ex);
}

pub fun create_stream(ctx: ptr<u8>, category: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var stream_state_roots: ptr<StreamHostState> = stream_state_storage(ctx);
    return construct(ctx, (deref stream_state_roots.stream_constructors)[category - 1], 0, null, ex);
}

export(c) fun jsrt_stream_has_instance(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var roots: ptr<StreamHostState> = stream_state_storage(ctx);
    if (count > 0 && kind(ctx, args[0]) == 5 && equal(ctx, receiver, (deref roots.stream_constructors)[1])) {
        var state: ptr<u8> = weak_get(ctx, deref roots.stream_states, args[0], ex);
        if (kind(ctx, state) == 5 && (integer(ctx, state, "type", ex) & 2) != 0) {
            return boolean(ctx, true);
        }
    }
    var value: ptr<u8> = undefined(ctx);
    if (count > 0) {
        value = args[0];
    }
    var parent: ptr<u8> = get(ctx, receiver, "prototype", ex);
    if (kind(ctx, parent) != 5) {
        fail(ctx, ex, 1, "constructor prototype must be an object");
        return undefined(ctx);
    }
    var call_args: array<ptr<u8>, 1> = [value];
    return apply(ctx, deref roots.is_prototype_of, parent, 1, &call_args[0], ex);
}
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;

pub fun install_streams(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var stream_state_roots: ptr<StreamHostState> = stream_state_storage(ctx);
    if (!initialize_stream_state(ctx, ex)) {
        return false;
    }
    var names: array<str, 34> = ["push", "read", "pause", "resume", "write", "end", "destroy", "pipe",
        "unpipe", "readJob", "writeJob", "writeDone", "writeComplete", "afterAdd", "drainResume", "closeJob",
        "readableLength", "writableLength", "destroyed", "readableEnded", "writableFinished", "writableNeedDrain",
        "readableFlowing", "finalDone", "destroyDone", "transformDone", "flushDone", "setEncoding", "readableEncoding",
        "cork", "uncork", "writableCorked", "streamAbort", "hasInstance"];
    for (var i: i64 = 0; i < STREAM_METHOD_COUNT; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref stream_state_roots.stream_methods)[i] = function(ctx, name, callback(i as i32));
        release(name);
        protect(ctx, (deref stream_state_roots.stream_methods)[i]);
    }
    (deref stream_state_roots.stream_exports) = plain(ctx);
    protect(ctx, (deref stream_state_roots.stream_exports));
    var classes: array<str, 5> = ["Readable", "Writable", "PassThrough", "Transform", "Duplex"];
    for (var i: i64 = 0; i < STREAM_CLASS_COUNT; i++) {
        (deref stream_state_roots.stream_constructors)[i] = constructor(ctx, constructor_callback());
        protect(ctx, (deref stream_state_roots.stream_constructors)[i]);
        (deref stream_state_roots.stream_prototypes)[i] = get(ctx, (deref stream_state_roots.stream_constructors)[i],
            "prototype", ex);
        protect(ctx, (deref stream_state_roots.stream_prototypes)[i]);
        var parent: ptr<u8> = event_parent(ctx);
        if (i >= 2) {
            parent = (deref stream_state_roots.stream_prototypes)[0];
        }
        prototype(ctx, (deref stream_state_roots.stream_prototypes)[i], parent);
        define(ctx, (deref stream_state_roots.stream_prototypes)[i], "constructor", (deref stream_state_roots.stream_constructors)[i],
            ex, false);
        for (var j: i64 = 0; j < 9; j++) {
            var readable: bool = j < 4 || j == 7 || j == 8;
            if (j == 6 || i >= 2 || (i == 0 && readable) || (i == 1 && !readable)) {
                define(ctx, (deref stream_state_roots.stream_prototypes)[i], names[j], (deref stream_state_roots.stream_methods)[j],
                    ex, false);
            }
        }
        for (var j: i64 = 16; j < 23; j++) {
            if (j == 18 || i >= 2 || (i == 0 && (j == 16 || j == 19 || j == 22)) || (i == 1 && (j == 17 || j == 20 || j == 21))) {
                getter(ctx, (deref stream_state_roots.stream_prototypes)[i], names[j], (deref stream_state_roots.stream_methods)[j],
                    ex);
            }
        }
        put(ctx, (deref stream_state_roots.stream_exports), classes[i], (deref stream_state_roots.stream_constructors)[i],
            ex);
        if (i != 0) {
            define(ctx, (deref stream_state_roots.stream_prototypes)[i], "cork",
                (deref stream_state_roots.stream_methods)[STREAM_CORK_METHOD], ex, false);
            define(ctx, (deref stream_state_roots.stream_prototypes)[i], "uncork",
                (deref stream_state_roots.stream_methods)[STREAM_UNCORK_METHOD], ex, false);
            getter(ctx, (deref stream_state_roots.stream_prototypes)[i], "writableCorked",
                (deref stream_state_roots.stream_methods)[STREAM_CORKED_GETTER], ex);
        }
        if (i != 1) {
            define(ctx, (deref stream_state_roots.stream_prototypes)[i], "setEncoding",
                (deref stream_state_roots.stream_methods)[27], ex, false);
            getter(ctx, (deref stream_state_roots.stream_prototypes)[i], "readableEncoding",
                (deref stream_state_roots.stream_methods)[28], ex);
        }
    }
    prototype(ctx, (deref stream_state_roots.stream_prototypes)[2], (deref stream_state_roots.stream_prototypes)[3]);
    prototype(ctx, (deref stream_state_roots.stream_prototypes)[3], (deref stream_state_roots.stream_prototypes)[STREAM_DUPLEX_CLASS]);
    var symbol: ptr<u8> = get(ctx, get(ctx, global(ctx), "Symbol", ex), "hasInstance", ex);
    var parent: ptr<u8> = get(ctx, get(ctx, global(ctx), "Object", ex), "prototype", ex);
    deref stream_state_roots.is_prototype_of = capture(ctx, parent, "isPrototypeOf", ex);
    define_key(ctx, (deref stream_state_roots.stream_constructors)[1], symbol,
        (deref stream_state_roots.stream_methods)[STREAM_INSTANCE_METHOD], ex, false);
    return deref ex == null;
}

pub fun streams_module() -> ptr<u8> {
    var stream_state_roots: ptr<StreamHostState> = stream_state_storage(active_context());
    return (deref stream_state_roots.stream_exports);
}

pub fun shutdown_streams(ctx: ptr<u8>) {
    shutdown_stream_state(ctx);
}
