import("./stream_writable")::{stream_write, stream_end, stream_pump_write, stream_done, stream_complete};
import("./stream_lifecycle")::{stream_destroy, stream_close, stream_get, stream_hook_done};
import("./stream_transform")::{configure_transform};
import("./stream_options")::{configure_stream_options};
import("./collections")::{set_flag, weak_get, integer};
import("./context_state")::{active_context};
import("./values")::{get, put, plain, define, define_key, getter, capture, fail};
import("./web_support")::{apply};
import("./events")::{event_parent, event_state};
import("./stream_state")::{initialize_stream_state, new_stream_state, shutdown_stream_state, stream_state_storage,
    StreamHostState, STREAM_METHOD_COUNT, STREAM_CLASS_COUNT, STREAM_DUPLEX_CLASS, STREAM_CORK_METHOD,
    STREAM_UNCORK_METHOD, STREAM_CORKED_GETTER, STREAM_INSTANCE_METHOD};
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, left: ptr<u8>, right: ptr<u8>) -> bool;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, value: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_constructor") fun constructor(ctx: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_stream_callback") fun callback(code: i32) -> ptr<u8>;
extern(c, "jsrt_stream_constructor_callback") fun constructor_callback() -> ptr<u8>;
extern(c, "wr_construct") fun construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;

export(c) fun jsrt_stream_construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var stream_state_roots: ptr<StreamHostState> = stream_state_storage(ctx);
    var category: i64 = 1;
    if (equal(ctx, ctor, (deref stream_state_roots.stream_constructors)[1])) {
        category = 2;
    } else if (equal(ctx, ctor, (deref stream_state_roots.stream_constructors)[2]) ||
        equal(ctx, ctor, (deref stream_state_roots.stream_constructors)[3]) ||
        equal(ctx, ctor, (deref stream_state_roots.stream_constructors)[STREAM_DUPLEX_CLASS])) {
        category = 3;
    }
    var result: ptr<u8> = object(ctx, null, null);
    protect(ctx, result);
    prototype(ctx, result, get(ctx, ctor, "prototype", ex));
    var options: ptr<u8> = undefined(ctx);
    if (count > 0) {
        options = args[0];
    }
    var state: ptr<u8> = new_stream_state(ctx, result, category, options, ex);
    if (state != null && deref ex == null) {
        set_flag(ctx, state, "passThrough", equal(ctx, ctor, (deref stream_state_roots.stream_constructors)[2]), ex);
    }
    if (state != null && deref ex == null && equal(ctx, ctor, (deref stream_state_roots.stream_constructors)[3])) {
        configure_transform(ctx, result, state, options, ex);
    }
    if (state != null && deref ex == null) {
        var events: ptr<u8> = event_state(ctx, result, ex);
        put(ctx, events, "afterAdd", (deref stream_state_roots.stream_methods)[13], ex);
        configure_stream_options(ctx, result, state, options, ex);
    }
    unprotect(ctx, result);
    return result;
}

