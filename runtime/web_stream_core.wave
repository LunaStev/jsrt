// Engine-owned stream records and Promise capabilities shared by Web Streams.
import("./context_state")::{owned_context_slot, context_slot, release_context_slot};
import("./values")::{get, put, plain, define, capture, fail, coerce_number};
import("./collections")::{weak_map, weak_get, weak_set, list, length, at, append, remove_at, flag, set_flag, integer, set_integer, bind_one};
import("./web_support")::{apply};
import("./config")::{STREAM_CHUNK_LIMIT};
import("std::mem::layout")::{size_of};
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_number") fun number(ctx: ptr<u8>, value: f64) -> ptr<u8>;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_to_number") fun numeric(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> f64;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, owner: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, owner: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_promise") fun promise(ctx: ptr<u8>, resolve: ptr<ptr<u8>>, reject: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
pub const SLOT: i64 = 45;
pub const READABLE: i64 = 0;
pub const WRITABLE: i64 = 1;
pub const TRANSFORM: i64 = 2;
pub const READER: i64 = 3;
pub const WRITER: i64 = 4;
pub const READ_CONTROLLER: i64 = 5;
pub const WRITE_CONTROLLER: i64 = 6;
pub const TRANSFORM_CONTROLLER: i64 = 7;
pub const OPEN: i64 = 0;
pub const CLOSED: i64 = 1;
pub const ERRORED: i64 = 2;
pub const CLOSING: i64 = 3;
pub const ERRORING: i64 = 4;
pub const METHOD_COUNT: i64 = 62;
pub const JOB_OK: i64 = 40;
pub const JOB_ERROR: i64 = 41;
pub const NOOP: i64 = 42;
pub const JOB_READ_START: i64 = 0;
pub const JOB_READ_PULL: i64 = 1;
pub const JOB_WRITE_START: i64 = 2;
pub const JOB_WRITE: i64 = 3;
pub const JOB_WRITE_CLOSE: i64 = 4;
pub const JOB_WRITE_ABORT: i64 = 5;
pub const JOB_TRANSFORM: i64 = 6;
pub const JOB_FLUSH: i64 = 7;
pub const JOB_PIPE_READ: i64 = 8;
pub const JOB_PIPE_WRITE: i64 = 9;
pub const JOB_PIPE_CLOSE: i64 = 10;
pub const JOB_PIPE_CLEANUP: i64 = 11;
pub const JOB_TEE_READ: i64 = 12;
pub const JOB_READ_CANCEL: i64 = 13;
pub const JOB_ITERATOR_READ: i64 = 14;
pub const JOB_PIPE_WATCH_READ: i64 = 15;
pub const JOB_PIPE_WATCH_WRITE: i64 = 16;
pub const JOB_ITERATOR_RETURN: i64 = 17;
pub const JOB_TEE_CANCEL: i64 = 18;
pub const JOB_ADAPTER_READ: i64 = 19;
pub const JOB_ADAPTER_DESTROY: i64 = 20;
pub struct WebStreamState {
    records: ptr<u8>;
    ctors: array<ptr<u8>, 8>;
    parents: array<ptr<u8>, 8>;
    methods: array<ptr<u8>, 62>;
    promise_ctor: ptr<u8>;
    promise_resolve: ptr<u8>;
    promise_reject: ptr<u8>;
    promise_then: ptr<u8>;
    exports: ptr<u8>;
    iterator_parent: ptr<u8>;
}
pub fun storage(ctx: ptr<u8>) -> ptr<WebStreamState> {
    return context_slot(ctx, SLOT) as ptr<WebStreamState>;
}
pub fun lookup(ctx: ptr<u8>, owner: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, owner) != 5 || deref ex != null) {
        return undefined(ctx);
    }
    var s: ptr<WebStreamState> = storage(ctx);
    return weak_get(ctx, deref s.records, owner, ex);
}
pub fun record(ctx: ptr<u8>, owner: ptr<u8>, category: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var r: ptr<u8> = lookup(ctx, owner, ex);
    if (kind(ctx, r) != 5 || integer(ctx, r, "kind", ex) != category) {
        fail(ctx, ex, 1, "invalid Web Stream receiver");
        return undefined(ctx);
    }
    return r;
}
pub fun handle(ctx: ptr<u8>, category: i64, r: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<WebStreamState> = storage(ctx);
    var owner: ptr<u8> = object(ctx, null, null);
    protect(ctx, owner);
    prototype(ctx, owner, (deref s.parents)[category]);
    weak_set(ctx, deref s.records, owner, r, ex);
    unprotect(ctx, owner);
    return owner;
}
pub fun capability(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var r: ptr<u8> = plain(ctx);
    protect(ctx, r);
    var resolve: ptr<u8> = null;
    var reject: ptr<u8> = null;
    var p: ptr<u8> = promise(ctx, &resolve, &reject, ex);
    protect(ctx, p);
    protect(ctx, resolve);
    protect(ctx, reject);
    put(ctx, r, "promise", p, ex);
    put(ctx, r, "resolve", resolve, ex);
    put(ctx, r, "reject", reject, ex);
    unprotect(ctx, reject);
    unprotect(ctx, resolve);
    unprotect(ctx, p);
    unprotect(ctx, r);
    return r;
}
pub fun settle(ctx: ptr<u8>, r: ptr<u8>, value: ptr<u8>, rejected: bool, ex: ptr<ptr<u8>>) {
    if (kind(ctx, r) != 5 || flag(ctx, r, "settled", ex) || deref ex != null) {
        return;
    }
    set_flag(ctx, r, "settled", true, ex);
    var name: str = "resolve";
    if (rejected) {
        name = "reject";
    }
    var call_args: array<ptr<u8>, 1> = [value];
    call(ctx, get(ctx, r, name, ex), null, 1, &call_args[0], ex);
}
pub fun resolved(ctx: ptr<u8>, value: ptr<u8>, rejected: bool, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<WebStreamState> = storage(ctx);
    var fn: ptr<u8> = deref s.promise_resolve;
    if (rejected) {
        fn = deref s.promise_reject;
    }
    var call_args: array<ptr<u8>, 1> = [value];
    return call(ctx, fn, deref s.promise_ctor, 1, &call_args[0], ex);
}
pub fun handled(ctx: ptr<u8>, p: ptr<u8>, ex: ptr<ptr<u8>>) {
    var s: ptr<WebStreamState> = storage(ctx);
    var call_args: array<ptr<u8>, 2> = [undefined(ctx), (deref s.methods)[NOOP]];
    call(ctx, deref s.promise_then, p, 2, &call_args[0], ex);
}
pub fun internal_capability(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = capability(ctx, ex);
    protect(ctx, result);
    handled(ctx, get(ctx, result, "promise", ex), ex);
    unprotect(ctx, result);
    return result;
}
pub fun type_error(ctx: ptr<u8>, message: str) -> ptr<u8> {
    var problem: ptr<u8> = null;
    fail(ctx, &problem, 1, message);
    return problem;
}
pub fun rejected_type(ctx: ptr<u8>, message: str, ex: ptr<ptr<u8>>) -> ptr<u8> {
    return resolved(ctx, type_error(ctx, message), true, ex);
}
pub fun job(ctx: ptr<u8>, operation: i64, stream: ptr<u8>, extra: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var r: ptr<u8> = plain(ctx);
    protect(ctx, r);
    set_integer(ctx, r, "op", operation, ex);
    put(ctx, r, "stream", stream, ex);
    put(ctx, r, "extra", extra, ex);
    unprotect(ctx, r);
    return r;
}
pub fun follow(ctx: ptr<u8>, value: ptr<u8>, r: ptr<u8>, ex: ptr<ptr<u8>>) {
    var s: ptr<WebStreamState> = storage(ctx);
    protect(ctx, r);
    var p: ptr<u8> = resolved(ctx, value, false, ex);
    protect(ctx, p);
    var ok: ptr<u8> = bind_one(ctx, (deref s.methods)[JOB_OK], undefined(ctx), r, ex);
    protect(ctx, ok);
    var error: ptr<u8> = bind_one(ctx, (deref s.methods)[JOB_ERROR], undefined(ctx), r, ex);
    protect(ctx, error);
    var call_args: array<ptr<u8>, 2> = [ok, error];
    call(ctx, deref s.promise_then, p, 2, &call_args[0], ex);
    unprotect(ctx, error);
    unprotect(ctx, ok);
    unprotect(ctx, p);
    unprotect(ctx, r);
}
pub fun read_result(ctx: ptr<u8>, value: ptr<u8>, done: bool, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = object(ctx, null, null);
    protect(ctx, result);
    define(ctx, result, "value", value, ex, true);
    define(ctx, result, "done", boolean(ctx, done), ex, true);
    unprotect(ctx, result);
    return result;
}
pub fun field_number(ctx: ptr<u8>, r: ptr<u8>, name: str, ex: ptr<ptr<u8>>) -> f64 {
    return numeric(ctx, get(ctx, r, name, ex), ex);
}
pub fun queue_size(ctx: ptr<u8>, r: ptr<u8>, chunk: ptr<u8>, ex: ptr<ptr<u8>>) -> f64 {
    var fn: ptr<u8> = get(ctx, r, "size", ex);
    if (kind(ctx, fn) == 0) {
        return 1.0;
    }
    var call_args: array<ptr<u8>, 1> = [chunk];
    var result: ptr<u8> = apply(ctx, fn, undefined(ctx), 1, &call_args[0], ex);
    var size: f64 = coerce_number(ctx, result, ex);
    if (deref ex == null && (size != size || size < 0.0 || size > 1.7976931348623157e308)) {
        fail(ctx, ex, 2, "stream chunk size must be finite and nonnegative");
    }
    return size;
}
pub fun initialize(ctx: ptr<u8>, r: ptr<u8>, category: i64, strategy: ptr<u8>, high: f64, ex: ptr<ptr<u8>>) {
    set_integer(ctx, r, "kind", category, ex);
    set_integer(ctx, r, "state", OPEN, ex);
    put(ctx, r, "queue", list(ctx, ex), ex);
    put(ctx, r, "total", number(ctx, 0.0), ex);
    if (kind(ctx, strategy) == 5) {
        var value: ptr<u8> = get(ctx, strategy, "size", ex);
        if (kind(ctx, value) != 0 && !callable(ctx, value)) {
            fail(ctx, ex, 1, "stream strategy size must be callable");
        }
        put(ctx, r, "size", value, ex);
        value = get(ctx, strategy, "highWaterMark", ex);
        if (kind(ctx, value) != 0) {
            high = coerce_number(ctx, value, ex);
        }
    } else if (kind(ctx, strategy) != 0) {
        fail(ctx, ex, 1, "stream strategy must be an object");
    }
    if (high != high || high < 0.0) {
        fail(ctx, ex, 2, "stream highWaterMark must be nonnegative");
    }
    put(ctx, r, "high", number(ctx, high), ex);
}
pub fun queue_entry(ctx: ptr<u8>, r: ptr<u8>, chunk: ptr<u8>, size: f64, deferred: ptr<u8>, ex: ptr<ptr<u8>>) {
    var queue: ptr<u8> = get(ctx, r, "queue", ex);
    if (length(ctx, queue, ex) >= STREAM_CHUNK_LIMIT) {
        fail(ctx, ex, 2, "Web Stream queue item limit exceeded");
        return;
    }
    var entry: ptr<u8> = plain(ctx);
    protect(ctx, entry);
    put(ctx, entry, "chunk", chunk, ex);
    put(ctx, entry, "size", number(ctx, size), ex);
    put(ctx, entry, "deferred", deferred, ex);
    append(ctx, queue, entry, ex);
    put(ctx, r, "total", number(ctx, field_number(ctx, r, "total", ex) + size), ex);
    unprotect(ctx, entry);
}
pub fun shift(ctx: ptr<u8>, r: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var queue: ptr<u8> = get(ctx, r, "queue", ex);
    var entry: ptr<u8> = at(ctx, queue, 0, ex);
    protect(ctx, entry);
    remove_at(ctx, queue, 0, ex);
    var total: f64 = field_number(ctx, r, "total", ex) - field_number(ctx, entry, "size", ex);
    if (total < 0.0) {
        total = 0.0;
    }
    put(ctx, r, "total", number(ctx, total), ex);
    unprotect(ctx, entry);
    return entry;
}
pub fun close_readable(ctx: ptr<u8>, r: ptr<u8>, ex: ptr<ptr<u8>>) {
    if (integer(ctx, r, "state", ex) != OPEN) {
        return;
    }
    set_integer(ctx, r, "state", CLOSED, ex);
    var requests: ptr<u8> = get(ctx, r, "requests", ex);
    protect(ctx, requests);
    put(ctx, r, "requests", list(ctx, ex), ex);
    for (var i: i64 = 0; i < length(ctx, requests, ex); i++) {
        settle(ctx, at(ctx, requests, i, ex), read_result(ctx, undefined(ctx), true, ex), false, ex);
    }
    var reader: ptr<u8> = get(ctx, r, "reader", ex);
    if (kind(ctx, reader) == 5) {
        settle(ctx, get(ctx, reader, "closed", ex), undefined(ctx), false, ex);
    }
    unprotect(ctx, requests);
}
pub fun error_readable(ctx: ptr<u8>, r: ptr<u8>, reason: ptr<u8>, ex: ptr<ptr<u8>>) {
    if (integer(ctx, r, "state", ex) != OPEN) {
        return;
    }
    protect(ctx, reason);
    set_integer(ctx, r, "state", ERRORED, ex);
    put(ctx, r, "error", reason, ex);
    put(ctx, r, "queue", list(ctx, ex), ex);
    put(ctx, r, "total", number(ctx, 0.0), ex);
    var requests: ptr<u8> = get(ctx, r, "requests", ex);
    protect(ctx, requests);
    put(ctx, r, "requests", list(ctx, ex), ex);
    for (var i: i64 = 0; i < length(ctx, requests, ex); i++) {
        settle(ctx, at(ctx, requests, i, ex), reason, true, ex);
    }
    var reader: ptr<u8> = get(ctx, r, "reader", ex);
    if (kind(ctx, reader) == 5) {
        settle(ctx, get(ctx, reader, "closed", ex), reason, true, ex);
    }
    unprotect(ctx, requests);
    unprotect(ctx, reason);
}
pub fun initialize_storage(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<WebStreamState> {
    var s: ptr<WebStreamState> = owned_context_slot(ctx, SLOT, size_of<WebStreamState>() as i64) as ptr<WebStreamState>;
    deref s.records = weak_map(ctx, ex);
    protect(ctx, deref s.records);
    deref s.promise_ctor = capture(ctx, global(ctx), "Promise", ex);
    deref s.promise_resolve = capture(ctx, deref s.promise_ctor, "resolve", ex);
    deref s.promise_reject = capture(ctx, deref s.promise_ctor, "reject", ex);
    deref s.promise_then = capture(ctx, get(ctx, deref s.promise_ctor, "prototype", ex), "then", ex);
    return s;
}
pub fun shutdown_storage(ctx: ptr<u8>) {
    var s: ptr<WebStreamState> = storage(ctx);
    if (s == null) {
        return;
    }
    var roots: array<ptr<u8>, 7> = [deref s.records, deref s.promise_ctor, deref s.promise_resolve,
        deref s.promise_reject, deref s.promise_then, deref s.exports, deref s.iterator_parent];
    for (var i: i64 = 0; i < 7; i++) {
        if (roots[i] != null) {
            unprotect(ctx, roots[i]);
        }
    }
    for (var i: i64 = 0; i < 8; i++) {
        if ((deref s.ctors)[i] != null) {
            unprotect(ctx, (deref s.ctors)[i]);
        }
        if ((deref s.parents)[i] != null) {
            unprotect(ctx, (deref s.parents)[i]);
        }
    }
    for (var i: i64 = 0; i < METHOD_COUNT; i++) {
        if ((deref s.methods)[i] != null) {
            unprotect(ctx, (deref s.methods)[i]);
        }
    }
    release_context_slot(ctx, SLOT, size_of<WebStreamState>() as i64);
}
