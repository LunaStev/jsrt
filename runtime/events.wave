import("./context_state")::{EVENTS_SLOT, context_slot, allocate_context_slot, release_context_slot};
fun intrinsic(ctx: ptr<u8>, index: i64) -> ptr<ptr<u8>> {
    return(context_slot(ctx, EVENTS_SLOT) as ptr<ptr<u8>>) + index;
}

pub fun event_parent(ctx: ptr<u8>) -> ptr<u8> {
    return deref intrinsic(ctx, 2);
}

// EventEmitter policy in Wave; WeakMap entries are collected with their owners.
import("./values")::{get, put, text, plain, define, fail};
import("./collections")::{weak_map, weak_get, weak_set, list, length, at, append, flag, set_flag, bind_one};
import("./config")::{EVENT_LISTENER_LIMIT};
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, left: ptr<u8>, right: ptr<u8>) -> bool;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_number") fun number(ctx: ptr<u8>, value: f64) -> ptr<u8>;
extern(c, "wr_to_number") fun to_number(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> f64;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, value: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_constructor") fun constructor(ctx: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, callback: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_array") fun array(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_event_callback") fun callback(code: i32) -> ptr<u8>;
extern(c, "wr_promise") fun make_promise(ctx: ptr<u8>, resolve: ptr<ptr<u8>>, reject: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_event_constructor_callback") fun constructor_callback() -> ptr<u8>;
pub fun event_state(ctx: ptr<u8>, receiver: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (kind(ctx, receiver) != 5) {
        fail(ctx, ex, 1, "EventEmitter requires an object receiver");
        return null;
    }
    var state: ptr<u8> = weak_get(ctx, deref intrinsic(ctx, 0), receiver, ex);
    if (deref ex != null) {
        return null;
    }
    if (kind(ctx, state) == 0) {
        state = plain(ctx);
        protect(ctx, state);
        put(ctx, state, "listeners", list(ctx, ex), ex);
        weak_set(ctx, deref intrinsic(ctx, 0), receiver, state, ex);
        unprotect(ctx, state);
    }
    return state;
}

fun valid_name(ctx: ptr<u8>, name: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (kind(ctx, name) == 4 || kind(ctx, name) == 6) {
        return true;
    }
    fail(ctx, ex, 1, "event name must be a string or symbol");
    return false;
}

pub fun add_listener(ctx: ptr<u8>, receiver: ptr<u8>, name: ptr<u8>, fn: ptr<u8>, once: bool, prepend: bool,
    ex: ptr<ptr<u8>>) {
    if (!valid_name(ctx, name, ex)) {
        return;
    }
    if (kind(ctx, fn) != 5 || !callable(ctx, fn)) {
        fail(ctx, ex, 1, "listener must be a function");
        return;
    }
    var state: ptr<u8> = event_state(ctx, receiver, ex);
    if (state == null) {
        return;
    }
    var old: ptr<u8> = get(ctx, state, "listeners", ex);
    var n: i64 = length(ctx, old, ex);
    if (n >= EVENT_LISTENER_LIMIT) {
        fail(ctx, ex, 2, "EventEmitter listener limit exceeded");
        return;
    }
    // Node emits 'newListener' before the listener is added. A handler may add listeners itself, so
    // the list is read again afterwards.
    if (has_named_listeners(ctx, receiver, "newListener")) {
        var notice: array<ptr<u8>, 2> = [name, fn];
        emit_event(ctx, receiver, text(ctx, "newListener"), 2, &notice[0], ex);
        if (deref ex != null) {
            return;
        }
        old = get(ctx, state, "listeners", ex);
        n = length(ctx, old, ex);
        if (n >= EVENT_LISTENER_LIMIT) {
            fail(ctx, ex, 2, "EventEmitter listener limit exceeded");
            return;
        }
    }
    var entry: ptr<u8> = plain(ctx);
    protect(ctx, entry);
    put(ctx, entry, "name", name, ex);
    put(ctx, entry, "fn", fn, ex);
    set_flag(ctx, entry, "once", once, ex);
    if (prepend) {
        var next: ptr<u8> = list(ctx, ex);
        protect(ctx, next);
        append(ctx, next, entry, ex);
        for (var i: i64 = 0; i < n && deref ex == null; i++) {
            append(ctx, next, at(ctx, old, i, ex), ex);
        }
        put(ctx, state, "listeners", next, ex);
        unprotect(ctx, next);
    } else {
        // Emission captures its initial length. Appending cannot change that
        // snapshot; removal and prepending still replace the private array.
        append(ctx, old, entry, ex);
    }
    unprotect(ctx, entry);
    var hook: ptr<u8> = get(ctx, state, "afterAdd", ex);
    if (kind(ctx, hook) == 5 && deref ex == null) {
        var args: array<ptr<u8>, 1> = [name];
        call(ctx, hook, receiver, 1, &args[0], ex);
    }
}

pub fun remove_listener(ctx: ptr<u8>, receiver: ptr<u8>, name: ptr<u8>, fn: ptr<u8>, exact: ptr<u8>,
    ex: ptr<ptr<u8>>) {
    var state: ptr<u8> = event_state(ctx, receiver, ex);
    if (state == null) {
        return;
    }
    var old: ptr<u8> = get(ctx, state, "listeners", ex);
    var n: i64 = length(ctx, old, ex);
    var found: i64 = -1;
    for (var i: i64 = n; i > 0 && deref ex == null; i--) {
        var entry: ptr<u8> = at(ctx, old, i - 1, ex);
        if ((exact != null && equal(ctx, exact, entry)) || (exact == null && equal(ctx, get(ctx, entry,
            "name", ex), name) && equal(ctx, get(ctx, entry, "fn", ex), fn))) {
            found = i - 1;
            break;
        }
    }
    if (found < 0) {
        return;
    }
    var removed: ptr<u8> = at(ctx, old, found, ex);
    protect(ctx, removed);
    var next: ptr<u8> = list(ctx, ex);
    protect(ctx, next);
    for (var i: i64 = 0; i < n && deref ex == null; i++) {
        if (i != found) {
            append(ctx, next, at(ctx, old, i, ex), ex);
        }
    }
    put(ctx, state, "listeners", next, ex);
    unprotect(ctx, next);
    // Node emits 'removeListener' after the listener is gone, with its name and function.
    if (deref ex == null && has_named_listeners(ctx, receiver, "removeListener")) {
        var notice: array<ptr<u8>, 2> = [get(ctx, removed, "name", ex), get(ctx, removed, "fn", ex)];
        protect(ctx, notice[0]);
        protect(ctx, notice[1]);
        emit_event(ctx, receiver, text(ctx, "removeListener"), 2, &notice[0], ex);
        unprotect(ctx, notice[1]);
        unprotect(ctx, notice[0]);
    }
    unprotect(ctx, removed);
}

pub fun emit_event(ctx: ptr<u8>, receiver: ptr<u8>, name: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> bool {
    if (!valid_name(ctx, name, ex)) {
        return false;
    }
    protect(ctx, name);
    var state: ptr<u8> = event_state(ctx, receiver, ex);
    if (state == null) {
        unprotect(ctx, name);
        return false;
    }
    var snapshot: ptr<u8> = get(ctx, state, "listeners", ex);
    protect(ctx, snapshot);
    var n: i64 = length(ctx, snapshot, ex);
    var handled: bool = false;
    for (var i: i64 = 0; i < n && deref ex == null; i++) {
        var entry: ptr<u8> = at(ctx, snapshot, i, ex);
        if (!equal(ctx, name, get(ctx, entry, "name", ex)) || flag(ctx, entry, "fired", ex)) {
            continue;
        }
        handled = true;
        var fn: ptr<u8> = get(ctx, entry, "fn", ex);
        if (flag(ctx, entry, "once", ex)) {
            set_flag(ctx, entry, "fired", true, ex);
            remove_listener(ctx, receiver, name, fn, entry, ex);
        }
        if (deref ex == null) {
            call(ctx, fn, receiver, count, args, ex);
        }
    }
    if (!handled && deref ex == null && equal(ctx, name, text(ctx, "error"))) {
        if (count > 0 && kind(ctx, args[0]) == 5) {
            deref ex = args[0];
        } else {
            fail(ctx, ex, 0, "Unhandled 'error' event");
        }
    }
    unprotect(ctx, snapshot);
    unprotect(ctx, name);
    return handled;
}

pub fun emit_named(ctx: ptr<u8>, receiver: ptr<u8>, name: str, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> bool {
    return emit_event(ctx, receiver, text(ctx, name), count, args, ex);
}

pub fun has_named_listeners(ctx: ptr<u8>, receiver: ptr<u8>, name: str) -> bool {
    var ex: ptr<u8> = null;
    var state: ptr<u8> = event_state(ctx, receiver, &ex);
    if (state == null) {
        return false;
    }
    var listeners: ptr<u8> = get(ctx, state, "listeners", &ex);
    var wanted: ptr<u8> = text(ctx, name);
    protect(ctx, wanted);
    var found: bool = false;
    for (var i: i64 = 0; i < length(ctx, listeners, &ex) && ex == null; i++) {
        var entry: ptr<u8> = at(ctx, listeners, i, &ex);
        if (equal(ctx, wanted, get(ctx, entry, "name", &ex)) && !flag(ctx, entry, "fired", &ex)) {
            found = true;
            break;
        }
    }
    unprotect(ctx, wanted);
    return found && ex == null;
}

export(c) fun jsrt_event_construct(ctx: ptr<u8>, ctor: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: ptr<u8> = object(ctx, null, null);
    protect(ctx, result);
    prototype(ctx, result, get(ctx, ctor, "prototype", ex));
    event_state(ctx, result, ex);
    unprotect(ctx, result);
    return result;
}

export(c) fun jsrt_event_on(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 2) {
        fail(ctx, ex, 1, "listener registration requires event and callback");
        return undefined(ctx);
    }
    // The callback function identity selects the four registration variants.
    var once: bool = equal(ctx, fn, deref intrinsic(ctx, 3 + (1))) || equal(ctx, fn, deref intrinsic(ctx,
        3 + (3)));
    var prepend: bool = equal(ctx, fn, deref intrinsic(ctx, 3 + (2))) || equal(ctx, fn, deref intrinsic(ctx,
        3 + (3)));
    add_listener(ctx, receiver, args[0], args[1], once, prepend, ex);
    return receiver;
}

export(c) fun jsrt_event_emit(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 1) {
        fail(ctx, ex, 1, "emit requires an event name");
        return undefined(ctx);
    }
    return boolean(ctx, emit_event(ctx, receiver, args[0], count - 1, args + 1, ex));
}

export(c) fun jsrt_event_off(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 2 || !valid_name(ctx, args[0], ex)) {
        fail(ctx, ex, 1, "off requires an event and listener");
        return undefined(ctx);
    }
    if (kind(ctx, args[1]) != 5 || !callable(ctx, args[1])) {
        fail(ctx, ex, 1, "listener must be a function");
        return undefined(ctx);
    }
    remove_listener(ctx, receiver, args[0], args[1], null, ex);
    return receiver;
}

export(c) fun jsrt_event_clear(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count > 0 && !valid_name(ctx, args[0], ex)) {
        return undefined(ctx);
    }
    var state: ptr<u8> = event_state(ctx, receiver, ex);
    if (state == null) {
        return undefined(ctx);
    }
    var old: ptr<u8> = get(ctx, state, "listeners", ex);
    var n: i64 = length(ctx, old, ex);
    var next: ptr<u8> = list(ctx, ex);
    protect(ctx, next);
    for (var i: i64 = 0; count > 0 && i < n && deref ex == null; i++) {
        var entry: ptr<u8> = at(ctx, old, i, ex);
        if (!equal(ctx, get(ctx, entry, "name", ex), args[0])) {
            append(ctx, next, entry, ex);
        }
    }
    put(ctx, state, "listeners", next, ex);
    unprotect(ctx, next);
    return receiver;
}

export(c) fun jsrt_event_inspect(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var names: bool = equal(ctx, fn, deref intrinsic(ctx, 3 + (9)));
    var counting: bool = equal(ctx, fn, deref intrinsic(ctx, 3 + (8)));
    if (!names && (count == 0 || !valid_name(ctx, args[0], ex))) {
        fail(ctx, ex, 1, "event name is required");
        return undefined(ctx);
    }
    var state: ptr<u8> = event_state(ctx, receiver, ex);
    if (state == null) {
        return undefined(ctx);
    }
    var entries: ptr<u8> = get(ctx, state, "listeners", ex);
    var n: i64 = length(ctx, entries, ex);
    var result: ptr<u8> = array(ctx, 0, null, ex);
    protect(ctx, result);
    var matched: i64 = 0;
    for (var i: i64 = 0; i < n && deref ex == null; i++) {
        var entry: ptr<u8> = at(ctx, entries, i, ex);
        var name: ptr<u8> = get(ctx, entry, "name", ex);
        if (names) {
            var found: bool = false;
            for (var j: i64 = 0; j < length(ctx, result, ex); j++) {
                if (equal(ctx, name, at(ctx, result, j, ex))) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                append(ctx, result, name, ex);
            }
        } else if (equal(ctx, name, args[0])) {
            var listener: ptr<u8> = get(ctx, entry, "fn", ex);
            if (!counting || count < 2 || equal(ctx, listener, args[1])) {
                matched += 1;
                if (!counting) {
                    append(ctx, result, listener, ex);
                }
            }
        }
    }
    unprotect(ctx, result);
    if (counting) {
        return number(ctx, matched as f64);
    }
    return result;
}

// events.once(emitter, name): a Promise for the next `name` event, resolved with the array of event
// arguments. An 'error' event before it rejects instead (unless name is 'error' itself). Either way
// the pending listeners are removed. The unsupported `signal` option and bad arguments reject.
const INTRINSIC_ONCE: i64 = 13;
const INTRINSIC_SETTLE_VALUE: i64 = 14;
const INTRINSIC_SETTLE_ERROR: i64 = 15;
const INTRINSIC_STATIC_COUNT: i64 = 16;
// setMaxListeners/getMaxListeners share one C callback (code 9).
const INTRINSIC_SET_MAX: i64 = 17;
const INTRINSIC_GET_MAX: i64 = 18;
const INTRINSIC_LAST: i64 = 19;
const DEFAULT_MAX_LISTENERS: f64 = 10.0;
const JS_NUMBER: i32 = 3;
const EVENTS_STATE_BYTES: i64 = 160;
const JS_OBJECT: i32 = 5;

// Marks the record settled and removes both listeners. False when it already settled.
fun finish_once(ctx: ptr<u8>, record: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (flag(ctx, record, "done", ex)) {
        return false;
    }
    set_flag(ctx, record, "done", true, ex);
    var emitter: ptr<u8> = get(ctx, record, "emitter", ex);
    protect(ctx, emitter);
    remove_listener(ctx, emitter, get(ctx, record, "name", ex), get(ctx, record, "listener", ex), null, ex);
    var error_listener: ptr<u8> = get(ctx, record, "errorListener", ex);
    if (kind(ctx, error_listener) == JS_OBJECT) {
        remove_listener(ctx, emitter, text(ctx, "error"), error_listener, null, ex);
    }
    unprotect(ctx, emitter);
    return deref ex == null;
}

// Bound as listener(record, ...eventArguments).
export(c) fun jsrt_event_settle_value(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 1 || !finish_once(ctx, args[0], ex)) {
        return undefined(ctx);
    }
    var values: ptr<u8> = array(ctx, count - 1, args + 1, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, values);
    var resolve: ptr<u8> = get(ctx, args[0], "resolve", ex);
    var settled: array<ptr<u8>, 1> = [values];
    call(ctx, resolve, null, 1, &settled[0], ex);
    unprotect(ctx, values);
    return undefined(ctx);
}

// Bound as errorListener(record, error).
export(c) fun jsrt_event_settle_error(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 1 || !finish_once(ctx, args[0], ex)) {
        return undefined(ctx);
    }
    var problem: array<ptr<u8>, 1> = [undefined(ctx)];
    if (count > 1) {
        problem[0] = args[1];
    }
    var reject: ptr<u8> = get(ctx, args[0], "reject", ex);
    call(ctx, reject, null, 1, &problem[0], ex);
    return undefined(ctx);
}

export(c) fun jsrt_event_once(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var resolve: ptr<u8> = null;
    var reject: ptr<u8> = null;
    var result: ptr<u8> = make_promise(ctx, &resolve, &reject, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    protect(ctx, result);
    protect(ctx, resolve);
    protect(ctx, reject);
    var problem: ptr<u8> = null;
    if (count < 2 || kind(ctx, args[0]) != JS_OBJECT) {
        fail(ctx, &problem, 1, "events.once requires an emitter and an event name");
    } else if (valid_name(ctx, args[1], &problem) && count > 2 && kind(ctx, args[2]) == JS_OBJECT &&
        kind(ctx, get(ctx, args[2], "signal", &problem)) != 0) {
        fail(ctx, &problem, 1, "events.once does not support the signal option");
    }
    if (problem == null) {
        var record: ptr<u8> = plain(ctx);
        protect(ctx, record);
        put(ctx, record, "emitter", args[0], &problem);
        put(ctx, record, "name", args[1], &problem);
        put(ctx, record, "resolve", resolve, &problem);
        put(ctx, record, "reject", reject, &problem);
        var listener: ptr<u8> = bind_one(ctx, deref intrinsic(ctx, INTRINSIC_SETTLE_VALUE), null, record, &problem);
        if (problem == null) {
            protect(ctx, listener);
            put(ctx, record, "listener", listener, &problem);
            add_listener(ctx, args[0], args[1], listener, true, false, &problem);
            unprotect(ctx, listener);
        }
        // Waiting for 'error' itself must not also install the rejecting listener.
        var waits_for_error: bool = problem == null && equal(ctx, args[1], text(ctx, "error"));
        if (problem == null && !waits_for_error) {
            var error_listener: ptr<u8> = bind_one(ctx, deref intrinsic(ctx, INTRINSIC_SETTLE_ERROR), null, record,
                &problem);
            if (problem == null) {
                protect(ctx, error_listener);
                put(ctx, record, "errorListener", error_listener, &problem);
                add_listener(ctx, args[0], text(ctx, "error"), error_listener, true, false, &problem);
                unprotect(ctx, error_listener);
            }
        }
        unprotect(ctx, record);
    }
    if (problem != null) {
        var rejected: array<ptr<u8>, 1> = [problem];
        call(ctx, reject, null, 1, &rejected[0], ex);
    }
    unprotect(ctx, reject);
    unprotect(ctx, resolve);
    unprotect(ctx, result);
    return result;
}

// events.listenerCount(emitter, name): the legacy static form of emitter.listenerCount(name).
export(c) fun jsrt_event_static_count(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 2 || kind(ctx, args[0]) != JS_OBJECT) {
        fail(ctx, ex, 1, "listenerCount requires an emitter and an event name");
        return undefined(ctx);
    }
    var method: ptr<u8> = get(ctx, args[0], "listenerCount", ex);
    if (deref ex != null || !callable(ctx, method)) {
        fail(ctx, ex, 1, "emitter does not implement listenerCount");
        return undefined(ctx);
    }
    var name: array<ptr<u8>, 1> = [args[1]];
    return call(ctx, method, args[0], 1, &name[0], ex);
}


// emitter.setMaxListeners(n) / emitter.getMaxListeners(). The value is stored and reported for
// compatibility; jsrt does not print Node's leak warning, and EVENT_LISTENER_LIMIT stays the hard cap.
export(c) fun jsrt_event_max(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var state: ptr<u8> = event_state(ctx, receiver, ex);
    if (state == null) {
        return undefined(ctx);
    }
    if (equal(ctx, fn, deref intrinsic(ctx, INTRINSIC_SET_MAX))) {
        if (count < 1 || kind(ctx, args[0]) != JS_NUMBER) {
            fail(ctx, ex, 1, "setMaxListeners requires a number");
            return undefined(ctx);
        }
        var limit: f64 = to_number(ctx, args[0], ex);
        if (deref ex != null) {
            return undefined(ctx);
        }
        if (limit != limit || limit < 0.0) {
            fail(ctx, ex, 2, "setMaxListeners requires a non-negative number");
            return undefined(ctx);
        }
        put(ctx, state, "max", args[0], ex);
        return receiver;
    }
    var stored: ptr<u8> = get(ctx, state, "max", ex);
    if (deref ex == null && kind(ctx, stored) == JS_NUMBER) {
        return stored;
    }
    return get(ctx, deref intrinsic(ctx, 1), "defaultMaxListeners", ex);
}
pub fun install_events(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (!allocate_context_slot(ctx, EVENTS_SLOT, EVENTS_STATE_BYTES)) {
        return false;
    }
    deref intrinsic(ctx, 0) = weak_map(ctx, ex);
    protect(ctx, deref intrinsic(ctx, 0));
    deref intrinsic(ctx, 1) = constructor(ctx, constructor_callback());
    protect(ctx, deref intrinsic(ctx, 1));
    deref intrinsic(ctx, 2) = get(ctx, deref intrinsic(ctx, 1), "prototype", ex);
    protect(ctx, deref intrinsic(ctx, 2));
    define(ctx, deref intrinsic(ctx, 2), "constructor", deref intrinsic(ctx, 1), ex, false);
    define(ctx, deref intrinsic(ctx, 1), "EventEmitter", deref intrinsic(ctx, 1), ex, false);
    var names: array<str, 10> = ["on", "once", "prependListener", "prependOnceListener", "emit", "off",
        "removeAllListeners", "listeners", "listenerCount", "eventNames"];
    var codes: array<i32, 10> = [0, 0, 0, 0, 1, 2, 3, 4, 4, 4];
    for (var i: i64 = 0; i < 10; i++) {
        var name: ptr<u8> = utf8(names[i]);
        deref intrinsic(ctx, 3 + (i)) = function(ctx, name, callback(codes[i]));
        release(name);
        protect(ctx, deref intrinsic(ctx, 3 + (i)));
        define(ctx, deref intrinsic(ctx, 2), names[i], deref intrinsic(ctx, 3 + (i)), ex, false);
    }
    define(ctx, deref intrinsic(ctx, 2), "addListener", deref intrinsic(ctx, 3 + (0)), ex, false);
    define(ctx, deref intrinsic(ctx, 2), "removeListener", deref intrinsic(ctx, 3 + (5)), ex, false);
    // Static helpers and the native listeners events.once binds. Codes 5-8 select the C callbacks.
    var static_names: array<str, 4> = ["once", "settleValue", "settleError", "listenerCount"];
    for (var i: i64 = 0; i < 4; i++) {
        var static_name: ptr<u8> = utf8(static_names[i]);
        deref intrinsic(ctx, INTRINSIC_ONCE + i) = function(ctx, static_name, callback(5 + i as i32));
        release(static_name);
        protect(ctx, deref intrinsic(ctx, INTRINSIC_ONCE + i));
    }
    define(ctx, deref intrinsic(ctx, 1), "once", deref intrinsic(ctx, INTRINSIC_ONCE), ex, true);
    define(ctx, deref intrinsic(ctx, 1), "listenerCount", deref intrinsic(ctx, INTRINSIC_STATIC_COUNT), ex, true);
    var max_names: array<str, 2> = ["setMaxListeners", "getMaxListeners"];
    for (var i: i64 = 0; i < 2; i++) {
        var max_name: ptr<u8> = utf8(max_names[i]);
        deref intrinsic(ctx, INTRINSIC_SET_MAX + i) = function(ctx, max_name, callback(9));
        release(max_name);
        protect(ctx, deref intrinsic(ctx, INTRINSIC_SET_MAX + i));
        define(ctx, deref intrinsic(ctx, 2), max_names[i], deref intrinsic(ctx, INTRINSIC_SET_MAX + i), ex, false);
    }
    // rawListeners returns the registered functions; jsrt stores once listeners unwrapped.
    define(ctx, deref intrinsic(ctx, 2), "rawListeners", deref intrinsic(ctx, 3 + (7)), ex, false);
    define(ctx, deref intrinsic(ctx, 1), "defaultMaxListeners", number(ctx, DEFAULT_MAX_LISTENERS), ex, true);
    return deref ex == null;
}

pub fun events_module(ctx: ptr<u8>) -> ptr<u8> {
    return deref intrinsic(ctx, 1);
}

pub fun shutdown_events(ctx: ptr<u8>) {
    if (context_slot(ctx, EVENTS_SLOT) == null) {
        return;
    }
    for (var i: i64 = 0; i < 10; i++) {
        if (deref intrinsic(ctx, 3 + (i)) != null) {
            unprotect(ctx, deref intrinsic(ctx, 3 + (i)));
            deref intrinsic(ctx, 3 + (i)) = null;
        }
    }
    for (var i: i64 = INTRINSIC_ONCE; i < INTRINSIC_LAST; i++) {
        if (deref intrinsic(ctx, i) != null) {
            unprotect(ctx, deref intrinsic(ctx, i));
            deref intrinsic(ctx, i) = null;
        }
    }
    if (deref intrinsic(ctx, 2) != null) {
        unprotect(ctx, deref intrinsic(ctx, 2));
        deref intrinsic(ctx, 2) = null;
    }
    if (deref intrinsic(ctx, 1) != null) {
        unprotect(ctx, deref intrinsic(ctx, 1));
        deref intrinsic(ctx, 1) = null;
    }
    if (deref intrinsic(ctx, 0) != null) {
        unprotect(ctx, deref intrinsic(ctx, 0));
        deref intrinsic(ctx, 0) = null;
    }
    release_context_slot(ctx, EVENTS_SLOT, EVENTS_STATE_BYTES);
}
