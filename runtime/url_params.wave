import("./context_state")::{owned_context_slot, active_context};
import("std::mem::layout")::{size_of};
struct UrlParamsState {
    states: ptr<u8>;
    iterators: ptr<u8>;
    ctor: ptr<u8>;
    parent: ptr<u8>;
    keys_fn: ptr<u8>;
    iterator_key: ptr<u8>;
    methods: array<ptr<u8>, 15>;
}

fun url_params_storage(ctx: ptr<u8>) -> ptr<UrlParamsState> {
    return owned_context_slot(ctx, 24, size_of<UrlParamsState>() as i64) as ptr<UrlParamsState>;
}

// Ordered form-urlencoded pairs and live URL linkage, entirely engine-owned.
import("./config")::{URL_CAP, URL_PAIR_LIMIT};
import("./values")::{get, put, text, plain, define, define_key, getter, capture, fail};
import("./collections")::{weak_map, weak_get, weak_set, list, append, at, length, set_at, integer, set_integer};
import("./url_core")::{usv, change_url};
import("./byte_codec")::{encode_utf8, decode_bytes};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_is_array") fun is_array(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_null") fun js_null(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_number") fun number(ctx: ptr<u8>, value: f64) -> ptr<u8>;
extern(c, "wr_array") fun public_array(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set_prototype") fun prototype(ctx: ptr<u8>, value: ptr<u8>, parent: ptr<u8>);
extern(c, "wr_constructor") fun constructor(ctx: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_to_string") fun stringify(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_get") fun property(ctx: ptr<u8>, value: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_string_characters") fun characters(value: ptr<u8>) -> ptr<u16>;
extern(c, "wr_string_length") fun string_length(value: ptr<u8>) -> i64;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_params_callback") fun callback(code: i32) -> ptr<u8>;

fun pair(ctx: ptr<u8>, name: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    protect(ctx, name);
    protect(ctx, value);
    var result: ptr<u8> = list(ctx, ex);
    protect(ctx, result);
    append(ctx, result, name, ex);
    append(ctx, result, value, ex);
    unprotect(ctx, result);
    unprotect(ctx, value);
    unprotect(ctx, name);
    return result;
}

fun hex(c: u8) -> i64 {
    if (c >= 48 && c <= 57) {
        return(c - 48) as i64;
    }
    if (c >= 65 && c <= 70) {
        return(c - 55) as i64;
    }
    if (c >= 97 && c <= 102) {
        return(c - 87) as i64;
    }
    return -1;
}

fun unescape(ctx: ptr<u8>, bytes: ptr<u8>, n: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var result: array<u8, 8192>;
    var used: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        var c: u8 = bytes[i];
        if (c == 43) {
            c = 32;
        } else if (c == 37 && i + 2 < n) {
            var a: i64 = hex(bytes[i + 1]);
            var b: i64 = hex(bytes[i + 2]);
            if (a >= 0 && b >= 0) {
                c = (a * 16 + b) as u8;
                i += 2;
            }
        }
        result[used] = c;
        used += 1;
        i += 1;
    }
    return decode_bytes(ctx, &result[0], used, 0, ex);
}

pub fun parse_pairs(ctx: ptr<u8>, source: ptr<u8>, strip_question: bool, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var bytes: array<u8, 8192>;
    var n: i64 = encode_utf8(ctx, source, &bytes[0], URL_CAP, false, ex);
    if (n < 0) {
        return undefined(ctx);
    }
    var entries: ptr<u8> = list(ctx, ex);
    protect(ctx, entries);
    var cursor: i64 = 0;
    if (strip_question && n > 0 && bytes[0] == 63) {
        cursor = 1;
    }
    while (cursor < n && deref ex == null) {
        var first: i64 = cursor;
        while (cursor < n && bytes[cursor] != 38) {
            cursor += 1;
        }
        var last: i64 = cursor;
        cursor += 1;
        if (first == last) {
            continue;
        }
        if (length(ctx, entries, ex) >= URL_PAIR_LIMIT) {
            fail(ctx, ex, 2, "URLSearchParams pair limit exceeded");
            break;
        }
        var separator: i64 = first;
        while (separator < last && bytes[separator] != 61) {
            separator += 1;
        }
        var name: ptr<u8> = unescape(ctx, &bytes[first], separator - first, ex);
        protect(ctx, name);
        var start: i64 = separator;
        if (start < last) {
            start += 1;
        }
        var value: ptr<u8> = unescape(ctx, &bytes[start], last - start, ex);
        protect(ctx, value);
        append(ctx, entries, pair(ctx, name, value, ex), ex);
        unprotect(ctx, value);
        unprotect(ctx, name);
    }
    unprotect(ctx, entries);
    return entries;
}

fun encoded_field(ctx: ptr<u8>, value: ptr<u8>, bytes: ptr<u8>, used: i64, ex: ptr<ptr<u8>>) -> i64 {
    var source: array<u8, 8192>;
    var n: i64 = encode_utf8(ctx, value, &source[0], URL_CAP, false, ex);
    if (n < 0) {
        return -1;
    }
    var cursor: i64 = used;
    var digits: str = "0123456789ABCDEF";
    for (var i: i64 = 0; i < n; i++) {
        var c: u8 = source[i];
        var safe: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 42 || c == 45 || c == 46 || c == 95;
        var width: i64 = 1;
        if (!safe && c != 32) {
            width = 3;
        }
        if (cursor + width >= URL_CAP) {
            fail(ctx, ex, 2, "URLSearchParams serialized byte limit exceeded");
            return -1;
        }
        if (safe) {
            bytes[cursor] = c;
        } else if (c == 32) {
            bytes[cursor] = 43;
        } else {
            bytes[cursor] = 37;
            bytes[cursor + 1] = digits[c >> 4];
            bytes[cursor + 2] = digits[c & 15];
        }
        cursor += width;
    }
    return cursor;
}

pub fun serialize_pairs(ctx: ptr<u8>, entries: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var bytes: array<u8, 8192>;
    var used: i64 = 0;
    for (var i: i64 = 0; i < length(ctx, entries, ex) && deref ex == null; i++) {
        if (used >= 8190) {
            fail(ctx, ex, 2, "URLSearchParams serialized byte limit exceeded");
            break;
        }
        if (i > 0) {
            bytes[used] = 38;
            used += 1;
        }
        var entry: ptr<u8> = at(ctx, entries, i, ex);
        used = encoded_field(ctx, at(ctx, entry, 0, ex), &bytes[0], used, ex);
        if (used < 0) {
            break;
        }
        if (used >= (URL_CAP - 1)) {
            fail(ctx, ex, 2, "URLSearchParams serialized byte limit exceeded");
            break;
        }
        bytes[used] = 61;
        used += 1;
        used = encoded_field(ctx, at(ctx, entry, 1, ex), &bytes[0], used, ex);
        if (used < 0) {
            break;
        }
    }
    if (deref ex != null) {
        return undefined(ctx);
    }
    bytes[used] = 0;
    return text(ctx, &bytes[0] as str);
}

pub fun params_state(ctx: ptr<u8>, owner: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<UrlParamsState> = url_params_storage(ctx);
    if (kind(ctx, owner) != 5) {
        fail(ctx, ex, 1, "invalid URLSearchParams receiver");
        return undefined(ctx);
    }
    var record: ptr<u8> = weak_get(ctx, (deref host_state.states), owner, ex);
    if (kind(ctx, record) != 5) {
        fail(ctx, ex, 1, "invalid URLSearchParams receiver");
    }
    return record;
}

pub fun new_params(ctx: ptr<u8>, entries: ptr<u8>, url_record: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<UrlParamsState> = url_params_storage(ctx);
    protect(ctx, entries);
    var owner: ptr<u8> = object(ctx, null, null);
    protect(ctx, owner);
    prototype(ctx, owner, (deref host_state.parent));
    var record: ptr<u8> = plain(ctx);
    protect(ctx, record);
    put(ctx, record, "pairs", entries, ex);
    if (url_record != null) {
        put(ctx, record, "url", url_record, ex);
    }
    weak_set(ctx, (deref host_state.states), owner, record, ex);
    unprotect(ctx, record);
    unprotect(ctx, owner);
    unprotect(ctx, entries);
    return owner;
}

fun commit(ctx: ptr<u8>, record: ptr<u8>, entries: ptr<u8>, ex: ptr<ptr<u8>>) {
    protect(ctx, entries);
    var serialized: ptr<u8> = serialize_pairs(ctx, entries, ex);
    protect(ctx, serialized);
    var linked: ptr<u8> = get(ctx, record, "url", ex);
    if (deref ex == null && kind(ctx, linked) == 5) {
        var bytes: array<u8, 8192>;
        var n: i64 = encode_utf8(ctx, serialized, &bytes[0], URL_CAP, false, ex);
        var href: ptr<u8> = change_url(ctx, get(ctx, linked, "href", ex), 8, serialized, n == 0, ex);
        if (deref ex == null) {
            put(ctx, linked, "href", href, ex);
        }
    }
    if (deref ex == null) {
        put(ctx, record, "pairs", entries, ex);
    }
    unprotect(ctx, serialized);
    unprotect(ctx, entries);
}

export(c) fun jsrt_params_construct(ctx: ptr<u8>, ignored: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<UrlParamsState> = url_params_storage(ctx);
    var entries: ptr<u8> = list(ctx, ex);
    protect(ctx, entries);
    if (count > 0 && kind(ctx, args[0]) != 0 && kind(ctx, args[0]) != 1) {
        var value: ptr<u8> = args[0];
        if (kind(ctx, value) != 5) {
            var source: ptr<u8> = usv(ctx, value, ex);
            protect(ctx, source);
            var parsed: ptr<u8> = parse_pairs(ctx, source, true, ex);
            protect(ctx, parsed);
            unprotect(ctx, source);
            unprotect(ctx, entries);
            entries = parsed;
        } else {
            var original: ptr<u8> = weak_get(ctx, (deref host_state.states), value, ex);
            var keys: ptr<u8> = null;
            var n: i64 = 0;
            var array_input: bool = is_array(ctx, value);
            if (kind(ctx, original) == 5) {
                keys = get(ctx, original, "pairs", ex);
                n = length(ctx, keys, ex);
            } else if (array_input) {
                keys = value;
                n = length(ctx, value, ex);
            } else {
                var params: array<ptr<u8>, 1> = [value];
                keys = call(ctx, (deref host_state.keys_fn), null, 1, &params[0], ex);
                n = length(ctx, keys, ex);
            }
            protect(ctx, keys);
            if (n > URL_PAIR_LIMIT) {
                fail(ctx, ex, 2, "URLSearchParams pair limit exceeded");
            }
            for (var i: i64 = 0; i < n && deref ex == null; i++) {
                var key: ptr<u8> = at(ctx, keys, i, ex);
                var raw_name: ptr<u8> = key;
                var raw_value: ptr<u8> = undefined(ctx);
                if (kind(ctx, original) == 5 || array_input) {
                    if (kind(ctx, key) != 5 || length(ctx, key, ex) != 2) {
                        fail(ctx, ex, 1, "URLSearchParams entries must contain two values");
                        break;
                    }
                    raw_name = at(ctx, key, 0, ex);
                    raw_value = at(ctx, key, 1, ex);
                } else {
                    var js_key: ptr<u8> = stringify(ctx, key, ex);
                    if (js_key == null) {
                        break;
                    }
                    raw_value = property(ctx, value, js_key, ex);
                    release(js_key);
                }
                protect(ctx, raw_name);
                protect(ctx, raw_value);
                var name: ptr<u8> = usv(ctx, raw_name, ex);
                protect(ctx, name);
                var content: ptr<u8> = undefined(ctx);
                if (deref ex == null) {
                    content = usv(ctx, raw_value, ex);
                }
                protect(ctx, content);
                if (deref ex == null) {
                    append(ctx, entries, pair(ctx, name, content, ex), ex);
                }
                unprotect(ctx, content);
                unprotect(ctx, name);
                unprotect(ctx, raw_value);
                unprotect(ctx, raw_name);
            }
            unprotect(ctx, keys);
        }
    }
    var result: ptr<u8> = null;
    if (deref ex == null) {
        serialize_pairs(ctx, entries, ex);
    }
    if (deref ex == null) {
        result = new_params(ctx, entries, null, ex);
    }
    unprotect(ctx, entries);
    return result;
}

fun compare_names(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>, ex: ptr<ptr<u8>>) -> i32 {
    var left: ptr<u8> = stringify(ctx, a, ex);
    if (left == null) {
        return 0;
    }
    var right: ptr<u8> = stringify(ctx, b, ex);
    if (right == null) {
        release(left);
        return 0;
    }
    var na: i64 = string_length(left);
    var nb: i64 = string_length(right);
    var pa: ptr<u16> = characters(left);
    var pb: ptr<u16> = characters(right);
    var result: i32 = 0;
    var i: i64 = 0;
    while (i < na && i < nb) {
        if (pa[i] < pb[i]) {
            result = -1;
            break;
        }
        if (pa[i] > pb[i]) {
            result = 1;
            break;
        }
        i += 1;
    }
    if (result == 0) {
        if (na < nb) {
            result = -1;
        } else if (na > nb) {
            result = 1;
        }
    }
    release(left);
    release(right);
    return result;
}

export(c) fun jsrt_params_api(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<UrlParamsState> = url_params_storage(ctx);
    var code: i64 = 0;
    while (code < 15 && !equal(ctx, fn, (deref host_state.methods)[code])) {
        code += 1;
    }
    if (code >= 13) {
        var iterator: ptr<u8> = undefined(ctx);
        if (kind(ctx, receiver) == 5) {
            iterator = weak_get(ctx, (deref host_state.iterators), receiver, ex);
        }
        if (kind(ctx, iterator) != 5) {
            fail(ctx, ex, 1, "invalid URLSearchParams iterator");
            return undefined(ctx);
        }
        if (code == 14) {
            return receiver;
        }
        var record: ptr<u8> = params_state(ctx, get(ctx, iterator, "owner", ex), ex);
        var entries: ptr<u8> = get(ctx, record, "pairs", ex);
        var index: i64 = integer(ctx, iterator, "index", ex);
        var result: ptr<u8> = plain(ctx);
        protect(ctx, result);
        var done: bool = index >= length(ctx, entries, ex);
        put(ctx, result, "done", boolean(ctx, done), ex);
        var value: ptr<u8> = undefined(ctx);
        if (!done) {
            var entry: ptr<u8> = at(ctx, entries, index, ex);
            var mode: i64 = integer(ctx, iterator, "mode", ex);
            if (mode == 0) {
                var items: array<ptr<u8>, 2> = [at(ctx, entry, 0, ex), at(ctx, entry, 1, ex)];
                value = public_array(ctx, 2, &items[0], ex);
            } else {
                value = at(ctx, entry, mode - 1, ex);
            }
            protect(ctx, value);
            set_integer(ctx, iterator, "index", index + 1, ex);
        } else {
            protect(ctx, value);
        }
        put(ctx, result, "value", value, ex);
        unprotect(ctx, value);
        unprotect(ctx, result);
        return result;
    }
    var record: ptr<u8> = params_state(ctx, receiver, ex);
    if (deref ex != null) {
        return undefined(ctx);
    }
    if (code == 12) {
        return number(ctx, length(ctx, get(ctx, record, "pairs", ex), ex) as f64);
    }
    if (code == 7) {
        return serialize_pairs(ctx, get(ctx, record, "pairs", ex), ex);
    }
    if (code >= 8 && code <= 10) {
        var iterator: ptr<u8> = plain(ctx);
        protect(ctx, iterator);
        var data: ptr<u8> = plain(ctx);
        protect(ctx, data);
        put(ctx, data, "owner", receiver, ex);
        set_integer(ctx, data, "index", 0, ex);
        set_integer(ctx, data, "mode", code - 8, ex);
        weak_set(ctx, (deref host_state.iterators), iterator, data, ex);
        define(ctx, iterator, "next", (deref host_state.methods)[13], ex, false);
        define_key(ctx, iterator, (deref host_state.iterator_key), (deref host_state.methods)[14], ex,
            false);
        unprotect(ctx, data);
        unprotect(ctx, iterator);
        return iterator;
    }
    if (code == 11) {
        if (count == 0 || kind(ctx, args[0]) != 5 || !callable(ctx, args[0])) {
            fail(ctx, ex, 1, "forEach requires a function");
            return undefined(ctx);
        }
        var target: ptr<u8> = undefined(ctx);
        if (count > 1) {
            target = args[1];
        }
        for (var i: i64 = 0; deref ex == null; i++) {
            var entries: ptr<u8> = get(ctx, record, "pairs", ex);
            if (i >= length(ctx, entries, ex)) {
                break;
            }
            var entry: ptr<u8> = at(ctx, entries, i, ex);
            var params: array<ptr<u8>, 3> = [at(ctx, entry, 1, ex), at(ctx, entry, 0, ex), receiver];
            call(ctx, args[0], target, 3, &params[0], ex);
        }
        return undefined(ctx);
    }
    if (code != 6 && (count == 0 || ((code == 0 || code == 5) && count < 2))) {
        fail(ctx, ex, 1, "URLSearchParams argument missing");
        return undefined(ctx);
    }
    var name: ptr<u8> = undefined(ctx);
    var content: ptr<u8> = undefined(ctx);
    if (code != 6) {
        name = usv(ctx, args[0], ex);
    }
    protect(ctx, name);
    var value_filter: bool = (code == 1 || code == 4) && count > 1 && kind(ctx, args[1]) != 0;
    if (deref ex == null && (code == 0 || code == 5 || value_filter)) {
        content = usv(ctx, args[1], ex);
    }
    protect(ctx, content);
    // User conversion may reenter and mutate this same owner. Read its current list afterwards.
    var entries: ptr<u8> = get(ctx, record, "pairs", ex);
    var result: ptr<u8> = undefined(ctx);
    if (deref ex == null && (code == 2 || code == 3 || code == 4)) {
        result = js_null(ctx);
        if (code == 4) {
            result = boolean(ctx, false);
        }
        if (code == 3) {
            result = public_array(ctx, 0, null, ex);
        }
        protect(ctx, result);
        for (var i: i64 = 0; i < length(ctx, entries, ex) && deref ex == null; i++) {
            var entry: ptr<u8> = at(ctx, entries, i, ex);
            if (equal(ctx, at(ctx, entry, 0, ex), name) && (!value_filter || equal(ctx, at(ctx, entry,
                1, ex), content))) {
                if (code == 2) {
                    unprotect(ctx, result);
                    result = at(ctx, entry, 1, ex);
                    protect(ctx, result);
                    break;
                }
                if (code == 4) {
                    unprotect(ctx, result);
                    result = boolean(ctx, true);
                    protect(ctx, result);
                    break;
                }
                set_at(ctx, result, length(ctx, result, ex), at(ctx, entry, 1, ex), ex);
            }
        }
        unprotect(ctx, result);
    } else if (deref ex == null) {
        var next: ptr<u8> = list(ctx, ex);
        protect(ctx, next);
        var replaced: bool = false;
        for (var i: i64 = 0; i < length(ctx, entries, ex) && deref ex == null; i++) {
            var entry: ptr<u8> = at(ctx, entries, i, ex);
            var matches: bool = code != 6 && equal(ctx, at(ctx, entry, 0, ex), name);
            if (code == 1 && matches && (!value_filter || equal(ctx, at(ctx, entry, 1, ex), content))) {
                continue;
            }
            if (code == 5 && matches) {
                if (!replaced) {
                    append(ctx, next, pair(ctx, name, content, ex), ex);
                    replaced = true;
                }
            } else {
                append(ctx, next, entry, ex);
            }
        }
        if (code == 0 || (code == 5 && !replaced)) {
            if (length(ctx, next, ex) >= URL_PAIR_LIMIT) {
                fail(ctx, ex, 2, "URLSearchParams pair limit exceeded");
            } else {
                append(ctx, next, pair(ctx, name, content, ex), ex);
            }
        }
        if (code == 6) {
            for (var i: i64 = 1; i < length(ctx, next, ex); i++) {
                var item: ptr<u8> = at(ctx, next, i, ex);
                protect(ctx, item);
                var j: i64 = i;
                while (j > 0 && compare_names(ctx, at(ctx, at(ctx, next, j - 1, ex), 0, ex), at(ctx,
                    item, 0, ex), ex) > 0 && deref ex == null) {
                    set_at(ctx, next, j, at(ctx, next, j - 1, ex), ex);
                    j -= 1;
                }
                set_at(ctx, next, j, item, ex);
                unprotect(ctx, item);
            }
        }
        if (deref ex == null) {
            commit(ctx, record, next, ex);
        }
        unprotect(ctx, next);
    }
    unprotect(ctx, content);
    unprotect(ctx, name);
    return result;
}

pub fun install_params(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<UrlParamsState> = url_params_storage(ctx);
    (deref host_state.states) = weak_map(ctx, ex);
    protect(ctx, (deref host_state.states));
    (deref host_state.iterators) = weak_map(ctx, ex);
    protect(ctx, (deref host_state.iterators));
    (deref host_state.keys_fn) = capture(ctx, get(ctx, global(ctx), "Object", ex), "keys", ex);
    (deref host_state.iterator_key) = capture(ctx, get(ctx, global(ctx), "Symbol", ex), "iterator", ex);
    (deref host_state.ctor) = constructor(ctx, callback(15));
    protect(ctx, (deref host_state.ctor));
    (deref host_state.parent) = get(ctx, (deref host_state.ctor), "prototype", ex);
    protect(ctx, (deref host_state.parent));
    define(ctx, (deref host_state.parent), "constructor", (deref host_state.ctor), ex, false);
    var names: array<str, 15> = ["append", "delete", "get", "getAll", "has", "set", "sort", "toString",
        "entries", "keys", "values", "forEach", "size", "next", "iterator"];
    for (var i: i64 = 0; i < 15; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref host_state.methods)[i] = function(ctx, name, callback(i as i32));
        release(name);
        protect(ctx, (deref host_state.methods)[i]);
        if (i < 12) {
            define(ctx, (deref host_state.parent), names[i], (deref host_state.methods)[i], ex, false);
        }
    }
    getter(ctx, (deref host_state.parent), "size", (deref host_state.methods)[12], ex);
    define_key(ctx, (deref host_state.parent), (deref host_state.iterator_key), (deref host_state.methods)[8],
        ex, false);
    define(ctx, global(ctx), "URLSearchParams", (deref host_state.ctor), ex, false);
    return deref ex == null;
}

pub fun params_constructor() -> ptr<u8> {
    var host_state: ptr<UrlParamsState> = url_params_storage(active_context());
    return(deref host_state.ctor);
}

pub fun shutdown_params(ctx: ptr<u8>) {
    var host_state: ptr<UrlParamsState> = url_params_storage(ctx);
    for (var i: i64 = 0; i < 15; i++) {
        if ((deref host_state.methods)[i] != null) {
            unprotect(ctx, (deref host_state.methods)[i]);
            (deref host_state.methods)[i] = null;
        }
    }
    if ((deref host_state.states) != null) {
        unprotect(ctx, (deref host_state.states));
        (deref host_state.states) = null;
    }
    if ((deref host_state.iterators) != null) {
        unprotect(ctx, (deref host_state.iterators));
        (deref host_state.iterators) = null;
    }
    if ((deref host_state.ctor) != null) {
        unprotect(ctx, (deref host_state.ctor));
        (deref host_state.ctor) = null;
    }
    if ((deref host_state.parent) != null) {
        unprotect(ctx, (deref host_state.parent));
        (deref host_state.parent) = null;
    }
    if ((deref host_state.keys_fn) != null) {
        unprotect(ctx, (deref host_state.keys_fn));
        (deref host_state.keys_fn) = null;
    }
    if ((deref host_state.iterator_key) != null) {
        unprotect(ctx, (deref host_state.iterator_key));
        (deref host_state.iterator_key) = null;
    }
}
