// Native graph snapshots contain no JSC handles. Sender roots are temporary and
// receiver values are rebuilt only by the receiver's owning thread.
import("./config")::{CLONE_NODE_LIMIT, CLONE_BYTE_LIMIT, CLONE_DEPTH_LIMIT};
import("./context_state")::{context_slot, allocate_context_slot, release_context_slot};
import("./values")::{get, text, capture, define, define_key, fail};
import("./brands")::{is_map, is_set, is_regexp, is_native_error, is_weak_map, is_weak_set, is_promise};
import("./collections")::{length, at};
import("./buffer_core")::{copy_byte_view};
import("std::mem::alloc")::{mem_alloc_zeroed, mem_alloc, mem_free};
import("std::mem::layout")::{size_of};
import("std::mem::ops")::{mem_copy};
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_is_array") fun is_array(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_is_date") fun is_date(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "jsrt_clone_proxy_status") fun proxy_status(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_to_number") fun numeric(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> f64;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_to_string") fun string(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_string_length") fun string_length(value: ptr<u8>) -> i64;
extern(c, "wr_string_characters") fun characters(value: ptr<u8>) -> ptr<u16>;
extern(c, "wr_string_utf16") fun utf16(value: ptr<u16>, count: i64) -> ptr<u8>;
extern(c, "wr_string_value") fun string_value(ctx: ptr<u8>, value: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_object") fun object(ctx: ptr<u8>, cls: ptr<u8>, data: ptr<u8>) -> ptr<u8>;
extern(c, "wr_array") fun array(ctx: ptr<u8>, count: i64, args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_number") fun number(ctx: ptr<u8>, value: f64) -> ptr<u8>;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_null") fun js_null(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_construct") fun construct(ctx: ptr<u8>, fn: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_get") fun property(ctx: ptr<u8>, value: ptr<u8>, name: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_set") fun set(ctx: ptr<u8>, value: ptr<u8>, name: ptr<u8>, content: ptr<u8>,
    flags: u32, ex: ptr<ptr<u8>>);
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_typed_type") fun typed_type(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i32;
extern(c, "wr_typed_length") fun typed_length(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> i64;
extern(c, "wr_typed_bytes") fun typed_bytes(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_u8_new") fun new_u8(ctx: ptr<u8>, count: i64, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "jsrt_clone_callback") fun clone_callback() -> ptr<u8>;
const SLOT: i64 = 33;
const RECORD: i32 = 5;
const ARRAY: i32 = 8;
const BYTES: i32 = 9;
const DATE: i32 = 10;
// Node tags for the structured clone extensions. Children hang off edges as (key, value) pairs:
// MAP uses (key, value), SET uses (element, element), REGEXP uses (source, flags) strings, ERROR
// uses (name, message[, cause]) pairs and BOXED uses one (primitive, primitive) pair whose kind is
// kept in node.value (BOXED_NUMBER..BOXED_BIGINT).
const MAP: i32 = 11;
const SET: i32 = 12;
const REGEXP: i32 = 13;
const ERROR: i32 = 14;
const BOXED: i32 = 15;
const BOXED_NUMBER: f64 = 0.0;
const BOXED_STRING: f64 = 1.0;
const BOXED_BOOLEAN: f64 = 2.0;
const BOXED_BIGINT: f64 = 3.0;
// roots[8] is Object.prototype.hasOwnProperty, used to skip keys an earlier getter deleted.
const ROOT_HAS_OWN: i64 = 8;
// roots 9.. capture the intrinsics the new tags need: Map entries, Set values, Array.from, the
// RegExp constructor, the primitive wrappers' valueOf and the standard error constructors.
const ROOT_MAP_ENTRIES: i64 = 9;
const ROOT_SET_VALUES: i64 = 10;
const ROOT_ARRAY_FROM: i64 = 11;
const ROOT_MAP_CTOR: i64 = 12;
const ROOT_SET_CTOR: i64 = 13;
const ROOT_REGEXP_CTOR: i64 = 14;
const ROOT_NUMBER_VALUE: i64 = 15;
const ROOT_STRING_VALUE: i64 = 16;
const ROOT_BOOLEAN_VALUE: i64 = 17;
const ROOT_BIGINT_VALUE: i64 = 18;
const ROOT_ERROR_CTORS: i64 = 19;
const ROOT_SYMBOL_VALUE: i64 = 26;
const ROOT_MAP_SET: i64 = 27;
const ROOT_SET_ADD: i64 = 28;
const ERROR_CTOR_COUNT: i64 = 7;
const ROOT_COUNT: i64 = 29;
struct CloneState {
    roots: array<ptr<u8>, 29>;
}
pub struct CloneNode {
    tag: i32;
    value: f64;
    bytes: ptr<u8>;
    size: i64;
    edges: ptr<i64>;
    count: i64;
    // Allocated edge pairs; count can be smaller when deleted keys were skipped.
    capacity: i64;
}
pub struct CloneGraph {
    nodes: ptr<CloneNode>;
    count: i64;
    bytes: i64;
}
struct Walk {
    graph: ptr<CloneGraph>;
    refs: ptr<ptr<u8>>;
}
fun storage(ctx: ptr<u8>) -> ptr<CloneState> {
    return context_slot(ctx, SLOT) as ptr<CloneState>;
}
pub fun clone_failure(ctx: ptr<u8>, ex: ptr<ptr<u8>>, message: str) {
    if (deref ex != null) {
        return;
    }
    fail(ctx, ex, 0, message);
    protect(ctx, deref ex);
    var nested: ptr<u8> = null;
    define(ctx, deref ex, "name", text(ctx, "DataCloneError"), &nested, true);
    unprotect(ctx, deref ex);
}
pub fun free_clone(graph: ptr<CloneGraph>) {
    if (graph == null) {
        return;
    }
    if (deref graph.nodes != null) {
        for (var i: i64 = 0; i < deref graph.count; i++) {
            var node: ptr<CloneNode> = deref graph.nodes + i;
            if (deref node.bytes != null) {
                var bytes: i64 = deref node.size;
                if (deref node.tag != BYTES) {
                    bytes = bytes * 2;
                }
                mem_free(deref node.bytes, bytes + 2);
            }
            if (deref node.edges != null) {
                mem_free(deref node.edges as ptr<u8>, deref node.capacity * 16);
            }
        }
        mem_free(deref graph.nodes as ptr<u8>, CLONE_NODE_LIMIT * (size_of<CloneNode>() as i64));
    }
    mem_free(graph as ptr<u8>, size_of<CloneGraph>() as i64);
}
fun payload(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, bytes: i64,
    ex: ptr<ptr<u8>>) -> bool {
    var graph: ptr<CloneGraph> = deref walk.graph;
    if (bytes < 0 || bytes > CLONE_BYTE_LIMIT - deref graph.bytes) {
        clone_failure(ctx, ex, "clone byte limit exceeded");
        return false;
    }
    deref node.bytes = mem_alloc(bytes + 2);
    if (deref node.bytes == null) {
        clone_failure(ctx, ex, "cannot allocate clone bytes");
        return false;
    }
    deref graph.bytes += bytes;
    return true;
}
fun visit(ctx: ptr<u8>, walk: ptr<Walk>, value: ptr<u8>, depth: i64,
    ex: ptr<ptr<u8>>) -> i64 {
    if (deref ex != null) {
        return -1;
    }
    var graph: ptr<CloneGraph> = deref walk.graph;
    var tag: i32 = kind(ctx, value);
    if (tag == RECORD) {
        for (var i: i64 = 0; i < deref graph.count; i++) {
            if ((deref walk.refs)[i] != null && equal(ctx, (deref walk.refs)[i], value)) {
                return i;
            }
        }
    }
    if (depth > CLONE_DEPTH_LIMIT || deref graph.count >= CLONE_NODE_LIMIT) {
        clone_failure(ctx, ex, "clone graph limit exceeded");
        return -1;
    }
    var index: i64 = deref graph.count;
    deref graph.count += 1;
    var node: ptr<CloneNode> = deref graph.nodes + index;
    deref node.tag = tag;
    (deref walk.refs)[index] = value;
    protect(ctx, value);
    if (tag == 0 || tag == 1) {
        return index;
    }
    if (tag == 2) {
        if (truth(ctx, value)) {
            deref node.value = 1.0;
        }
    } else if (tag == 3) {
        deref node.value = numeric(ctx, value, ex);
    } else if (tag == 4 || tag == 7) {
        var content: ptr<u8> = string(ctx, value, ex);
        if (deref ex == null && content != null) {
            deref node.size = string_length(content);
            if (payload(ctx, walk, node, deref node.size * 2, ex)) {
                mem_copy(deref node.bytes, characters(content) as ptr<u8>, deref node.size * 2);
            }
        }
        if (content != null) {
            release(content);
        }
    } else if (tag == RECORD && !callable(ctx, value)) {
        visit_object(ctx, walk, node, value, depth, ex);
    } else {
        clone_failure(ctx, ex, "value is not supported by the clone subset");
    }
    return index;
}
// Adds one (key, value) child pair to node's edge list, growing it by one slot. The edge array is
// owned by the node and freed through capacity in free_clone.
fun add_edge(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, key_value: ptr<u8>, item: ptr<u8>, depth: i64,
    ex: ptr<ptr<u8>>) {
    var key_index: i64 = visit(ctx, walk, key_value, depth + 1, ex);
    if (deref ex != null) {
        return;
    }
    var item_index: i64 = visit(ctx, walk, item, depth + 1, ex);
    if (deref ex != null) {
        return;
    }
    if (deref node.count >= deref node.capacity) {
        var grown: i64 = deref node.capacity * 2;
        if (grown < 4) {
            grown = 4;
        }
        if (grown > CLONE_NODE_LIMIT) {
            clone_failure(ctx, ex, "clone property limit exceeded");
            return;
        }
        var edges: ptr<i64> = mem_alloc_zeroed(grown * 16) as ptr<i64>;
        if (edges == null) {
            clone_failure(ctx, ex, "cannot allocate clone properties");
            return;
        }
        if (deref node.edges != null) {
            mem_copy(edges as ptr<u8>, deref node.edges as ptr<u8>, deref node.count * 16);
            mem_free(deref node.edges as ptr<u8>, deref node.capacity * 16);
        }
        deref node.edges = edges;
        deref node.capacity = grown;
    }
    (deref node.edges)[deref node.count * 2] = key_index;
    (deref node.edges)[deref node.count * 2 + 1] = item_index;
    deref node.count += 1;
}

// Reads a string property through the engine's own getter chain (source, flags, message, name).
fun string_property(ctx: ptr<u8>, value: ptr<u8>, name: str, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var content: ptr<u8> = get(ctx, value, name, ex);
    if (deref ex != null || kind(ctx, content) != 4) {
        return text(ctx, "");
    }
    return content;
}

// Snapshots a Map: (key, value) pairs from the captured Map.prototype.entries, so an overridden
// Symbol.iterator on the instance cannot change what is cloned.
fun visit_map(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, value: ptr<u8>, depth: i64, ex: ptr<ptr<u8>>) {
    var state: ptr<CloneState> = storage(ctx);
    deref node.tag = MAP;
    var iterator: ptr<u8> = call(ctx, (deref state.roots)[ROOT_MAP_ENTRIES], value, 0, null, ex);
    if (deref ex != null) {
        return;
    }
    protect(ctx, iterator);
    var args: array<ptr<u8>, 1> = [iterator];
    var items: ptr<u8> = call(ctx, (deref state.roots)[ROOT_ARRAY_FROM], null, 1, &args[0], ex);
    unprotect(ctx, iterator);
    if (deref ex != null) {
        return;
    }
    protect(ctx, items);
    var total: i64 = length(ctx, items, ex);
    for (var i: i64 = 0; i < total && deref ex == null; i++) {
        var entry: ptr<u8> = at(ctx, items, i, ex);
        var key: ptr<u8> = at(ctx, entry, 0, ex);
        var item: ptr<u8> = at(ctx, entry, 1, ex);
        if (deref ex == null) {
            add_edge(ctx, walk, node, key, item, depth, ex);
        }
    }
    unprotect(ctx, items);
}

fun visit_set(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, value: ptr<u8>, depth: i64, ex: ptr<ptr<u8>>) {
    var state: ptr<CloneState> = storage(ctx);
    deref node.tag = SET;
    var iterator: ptr<u8> = call(ctx, (deref state.roots)[ROOT_SET_VALUES], value, 0, null, ex);
    if (deref ex != null) {
        return;
    }
    protect(ctx, iterator);
    var args: array<ptr<u8>, 1> = [iterator];
    var items: ptr<u8> = call(ctx, (deref state.roots)[ROOT_ARRAY_FROM], null, 1, &args[0], ex);
    unprotect(ctx, iterator);
    if (deref ex != null) {
        return;
    }
    protect(ctx, items);
    var total: i64 = length(ctx, items, ex);
    for (var i: i64 = 0; i < total && deref ex == null; i++) {
        var item: ptr<u8> = at(ctx, items, i, ex);
        if (deref ex == null) {
            add_edge(ctx, walk, node, item, item, depth, ex);
        }
    }
    unprotect(ctx, items);
}

// RegExp keeps only its source and flags; lastIndex is reset by the receiver, as in the standard.
fun visit_regexp(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, value: ptr<u8>, depth: i64, ex: ptr<ptr<u8>>) {
    deref node.tag = REGEXP;
    var source: ptr<u8> = string_property(ctx, value, "source", ex);
    protect(ctx, source);
    var flags: ptr<u8> = string_property(ctx, value, "flags", ex);
    protect(ctx, flags);
    if (deref ex == null) {
        add_edge(ctx, walk, node, source, flags, depth, ex);
    }
    unprotect(ctx, flags);
    unprotect(ctx, source);
}

// Errors keep name (only the standard names survive, others become "Error"), message and cause.
// The stack is not cloned. Edge 0 is (name, message); an optional edge 1 is (cause, cause).
fun visit_error(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, value: ptr<u8>, depth: i64, ex: ptr<ptr<u8>>) {
    deref node.tag = ERROR;
    var name: ptr<u8> = string_property(ctx, value, "name", ex);
    protect(ctx, name);
    var message: ptr<u8> = string_property(ctx, value, "message", ex);
    protect(ctx, message);
    if (deref ex == null) {
        add_edge(ctx, walk, node, name, message, depth, ex);
    }
    var has_cause: bool = false;
    var cause: ptr<u8> = undefined(ctx);
    if (deref ex == null) {
        var state: ptr<CloneState> = storage(ctx);
        var key: array<ptr<u8>, 1> = [text(ctx, "cause")];
        protect(ctx, key[0]);
        has_cause = truth(ctx, call(ctx, (deref state.roots)[ROOT_HAS_OWN], value, 1, &key[0], ex));
        unprotect(ctx, key[0]);
        if (deref ex == null && has_cause) {
            cause = get(ctx, value, "cause", ex);
        }
    }
    if (deref ex == null && has_cause) {
        protect(ctx, cause);
        add_edge(ctx, walk, node, cause, cause, depth, ex);
        unprotect(ctx, cause);
    }
    unprotect(ctx, message);
    unprotect(ctx, name);
}
// A boxed primitive is recognized by calling the captured X.prototype.valueOf on it: that throws a
// TypeError for anything that is not a real wrapper object (including forged prototypes). On
// success the primitive is cloned as the single child and node.value records which wrapper it was.
fun unbox(ctx: ptr<u8>, value: ptr<u8>, root: i64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var state: ptr<CloneState> = storage(ctx);
    var discarded: ptr<u8> = null;
    var primitive: ptr<u8> = call(ctx, (deref state.roots)[root], value, 0, null, &discarded);
    if (discarded != null || primitive == null) {
        return null;
    }
    return primitive;
}

fun visit_boxed(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, value: ptr<u8>, depth: i64,
    ex: ptr<ptr<u8>>) -> bool {
    var roots: array<i64, 4> = [ROOT_NUMBER_VALUE, ROOT_STRING_VALUE, ROOT_BOOLEAN_VALUE, ROOT_BIGINT_VALUE];
    var kinds: array<f64, 4> = [BOXED_NUMBER, BOXED_STRING, BOXED_BOOLEAN, BOXED_BIGINT];
    for (var i: i64 = 0; i < 4; i++) {
        var primitive: ptr<u8> = unbox(ctx, value, roots[i], ex);
        if (primitive != null) {
            deref node.tag = BOXED;
            deref node.value = kinds[i];
            protect(ctx, primitive);
            add_edge(ctx, walk, node, primitive, primitive, depth, ex);
            unprotect(ctx, primitive);
            return true;
        }
    }
    return false;
}

// True when `prototype` is the named global's prototype object. A forged prototype can only make a
// value look like a DataView, which makes it get rejected, never wrongly accepted.
fun inherits_from_global(ctx: ptr<u8>, prototype: ptr<u8>, name: str, ex: ptr<ptr<u8>>) -> bool {
    var constructor: ptr<u8> = get(ctx, global(ctx), name, ex);
    if (deref ex != null || kind(ctx, constructor) != 5) {
        return false;
    }
    var expected: ptr<u8> = get(ctx, constructor, "prototype", ex);
    return deref ex == null && kind(ctx, expected) == 5 && equal(ctx, prototype, expected);
}

fun visit_object(ctx: ptr<u8>, walk: ptr<Walk>, node: ptr<CloneNode>, value: ptr<u8>, depth: i64,
    ex: ptr<ptr<u8>>) {
    var state: ptr<CloneState> = storage(ctx);
    var proxy: i32 = proxy_status(ctx, value);
    if (proxy != 0) {
        clone_failure(ctx, ex, "Proxy cloning is unsupported; object clones require the matching engine clone ABI");
        return;
    }
    var view_kind: i32 = typed_type(ctx, value, ex);
    if (deref ex != null) {
        return;
    }
    // JSC's Uint8Array enum is 3; other views/backings are explicitly unsupported.
    if (view_kind == 3) {
        deref node.tag = BYTES;
        deref node.size = typed_length(ctx, value, ex);
        if (deref ex == null && payload(ctx, walk, node, deref node.size, ex)) {
            copy_byte_view(ctx, value, deref node.bytes, deref node.size, ex);
        }
        return;
    }
    var arg: array<ptr<u8>, 1> = [value];
    var parent: ptr<u8> = call(ctx, (deref state.roots)[1], null, 1, &arg[0], ex);
    if (deref ex != null) {
        return;
    }
    if (is_date(ctx, value)) {
        deref node.tag = DATE;
        var stamp: ptr<u8> = call(ctx, (deref state.roots)[6], value, 0, null, ex);
        if (deref ex == null) {
            deref node.value = numeric(ctx, stamp, ex);
        }
        return;
    }
    // Built-ins with internal state are recognized by engine-backed brand checks (brands.wave), never
    // by Symbol.toStringTag. Uncloneable built-ins are rejected instead of silently becoming plain
    // records. Anything else with a prototype, such as a class instance, is cloned as a plain record
    // that keeps its own enumerable data properties.
    if (is_map(ctx, value)) {
        visit_map(ctx, walk, node, value, depth, ex);
        return;
    }
    if (is_set(ctx, value)) {
        visit_set(ctx, walk, node, value, depth, ex);
        return;
    }
    if (is_regexp(ctx, value)) {
        visit_regexp(ctx, walk, node, value, depth, ex);
        return;
    }
    if (is_native_error(ctx, value)) {
        visit_error(ctx, walk, node, value, depth, ex);
        return;
    }
    if (is_weak_map(ctx, value) || is_weak_set(ctx, value) || is_promise(ctx, value)) {
        clone_failure(ctx, ex, "WeakMap, WeakSet and Promise objects cannot be cloned");
        return;
    }
    // Typed arrays other than Uint8Array, ArrayBuffer and DataView are not cloned yet. They must be
    // rejected here: falling through would turn them into empty plain records.
    if (view_kind != 10) {
        clone_failure(ctx, ex, "ArrayBuffer and typed array views other than Uint8Array cannot be cloned yet");
        return;
    }
    if (inherits_from_global(ctx, parent, "DataView", ex)) {
        clone_failure(ctx, ex, "DataView objects cannot be cloned yet");
        return;
    }
    if (visit_boxed(ctx, walk, node, value, depth, ex)) {
        return;
    }
    if (deref ex != null) {
        return;
    }
    if (unbox(ctx, value, ROOT_SYMBOL_VALUE, ex) != null) {
        clone_failure(ctx, ex, "Symbol objects cannot be cloned");
        return;
    }
    if (is_array(ctx, value)) {
        deref node.tag = ARRAY;
        deref node.value = numeric(ctx, get(ctx, value, "length", ex), ex);
    }
    if (deref ex != null) {
        return;
    }
    var keys: ptr<u8> = call(ctx, (deref state.roots)[0], null, 1, &arg[0], ex);
    if (deref ex != null) {
        return;
    }
    protect(ctx, keys);
    var count: i64 = length(ctx, keys, ex);
    if (count > CLONE_NODE_LIMIT || count < 0) {
        clone_failure(ctx, ex, "clone property limit exceeded");
    } else if (count > 0 && deref ex == null) {
        deref node.count = count;
        deref node.edges = mem_alloc_zeroed(count * 16) as ptr<i64>;
        deref node.capacity = count;
        if (deref node.edges == null) {
            clone_failure(ctx, ex, "cannot allocate clone properties");
        }
        // Keys are snapshotted first; a key that an earlier getter deleted is skipped instead of being
        // recreated as undefined, as in the HTML structured serialization steps.
        var written: i64 = 0;
        for (var i: i64 = 0; i < count && deref ex == null; i++) {
            var key: ptr<u8> = at(ctx, keys, i, ex);
            var own_argument: array<ptr<u8>, 1> = [key];
            var owned: bool = truth(ctx, call(ctx, (deref state.roots)[ROOT_HAS_OWN], value, 1, &own_argument[0], ex));
            if (deref ex != null) {
                break;
            }
            if (!owned) {
                continue;
            }
            var key_index: i64 = visit(ctx, walk, key, depth + 1, ex);
            if (deref ex != null) {
                break;
            }
            var child: ptr<u8> = property(ctx, value, key, ex);
            var child_index: i64 = visit(ctx, walk, child, depth + 1, ex);
            if (deref ex == null) {
                (deref node.edges)[written * 2] = key_index;
                (deref node.edges)[written * 2 + 1] = child_index;
                written += 1;
            }
        }
        deref node.count = written;
    }
    unprotect(ctx, keys);
}
pub fun snapshot_clone(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<CloneGraph> {
    var graph: ptr<CloneGraph> = mem_alloc_zeroed(size_of<CloneGraph>() as i64) as ptr<CloneGraph>;
    if (graph == null) {
        clone_failure(ctx, ex, "cannot allocate clone graph");
        return null;
    }
    deref graph.nodes = mem_alloc_zeroed(CLONE_NODE_LIMIT * (size_of<CloneNode>() as i64)) as ptr<CloneNode>;
    var walk: Walk;
    walk.graph = graph;
    walk.refs = mem_alloc_zeroed(CLONE_NODE_LIMIT * 8) as ptr<ptr<u8>>;
    if (deref graph.nodes == null || walk.refs == null) {
        clone_failure(ctx, ex, "cannot allocate clone traversal");
    } else {
        visit(ctx, &walk, value, 0, ex);
    }
    if (walk.refs != null) {
        for (var i: i64 = 0; i < deref graph.count; i++) {
            if (walk.refs[i] != null) {
                unprotect(ctx, walk.refs[i]);
            }
        }
        mem_free(walk.refs as ptr<u8>, CLONE_NODE_LIMIT * 8);
    }
    if (deref ex != null) {
        free_clone(graph);
        return null;
    }
    return graph;
}
// Wraps a restored primitive in its wrapper object by calling the wrapper constructor as a function
// through Object(value), which is exactly what new Number(1), new String("s") and so on produce.
fun box_primitive(ctx: ptr<u8>, primitive: ptr<u8>, kind_code: f64, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var state: ptr<CloneState> = storage(ctx);
    var argument: array<ptr<u8>, 1> = [primitive];
    var wrapper: ptr<u8> = get(ctx, global(ctx), "Object", ex);
    if (deref ex != null) {
        return null;
    }
    var result: ptr<u8> = call(ctx, wrapper, null, 1, &argument[0], ex);
    if (deref ex != null) {
        return null;
    }
    return result;
}

// Picks the standard error constructor matching the cloned name; any other name becomes Error.
fun build_error(ctx: ptr<u8>, node: ptr<CloneNode>, refs: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var state: ptr<CloneState> = storage(ctx);
    var name: ptr<u8> = refs[(deref node.edges)[0]];
    var message: ptr<u8> = refs[(deref node.edges)[1]];
    var names: array<str, 7> = ["Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError",
        "URIError"];
    var chosen: i64 = 0;
    for (var i: i64 = 1; i < ERROR_CTOR_COUNT; i++) {
        var candidate: ptr<u8> = text(ctx, names[i]);
        protect(ctx, candidate);
        if (equal(ctx, name, candidate)) {
            chosen = i;
        }
        unprotect(ctx, candidate);
    }
    var arguments: array<ptr<u8>, 2> = [message, undefined(ctx)];
    var count: i64 = 1;
    var options: ptr<u8> = null;
    if (deref node.count > 1) {
        options = object(ctx, null, null);
        protect(ctx, options);
        define(ctx, options, "cause", refs[(deref node.edges)[2]], ex, true);
        arguments[1] = options;
        count = 2;
    }
    var result: ptr<u8> = construct(ctx, (deref state.roots)[ROOT_ERROR_CTORS + chosen], count, &arguments[0], ex);
    if (options != null) {
        unprotect(ctx, options);
    }
    if (deref ex != null) {
        return null;
    }
    return result;
}

fun map_set(ctx: ptr<u8>, map: ptr<u8>, key: ptr<u8>, item: ptr<u8>, ex: ptr<ptr<u8>>) {
    var state: ptr<CloneState> = storage(ctx);
    var pair: array<ptr<u8>, 2> = [key, item];
    call(ctx, (deref state.roots)[ROOT_MAP_SET], map, 2, &pair[0], ex);
}

fun set_add(ctx: ptr<u8>, collection: ptr<u8>, item: ptr<u8>, ex: ptr<ptr<u8>>) {
    var state: ptr<CloneState> = storage(ctx);
    var argument: array<ptr<u8>, 1> = [item];
    call(ctx, (deref state.roots)[ROOT_SET_ADD], collection, 1, &argument[0], ex);
}

pub fun restore_clone(ctx: ptr<u8>, graph: ptr<CloneGraph>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var refs: ptr<ptr<u8>> = mem_alloc_zeroed(deref graph.count * 8) as ptr<ptr<u8>>;
    if (refs == null) {
        clone_failure(ctx, ex, "cannot allocate clone receiver");
        return undefined(ctx);
    }
    var state: ptr<CloneState> = storage(ctx);
    for (var i: i64 = 0; i < deref graph.count && deref ex == null; i++) {
        var node: ptr<CloneNode> = deref graph.nodes + i;
        var tag: i32 = deref node.tag;
        var value: ptr<u8> = undefined(ctx);
        if (tag == 1) {
            value = js_null(ctx);
        } else if (tag == 2) {
            value = boolean(ctx, deref node.value != 0.0);
        } else if (tag == 3) {
            value = number(ctx, deref node.value);
        } else if (tag == 4 || tag == 7) {
            var content: ptr<u8> = utf16(deref node.bytes as ptr<u16>, deref node.size);
            value = string_value(ctx, content);
            release(content);
            if (tag == 7) {
                protect(ctx, value);
                var arg: array<ptr<u8>, 1> = [value];
                value = call(ctx, (deref state.roots)[4], null, 1, &arg[0], ex);
                unprotect(ctx, arg[0]);
            }
        } else if (tag == RECORD) {
            value = object(ctx, null, null);
        } else if (tag == ARRAY) {
            value = array(ctx, 0, null, ex);
        } else if (tag == MAP) {
            value = construct(ctx, (deref state.roots)[ROOT_MAP_CTOR], 0, null, ex);
        } else if (tag == SET) {
            value = construct(ctx, (deref state.roots)[ROOT_SET_CTOR], 0, null, ex);
        } else if (tag == REGEXP || tag == ERROR || tag == BOXED) {
            // Built in the reverse pass below, once every child value exists.
            value = null;
        } else if (tag == DATE) {
            var arg: array<ptr<u8>, 1> = [number(ctx, deref node.value)];
            value = construct(ctx, (deref state.roots)[5], 1, &arg[0], ex);
        } else if (tag == BYTES) {
            value = new_u8(ctx, deref node.size, ex);
            if (deref ex == null) {
                protect(ctx, value);
                var bytes: ptr<u8> = typed_bytes(ctx, value, ex);
                if (deref ex == null && deref node.size > 0) {
                    mem_copy(bytes, deref node.bytes, deref node.size);
                }
                unprotect(ctx, value);
            }
        }
        if (value != null) {
            protect(ctx, value);
            refs[i] = value;
        }
    }
    // Reverse pass: RegExp, Error and boxed values are built from children that already exist.
    // Children always have larger indexes than their parent, so walking backwards builds a child
    // before any value that uses it.
    for (var back: i64 = deref graph.count - 1; back >= 0 && deref ex == null; back--) {
        var built: ptr<CloneNode> = deref graph.nodes + back;
        var built_tag: i32 = deref built.tag;
        var made: ptr<u8> = null;
        if (built_tag == REGEXP && deref built.count > 0) {
            var pattern: array<ptr<u8>, 2> = [refs[(deref built.edges)[0]], refs[(deref built.edges)[1]]];
            made = construct(ctx, (deref state.roots)[ROOT_REGEXP_CTOR], 2, &pattern[0], ex);
        } else if (built_tag == BOXED && deref built.count > 0) {
            made = box_primitive(ctx, refs[(deref built.edges)[0]], deref built.value, ex);
        } else if (built_tag == ERROR && deref built.count > 0) {
            made = build_error(ctx, built, refs, ex);
        }
        if (made != null && deref ex == null) {
            protect(ctx, made);
            refs[back] = made;
        }
    }
    for (var i: i64 = 0; i < deref graph.count && deref ex == null; i++) {
        var node: ptr<CloneNode> = deref graph.nodes + i;
        var fill_tag: i32 = deref node.tag;
        for (var j: i64 = 0; j < deref node.count && deref ex == null; j++) {
            var key: i64 = (deref node.edges)[j * 2];
            var value: i64 = (deref node.edges)[j * 2 + 1];
            if (fill_tag == MAP) {
                // Map.prototype.set through the receiver's own prototype is avoided: the pair is
                // added with the intrinsic captured at install time.
                map_set(ctx, refs[i], refs[key], refs[value], ex);
            } else if (fill_tag == SET) {
                set_add(ctx, refs[i], refs[key], ex);
            } else if (fill_tag != REGEXP && fill_tag != ERROR && fill_tag != BOXED) {
                define_key(ctx, refs[i], refs[key], refs[value], ex, true);
            }
        }
        if (deref node.tag == ARRAY && deref ex == null) {
            var key: ptr<u8> = utf8("length");
            set(ctx, refs[i], key, number(ctx, deref node.value), 0, ex);
            release(key);
        }
    }
    var result: ptr<u8> = refs[0];
    if (deref ex != null || result == null) {
        result = undefined(ctx);
    }
    for (var i: i64 = 0; i < deref graph.count; i++) {
        if (refs[i] != null) {
            unprotect(ctx, refs[i]);
        }
    }
    mem_free(refs as ptr<u8>, deref graph.count * 8);
    return result;
}
export(c) fun jsrt_structured_clone(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    if (count < 1 || (count > 1 && kind(ctx, args[1]) != 0)) {
        clone_failure(ctx, ex, "structuredClone requires a value; transfer options are not implemented");
        return undefined(ctx);
    }
    var graph: ptr<CloneGraph> = snapshot_clone(ctx, args[0], ex);
    if (graph == null) {
        return undefined(ctx);
    }
    var result: ptr<u8> = restore_clone(ctx, graph, ex);
    free_clone(graph);
    return result;
}
pub fun install_clone(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (!allocate_context_slot(ctx, SLOT, size_of<CloneState>() as i64)) {
        return false;
    }
    var state: ptr<CloneState> = storage(ctx);
    var obj: ptr<u8> = get(ctx, global(ctx), "Object", ex);
    (deref state.roots)[0] = capture(ctx, obj, "keys", ex);
    (deref state.roots)[1] = capture(ctx, obj, "getPrototypeOf", ex);
    (deref state.roots)[2] = capture(ctx, obj, "prototype", ex);
    var arr: ptr<u8> = get(ctx, global(ctx), "Array", ex);
    (deref state.roots)[3] = capture(ctx, arr, "prototype", ex);
    (deref state.roots)[4] = capture(ctx, global(ctx), "BigInt", ex);
    (deref state.roots)[5] = capture(ctx, global(ctx), "Date", ex);
    (deref state.roots)[7] = capture(ctx, (deref state.roots)[5], "prototype", ex);
    (deref state.roots)[6] = capture(ctx, (deref state.roots)[7], "getTime", ex);
    (deref state.roots)[ROOT_HAS_OWN] = capture(ctx, (deref state.roots)[2], "hasOwnProperty", ex);
    var root: ptr<u8> = global(ctx);
    (deref state.roots)[ROOT_MAP_CTOR] = capture(ctx, root, "Map", ex);
    (deref state.roots)[ROOT_SET_CTOR] = capture(ctx, root, "Set", ex);
    (deref state.roots)[ROOT_REGEXP_CTOR] = capture(ctx, root, "RegExp", ex);
    (deref state.roots)[ROOT_MAP_ENTRIES] = capture(ctx, get(ctx, (deref state.roots)[ROOT_MAP_CTOR], "prototype", ex),
        "entries", ex);
    (deref state.roots)[ROOT_SET_VALUES] = capture(ctx, get(ctx, (deref state.roots)[ROOT_SET_CTOR], "prototype", ex),
        "values", ex);
    (deref state.roots)[ROOT_ARRAY_FROM] = capture(ctx, arr, "from", ex);
    (deref state.roots)[ROOT_MAP_SET] = capture(ctx, get(ctx, (deref state.roots)[ROOT_MAP_CTOR], "prototype", ex), "set", ex);
    (deref state.roots)[ROOT_SET_ADD] = capture(ctx, get(ctx, (deref state.roots)[ROOT_SET_CTOR], "prototype", ex), "add", ex);
    (deref state.roots)[ROOT_NUMBER_VALUE] = capture(ctx, get(ctx, get(ctx, root, "Number", ex), "prototype", ex), "valueOf", ex);
    (deref state.roots)[ROOT_STRING_VALUE] = capture(ctx, get(ctx, get(ctx, root, "String", ex), "prototype", ex), "valueOf", ex);
    (deref state.roots)[ROOT_BOOLEAN_VALUE] = capture(ctx, get(ctx, get(ctx, root, "Boolean", ex), "prototype", ex), "valueOf", ex);
    (deref state.roots)[ROOT_BIGINT_VALUE] = capture(ctx, get(ctx, get(ctx, root, "BigInt", ex), "prototype", ex), "valueOf", ex);
    (deref state.roots)[ROOT_SYMBOL_VALUE] = capture(ctx, get(ctx, get(ctx, root, "Symbol", ex), "prototype", ex), "valueOf", ex);
    var error_names: array<str, 7> = ["Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError",
        "URIError"];
    for (var i: i64 = 0; i < ERROR_CTOR_COUNT; i++) {
        (deref state.roots)[ROOT_ERROR_CTORS + i] = capture(ctx, root, error_names[i], ex);
    }
    var name: ptr<u8> = utf8("structuredClone");
    var fn: ptr<u8> = function(ctx, name, clone_callback());
    release(name);
    define(ctx, global(ctx), "structuredClone", fn, ex, true);
    return deref ex == null;
}
pub fun shutdown_clone(ctx: ptr<u8>) {
    var state: ptr<CloneState> = storage(ctx);
    if (state == null) {
        return;
    }
    for (var i: i64 = 0; i < ROOT_COUNT; i++) {
        if ((deref state.roots)[i] != null) {
            unprotect(ctx, (deref state.roots)[i]);
        }
    }
    release_context_slot(ctx, SLOT, size_of<CloneState>() as i64);
}
