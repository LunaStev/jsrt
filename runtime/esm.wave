// Engine-owned ESM graphs; Wave owns exact local resolution and bounded source I/O.
import("./context_state")::{context_slot, allocate_context_slot, release_context_slot};
import("./config")::{MODULE_LIMIT};
import("./module_files")::{canonical, ends};
import("./module_support")::{builtin};
import("./module_packages")::{esm_scope};
import("./module_resolver")::{resolve_esm_path};
import("./module_compile")::{body};
import("./system")::{copy_host_path, read_text_file};
import("./values")::{text, get, capture, plain, define, fail};
import("./esm_interop")::{synthetic_available, canonical_builtin, host_exports, install_interop, shutdown_interop};
import("./esm_files")::{decode_file_url};
import("std::path::copy")::{path_dirname_copy};
import("std::mem::alloc")::{mem_free};
import("std::mem::layout")::{size_of};
import("std::mem::cstr")::{mem_len_cstr, mem_eq_cstr};
extern(c, "jsrt_esm_available") fun available() -> bool;
extern(c, "jsrt_esm_check") fun check(ctx: ptr<u8>, source: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> bool;
extern(c, "jsrt_esm_install") fun install(ctx: ptr<u8>, resolve: ptr<u8>, fetch: ptr<u8>, meta: ptr<u8>,
    value: ptr<u8>) -> bool;
extern(c, "jsrt_esm_dispose") fun dispose(ctx: ptr<u8>);
extern(c, "jsrt_esm_evaluate") fun evaluate(ctx: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_esm_callback") fun callback(kind: i32) -> ptr<u8>;
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_to_string") fun to_string(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_set") fun set(ctx: ptr<u8>, object: ptr<u8>, name: ptr<u8>, value: ptr<u8>, flags: u32,
    ex: ptr<ptr<u8>>);
const SLOT: i64 = 31;
const PATH_CAP: i64 = 8192;
struct State {
    then_fn: ptr<u8>;
    fulfilled: ptr<u8>;
    rejected: ptr<u8>;
    promise: ptr<u8>;
    failure: ptr<u8>;
    fetch_count: i64;
    settled: i32;
}

fun state(ctx: ptr<u8>) -> ptr<State> {
    return context_slot(ctx, SLOT) as ptr<State>;
}

pub fun esm_available() -> bool {
    return available();
}

pub fun check_esm(ctx: ptr<u8>, source: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (!available()) {
        return false;
    }
    return check(ctx, source, key, ex);
}

export(c) fun jsrt_esm_resolve(ctx: ptr<u8>, specifier: ptr<u8>, referrer: ptr<u8>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var name: array<u8, 8192>;
    var decoded: array<u8, 8192>;
    var parent: array<u8, 8192>;
    var directory: array<u8, 8192>;
    if (copy_host_path(ctx, specifier, &name[0], PATH_CAP, ex) < 0) {
        return null;
    }
    if (builtin(&name[0] as str) >= 0) {
        return canonical_builtin(ctx, &name[0] as str, ex);
    }
    var request: ptr<u8> = &name[0];
    if (decode_file_url(ctx, &name[0], &decoded[0], ex)) {
        request = &decoded[0];
    }
    if (deref ex != null) {
        return null;
    }
    if (request[0] == 47) {
        directory[0] = 47;
        directory[1] = 0;
    } else {
        if (copy_host_path(ctx, referrer, &parent[0], PATH_CAP, ex) < 0) {
            return null;
        }
        if (parent[0] != 47) {
            fail(ctx, ex, 1, "ESM imports require an absolute file referrer");
            return null;
        }
        if (path_dirname_copy(&directory[0], PATH_CAP as i32, &parent[0] as str) < 0) {
            if (deref ex == null) {
                fail(ctx, ex, 2, "ESM referrer path exceeds limit");
            }
            return null;
        }
    }
    var resolved: ptr<u8> = resolve_esm_path(ctx, &directory[0] as str, request as str, ex);
    if (deref ex != null) {
        return null;
    }
    if (resolved == null) {
        fail(ctx, ex, 0, "ESM file was not found or is not a regular file");
        return null;
    }
    if (builtin(resolved as str) >= 0) {
        var result: ptr<u8> = canonical_builtin(ctx, resolved as str, ex);
        mem_free(resolved, PATH_CAP);
        return result;
    }
    if (!ends(resolved as str, ".mjs") && !ends(resolved as str, ".js") &&
        !(synthetic_available() && (ends(resolved as str, ".cjs") || ends(resolved as str, ".json")))) {
        fail(ctx, ex, 1, "ESM supports JavaScript files only; CJS and JSON interop are not implemented");
        mem_free(resolved, PATH_CAP);
        return null;
    }
    if (!esm_scope(ctx, resolved as str, ex) && !synthetic_available()) {
        if (deref ex == null) {
            fail(ctx, ex, 1, "CommonJS to ESM import interop is not implemented");
        }
        mem_free(resolved, PATH_CAP);
        return null;
    }
    if (deref ex != null) {
        mem_free(resolved, PATH_CAP);
        return null;
    }
    var result: ptr<u8> = utf8(resolved as str);
    mem_free(resolved, PATH_CAP);
    return result;
}

export(c) fun jsrt_esm_value(ctx: ptr<u8>, key: ptr<u8>, fetch_type: i32,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    if (s == null) {
        fail(ctx, ex, 0, "ESM host has stopped");
        return undefined(ctx);
    }
    return host_exports(ctx, key, fetch_type, &(deref s.fetch_count), ex);
}

export(c) fun jsrt_esm_fetch(ctx: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    if (s == null || deref s.fetch_count >= MODULE_LIMIT) {
        fail(ctx, ex, 2, "ESM source count exceeds module limit");
        return null;
    }
    (deref s.fetch_count) += 1;
    var source: ptr<u8> = read_text_file(ctx, key, ex);
    if (deref ex != null) {
        return null;
    }
    protect(ctx, source);
    var original: ptr<u8> = to_string(ctx, source, ex);
    var result: ptr<u8> = null;
    if (deref ex == null && original != null) {
        result = body(ctx, original, ex);
    }
    if (original != null) {
        release(original);
    }
    unprotect(ctx, source);
    return result;
}

export(c) fun jsrt_esm_meta(ctx: ptr<u8>, key: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var path: array<u8, 8192>;
    var url: array<u8, 24584>;
    var length: i64 = copy_host_path(ctx, key, &path[0], PATH_CAP, ex);
    if (length < 0) {
        return null;
    }
    var prefix: str = "file://";
    for (var i: i64 = 0; i < 7; i++) {
        url[i] = prefix[i];
    }
    var digits: str = "0123456789ABCDEF";
    var at: i64 = 7;
    for (var i: i64 = 0; i < length; i++) {
        var octet: u8 = path[i];
        if ((octet >= 65 && octet <= 90) || (octet >= 97 && octet <= 122) || (octet >= 48 && octet <= 57) || octet == 47 || octet == 45 || octet == 46 || octet == 95 || octet == 126) {
            url[at] = octet;
            at += 1;
        } else {
            url[at] = 37;
            url[at + 1] = digits[(octet as i64) / 16];
            url[at + 2] = digits[(octet as i64) % 16];
            at += 3;
        }
    }
    url[at] = 0;
    var result: ptr<u8> = plain(ctx);
    protect(ctx, result);
    define(ctx, result, "url", text(ctx, &url[0] as str), ex, true);
    define(ctx, result, "filename", key, ex, true);
    unprotect(ctx, result);
    return result;
}

export(c) fun jsrt_esm_fulfilled(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    if (s != null) {
        deref s.settled = 1;
    }
    return undefined(ctx);
}

export(c) fun jsrt_esm_rejected(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var s: ptr<State> = state(ctx);
    if (s != null && deref s.settled == 0) {
        deref s.failure = undefined(ctx);
        if (count > 0) {
            deref s.failure = args[0];
        }
        protect(ctx, deref s.failure);
        deref s.settled = 2;
    }
    return undefined(ctx);
}

pub fun install_esm(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    if (!available()) {
        return true;
    }
    if (!allocate_context_slot(ctx, SLOT, size_of<State>() as i64)) {
        return false;
    }
    var s: ptr<State> = state(ctx);
    deref s.then_fn = capture(ctx, get(ctx, get(ctx, global(ctx), "Promise", ex), "prototype", ex), "then", ex);
    for (var i: i32 = 0; i < 2; i++) {
        var name: ptr<u8> = utf8("moduleCompletion");
        var fn: ptr<u8> = function(ctx, name, callback(i + 3));
        release(name);
        protect(ctx, fn);
        if (i == 0) {
            deref s.fulfilled = fn;
        } else {
            deref s.rejected = fn;
        }
    }
    if (deref ex != null) {
        return false;
    }
    return install_interop(ctx, ex) && install(ctx, callback(0), callback(1), callback(2), callback(5));
}

pub fun execute_esm(ctx: ptr<u8>, path: str, ex: ptr<ptr<u8>>) {
    var s: ptr<State> = state(ctx);
    if (s == null) {
        fail(ctx, ex, 0, "ESM requires the matching JavaScriptCore module-enabled build");
        return;
    }
    var resolved: ptr<u8> = canonical(path);
    if (resolved == null) {
        fail(ctx, ex, 0, "ESM entry file was not found");
        return;
    }
    var key: ptr<u8> = utf8(resolved as str);
    mem_free(resolved, PATH_CAP);
    deref s.promise = evaluate(ctx, key, ex);
    release(key);
    if (deref s.promise == null || deref ex != null) {
        deref s.promise = null;
        return;
    }
    protect(ctx, deref s.promise);
    var constructor: ptr<u8> = utf8("constructor");
    set(ctx, deref s.promise, constructor, undefined(ctx), 14, ex);
    release(constructor);
    var args: array<ptr<u8>, 2> = [deref s.fulfilled, deref s.rejected];
    if (deref ex == null) {
        call(ctx, deref s.then_fn, deref s.promise, 2, &args[0], ex);
    }
}

pub fun esm_result(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var s: ptr<State> = state(ctx);
    if (s == null || deref s.promise == null) {
        return true;
    }
    if (deref s.settled == 2) {
        deref ex = deref s.failure;
        return false;
    }
    if (deref s.settled == 0) {
        fail(ctx, ex, 0, "Top-level await remains pending with no active host work");
        return false;
    }
    return true;
}

pub fun esm_failed(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var s: ptr<State> = state(ctx);
    if (s != null && deref s.settled == 2) {
        deref ex = deref s.failure;
        return true;
    }
    return false;
}

pub fun shutdown_esm(ctx: ptr<u8>) {
    var s: ptr<State> = state(ctx);
    if (s == null) {
        return;
    }
    dispose(ctx);
    shutdown_interop(ctx);
    var roots: array<ptr<u8>, 5> = [deref s.then_fn, deref s.fulfilled, deref s.rejected, deref s.promise,
        deref s.failure];
    for (var i: i64 = 0; i < 5; i++) {
        if (roots[i] != null) {
            unprotect(ctx, roots[i]);
        }
    }
    release_context_slot(ctx, SLOT, size_of<State>() as i64);
}
