import("./context_state")::{owned_context_slot, active_context};
import("std::mem::layout")::{size_of};
struct UtilState {
    exports: ptr<u8>;
    originals: ptr<u8>;
    set_prototype_fn: ptr<u8>;
    methods: array<ptr<u8>, 7>;
}

fun util_storage(ctx: ptr<u8>) -> ptr<UtilState> {
    return owned_context_slot(ctx, 25, size_of<UtilState>() as i64) as ptr<UtilState>;
}

// Callback-to-Promise adapters use native callbacks and JSC-owned Promise jobs.
import("./values")::{get, put, plain, define, fail, capture};
import("./collections")::{bind_one, flag, set_flag, weak_map, weak_get, weak_set};
import("./buffer_core")::{is_byte_view};
import("./config")::{ARGUMENT_LIMIT};
import("./format")::{format_to_value, inspect_to_value};
import("./inspect")::{set_inspect_function, inspect_intrinsic, INSPECT_CUSTOM};
extern(c, "wr_type") fun kind(ctx: ptr<u8>, value: ptr<u8>) -> i32;
extern(c, "wr_callable") fun callable(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_equal") fun equal(ctx: ptr<u8>, a: ptr<u8>, b: ptr<u8>) -> bool;
extern(c, "wr_to_boolean") fun truth(ctx: ptr<u8>, value: ptr<u8>) -> bool;
extern(c, "wr_boolean") fun boolean(ctx: ptr<u8>, value: bool) -> ptr<u8>;
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_function") fun function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_string_utf8") fun utf8(value: str) -> ptr<u8>;
extern(c, "wr_string_release") fun release(value: ptr<u8>);
extern(c, "wr_protect") fun protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun unprotect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_call") fun call(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_promise") fun promise(ctx: ptr<u8>, resolve: ptr<ptr<u8>>, reject: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "jsrt_util_callback") fun callback() -> ptr<u8>;
extern(c, "wr_context_global") fun global(ctx: ptr<u8>) -> ptr<u8>;

fun format_result(ctx: ptr<u8>, value: ptr<u8>) -> ptr<u8> {
    if (value == null) {
        return undefined(ctx);
    }
    return value;
}

export(c) fun jsrt_util_api(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64, args: ptr<ptr<u8>>,
    ex: ptr<ptr<u8>>) -> ptr<u8> {
    var host_state: ptr<UtilState> = util_storage(ctx);
    if (equal(ctx, fn, (deref host_state.methods)[5])) {
        return format_result(ctx, format_to_value(ctx, count, args, ex));
    }
    if (equal(ctx, fn, (deref host_state.methods)[6])) {
        return format_result(ctx, inspect_to_value(ctx, count, args, ex));
    }
    if (equal(ctx, fn, (deref host_state.methods)[4])) {
        if (count != 2 || kind(ctx, args[0]) != 5 || kind(ctx, args[1]) != 5 ||
            !callable(ctx, args[0]) || !callable(ctx, args[1])) {
            fail(ctx, ex, 1, "inherits requires two constructors");
            return undefined(ctx);
        }
        var parent: ptr<u8> = get(ctx, args[1], "prototype", ex);
        protect(ctx, parent);
        var child: ptr<u8> = get(ctx, args[0], "prototype", ex);
        protect(ctx, child);
        if (deref ex == null && kind(ctx, parent) == 5 && kind(ctx, child) == 5) {
            define(ctx, args[0], "super_", args[1], ex, false);
            if (deref ex == null) {
                var pair: array<ptr<u8>, 2> = [child, parent];
                var changed: ptr<u8> = call(ctx, deref host_state.set_prototype_fn, null, 2, &pair[0], ex);
                if (deref ex == null && !truth(ctx, changed)) {
                    fail(ctx, ex, 1, "cannot set inherited prototype");
                }
            }
        } else {
            fail(ctx, ex, 1, "constructors need object prototypes");
        }
        unprotect(ctx, child);
        unprotect(ctx, parent);
        return undefined(ctx);
    }
    if (equal(ctx, fn, (deref host_state.methods)[3])) {
        return boolean(ctx, count > 0 && is_byte_view(ctx, args[0], ex));
    }
    if (equal(ctx, fn, (deref host_state.methods)[0])) {
        if (count == 0 || kind(ctx, args[0]) != 5 || !callable(ctx, args[0])) {
            fail(ctx, ex, 1, "promisify requires a function");
            return undefined(ctx);
        }
        var name: ptr<u8> = utf8("promisified");
        var wrapper: ptr<u8> = function(ctx, name, callback());
        release(name);
        protect(ctx, wrapper);
        weak_set(ctx, (deref host_state.originals), wrapper, args[0], ex);
        unprotect(ctx, wrapper);
        return wrapper;
    }
    if (equal(ctx, fn, (deref host_state.methods)[2])) {
        if (count == 0) {
            return undefined(ctx);
        }
        var record: ptr<u8> = args[0];
        if (flag(ctx, record, "done", ex)) {
            return undefined(ctx);
        }
        set_flag(ctx, record, "done", true, ex);
        var value: ptr<u8> = undefined(ctx);
        var error: bool = count > 1 && truth(ctx, args[1]);
        if (error) {
            value = args[1];
        } else if (count > 2) {
            value = args[2];
        }
        var key: str = "resolve";
        if (error) {
            key = "reject";
        }
        var cb: ptr<u8> = get(ctx, record, key, ex);
        protect(ctx, cb);
        put(ctx, record, "resolve", undefined(ctx), ex);
        put(ctx, record, "reject", undefined(ctx), ex);
        var result: array<ptr<u8>, 1> = [value];
        call(ctx, cb, null, 1, &result[0], ex);
        unprotect(ctx, cb);
        return undefined(ctx);
    }
    var original: ptr<u8> = weak_get(ctx, (deref host_state.originals), fn, ex);
    if (kind(ctx, original) != 5) {
        fail(ctx, ex, 1, "invalid promisified function");
        return undefined(ctx);
    }
    protect(ctx, original);
    var resolve: ptr<u8> = null;
    var reject: ptr<u8> = null;
    var result: ptr<u8> = promise(ctx, &resolve, &reject, ex);
    protect(ctx, result);
    protect(ctx, resolve);
    protect(ctx, reject);
    var record: ptr<u8> = plain(ctx);
    protect(ctx, record);
    put(ctx, record, "resolve", resolve, ex);
    put(ctx, record, "reject", reject, ex);
    var done: ptr<u8> = bind_one(ctx, (deref host_state.methods)[2], null, record, ex);
    protect(ctx, done);
    var nested: ptr<u8> = null;
    if (count > ARGUMENT_LIMIT) {
        fail(ctx, &nested, 2, "promisified argument limit exceeded");
    } else {
        var params: array<ptr<u8>, 65>;
        for (var i: i64 = 0; i < count; i++) {
            params[i] = args[i];
        }
        params[count] = done;
        call(ctx, original, receiver, count + 1, &params[0], &nested);
    }
    if (nested != null && !flag(ctx, record, "done", ex)) {
        set_flag(ctx, record, "done", true, ex);
        var problem: array<ptr<u8>, 1> = [nested];
        call(ctx, reject, null, 1, &problem[0], ex);
        put(ctx, record, "resolve", undefined(ctx), ex);
        put(ctx, record, "reject", undefined(ctx), ex);
    }
    unprotect(ctx, done);
    unprotect(ctx, record);
    unprotect(ctx, reject);
    unprotect(ctx, resolve);
    unprotect(ctx, result);
    unprotect(ctx, original);
    return result;
}

pub fun install_util(ctx: ptr<u8>, ex: ptr<ptr<u8>>) -> bool {
    var host_state: ptr<UtilState> = util_storage(ctx);
    deref host_state.set_prototype_fn = capture(ctx, get(ctx, global(ctx), "Reflect", ex), "setPrototypeOf", ex);
    (deref host_state.originals) = weak_map(ctx, ex);
    protect(ctx, (deref host_state.originals));
    (deref host_state.exports) = plain(ctx);
    protect(ctx, (deref host_state.exports));
    var names: array<str, 7> = ["promisify", "promisified", "completion", "isUint8Array", "inherits", "format", "inspect"];
    for (var i: i64 = 0; i < 7; i++) {
        var name: ptr<u8> = utf8(names[i]);
        (deref host_state.methods)[i] = function(ctx, name, callback());
        release(name);
        protect(ctx, (deref host_state.methods)[i]);
    }
    define(ctx, (deref host_state.exports), "promisify", (deref host_state.methods)[0], ex, false);
    define(ctx, (deref host_state.exports), "inherits", (deref host_state.methods)[4], ex, false);
    define(ctx, (deref host_state.exports), "format", (deref host_state.methods)[5], ex, false);
    define(ctx, (deref host_state.exports), "inspect", (deref host_state.methods)[6], ex, false);
    define(ctx, (deref host_state.methods)[6], "custom", inspect_intrinsic(ctx, INSPECT_CUSTOM), ex, false);
    set_inspect_function(ctx, (deref host_state.methods)[6]);
    var types: ptr<u8> = plain(ctx);
    protect(ctx, types);
    define(ctx, types, "isUint8Array", (deref host_state.methods)[3], ex, false);
    define(ctx, (deref host_state.exports), "types", types, ex, false);
    unprotect(ctx, types);
    return deref ex == null;
}

pub fun util_module() -> ptr<u8> {
    var host_state: ptr<UtilState> = util_storage(active_context());
    return(deref host_state.exports);
}

pub fun shutdown_util(ctx: ptr<u8>) {
    var host_state: ptr<UtilState> = util_storage(ctx);
    if (deref host_state.set_prototype_fn != null) {
        unprotect(ctx, deref host_state.set_prototype_fn);
        deref host_state.set_prototype_fn = null;
    }
    if ((deref host_state.originals) != null) {
        unprotect(ctx, (deref host_state.originals));
        (deref host_state.originals) = null;
    }
    if ((deref host_state.exports) != null) {
        unprotect(ctx, (deref host_state.exports));
        (deref host_state.exports) = null;
    }
    for (var i: i64 = 0; i < 7; i++) {
        if ((deref host_state.methods)[i] != null) {
            unprotect(ctx, (deref host_state.methods)[i]);
            (deref host_state.methods)[i] = null;
        }
    }
}
