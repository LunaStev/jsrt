+        for (auto& entry : exportEntries()) {
+            bool written = false;
+            symbolTablePutTouchWatchpointSet(moduleEnvironment(), globalObject, entry.value.localName,
+                value, false, true, written);
+            if (scope.exception()) {
+                m_runtimeEvaluationError.set(vm, this, scope.exception()->value());
+                return { };
+            }
+            ASSERT(written);
+        }
+        m_runtimeValueEvaluator.clear();
