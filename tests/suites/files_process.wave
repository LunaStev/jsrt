// Filesystem, directory, system and owned child-process regressions.
import("jsrt::tools::support")::{join};
import("std::fs::file")::{create, write, remove};
import("std::io::fd")::{io_close, io_pipe};
import("std::mem::ops")::{mem_copy};
import("std::mem::cstr")::{mem_len_cstr};
import("std::sys::fs")::{ftruncate, mkdir, rmdir};
import("./harness")::{async_case, check, expect, filesystem_case, test, TestState, test_state};
extern(c, "symlink") fun symlink(target: str, link_path: str) -> i32;
extern(c, "jsrt_pipe_write") fun test_pipe_write(fd: i32, bytes: ptr<u8>, count: i64) -> i64;

pub fun file_tests() {
    var suite: ptr<TestState> = test_state();
    var source_path: str = join((deref suite.directory) as str, "source.js") as str;
    var source: str = "console.log([1,2,3].reduce((a,b) => a+b, 0));";
    check("write source using Wave std", write(source_path, source as ptr<u8>, mem_len_cstr(source)) >= 0);
    var command: array<str, 3> = [(deref suite.binary) as str, "run", source_path];
    expect("JS file with Unicode and spaces in path", &command[0], 3, "6\n" as ptr<u8>, 2, 0, "");
    var direct: array<str, 2> = [(deref suite.binary) as str, source_path];
    expect("direct file execution", &direct[0], 2, "6\n" as ptr<u8>, 2, 0, "");

    source = "console.log(JSON.stringify(process.argv.slice(2)));";
    write(source_path, source as ptr<u8>, mem_len_cstr(source));
    var forwarded: array<str, 6> = [(deref suite.binary) as str, "run", source_path, "--", "한글", "--version"];
    var forwarded_output: str = "[\"한글\",\"--version\"]\n";
    expect("file execution forwards script arguments", &forwarded[0], 6, forwarded_output as ptr<u8>,
        mem_len_cstr(forwarded_output), 0, "");
    var direct_args: array<str, 4> = [(deref suite.binary) as str, source_path, "한글", "--version"];
    expect("direct execution forwards flags as script arguments", &direct_args[0], 4, forwarded_output as ptr<u8>,
        mem_len_cstr(forwarded_output), 0, "");
    direct_args[1] = "--check";
    direct_args[2] = source_path;
    direct_args[3] = "extra";
    expect("syntax check rejects script arguments", &direct_args[0], 4, "" as ptr<u8>, 0, 2, "expected one script");

    source = "console.log('must not run'); throw new Error('not executed');";
    write(source_path, source as ptr<u8>, mem_len_cstr(source));
    command[1] = "--check";
    expect("syntax check does not execute", &command[0], 3, "" as ptr<u8>, 0, 0, "");
    source = "const = ;";
    write(source_path, source as ptr<u8>, mem_len_cstr(source));
    expect("syntax check reports error", &command[0], 3, "" as ptr<u8>, 0, 1, "SyntaxError");

    source = "console.log('must not run');";
    var invalid: array<u8, 64>;
    var prefix_length: i64 = mem_len_cstr(source);
    mem_copy(&invalid[0], source as ptr<u8>, prefix_length);
    invalid[prefix_length] = 0;
    invalid[prefix_length + 1] = 120;
    write(source_path, &invalid[0], prefix_length + 2);
    command[1] = "run";
    expect("NUL source rejected before execution", &command[0], 3, "" as ptr<u8>, 0, 1, "NUL byte");
    var fd: i64 = create(source_path);
    ftruncate(fd, 4194305);
    io_close(fd);
    expect("source size limit", &command[0], 3, "" as ptr<u8>, 0, 1, "4 MiB");
    command[2] = join((deref suite.directory) as str, "probe.js") as str;
    expect("missing source", &command[0], 3, "" as ptr<u8>, 0, 1, "cannot read script");
}

pub fun system_tests() {
    var suite: ptr<TestState> = test_state();
    var app_syntax: array<str, 3> = [(deref suite.binary) as str, "--check", "tests/npm_compat.js"];
    expect("package app and CLI fixtures parse on JSC without downloading dependencies", &app_syntax[0], 3,
        "" as ptr<u8>, 0, 0, "");
    test("beforeExit observes the code and runs before exit", "process.exitCode=7;process.on('beforeExit',c=>console.log('before',c));process.on('exit',c=>console.log('exit',c));console.log('main');",
        "main\nbefore 7\nexit 7\n", 7, "");
    test("beforeExit can revive timers and fires again after work drains", "let n=0;process.on('beforeExit',()=>{console.log('before',++n);if(n===1)setTimeout(()=>console.log('timer'),1)});process.on('exit',()=>console.log('exit'));",
        "before 1\ntimer\nbefore 2\nexit\n", 0, "");
    test("beforeExit engine jobs can revive file work", "let n=0;process.on('beforeExit',()=>{console.log('before',++n);if(n===1)Promise.resolve().then(()=>require('fs/promises').readFile('tests/app_input.json','utf8')).then(s=>console.log(JSON.parse(s).data.message))});",
        "before 1\n한글\nbefore 2\n", 0, "");
    test("beforeExit repeats after an owned child process drains", "let n=0;process.on('beforeExit',()=>{console.log('before',++n);if(n===1)require('child_process').spawn(process.execPath,['-e',\"console.log('child')\"],{stdio:'inherit'}).on('exit',c=>console.log('child exit',c))});",
        "before 1\nchild\nchild exit 0\nbefore 2\n", 0, "");
    test("beforeExit listener errors preserve first exception", "process.on('beforeExit',()=>{throw Error('beforeExit failure')});process.on('exit',()=>console.log('unexpected'));",
        "", 1, "beforeExit failure");
    test("inherits rejects primitive constructors before native function checks", "const u=require('util');for(const value of [undefined,null,1,'text',Symbol(),{},()=>{}]){try{u.inherits(value,4)}catch(e){console.log(e instanceof TypeError)}}",
        "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n", 0, "");
    test("stdio hook rejects primitive callbacks before native function checks", "for(const value of [undefined,null,1,'text',Symbol()]){try{process.stdout._write(Buffer.from('x'),'utf8',value)}catch(e){console.log(e instanceof TypeError)}}",
        "true\ntrue\ntrue\ntrue\ntrue\n", 0, "");
    test("inherits preserves prototype trap exceptions and captured intrinsics", "const u=require('util'),reason=Error('trap');function A(){}function B(){}B.prototype=new Proxy({},{setPrototypeOf(){throw reason}});try{u.inherits(B,A)}catch(e){console.log(e===reason)}Reflect.setPrototypeOf=()=>{throw Error('poison')};function C(){}u.inherits(C,A);console.log(new C instanceof A);",
        "true\ntrue\n", 0, "");
    test("inherits rejects cyclic and frozen child prototypes", "const u=require('util');function A(){}try{u.inherits(A,A)}catch(e){console.log(e instanceof TypeError)}function B(){}Object.preventExtensions(B.prototype);try{u.inherits(B,A)}catch(e){console.log(e instanceof TypeError)};",
        "true\ntrue\n", 0, "");
    test("signal subscriptions alone do not keep the process alive", "process.on('SIGTERM',()=>console.log('unexpected'));console.log('done');",
        "done\n", 0, "");
    async_case("signal dispatch wakes a host timer without a TCP handle", "const f=require('fs'),p=process.argv[2];f.writeFileSync(p,'starting');const src=\"const t=setInterval(()=>{},60000);process.once('SIGTERM',()=>{clearInterval(t);console.log('signal')});require('fs').writeFileSync(process.argv[2],'ready');\";const c=require('child_process').spawn(process.execPath,['-e',src,'--',p],{stdio:'inherit'});const t=setInterval(()=>{if(f.existsSync(p)&&f.readFileSync(p,'utf8')==='ready'){clearInterval(t);c.kill('SIGTERM')}},2);c.on('exit',code=>console.log(code));",
        "signal\n0\n", 0, "");
    test("process metadata reports jsrt and real JSC without Node branding", "console.log(process.platform,process.arch,process.versions.jsrt,typeof process.versions.jsc,process.versions.node===undefined);",
        "linux x64 0.1.0-dev string true\n", 0, "");
    test("stdio writable streams preserve callbacks and exit events", "process.on('exit',code=>console.log('exit',code));process.stdout.write('bytes',()=>console.log(' callback'));process.stderr.write('error');",
        "bytes callback\nexit 0\n", 0, "error");
    test("util inherits preserves child methods and parent prototype", "const u=require('util');function A(){}A.prototype.a=42;function B(){}B.prototype.b=7;u.inherits(B,A);const b=new B;console.log(b instanceof A,b instanceof B,b.a,b.b,B.super_===A,Object.keys(B).length);",
        "true true 42 7 true 0\n", 0, "");
    test("querystring parser safely aggregates duplicate and prototype names", "const q=require('node:querystring').parse('a=1&a=2&__proto__=safe&x=a+b');console.log(Object.getPrototypeOf(q)===null,q.a.join(','),q.__proto__,q.x);",
        "true 1,2 safe a b\n", 0, "");
    test("process environment snapshot and cwd", "console.log(Array.isArray(process.argv),process.argv[1],typeof process.env.PATH,Object.getPrototypeOf(process.env)===null,process.cwd().startsWith('/'));process.env.__proto__='plain';console.log(process.env.__proto__);",
        "true <eval> string true true\nplain\n", 0, "");
    var arguments: array<str, 7> = [(deref suite.binary) as str, "-e", "console.log(JSON.stringify(process.argv.slice(1)));",
        "--", "한글", "--flag", ""];
    var expected: str = "[\"<eval>\",\"한글\",\"--flag\",\"\"]\n";
    expect("eval forwards arguments after delimiter", &arguments[0], 7, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    test("exitCode waits for timers and microtasks", "process.exitCode=7;queueMicrotask(()=>console.log('microtask'));setTimeout(()=>console.log(process.exitCode),1);",
        "microtask\n7\n", 7, "");
    test("exitCode validates without coercion", "for(const v of ['7',null,true,{},1n]){try{process.exitCode=v;}catch(e){console.log(e instanceof TypeError);}}for(const v of [NaN,Infinity,-1,256,1.5]){try{process.exitCode=v;}catch(e){console.log(e instanceof RangeError);}}console.log(process.exitCode);",
        "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n0\n", 0, "");
    test("exitCode reset and descriptor integrity", "process.exitCode=9;process.exitCode=undefined;console.log(process.exitCode,Reflect.deleteProperty(process,'exitCode'));try{Object.defineProperty(process,'exitCode',{get(){return 55;}});}catch(e){console.log(e instanceof TypeError);}",
        "0 false\ntrue\n", 0, "");
    test("uncaught exception overrides exitCode", "process.exitCode=7;throw new Error('exit failure');",
        "", 1, "exit failure");
    test("captured errors survive constructor mutation", "const OriginalTypeError=TypeError;globalThis.TypeError=null;try{require('node:fs').readFileSync(42);}catch(e){console.log(e instanceof OriginalTypeError);}",
        "true\n", 0, "");

    var path: str = join((deref suite.directory) as str, "source.js") as str;
    var source: str = "const p=process.argv[2];const s='한글😀\\0끝\\ufeff';console.log(require('node:fs').writeFileSync(p,s)===undefined);console.log(require('node:fs').readFileSync(p,'utf8')===s);require('node:fs').writeFileSync(p,'x','utf8');console.log(require('node:fs').readFileSync(p,'utf8'));require('node:fs').writeFileSync(p,'');console.log(require('node:fs').readFileSync(p,'utf8').length);";
    var command: array<str, 4> = [(deref suite.binary) as str, "-e", source, path];
    expected = "true\ntrue\nx\n0\n";
    expect("UTF-8 files preserve NUL, Unicode and truncation", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    command[2] = "const p=process.argv[2];require('node:fs').writeFileSync(p,'safe');for(const run of [()=>require('node:fs').writeFileSync(p,{}),()=>require('node:fs').writeFileSync(p,'bad','hex'),()=>require('node:fs').writeFileSync(p+'\\0extra','bad'),()=>require('node:fs').writeFileSync(p+'\\ud800','bad')]){try{run();}catch(e){console.log(e instanceof TypeError);}}console.log(require('node:fs').readFileSync(p,'utf8'));";
    expected = "true\ntrue\ntrue\ntrue\nsafe\n";
    expect("invalid file arguments cannot truncate target", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    command[2] = "const p=process.argv[2];const s='x'.repeat(4194304);require('node:fs').writeFileSync(p,s);console.log(require('node:fs').readFileSync(p,'utf8').length);try{require('node:fs').writeFileSync(p,s+'x');}catch(e){console.log(e instanceof RangeError);}console.log(require('node:fs').readFileSync(p,'utf8').length);";
    expected = "4194304\ntrue\n4194304\n";
    expect("exact file limit and rejected oversized writes", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    // Invalid bytes are regression fixtures, not retained demonstration files.
    var malformed: array<u8, 5> = [65, 240, 128, 128, 128];
    write(path, &malformed[0], 5);
    command[2] = "try{require('node:fs').readFileSync(process.argv[2],'utf8');}catch(e){console.log(e instanceof TypeError);}console.log('alive');";
    expected = "true\nalive\n";
    expect("malformed UTF-8 is rejected without crashing", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    malformed[0] = 240;
    malformed[1] = 159;
    write(path, &malformed[0], 2);
    expect("truncated UTF-8 is rejected", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    malformed[0] = 237;
    malformed[1] = 160;
    malformed[2] = 128;
    write(path, &malformed[0], 3);
    expect("UTF-8 surrogate encoding is rejected", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    var fd: i64 = create(path);
    ftruncate(fd, 4194305);
    io_close(fd);
    command[2] = "try{require('node:fs').readFileSync(process.argv[2],'utf8');}catch(e){console.log(e instanceof RangeError);}";
    expect("oversized reads are rejected", &command[0], 4, "true\n" as ptr<u8>, 5, 0, "");
    command[2] = "try{require('node:fs').readFileSync(process.argv[2],'utf8');}catch(e){console.log(e instanceof Error);}";
    command[3] = (deref suite.directory) as str;
    expect("directory reads are rejected", &command[0], 4, "true\n" as ptr<u8>, 5, 0, "");
    command[3] = join((deref suite.directory) as str, "missing.txt") as str;
    expect("missing file throws a catchable Error", &command[0], 4, "true\n" as ptr<u8>, 5, 0, "");
    command[2] = "try{require('node:fs').readFileSync(process.argv[2],'utf8');}catch(e){console.log(e.code,e.errno,e.syscall,e.path===process.argv[2]);}";
    expected = "ENOENT -2 open true\n";
    expect("OS errors include operation, path and errno", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    command[2] = "for(const key of ['code','errno','path','syscall']){Object.defineProperty(Error.prototype,key,{set(){throw new Error('intercepted');},configurable:true});}try{require('node:fs').readFileSync(process.argv[2],'utf8');}catch(e){console.log(e instanceof Error,e.code,e.path===process.argv[2]);}";
    expected = "true ENOENT true\n";
    expect("OS error fields bypass inherited setters", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
    command[3] = path;
    command[2] = "const p=process.argv[2];require('node:fs').writeFileSync(p,'safe');try{require('node:fs').writeFileSync(p,'한'.repeat(1398102));}catch(e){console.log(e instanceof RangeError);}console.log(require('node:fs').readFileSync(p,'utf8'));require('node:fs').writeFileSync(p,'\\ud800-\\udc00');console.log(require('node:fs').readFileSync(p,'utf8')==='\\ufffd-\\ufffd');";
    expected = "true\nsafe\ntrue\n";
    expect("byte limit and lone-surrogate replacement", &command[0], 4, expected as ptr<u8>, mem_len_cstr(expected),
        0, "");
}

pub fun async_directory_tests() {
    var suite: ptr<TestState> = test_state();
    filesystem_case("async directory names and Dirents use worker snapshots", "const f=require('fs'),p=process.argv[2];f.mkdirSync(p);f.writeFileSync(p+'/a','x');f.writeFileSync(p+'/.hidden','x');f.writeFileSync(p+'/한글','x');f.mkdirSync(p+'/b');Promise.all([f.promises.readdir(p,'utf-8'),f.promises.readdir(p,{withFileTypes:true})]).then(([names,entries])=>{console.log(names.sort().join('|'));console.log(entries.length,entries.every(e=>e.parentPath===p),entries.find(e=>e.name==='b').isDirectory(),entries.find(e=>e.name==='한글').isFile())});",
        ".hidden|a|b|한글\n4 true true true\n", 0, "");
    var path: str = join((deref suite.directory) as str, "fs-entry") as str;
    check("prepare dangling link for async directory type snapshot", mkdir(path, 448) == 0 &&
        symlink("absent-target", join(path, "한글") as str) == 0);
    filesystem_case("async Dirent identifies dangling symlinks without following them", "const f=require('fs'),p=process.argv[2];f.promises.readdir(p,{withFileTypes:true}).then(a=>console.log(a.length,a[0].name,a[0].isSymbolicLink(),a[0].isFile(),a[0].parentPath===p));",
        "1 한글 true false true\n", 0, "");
    filesystem_case("async empty directories return ordinary arrays", "const f=require('fs'),p=process.argv[2];f.mkdirSync(p);f.promises.readdir(p).then(a=>console.log(Array.isArray(a),a.length));",
        "true 0\n", 0, "");
    filesystem_case("async directory OS failures retain path syscall and error code", "const f=require('fs'),p=process.argv[2];f.writeFileSync(p,'x');f.promises.readdir(p).catch(e=>console.log(e.code,e.syscall,e.path===p));",
        "ENOTDIR scandir true\n", 0, "");
    test("async readdir stops reading options at the first getter exception", "const f=require('fs/promises'),reason={};let reads=0;const p=f.readdir('.',{get withFileTypes(){throw reason},get recursive(){reads++;return false},get encoding(){reads++;return'utf8'}});console.log(p instanceof Promise);p.catch(e=>console.log(e===reason,reads));",
        "true\ntrue 0\n", 0, "");
    test("async readdir validates paths and rejects unsupported recursive and encoding options", "const f=require('fs/promises');let reads=0;Promise.all([f.readdir('.', {recursive:true}),f.readdir('.',{encoding:'buffer'}),f.readdir(4,{get withFileTypes(){reads++;return false}})].map(p=>p.then(()=>false,e=>e instanceof TypeError))).then(a=>console.log(a.every(Boolean),reads));",
        "true 0\n", 0, "");
    test("async readdir reserves its shared queue slot before reentrant getters", "const f=require('fs/promises'),jobs=[];f.readdir('.',{get withFileTypes(){for(let i=0;i<16;i++)jobs.push(f.readdir('.').then(()=>true,e=>{if(!(e instanceof RangeError))throw e;return false}));return false}}).then(()=>Promise.all(jobs)).then(a=>console.log(a.filter(Boolean).length,a.filter(v=>!v).length));",
        "15 1\n", 0, "");
    filesystem_case("async directory completion uses captured array and Dirent intrinsics", "const f=require('fs'),p=process.argv[2],A=Array;f.mkdirSync(p);f.writeFileSync(p+'/a','x');const job=f.promises.readdir(p,{withFileTypes:true});Array=null;Object.keys=null;WeakMap.prototype.get=WeakMap.prototype.set=()=>{throw Error('poison')};job.then(a=>console.log(A.isArray(a),a[0].name,a[0].isFile()));",
        "true a true\n", 0, "");
    test("fatal execution joins directory workers and frees pending snapshots", "const f=require('fs/promises');for(let i=0;i<16;i++)f.readdir('.');throw Error('directory shutdown');",
        "", 1, "directory shutdown");
    var growing: str = join((deref suite.directory) as str, "directory-growth") as str;
    check("prepare directory snapshot growth regression", mkdir(growing, 448) == 0);
    var source: str = "const f=require('fs'),p=process.argv[2];for(let i=0;i<26;i++)for(let j=0;j<26;j++)f.writeFileSync(p+'/'+String.fromCharCode(97+i,97+j),'');f.promises.readdir(p).then(a=>console.log(a.length,new Set(a).size,a.every(n=>n.length===2),a.includes('aa'),a.includes('zz')));";
    var command: array<str, 4> = [(deref suite.binary) as str, "-e", source, growing];
    var expected: str = "676 676 true true true\n";
    expect("async directory snapshot preserves every name across buffer growth", &command[0], 4,
        expected as ptr<u8>, mem_len_cstr(expected), 0, "");
    var name: array<u8, 3>;
    name[2] = 0;
    for (var i: i64 = 0; i < 26; i++) {
        for (var j: i64 = 0; j < 26; j++) {
            name[0] = (97 + i) as u8;
            name[1] = (97 + j) as u8;
            remove(join(growing, &name[0] as str) as str);
        }
    }
    check("directory growth regression removes all owned files", rmdir(growing) == 0);
}

pub fun async_tests() {
    var suite: ptr<TestState> = test_state();
    filesystem_case("async path jobs create inspect rename and remove", "const f=require('fs/promises'),p=process.argv[2];let turn=false;f.mkdir(p+'/a/b',{recursive:true}).then(v=>{console.log(turn,v===p);return f.mkdir(p+'/a/b',{recursive:true})}).then(v=>{console.log(v===undefined);return f.writeFile(p+'/a/b/data','hello')}).then(()=>f.stat(p+'/a/b/data')).then(s=>{console.log(s.isFile(),s.size,s.mtime instanceof Date);return f.access(p+'/a/b/data',4)}).then(v=>{console.log(v===undefined);return f.rename(p+'/a/b/data',p+'/a/b/moved')}).then(()=>f.unlink(p+'/a/b/moved')).then(()=>f.rmdir(p+'/a/b')).then(()=>f.rmdir(p+'/a')).then(()=>f.rmdir(p)).then(v=>console.log(v===undefined));turn=true;",
        "true true\ntrue\ntrue 5 true\ntrue\ntrue\n", 0, "");
    async_case("async metadata errors keep syscall path and destination", "const f=require('fs/promises'),p=process.argv[2]+'.missing';Promise.all([f.stat(p).catch(e=>e.code==='ENOENT'&&e.syscall==='stat'&&e.path===p),f.lstat(p).catch(e=>e.code==='ENOENT'&&e.syscall==='lstat'),f.access(p).catch(e=>e.code==='ENOENT'&&e.syscall==='access'),f.rename(p,p+'.dest').catch(e=>e.code==='ENOENT'&&e.syscall==='rename'&&e.dest===p+'.dest')]).then(v=>console.log(v.length,v.every(Boolean)));",
        "4 true\n", 0, "");
    filesystem_case("async path validation rejects without mutation", "const f=require('fs/promises'),p=process.argv[2];const jobs=[()=>f.stat(42),()=>f.stat(p,{bigint:true}),()=>f.access(p,8),()=>f.mkdir(p,{recursive:'yes'}),()=>f.mkdir(p+'\\0x'),()=>f.rename(p),()=>f.rmdir(p,{recursive:true})];Promise.all(jobs.map(run=>run().then(()=>false,e=>e instanceof TypeError||e instanceof RangeError))).then(v=>console.log(v.length,v.every(Boolean),require('fs').existsSync(p)));console.log('returned');",
        "returned\n7 true false\n", 0, "");
    filesystem_case("async mkdir stops option getters at first failure", "const f=require('fs/promises'),p=process.argv[2],marker={};let later=0;f.mkdir(p,{get recursive(){throw marker},get mode(){later++;return 511}}).catch(e=>console.log(e===marker,later,require('fs').existsSync(p)));",
        "true 0 false\n", 0, "");
    filesystem_case("async mkdir reserves its slot before reentrant getters", "const f=require('fs/promises'),p=process.argv[2];let inner;f.mkdir(p,{get recursive(){inner=f.stat(process.argv[0]);return false}}).then(()=>inner).then(s=>{console.log(s.isFile());return f.rmdir(p)}).then(()=>console.log('done'));",
        "true\ndone\n", 0, "");
    async_case("async metadata shares bounded file queue", "const f=require('fs/promises'),jobs=[];for(let i=0;i<17;i++)jobs.push(f.stat(process.argv[0]).then(s=>s.isFile()?'ok':'bad',e=>e instanceof RangeError?'limit':'bad'));Promise.all(jobs).then(v=>console.log(v.filter(x=>x==='ok').length,v.filter(x=>x==='limit').length));",
        "16 1\n", 0, "");
    async_case("async metadata functions retain identity after property replacement", "const f=require('fs/promises'),stat=f.stat;f.stat=null;stat.call({},process.argv[0]).then(s=>console.log(s.isFile()));",
        "true\n", 0, "");
    async_case("fatal metadata submission joins workers without calling handlers", "const f=require('fs/promises'),p=process.argv[2]+'.missing';f.rename(p,p+'.dest').catch(()=>console.log('wrong'));throw Error('metadata fatal');",
        "", 1, "metadata fatal");
    var path: str = join((deref suite.directory) as str, "source.js") as str;
    var initial: str = "hello";
    write(path, initial as ptr<u8>, 5);
    async_case("async files keep runtime alive without timers", "const f=require('node:fs/promises');console.log(f===require('fs/promises'),f===require('node:fs').promises);f.readFile(process.argv[2],'utf8').then(s=>console.log(s));console.log('sync');queueMicrotask(()=>console.log('microtask'));",
        "true true\nsync\nmicrotask\nhello\n", 0, "");
    async_case("async UTF-8 roundtrip and chained completion", "const f=require('node:fs/promises'),p=process.argv[2];f.writeFile(p,'한글😀\\0끝','utf8').then(v=>{console.log(v===undefined);return f.readFile(p,'utf8');}).then(s=>console.log(s==='한글😀\\0끝'));",
        "true\ntrue\n", 0, "");
    async_case("async invalid arguments reject rather than throw", "const f=require('node:fs/promises');let p;try{p=f.readFile(42);console.log('returned');}catch(e){console.log('wrong');}p.catch(e=>console.log(e instanceof TypeError));console.log('sync');",
        "returned\nsync\ntrue\n", 0, "");
    async_case("async validation cannot truncate existing file", "const f=require('node:fs/promises'),p=process.argv[2];require('node:fs').writeFileSync(p,'safe');Promise.all([f.writeFile(p,{}).catch(e=>e instanceof TypeError),f.writeFile(p,'bad','hex').catch(e=>e instanceof TypeError),f.writeFile(p+'\\0x','bad').catch(e=>e instanceof TypeError)]).then(v=>console.log(v.every(Boolean),require('node:fs').readFileSync(p,'utf8')));",
        "true safe\n", 0, "");
    async_case("async OS errors preserve structured diagnostics", "require('node:fs/promises').readFile(process.argv[2]+'.missing').catch(e=>console.log(e instanceof Error,e.code,e.errno,e.syscall,e.path.endsWith('.missing')));",
        "true ENOENT -2 open true\n", 0, "");
    async_case("async completions preserve requested exitCode", "process.exitCode=9;require('node:fs/promises').readFile(process.argv[2],'utf8').then(()=>console.log('finished'));",
        "finished\n", 9, "");
    async_case("Promise construction resists global replacement", "const f=require('node:fs/promises');globalThis.Promise=null;f.readFile(process.argv[2],'utf8').then(s=>console.log(s));",
        "safe\n", 0, "");
    async_case("file queue applies bounded backpressure", "const f=require('node:fs/promises'),list=[];for(let i=0;i<17;i++){list.push(f.readFile(process.argv[2],'utf8').then(()=>true,e=>e instanceof RangeError));}Promise.all(list).then(v=>console.log(v.length,v.every(Boolean)));",
        "17 true\n", 0, "");
    async_case("completed slots can be reused from continuations", "const f=require('node:fs/promises');let chain=Promise.resolve();for(let i=0;i<80;i++){chain=chain.then(()=>f.readFile(process.argv[2],'utf8'));}chain.then(s=>console.log(s));",
        "safe\n", 0, "");
    async_case("validation-only completion chains cannot lose wakeups", "const f=require('node:fs/promises');let chain=Promise.resolve();for(let i=0;i<80;i++){chain=chain.then(()=>f.readFile(null).catch(e=>e instanceof TypeError));}chain.then(v=>console.log(v));",
        "true\n", 0, "");
    async_case("worker completions and timers both make progress", "const f=require('node:fs/promises');let timer=false,done=false;setTimeout(()=>{timer=true;if(done)console.log('both');},1);f.readFile(process.argv[2],'utf8').then(()=>{done=true;if(timer)console.log('both');});",
        "both\n", 0, "");
    async_case("pending Promise roots survive allocation pressure", "const f=require('node:fs/promises');Promise.all(Array.from({length:12},()=>f.readFile(process.argv[2],'utf8'))).then(v=>console.log(v.length,v.every(s=>s==='safe')));for(let i=0;i<2000;i++){new Array(128).fill({value:i});}",
        "12 true\n", 0, "");
    async_case("microtask failure during completion stops timers", "require('node:fs/promises').readFile(process.argv[2],'utf8').then(()=>queueMicrotask(()=>{throw new Error('completion microtask');}));setTimeout(()=>console.log('wrong'),1000);",
        "", 1, "completion microtask");
    async_case("fatal script error joins workers without running continuations", "require('node:fs/promises').readFile(process.argv[2],'utf8').then(()=>console.log('wrong'));throw new Error('fatal script');",
        "", 1, "fatal script");
    async_case("unhandled file rejection fails the runtime", "require('node:fs/promises').readFile(process.argv[2]+'.missing');setTimeout(()=>console.log('wrong'),1000);",
        "", 1, "Unhandled Promise rejection");
    var invalid: array<u8, 2> = [240, 159];
    write(path, &invalid[0], 2);
    async_case("async malformed UTF-8 rejects on main thread", "require('node:fs/promises').readFile(process.argv[2],'utf8').catch(e=>console.log(e instanceof TypeError));",
        "true\n", 0, "");
    var fd: i64 = create(path);
    ftruncate(fd, 4194305);
    io_close(fd);
    async_case("async read limit returns RangeError", "require('node:fs/promises').readFile(process.argv[2],'utf8').catch(e=>console.log(e instanceof RangeError));",
        "true\n", 0, "");
    test("unhandled Promise rejection is fatal", "Promise.reject(new Error('unhandled reason'));setTimeout(()=>console.log('wrong'),1000);",
        "", 1, "Unhandled Promise rejection");
    test("undefined rejection reason is preserved", "Promise.reject(undefined);setTimeout(()=>console.log('wrong'),1000);",
        "", 1, "undefined");
    test("same-checkpoint rejection handlers suppress fatal policy", "const p=Promise.reject('handled');queueMicrotask(()=>p.catch(v=>console.log(v)));",
        "handled\n", 0, "");
    test("derived rejected Promises are tracked", "Promise.resolve().then(()=>{throw new Error('derived rejection');});",
        "", 1, "derived rejection");
    test("timer-created rejected Promises are tracked", "setTimeout(()=>Promise.reject(new Error('timer rejection')),1);setTimeout(()=>console.log('wrong'),1000);",
        "", 1, "timer rejection");
}

pub fun child_process_tests() {
    var suite: ptr<TestState> = test_state();
    test("process pipe hooks reject primitive callbacks before native invocation", "const c=require('child_process').spawn('/bin/true',[],{stdio:'pipe'}),w=c.stdin;for(const f of [()=>w._write(Buffer.from('x'),'buffer',5),()=>w._final(5),()=>w._destroy(null,5)])try{f()}catch(e){console.log(e instanceof TypeError)}w.destroy();c.on('close',code=>console.log(code));",
        "true\ntrue\ntrue\n0\n", 0, "");
    test("child pipe ownership ignores replaced public stream properties", "const c=require('child_process').spawn(process.execPath,['-e',\"process.stdout.write('ok');process.stderr.write('err')\"],{stdio:'pipe'});let out='',err='';c.stdout.on('data',x=>out+=x.toString());c.stderr.on('data',x=>err+=x.toString());for(const key of ['stdin','stdout','stderr'])Object.defineProperty(c,key,{get(){throw Error('public stream getter')}});c.on('close',code=>console.log(code,out,err));",
        "0 ok err\n", 0, "");
    var broken_pipe: array<i32, 2> = [-1, -1];
    var pipe_ready: bool = io_pipe(&broken_pipe[0]) == 0;
    check("prepare an owned broken process pipe", pipe_ready);
    if (pipe_ready) {
        io_close(broken_pipe[0] as i64);
        check("broken process pipe returns EPIPE without terminating the host", test_pipe_write(broken_pipe[1],
            "x" as ptr<u8>, 1) == -32);
        io_close(broken_pipe[1] as i64);
    }
    test("nextTick drains FIFO before Promise jobs and host timers", "const a=[];process.nextTick((x)=>{a.push(x);process.nextTick(()=>a.push('nested'))},'tick');Promise.resolve().then(()=>{a.push('promise');process.nextTick(()=>a.push('fromPromise'))});queueMicrotask(()=>a.push('micro'));a.push('sync');setTimeout(()=>console.log(a.join(',')),1);",
        "sync,tick,nested,promise,micro,fromPromise\n", 0, "");
    test("nextTick runs after a timer callback and before its Promise jobs", "setTimeout(()=>{console.log('timer');Promise.resolve().then(()=>console.log('promise'));process.nextTick(()=>console.log('tick'))},1);",
        "timer\ntick\npromise\n", 0, "");
    test("nextTick validates callbacks arguments and releases capacity before dispatch", "for(const x of [undefined,1,{},Symbol()])try{process.nextTick(x)}catch(e){console.log(e instanceof TypeError)}let n=0;for(let i=0;i<1024;i++)process.nextTick(()=>{n++;if(n===1024)process.nextTick(()=>console.log('done',n))});try{process.nextTick(()=>{})}catch(e){console.log(e instanceof RangeError)}",
        "true\ntrue\ntrue\ntrue\ntrue\ndone 1024\n", 0, "");
    test("nextTick thrown values stop later callbacks and preserve failure", "process.nextTick(()=>{throw Error('tick failure')});process.nextTick(()=>console.log('unexpected'));",
        "", 1, "tick failure");
    test("piped child stdin stdout and stderr drain before close", "const c=require('child_process').spawn(process.execPath,['-e',\"process.stdin.setEncoding('utf8');let s='';process.stdin.on('data',v=>s+=v);process.stdin.on('end',()=>{process.stdout.write(s.toUpperCase());process.stderr.write('err')})\"],{stdio:'pipe'});let out='',err='';c.stdout.setEncoding('utf8');c.stderr.setEncoding('utf8');c.stdout.on('data',v=>out+=v);c.stderr.on('data',v=>err+=v);c.stdin.end('abc');c.on('close',(code,signal)=>console.log(code,signal,out,err));",
        "0 null ABC err\n", 0, "");
    test("owned child process exits independently with exit and close events", "const c=require('child_process').spawn(process.execPath,['-e','process.exitCode=7'],{stdio:'inherit'});console.log(typeof c.pid,c.stdin===null,c.stdout===null);c.on('exit',(code,signal)=>console.log('exit',code,signal,c.kill()));c.on('close',(code,signal)=>console.log('close',code,signal));",
        "number true true\nexit 7 null false\nclose 7 null\n", 0, "");
    test("spawn errors are delivered asynchronously", "const c=require('node:child_process').spawn('/jsrt-missing-executable-321',[],{stdio:'inherit'});c.on('error',e=>console.log(e.code));console.log('returned');",
        "returned\nENOENT\n", 0, "");
    test("unhandled child spawn error becomes runtime failure", "require('child_process').spawn('/jsrt-missing-executable-321',[],{stdio:'inherit'});",
        "", 1, "cannot spawn child process");
    test("child options preserve thrown ownKeys errors and captured validation", "const s=require('child_process').spawn;try{s('/bin/true',[],new Proxy({},{ownKeys(){throw Error('keys failed')}}))}catch(e){console.log(e.message)}Reflect.ownKeys=()=>[];try{s('/bin/true',[],{stdio:'inherit',uid:0})}catch(e){console.log(e instanceof TypeError)}const c=s('/bin/true',[],{stdio:'inherit'});c.on('exit',n=>console.log(n));",
        "keys failed\ntrue\n0\n", 0, "");
    test("child process validates inherited stdio and unsupported options", "const s=require('child_process').spawn;for(const o of [undefined,{}, {stdio:'invalid'}, {stdio:'inherit',shell:true},{stdio:'inherit',cwd:'/tmp'},{stdio:'inherit',env:{}}]){try{s('/bin/true',[],o);console.log('wrong')}catch(e){console.log(e instanceof TypeError)}}",
        "true\ntrue\ntrue\ntrue\ntrue\ntrue\n", 0, "");
    test("child process rejects NUL non-string and oversized arguments before launch", "const s=require('child_process').spawn;for(const a of [[1],['a\\0b'],['a'.repeat(8192)]]){try{s('/bin/true',a,{stdio:'inherit'});console.log('wrong')}catch(e){console.log(e instanceof TypeError||e instanceof RangeError)}}",
        "true\ntrue\ntrue\n", 0, "");
    test("child process validates signal and prevents use after reaping", "const c=require('child_process').spawn('/bin/sleep',['5'],{stdio:'inherit'});try{c.kill('BAD')}catch(e){console.log(e instanceof TypeError)}console.log(c.kill('SIGKILL'),c.killed);c.on('exit',(code,signal)=>console.log(code,signal,c.kill()));",
        "true\ntrue true\nnull SIGKILL false\n", 0, "");
    test("child spawn metadata avoids poisoned inherited setters", "Object.defineProperty(require('events').prototype,'pid',{set(){throw Error('poisoned')}});const c=require('child_process').spawn('/bin/true',[],{stdio:'inherit'});c.on('exit',code=>console.log(code,typeof c.pid));",
        "0 number\n", 0, "");
    test("reentrant child option getters keep independent owned slots", "const s=require('child_process').spawn;try{s('/bin/true',[],{get stdio(){const c=s('/bin/true',[],{stdio:'inherit'});c.on('exit',code=>console.log('inner',code));throw Error('outer failed')}})}catch(e){console.log(e.message)}",
        "outer failed\ninner 0\n", 0, "");
    test("fatal script error terminates and reaps owned children", "require('child_process').spawn('/bin/sleep',['20'],{stdio:'inherit'});throw Error('fatal parent');",
        "", 1, "fatal parent");
    async_case("infinite JavaScript child work leaves the parent timer responsive", "const p=process.argv[2],f=require('fs');f.writeFileSync(p,'starting');const code=\"console.log('loop-ready');require('fs').writeFileSync(process.argv[2],'loop-ready');while(true){}\";const c=require('child_process').spawn(process.execPath,['-e',code,'--',p],{stdio:'inherit'});const t=setInterval(()=>{if(f.readFileSync(p,'utf8')==='loop-ready'){clearInterval(t);console.log('parent-alive');c.kill('SIGKILL')}},2);c.on('exit',(code,signal)=>console.log(code,signal));",
        "loop-ready\nparent-alive\nnull SIGKILL\n", 0, "");
    var command: array<str, 5> = [(deref suite.binary) as str, "--memory-limit-mb", "1048576", "-e", "console.log(/^Max address space\\s+1099511627776\\s/m.test(require('fs').readFileSync('/proc/self/limits','utf8')))"];
    expect("explicit memory limit applies to the process address space", &command[0], 5, "true\n" as ptr<u8>,
        5, 0, "");
    var invalid: array<str, 5> = ["0", "-1", "nope", "1048577", ""];
    for (var i: i64 = 0; i < 5; i++) {
        command[2] = invalid[i];
        expect("memory limit rejects invalid MiB before JS execution", &command[0], 5, "" as ptr<u8>,
            0, 2, "invalid memory limit");
    }
}
