// Context/thread isolation, host lifecycle and native callback targets.
import("jsrt::runtime::host")::{install_host, shutdown_host};
import("jsrt::runtime::event_loop")::{run_event_loop};
import("jsrt::runtime::values")::{plain, put};
import("jsrt::runtime::values")::{install_values, shutdown_values, define, text, fail};
