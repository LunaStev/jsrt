import("jsrt::runtime::buffer")::{install_buffer, shutdown_buffer};
import("jsrt::runtime::events")::{install_events, shutdown_events, events_module};
import("jsrt::runtime::timers")::{install_timers, shutdown_timers, next_timer_deadline, run_due_timer,
    report_job_failure, unhandled_rejection_failed};
import("jsrt::runtime::system")::{install_system, shutdown_system, system_exit_status};
import("jsrt::runtime::async_fs")::{install_async_fs, shutdown_async_fs, async_pending, file_completion_fd,
    file_completions_ready, drain_files, wait_for_files};
import("jsrt::runtime::headers")::{create_headers};
import("jsrt::runtime::package_io")::{Blob, read_blob, free_blob};
import("std::mem::ops")::{mem_eq};
import("std::mem::cstr")::{mem_eq_cstr};
import("std::time::clock")::{time_now_monotonic_ns};
import("std::time::sleep")::{time_sleep_ms};
import("./harness")::{check};
extern(c, "opendir") fun test_open_directory(path: str) -> ptr<u8>;
extern(c, "closedir") fun test_close_directory(directory: ptr<u8>) -> i32;
extern(c, "jsrt_directory_next") fun test_next_entry(directory: ptr<u8>, name: ptr<u8>, capacity: i64) -> i32;
extern(c, "jsrt_test_parallel_contexts") fun test_parallel_contexts() -> i32;
extern(c, "jsrt_test_termination_callback") fun test_termination_callback() -> ptr<u8>;
extern(c, "jsrt_test_publish_termination_group") fun publish_termination_group(task: ptr<u8>, group: ptr<u8>);
extern(c, "jsrt_test_termination_phase") fun termination_phase(phase: i32);
extern(c, "JSContextGetGroup") fun context_group(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "JSContextGroupRetain") fun retain_group(group: ptr<u8>) -> ptr<u8>;
extern(c, "jsrt_prepare_worker_termination") fun prepare_worker_termination(group: ptr<u8>) -> bool;
extern(c, "wr_context_set_data") fun context_set_data(ctx: ptr<u8>, data: ptr<u8>) -> bool;
extern(c, "wr_function") fun native_function(ctx: ptr<u8>, name: ptr<u8>, cb: ptr<u8>) -> ptr<u8>;
extern(c, "wr_set") fun native_set(ctx: ptr<u8>, owner: ptr<u8>, key: ptr<u8>, value: ptr<u8>,
    flags: u32, ex: ptr<ptr<u8>>);
extern(c, "wr_undefined") fun undefined(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_context_create") fun wr_context_create(cls: ptr<u8>) -> ptr<u8>;
extern(c, "wr_context_release") fun wr_context_release(ctx: ptr<u8>);
extern(c, "wr_string_utf8") fun wr_string_utf8(text: str) -> ptr<u8>;
extern(c, "wr_string_release") fun wr_string_release(text: ptr<u8>);
extern(c, "wr_string_copy_utf8") fun wr_string_copy_utf8(text: ptr<u8>, data: ptr<u8>, cap: i64) -> i64;
extern(c, "wr_evaluate") fun wr_evaluate(ctx: ptr<u8>, source: ptr<u8>, receiver: ptr<u8>, url: ptr<u8>, line: i32,
    ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_to_string") fun wr_to_string(ctx: ptr<u8>, value: ptr<u8>, ex: ptr<ptr<u8>>) -> ptr<u8>;
extern(c, "wr_context_global") fun wr_context_global(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_context_data") fun wr_context_data(ctx: ptr<u8>) -> ptr<u8>;
extern(c, "wr_protect") fun wr_protect(ctx: ptr<u8>, value: ptr<u8>);
extern(c, "wr_unprotect") fun wr_unprotect(ctx: ptr<u8>, value: ptr<u8>);

pub fun context_result(ctx: ptr<u8>, source: str, expected: str) -> bool {
    var script: ptr<u8> = wr_string_utf8(source);
    var ex: ptr<u8> = null;
    var value: ptr<u8> = wr_evaluate(ctx, script, null, null, 1, &ex);
    if (value != null && ex == null) {
        wr_protect(ctx, value);
    }
    wr_string_release(script);
    if (value == null || ex != null) {
        return false;
    }
    var encoded: ptr<u8> = wr_to_string(ctx, value, &ex);
    var bytes: array<u8, 512>;
    var ok: bool = encoded != null && ex == null;
    if (ok) {
        var n: i64 = wr_string_copy_utf8(encoded, &bytes[0], 512);
        ok = n > 0 && mem_eq_cstr(&bytes[0] as str, expected);
    }
    if (encoded != null) {
        wr_string_release(encoded);
    }
    wr_unprotect(ctx, value);
    return ok;
}

// Called on independent pthreads. Never access runner counters or another context's JS handles.
export(c) fun jsrt_test_context_task(result: ptr<i32>) {
    deref result = 0;
    var ctx: ptr<u8> = wr_context_create(null);
    if (ctx == null) {
        return;
    }
    var ex: ptr<u8> = null;
    var ok: bool = install_host(ctx, 0, true, "<parallel-host>", &ex);
    if (ok) {
        define(ctx, wr_context_global(ctx), "HostEventEmitter", events_module(ctx), &ex, true);
        ok = ex == null && context_result(ctx, "globalThis.ticks=0;globalThis.files=0;globalThis.metadata=0;globalThis.handles=0;globalThis.emitter=new HostEventEmitter();emitter.on('tick',()=>ticks++);true",
            "true");
    }
    var iteration: i64 = 0;
    while (ok && iteration < 20) {
        ok = context_result(ctx, "setTimeout(()=>emitter.emit('tick'),1);require('fs/promises').readFile('tests/http_server.js').then(v=>{if(Buffer.isBuffer(v)&&v.toString('utf8').startsWith('// Automated'))files++});require('fs/promises').stat('tests/http_server.js').then(s=>{if(!s.isFile()||s.size<=0)throw Error('metadata');return require('fs/promises').readdir('tests')}).then(a=>{if(a.includes('http_server.js'))metadata++});require('fs/promises').open('tests/http_server.js').then(async h=>{if(!(await h.stat()).isFile())throw Error('handle');await h.readFile();await h.close();handles++});JSON.stringify(JSON.parse('{\"host\":\"wave\"}'))",
            "{\"host\":\"wave\"}");
        var turns: i64 = 0;
        while (ok && (async_pending(ctx) > 0 || next_timer_deadline(ctx) >= 0) && turns < 500) {
            ex = null;
            if (async_pending(ctx) > 0) {
                ok = wait_for_files(ctx, 2) && drain_files(ctx, &ex) && ex == null;
            }
            if (ok) {
                ok = run_due_timer(ctx, time_now_monotonic_ns(), &ex) && ex == null && !report_job_failure(ctx,
                    &ex);
            }
            if (next_timer_deadline(ctx) >= 0) {
                time_sleep_ms(1);
            }
            turns += 1;
        }
        ok = ok && async_pending(ctx) == 0 && next_timer_deadline(ctx) == -1;
        iteration += 1;
    }
    if (ok) {
        ok = context_result(ctx, "ticks===20&&files===20&&metadata===20&&handles===20", "true");
    }
    ok = shutdown_host(ctx) && ok;
    ok = wr_context_data(ctx) == null && ok;
    wr_context_release(ctx);
    if (ok) {
        deref result = 1;
    }
}

export(c) fun jsrt_test_termination_ready(ctx: ptr<u8>, fn: ptr<u8>, receiver: ptr<u8>, count: i64,
    args: ptr<ptr<u8>>, ex: ptr<ptr<u8>>) -> ptr<u8> {
    var group: ptr<u8> = retain_group(context_group(ctx));
    publish_termination_group(wr_context_data(ctx), group);
    return undefined(ctx);
}

export(c) fun jsrt_test_termination_task(task: ptr<u8>, result: ptr<i32>) {
    deref result = 0;
    var ctx: ptr<u8> = wr_context_create(null);
    if (ctx == null) {
        return;
    }
    if (!prepare_worker_termination(context_group(ctx))) {
        wr_context_release(ctx);
        return;
    }
    context_set_data(ctx, task);
    var ex: ptr<u8> = null;
    var key: ptr<u8> = wr_string_utf8("readyToTerminate");
    var fn: ptr<u8> = native_function(ctx, key, test_termination_callback());
    wr_protect(ctx, fn);
    native_set(ctx, wr_context_global(ctx), key, fn, 0, &ex);
    wr_string_release(key);
    wr_unprotect(ctx, fn);
    if (ex == null) {
        // Termination bypasses catch/finally. Wave must guard every subsequent entry.
        var source: ptr<u8> = wr_string_utf8("try{readyToTerminate();while(true){}}catch(e){while(true){}}finally{while(true){}}");
        wr_evaluate(ctx, source, null, null, 1, &ex);
        termination_phase(1);
        wr_string_release(source);
        if (ex != null) {
            if (!prepare_worker_termination(context_group(ctx))) {
                deref result = 1;
            }
        }
    }
    context_set_data(ctx, null);
    termination_phase(2);
    wr_context_release(ctx);
    termination_phase(3);
}

pub fun context_isolation_tests() {
    check("two JSC threads independently install run and release the full Wave host", test_parallel_contexts() == 1);
    var a: ptr<u8> = wr_context_create(null);
    var b: ptr<u8> = wr_context_create(null);
    check("create independent JSC contexts for host-state isolation", a != null && b != null);
    if (a == null || b == null) {
        if (a != null) {
            wr_context_release(a);
        }
        if (b != null) {
            wr_context_release(b);
        }
        return;
    }
    var ex: ptr<u8> = null;
    var ready_a: bool = install_values(a, &ex) && install_json(a) && install_collections(a, &ex) && install_buffer(a,
        &ex) && install_events(a, &ex) && install_timers(a) && install_system(a, 0, true) && install_async_fs(a);
    ex = null;
    var ready_b: bool = install_values(b, &ex) && install_json(b) && install_collections(b, &ex) && install_buffer(b,
        &ex) && install_events(b, &ex) && install_timers(b) && install_system(b, 0, true) && install_async_fs(b);
    check("two contexts independently install eight Wave host-state areas", ready_a && ready_b);
    if (ready_a && ready_b) {
        check("reinstall refuses to overwrite an existing context state", !install_json(a));
        check("timer and filesystem reinstall preserve existing context state", !install_timers(a) && !install_system(a,
            0, true) && !install_async_fs(a));
        check("contexts own distinct file completion descriptors", file_completion_fd(a) >= 0 && file_completion_fd(b) >= 0 && file_completion_fd(a) != file_completion_fd(b));
        check("process exit codes belong to their context", context_result(a, "process.exitCode=17;process.exitCode",
            "17") && context_result(b, "process.exitCode=23;process.exitCode", "23") && system_exit_status(a) == 17 && system_exit_status(b) == 23);
        check("timer argument errors use each context TypeError", context_result(a, "(()=>{try{setTimeout(1)}catch(e){return e instanceof TypeError}})()",
            "true") && context_result(b, "(()=>{try{setTimeout(1)}catch(e){return e instanceof TypeError}})()",
            "true"));
        check("timer identifiers begin independently in each context", context_result(a, "globalThis.timerTicks=0;setTimeout(()=>timerTicks++,1)",
            "1") && context_result(b, "globalThis.timerTicks=0;setTimeout(()=>timerTicks++,1)", "1"));
        check("clearing an identifier only removes the current context timer", context_result(a, "clearTimeout(1);true",
            "true") && next_timer_deadline(a) == -1 && next_timer_deadline(b) >= 0);
        time_sleep_ms(3);
        ex = null;
        check("other context timer still dispatches after cancellation", run_due_timer(b, time_now_monotonic_ns(),
            &ex) && ex == null && context_result(a, "timerTicks", "0") && context_result(b, "timerTicks",
            "1"));
        check("microtasks use each context captured intrinsics", context_result(a, "globalThis.microTicks=0;const savedThen=Promise.prototype.then;Promise.prototype.then=()=>{throw 1};queueMicrotask(()=>microTicks++);Promise.prototype.then=savedThen;true",
            "true") && context_result(b, "globalThis.microTicks=0;queueMicrotask(()=>microTicks+=2);true",
            "true") && context_result(a, "microTicks", "1") && context_result(b, "microTicks", "2"));
        check("both contexts submit work to independent file worker pools", context_result(a, "globalThis.fileText='pending';fs.promises.readFile('tests/http_server.js','utf8').then(v=>fileText=v);true",
            "true") && context_result(b, "globalThis.fileText='pending';fs.promises.readFile('tests/json_cases.js','utf8').then(v=>fileText=v);true",
            "true") && async_pending(a) == 1 && async_pending(b) == 1);
        var file_ok: bool = true;
        var turns: i64 = 0;
        while ((async_pending(a) > 0 || async_pending(b) > 0) && turns < 200) {
            ex = null;
            if (async_pending(a) > 0 && (!wait_for_files(a, 10) || !drain_files(a, &ex) || ex != null)) {
                file_ok = false;
                break;
            }
            if (async_pending(b) > 0 && (!wait_for_files(b, 10) || !drain_files(b, &ex) || ex != null)) {
                file_ok = false;
                break;
            }
            turns += 1;
        }
        check("simultaneous native file work settles only in its owning JSC context", file_ok && async_pending(a) == 0 && async_pending(b) == 0 && context_result(a,
            "fileText.startsWith('// Automated TCP integration fixture')", "true") && context_result(b,
            "fileText.startsWith('// The same fixtures run')", "true"));
        check("first context preserves captured JSON intrinsics", context_result(a, "Object.keys=()=>{throw Error('poison A')};Array.isArray=()=>false;JSON.stringify({realm:'A',items:[1,2]})",
            "{\"realm\":\"A\",\"items\":[1,2]}"));
        check("second context preserves its own JSON intrinsics", context_result(b, "Object.keys=()=>{throw Error('poison B')};JSON.stringify({realm:'B',items:[3,4]})",
            "{\"realm\":\"B\",\"items\":[3,4]}"));
        check("JSON errors belong to the receiving context", context_result(a, "(()=>{try{JSON.parse('{')}catch(e){return e instanceof SyntaxError}})()",
            "true") && context_result(b, "(()=>{try{JSON.parse('{')}catch(e){return e instanceof SyntaxError}})()",
            "true"));
        var contexts: array<ptr<u8>, 2> = [a, b];
        for (var i: i64 = 0; i < 2; i++) {
            var ctx: ptr<u8> = contexts[i];
            ex = null;
            define(ctx, wr_context_global(ctx), "HostEventEmitter", events_module(ctx), &ex, true);
            check("Buffer branding and storage remain local to their context", ex == null && context_result(ctx,
                "globalThis.savedBuffer=Buffer.from('wave');Buffer.isBuffer(savedBuffer)&&savedBuffer.toString()==='wave'",
                "true"));
            check("numeric Buffer intrinsics belong to the receiving context", context_result(ctx, "globalThis.numericBuffer=Buffer.alloc(8);numericBuffer.writeBigUInt64BE(18446744073709551615n);numericBuffer.readBigUInt64BE()===18446744073709551615n&&numericBuffer.indexOf(Buffer.from([255,255]))===0",
                "true"));
            check("EventEmitter listeners remain local to their context", context_result(ctx, "globalThis.eventCount=0;globalThis.emitter=new HostEventEmitter();emitter.on('tick',()=>eventCount++);emitter.emit('tick');eventCount",
                "1"));
            var map: ptr<u8> = weak_map(ctx, &ex);
            wr_protect(ctx, map);
            var key: ptr<u8> = plain(ctx);
            wr_protect(ctx, key);
            weak_set(ctx, map, key, text(ctx, "retained"), &ex);
            var value: ptr<u8> = weak_get(ctx, map, key, &ex);
            define(ctx, wr_context_global(ctx), "hostValue", value, &ex, true);
            check("WeakMap and property definitions use only their own context", ex == null && context_result(ctx,
                "hostValue", "retained"));
            fail(ctx, &ex, 1, "context error");
            var error: ptr<u8> = ex;
            ex = null;
            wr_protect(ctx, error);
            put(ctx, wr_context_global(ctx), "hostError", error, &ex);
            wr_unprotect(ctx, error);
            check("host TypeError uses the receiving context constructor", ex == null && context_result(ctx,
                "hostError instanceof TypeError", "true"));
            wr_unprotect(ctx, key);
            wr_unprotect(ctx, map);
        }
    }
    if (ready_a && ready_b) {
        check("second context can shut down with pending content and metadata jobs", context_result(b, "globalThis.shutdownContinuation=false;fs.promises.readFile('tests/http_server.js').then(()=>shutdownContinuation=true);fs.promises.access('tests/http_server.js').then(()=>shutdownContinuation=true);true",
            "true") && async_pending(b) == 2);
        check("a microtask failure stays in its owning context", context_result(b, "queueMicrotask(()=>{throw undefined});true",
            "true") && report_job_failure(b, &ex) && !report_job_failure(a, &ex));
        check("microtask exceptions are distinct from unhandled rejections", !unhandled_rejection_failed(b,
            ex));
    }
    shutdown_timers(b);
    check("late rejection hook safely ignores a stopped scheduler", context_result(b, "Promise.reject('late shutdown rejection');true",
        "true"));
    check("second context file pool joins safely", shutdown_async_fs(b));
    shutdown_system(b);
    if (ready_b) {
        check("shutdown joins pending file work without running user continuations", context_result(b,
            "shutdownContinuation", "false") && async_pending(b) == 0 && file_completion_fd(b) == -1 && !file_completions_ready(b));
    }
    shutdown_events(b);
    shutdown_buffer(b);
    shutdown_collections(b);
    shutdown_json(b);
    shutdown_values(b);
    check("context shutdown releases its private native state", wr_context_data(b) == null);
    wr_context_release(b);
    if (ready_a) {
        check("remaining context works after the other context is destroyed", context_result(a, "JSON.stringify(JSON.parse('{\"alive\":true}'))",
            "{\"alive\":true}"));
    }
    if (ready_a) {
        check("Buffer and EventEmitter survive destruction of the other context", context_result(a, "emitter.emit('tick');Buffer.isBuffer(savedBuffer)&&savedBuffer.toString()==='wave'&&eventCount===2",
            "true"));
    }
    if (ready_a) {
        check("remaining file pool accepts work after other context shutdown", context_result(a, "globalThis.fileDone=false;fs.promises.readFile('tests/http_server.js').then(v=>fileDone=Buffer.isBuffer(v));true",
            "true"));
        var turns: i64 = 0;
        var file_ok: bool = true;
        ex = null;
        while (async_pending(a) > 0 && turns < 200) {
            if (!wait_for_files(a, 10) || !drain_files(a, &ex) || ex != null) {
                file_ok = false;
                break;
            }
            turns += 1;
        }
        check("remaining file pool completes with its own Buffer prototype", file_ok && async_pending(a) == 0 && context_result(a,
            "fileDone", "true"));
        check("remaining timer scheduler accepts work after other context shutdown", context_result(a,
            "setTimeout(()=>timerTicks++,1)", "2"));
        time_sleep_ms(3);
        ex = null;
        check("remaining timer dispatches after other context shutdown", run_due_timer(a, time_now_monotonic_ns(),
            &ex) && ex == null && context_result(a, "timerTicks", "1"));
    }
    shutdown_timers(a);
    check("first context file pool joins safely", shutdown_async_fs(a));
    shutdown_system(a);
    shutdown_events(a);
    shutdown_buffer(a);
    shutdown_collections(a);
    shutdown_json(a);
    shutdown_values(a);
    check("last context releases all converted module state", wr_context_data(a) == null);
    wr_context_release(a);
}

fun descriptor_count() -> i64 {
    var directory: ptr<u8> = test_open_directory("/proc/self/fd");
    if (directory == null) {
        return -1;
    }
    var name: array<u8, 256>;
    var count: i64 = 0;
    while (true) {
        var status: i32 = test_next_entry(directory, &name[0], 256);
        if (status == 0) {
            break;
        }
        if (status < 0) {
            count = -1;
            break;
        }
        if (!mem_eq_cstr(&name[0] as str, ".") && !mem_eq_cstr(&name[0] as str, "..")) {
            count += 1;
        }
    }
    if (test_close_directory(directory) != 0) {
        return -1;
    }
    return count;
}

fun resident_kib() -> i64 {
    var bytes: Blob = read_blob("/proc/self/status", 65536);
    if (bytes.bytes == null) {
        return -1;
    }
    var result: i64 = -1;
    var prefix: str = "VmRSS:";
    for (var i: i64 = 0; i + 6 < bytes.length; i++) {
        if ((i == 0 || bytes.bytes[i - 1] == 10) && mem_eq(bytes.bytes + i, prefix as ptr<u8>, 6)) {
            i += 6;
            while (i < bytes.length && (bytes.bytes[i] == 32 || bytes.bytes[i] == 9)) {
                i += 1;
            }
            result = 0;
            while (i < bytes.length && bytes.bytes[i] >= 48 && bytes.bytes[i] <= 57) {
                result = result * 10 + (bytes.bytes[i] as i64) - 48;
                i += 1;
            }
            break;
        }
    }
    free_blob(&bytes);
    return result;
}

pub fun host_stability_tests() {
    var result: i32 = 0;
    for (var i: i64 = 0; i < 3; i++) {
        jsrt_test_context_task(&result);
        if (result != 1) {
            check("warm up repeated full host lifecycle", false);
            return;
        }
    }
    var before: i64 = descriptor_count();
    var rss: i64 = resident_kib();
    var peak: i64 = rss;
    var ok: bool = before >= 0 && rss >= 0;
    for (var i: i64 = 0; i < 16 && ok; i++) {
        jsrt_test_context_task(&result);
        ok = result == 1 && descriptor_count() == before;
        var sample: i64 = resident_kib();
        ok = sample >= 0 && ok;
        if (sample > peak) {
            peak = sample;
        }
    }
    check("16 warmed full host lifecycles drain jobs roots threads and descriptors", ok);
    // RSS includes engine caches and allocator retention; report, do not label it JS heap usage.
    println("Host lifecycle samples: 16, FD baseline: {}, RSS KiB start/peak/end: {}/{}/{}", before,
        rss, peak, resident_kib());
}

pub fun full_host_isolation_tests() {
    var a: ptr<u8> = wr_context_create(null);
    var b: ptr<u8> = wr_context_create(null);
    if (a == null || b == null) {
        check("full host isolation contexts", false);
        if (a != null) {
            wr_context_release(a);
        }
        if (b != null) {
            wr_context_release(b);
        }
        return;
    }
    var ex: ptr<u8> = null;
    var ready_a: bool = install_host(a, 0, true, "<host-a>", &ex);
    ex = null;
    var ready_b: bool = install_host(b, 0, true, "<host-b>", &ex);
    check("two full hosts install in independent contexts on the same thread", ready_a && ready_b);
    if (ready_a) {
        var initial: ptr<u8> = plain(a);
        wr_protect(a, initial);
        put(a, initial, "X-Test", text(a, "ok"), &ex);
        var headers: ptr<u8> = create_headers(a, initial, false, &ex);
        wr_protect(a, headers);
        define(a, wr_context_global(a), "nativeResponseHeaders", headers, &ex, true);
        wr_unprotect(a, headers);
        wr_unprotect(a, initial);
        check("native response Headers are immutable and copies are independently mutable", ex == null &&
            context_result(a, "(()=>{const h=nativeResponseHeaders;let n=0;for(const f of [()=>h.set('x-test','bad'),()=>h.append('x','bad'),()=>h.delete('x-test')])try{f()}catch(e){if(e instanceof TypeError)n++}const copy=new Headers(h);copy.set('x-test','copy');return h instanceof Headers&&n===3&&h.get('X-Test')==='ok'&&copy.get('x-test')==='copy'&&Array.from(h.keys()).join(',')==='x-test'})()",
                "true"));
    }
    if (ready_a && ready_b) {
        check("stream prototypes and private state belong to each full host", context_result(a, "globalThis.pipe=new(require('stream').PassThrough)();globalThis.data='';pipe.on('data',v=>data+=v.toString());pipe.end('A');true",
            "true") && context_result(b, "globalThis.pipe=new(require('stream').PassThrough)();globalThis.data='';pipe.on('data',v=>data+=v.toString());pipe.end('B');true",
            "true"));
        ex = null;
        var loop_a: bool = run_event_loop(a, &ex) && ex == null;
        ex = null;
        var loop_b: bool = run_event_loop(b, &ex) && ex == null;
        check("full hosts dispatch streams without crossing contexts", loop_a && loop_b && context_result(a,
            "data", "A") && context_result(b, "data", "B"));
        check("module caches exports and HTTP constructors remain context-local", context_result(a, "require('path').hostMark='A';require('http').createServer() instanceof require('events')",
            "true") && context_result(b, "require('path').hostMark===undefined&&require('http').createServer() instanceof require('events')",
            "true"));
        check("crypto URL and cancellation use their own full-host roots", context_result(a, "require('crypto').createHash('sha256').update('abc').digest('hex').startsWith('ba7816')&&new URL('https://a.test/x').hostname==='a.test'&&new AbortController().signal.aborted===false",
            "true") && context_result(b, "require('crypto').createHash('sha256').update('abc').digest('hex').startsWith('ba7816')&&new URL('https://b.test/x').hostname==='b.test'&&new AbortController().signal.aborted===false",
            "true"));
    }
    check("second full host releases every native state slot", shutdown_host(b) && wr_context_data(b) == null);
    wr_context_release(b);
    if (ready_a) {
        check("full host survives destruction of another full host", context_result(a, "require('path').hostMark==='A'&&require('crypto').randomBytes(8).length===8&&new URL('https://alive.test/').hostname==='alive.test'",
            "true"));
        ex = null;
        check("remaining full host event loop is operational", run_event_loop(a, &ex) && ex == null);
    }
    check("first full host releases every native state slot", shutdown_host(a) && wr_context_data(a) == null);
    wr_context_release(a);
}
