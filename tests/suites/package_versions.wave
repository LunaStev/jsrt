// Version selection, semver and archive-cache capacity regressions.
import("jsrt::tools::support")::{join, concat, private_directory};
import("jsrt::tools::private_files")::{clean_private_directory};
import("jsrt::runtime::package_version")::{Version, parse_version, compare_versions};
import("jsrt::runtime::package_semver")::{valid_range, satisfies};
import("jsrt::runtime::package_versions")::{select_version, registry_exact_version};
import("jsrt::runtime::package_versions")::{select_peer_version};
import("jsrt::runtime::package_graph")::{graph_clear, record_peer};
import("jsrt::runtime::package_cache")::{cache_filename, read_cached_archive, store_cached_archive};
import("jsrt::runtime::package_io")::{Blob, free_blob, integrity};
import("jsrt::runtime::package_transaction")::{open_transaction, start_transaction_stage, close_transaction};
import("wjson")::{JsonDoc, json_parse_bytes, json_ok, json_root, json_free, JSON_STRICT};
import("std::fs::file")::{write};
import("std::mem::ops")::{mem_eq, mem_zero};
import("std::mem::cstr")::{mem_len_cstr, mem_eq_cstr};
import("std::sys::fs")::{Stat, stat, mkdir};
import("./harness")::{check, TestState, test_state};
extern(c, "utimensat") fun test_file_times(fd: i32, path: str, times: ptr<i64>, flags: i32) -> i32;

pub fun cache_capacity_tests() {
    var suite: ptr<TestState> = test_state();
    var root: ptr<u8> = private_directory((deref suite.directory) as str, "cache-capacity-");
    check("reserve automatic cache eviction fixture", root != null);
    if (root == null) {
        return;
    }
    var cache: str = join(root as str, ".jsrt-cache") as str;
    var opened: bool = open_transaction(root as str);
    var ok: bool = opened && start_transaction_stage() && mkdir(cache, 448) == 0;
    var oldest: str = "";
    var other: str = "";
    var bytes: array<u8, 8>;
    var sri: array<u8, 96>;
    var name: array<u8, 104>;
    // Cache entries are opaque SRI-verified bytes; package extraction is tested
    // separately. Tiny entries exercise the real default boundary without big I/O.
    for (var i: i64 = 0; i < 1024 && ok; i++) {
        mem_zero(&bytes[0], 8);
        bytes[0] = (i % 256) as u8;
        bytes[1] = (i / 256) as u8;
        ok = integrity(&bytes[0], 8, &sri[0]) && cache_filename(&sri[0] as str, &name[0]);
        var path: str = join(cache, &name[0] as str) as str;
        if (ok) {
            ok = write(path, &bytes[0], 8) == 8;
        }
        if (i == 0 && ok) {
            oldest = path;
            var times: array<i64, 4> = [100, 0, 100, 0];
            ok = test_file_times(-100, path, &times[0], 256) == 0;
        } else if (i == 1) {
            other = path;
        }
    }
    check("prepare 1024 real bounded cache entries", ok);
    bytes[0] = 255;
    bytes[1] = 255;
    var archive: Blob = Blob {bytes: &bytes[0], length: 8, capacity: 8};
    if (ok) {
        ok = integrity(&bytes[0], 8, &sri[0]) && store_cached_archive(archive, &sri[0] as str);
        var info: Stat;
        check("archive publication automatically evicts the oldest entry at the default limit", ok &&
            stat(oldest, &info) < 0 && stat(other, &info) == 0);
        var hit: Blob;
        var found: i64 = read_cached_archive(&sri[0] as str, &hit);
        check("automatic eviction leaves the new archive verified and readable", found == 1 &&
            hit.length == 8 && mem_eq(hit.bytes, &bytes[0], 8));
        free_blob(&hit);
    }
    if (opened) {
        check("automatic cache eviction releases the transaction", close_transaction());
    }
    check("remove automatic cache eviction fixture", clean_private_directory(root as str));
}

fun semver_case(version: str, requirement: str, expected: bool) {
    var actual: bool = satisfies(version, requirement);
    check(concat(concat("semver ", version) as str, concat(" in ", requirement) as str) as str, (actual && expected) || (!actual && !expected));
}

pub fun semver_tests() {
    var invalid: array<str, 12> = ["01.0.0", "1.02.0", "1.0", "1.2.3.4", "1.0.0-01", "1.0.0-", "1.0.0+",
        "1.0.0-a..b", "1.0.0+!", "9007199254740992.0.0", "v1.0.0", "1.0.0 "];
    for (var i: i64 = 0; i < 12; i++) {
        var value: Version = parse_version(invalid[i]);
        check(concat("reject invalid version ", invalid[i]) as str, !value.valid);
    }
    var order: array<str, 8> = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2",
        "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0"];
    for (var i: i64 = 1; i < 8; i++) {
        check(concat("SemVer precedence ", order[i]) as str, compare_versions(parse_version(order[i-1]),
            parse_version(order[i])) < 0);
    }
    check("SemVer build metadata does not affect precedence", compare_versions(parse_version("1.2.3+001.build"),
        parse_version("1.2.3+other")) == 0);
    check("registry exact endpoint accepts release and prerelease identities",registry_exact_version("1.2.3") && registry_exact_version("1.2.3-beta.1"));
    check("registry build metadata requirements use version selection",!registry_exact_version("1.2.3+build") && !registry_exact_version("^1.2.3"));
    check("SemVer arbitrary numeric prerelease identifiers compare without integer overflow", compare_versions(parse_version("1.0.0-999999999999999999999999999999"),
        parse_version("1.0.0-1000000000000000000000000000000")) < 0);
    semver_case("1.9.9", "^1.2.3", true);
    semver_case("2.0.0", "^1.2.3", false);
    semver_case("0.2.9", "^0.2.3", true);
    semver_case("0.3.0", "^0.2.3", false);
    semver_case("0.0.4", "^0.0.3", false);
    semver_case("0.0.3", "^0.0.3", true);
    semver_case("0.7.0", "^0", true);
    semver_case("0.0.9", "^0.0", true);
    semver_case("1.2.9", "~1.2.3", true);
    semver_case("1.3.0", "~1.2.3", false);
    semver_case("1.9.0", "~1", true);
    semver_case("2.0.0", "~1", false);
    semver_case("1.2.9", "1.2.x", true);
    semver_case("1.3.0", "1.2.*", false);
    semver_case("1.9.9", "1", true);
    semver_case("1.2.0", "1.2", true);
    semver_case("1.2.3", "", true);
    semver_case("1.2.3", "*", true);
    semver_case("1.2.3", "= 1.2.3", true);
    semver_case("1.2.3", "=1.2.4", false);
    semver_case("2.0.0", ">1", true);
    semver_case("1.9.9", ">1", false);
    semver_case("1.3.0", ">1.2", true);
    semver_case("1.2.9", ">1.2", false);
    semver_case("1.2.0", ">=1.2", true);
    semver_case("1.2.0", "<1.2", false);
    semver_case("1.1.9", "<1.2", true);
    semver_case("1.9.9", "<=1", true);
    semver_case("2.0.0", "<=1", false);
    semver_case("1.5.0", ">=1.2.0 <2.0.0", true);
    semver_case("2.0.0", ">=1.2.0 <2.0.0", false);
    semver_case("3.1.0", "^1 || >=3.0.0 <4", true);
    semver_case("2.1.0", "^1 || >=3.0.0 <4", false);
    semver_case("1.2.0", "1.2 - 2.3", true);
    semver_case("2.3.99", "1.2 - 2.3", true);
    semver_case("2.4.0", "1.2 - 2.3", false);
    semver_case("1.0.0-alpha", "*", false);
    semver_case("1.2.3-beta.2", ">=1.2.3-beta.1 <2", true);
    semver_case("1.3.0-beta", ">=1.2.3-beta.1 <2", false);
    semver_case("1.2.3", "1.2.3+build", true);
    semver_case("1.2.3", ">*", false);
    semver_case("1.2.3", "<*", false);
    semver_case("1.2.3", ">=*", true);
    var bad_ranges: array<str, 10> = ["^", "1 ||", "|| 1", "1 | 2", ">=1.0.0.1", "1.x.3", "latest", "git:x",
        "file:x", "1.0.0 -"];
    for (var i: i64 = 0; i < 10; i++) {
        check(concat("reject invalid range ", bad_ranges[i]) as str, !valid_range(bad_ranges[i]));
    }
    var source: str = "{\"1.9.0\":{},\"1.2.3\":{},\"2.0.0-beta\":{},\"1.10.0\":{},\"bad\":{},\"1.11.0\":false}";
    var doc: JsonDoc = json_parse_bytes(source as ptr<u8>, mem_len_cstr(source), 32, JSON_STRICT);
    check("registry selection chooses highest satisfying stable version independently of key order",
        json_ok(doc) && mem_eq_cstr(select_version(json_root(doc), "^1.2.3"), "1.10.0"));
    check("registry selection honors explicit prerelease ranges", mem_eq_cstr(select_version(json_root(doc),
        "^2.0.0-beta"), "2.0.0-beta"));
    check("registry selection reports no matching version", (select_version(json_root(doc), ">=3") as ptr<u8>) == null);
    graph_clear();
    check("peer graph records intersecting alternatives in a shared scope", record_peer("host", "^1 || ^2", "", false) &&
        record_peer("host", "<1.10.0", "", false) && record_peer("host", "^9", "nested", false));
    check("peer selection chooses a shared version without flattening OR ranges", mem_eq_cstr(
        select_peer_version(json_root(doc), "^1 || ^2", "host", ""), "1.9.0"));
    check("optional peer constraints apply when the shared peer is installed", record_peer("host", "<1.9", "", true) &&
        mem_eq_cstr(select_peer_version(json_root(doc), "^1 || ^2", "host", ""), "1.2.3"));
    check("incompatible shared peer ranges have no selectable version", record_peer("host", ">=3", "", false) &&
        (select_peer_version(json_root(doc), "^1 || ^2", "host", "") as ptr<u8>) == null);
    graph_clear();
    json_free(&doc);
}
