# JSC 2.54.1 creates one process-wide empty ExecutableAllocator object (one byte).
# The upstream source keeps it in g_jscConfig/globalExecutableAllocatorToWorkAroundLeaks.
# This excludes only that initialization stack, never VM/RunLoop/host allocations.
{
    jsc-2.54.1-process-executable-allocator
    Memcheck:Leak
    match-leak-kinds: definite
    fun:malloc
    fun:_ZN3WTF10fastMallocEm
    fun:_ZN3JSC19ExecutableAllocator10initializeEv
}
